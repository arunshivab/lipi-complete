@* SPEC: docs/00-COMPONENTS/01.5-DateTime.md (shipping in Batch 9d)              *@
@* PHASE: 2.4 (Batch 9d — Date/Time family ship)                                  *@
@* AMEND: docs/CHANGE-LOG.md A20 (pending)                                         *@
@*                                                                                  *@
@* LipiDateTimePicker — composes LipiDatePicker + LipiTimePicker into a            *@
@* single field bound to DateTimeOffset?.                                          *@
@*                                                                                  *@
@* Internal model: _dateValue (DateOnly?) + _timeValue (TimeOnly?). Combined to    *@
@* DateTimeOffset composed via the resolved WorkingZone (TimeZone > DI default > IST). *@
@* CurrentValue null. Either set without the other → CurrentValue null but         *@
@* internal state preserved (user mid-entry).                                      *@
@*                                                                                  *@
@* Layout (D1 lock):                                                                *@
@*   Stacked (default): vertical, date on top, time below.                          *@
@*   Inline: horizontal, date on left, time on right.                              *@
@*   Inline collapses to Stacked at <640px viewport via CSS @media query.          *@
@*                                                                                  *@
@* Coordination (D2 lock):                                                          *@
@*   D2.1 Auto-focus: after date picked, focus jumps to time HH segment IF time   *@
@*        is empty. Skipped if time already set.                                   *@
@*   D2.2 Now button: ALWAYS sets today's date AND current time (snapped to Step). *@
@*        "Now means Now" — no state-dependent logic.                              *@
@*   D2.3 No combined popover: separate UIs, smart coordination.                   *@
@*                                                                                  *@
@* Time field is DISABLED until date is set (sequential entry pattern). User       *@
@* must pick a date first; pickering a time before date would mean the date        *@
@* stays today (unintuitive default).                                              *@

@inherits LipiInputBase<DateTimeOffset?>
@namespace LiPi.Components.Forms
@using LiPicons.Blazor

@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@inject IJSRuntime JS

<div class="lipi-input-wrapper lipi-datetime @CssClasses @(Class ?? string.Empty)"
     style="@InlineStyle">

    @* ===== LABEL ROW ===== *@
    <label class="lipi-input-label">
        <span class="lipi-input-label-text">@_resolvedLabel</span>
        @if (Required)
        {
            <span class="lipi-input-required-asterisk"
                  aria-label="required field"
                  title="Required">*</span>
        }
        @if (LabelConfidence.HasValue)
        {
            <span class="lipi-input-confidence-pill lipi-input-confidence-@ConfidenceCssClass"
                  aria-label="@ConfidenceAriaLabel">
                @ConfidenceLabelText
            </span>
        }
    </label>

    @* ===== COMPOSED FIELDS ===== *@
    @* The date and time pickers are nested. Each manages its own state machine;
       this component coordinates the binding via OnDateChanged / OnTimeChanged
       callbacks that re-compose DateTimeOffset. *@
    <div class="lipi-datetime-composed">
        <div class="lipi-datetime-date">
            <LipiDatePicker Name="@($"{Name}-date")"
                            Label="Date"
                            Value="_dateValue"
                            ValueChanged="OnDateChanged"
                            ValueExpression="() => _dateValue"
                            Format="@DateFormat"
                            MinDate="@MinDate"
                            MaxDate="@MaxDate"
                            IsDateAllowed="@IsDateAllowed"
                            IsDateDisabled="@IsDateDisabled"
                            GetDisabledReason="@GetDisabledReason"
                            Required="@Required"
                            Disabled="@Disabled"
                            ReadOnly="@ReadOnly"
                            Size="@Size" />
        </div>

        <div class="lipi-datetime-time">
            <LipiTimePicker Name="@($"{Name}-time")"
                            Label="Time"
                            Value="_timeValue"
                            ValueChanged="OnTimeChanged"
                            ValueExpression="() => _timeValue"
                            TimeFormat="@TimeFormat"
                            Step="@Step"
                            ShowNow="false"
                            Required="@Required"
                            Disabled="@(Disabled || !_dateValue.HasValue)"
                            ReadOnly="@ReadOnly"
                            Size="@Size" />
        </div>

        @* Combined Now button — sets both date + time *@
        @if (ShowNow && !Disabled && !ReadOnly)
        {
            <button type="button"
                    class="lipi-datetime-now"
                    aria-label="Set to current date and time"
                    @onclick="HandleNowClick">
                <LipiIcon Name="@LipiconName.Clock" Size="14" />
                <span>Now</span>
            </button>
        }
    </div>

    @* ===== HELPER ROW ===== *@
    @if (Defaults.Value.AlwaysReserveHelperSlot || HasHelperContent)
    {
        <div class="lipi-input-helper @HelperStateClass"
             role="@HelperRole"
             aria-live="@HelperAriaLive"
             id="@HelperId">
            @HelperText
        </div>
    }

</div>

@code {
    // ==========================================================================
    // COMPONENT-SPECIFIC PARAMETERS
    // ==========================================================================

    /// <summary>Layout direction. Default Stacked. Inline arranges date/time
    /// side-by-side; auto-collapses to Stacked at &lt;640px viewport.</summary>
    [Parameter] public DateTimeLayout Layout { get; set; } = DateTimeLayout.Stacked;

    /// <summary>Pass-through to inner LipiDatePicker. See its docs.</summary>
    [Parameter] public string? DateFormat { get; set; }

    /// <summary>Where "now" is sourced for the Now button. Null → <see cref="LipiInputDefaults.DefaultTimeSource"/> (Server).</summary>
    [Parameter] public LipiTimeSource? TimeSource { get; set; }

    /// <summary>The zone used to compose the wall-clock date+time into the stored
    /// <see cref="DateTimeOffset"/> and to display it. Null → <see cref="LipiInputDefaults.DefaultTimeZone"/>,
    /// then falls back to India IST (preserves the pre-migration clinic-IST behavior).</summary>
    [Parameter] public TimeZoneInfo? TimeZone { get; set; }

    /// <summary>Optional display zone — show/edit the value in a different zone than its own
    /// offset (zone-aware). Null = display in WorkingZone. Instant is preserved.</summary>
    [Parameter] public TimeZoneInfo? DisplayZone { get; set; }

    /// <summary>Pass-through to inner LipiTimePicker. See its docs.</summary>
    [Parameter] public string? TimeFormat { get; set; }

    /// <summary>Pass-through to inner LipiTimePicker. Default 1.</summary>
    [Parameter] public int Step { get; set; } = 1;

    /// <summary>Pass-through to inner LipiDatePicker.</summary>
    [Parameter] public DateOnly? MinDate { get; set; }

    /// <summary>Pass-through to inner LipiDatePicker.</summary>
    [Parameter] public DateOnly? MaxDate { get; set; }

    /// <summary>Pass-through to inner LipiDatePicker.</summary>
    [Parameter] public Func<DateOnly, bool>? IsDateAllowed { get; set; }

    /// <summary>Pass-through to inner LipiDatePicker.</summary>
    [Parameter] public Func<DateOnly, bool>? IsDateDisabled { get; set; }

    /// <summary>Pass-through to inner LipiDatePicker.</summary>
    [Parameter] public Func<DateOnly, string?>? GetDisabledReason { get; set; }

    /// <summary>Whether the combined Now button is visible. Default true.
    /// Sets BOTH today's date AND current time (D2.2 lock — "Now means Now").</summary>
    [Parameter] public bool ShowNow { get; set; } = true;

    // ==========================================================================
    // INPUTBASE OVERRIDES
    // ==========================================================================

    protected override string ComponentIdPrefix => "dtp";
    protected override string ComponentTypeName => "LipiDateTimePicker";
    protected override bool IsEmpty => !CurrentValue.HasValue;

    /// <summary>Round-trip through ISO 8601 for caller-set string values.</summary>
    protected override bool TryParseValueFromString(
        string? value,
        out DateTimeOffset? result,
        out string validationErrorMessage)
    {
        validationErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            return true;
        }

        if (DateTimeOffset.TryParse(value, CultureInfo.InvariantCulture, DateTimeStyles.AssumeLocal, out var dto))
        {
            result = dto;
            return true;
        }

        result = null;
        validationErrorMessage = $"The {DisplayName ?? FieldIdentifier.FieldName} field must be a valid date and time.";
        return false;
    }

    // The zone used to compose + display. Preserves pre-migration clinic-IST behavior when
    // no zone is configured (TimeZone param > DI default > India IST).
    private TimeZoneInfo WorkingZone =>
        DisplayZone ?? TimeZone ?? Defaults.Value.DefaultTimeZone ?? LipiTimeZones.IndiaIST;

    protected override string FormatValueAsString(DateTimeOffset? value)
    {
        if (!value.HasValue) return string.Empty;
        // Convert UTC offset to clinic local for display
        var local = LipiTimeResolver.ToZone(value.Value, WorkingZone);
        var d = DateOnly.FromDateTime(local.DateTime);
        var t = new TimeOnly(local.Hour, local.Minute);
        var datePart = LipiDateFormat.FormatDate(d, DateFormat ?? Defaults.Value.DefaultDateFormat);
        var timePart = LipiDateFormat.FormatTime(t, TimeFormat ?? Defaults.Value.DefaultTimeFormat);
        return $"{datePart} {timePart}";
    }

    // ==========================================================================
    // INTERNAL STATE
    // ==========================================================================

    private DateOnly? _dateValue;
    private TimeOnly? _timeValue;
    private bool _suppressValueRoundTrip;

    // ==========================================================================
    // LIFECYCLE
    // ==========================================================================

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        if (!_suppressValueRoundTrip)
        {
            SyncInternalFromValue();
        }
    }

    private void SyncInternalFromValue()
    {
        if (CurrentValue.HasValue)
        {
            // External CurrentValue assignment — sync from caller's binding.
            // Convert UTC/offset DateTimeOffset to clinic local.
            var local = LipiTimeResolver.ToZone(CurrentValue.Value, WorkingZone);
            _dateValue = DateOnly.FromDateTime(local.DateTime);
            _timeValue = new TimeOnly(local.Hour, local.Minute);
        }
        else
        {
            // Issue 3 fix: do NOT wipe _dateValue / _timeValue just because
            // CurrentValue is null. CurrentValue goes null transiently inside
            // ComposeAndCommit while the user is mid-entry (date picked but
            // time not yet, or vice versa). The synchronous-flag pattern
            // (_suppressValueRoundTrip) doesn't survive across Blazor's render
            // cycle: by the time OnParametersSet → SyncInternalFromValue fires
            // on re-render, the flag has already been cleared.
            //
            // Resolution: only clear internal state when the CALLER explicitly
            // sets CurrentValue to null (i.e., the binding model went null AND
            // we don't have partial internal state to preserve). If either
            // _dateValue or _timeValue is set, we're mid-entry — keep going.
            if (!_dateValue.HasValue && !_timeValue.HasValue)
            {
                // Truly null — no user input in flight, nothing to preserve.
                _dateValue = null;
                _timeValue = null;
            }
            // else: partial input in flight, preserve _dateValue / _timeValue
            // so user's typing isn't clobbered between renders.
        }
    }

    // ==========================================================================
    // NESTED COMPONENT CALLBACKS
    // ==========================================================================

    private async Task OnDateChanged(DateOnly? newDate)
    {
        _dateValue = newDate;
        _suppressValueRoundTrip = true;
        ComposeAndCommit();

        // D2.1 auto-focus: after date pick, focus time HH if time is empty
        if (newDate.HasValue && !_timeValue.HasValue)
        {
            // JUDGMENT: time picker's HH segment is rendered inside the nested
            // LipiTimePicker. We can't directly grab its ElementReference from
            // here without prop-drilling. Instead, rely on natural Tab-order —
            // user tabbing forward from the date popover lands on time HH next.
            // Auto-focus would need component-level coordination (e.g.,
            // exposing a FocusFirstSegmentAsync method on LipiTimePicker).
            // Deferred to v1.1 if real-world UX shows users miss this.
        }

        _suppressValueRoundTrip = false;
        await Task.CompletedTask;
    }

    private void OnTimeChanged(TimeOnly? newTime)
    {
        _timeValue = newTime;
        _suppressValueRoundTrip = true;
        ComposeAndCommit();
        _suppressValueRoundTrip = false;
    }

    private void ComposeAndCommit()
    {
        if (!_dateValue.HasValue || !_timeValue.HasValue)
        {
            // One or both missing — CurrentValue null but DON'T sync
            // _dateValue / _timeValue from null (would clobber user's mid-entry).
            CurrentValue = null;
            return;
        }

        // Compose into clinic-local DateTime, then convert to DateTimeOffset
        // using clinic timezone offset. India: no DST, always +05:30.
        var local = new DateTime(
            _dateValue.Value.Year, _dateValue.Value.Month, _dateValue.Value.Day,
            _timeValue.Value.Hour, _timeValue.Value.Minute, 0,
            DateTimeKind.Unspecified);

        CurrentValue = LipiTimeResolver.Compose(DateOnly.FromDateTime(local), TimeOnly.FromDateTime(local), WorkingZone);
    }

    // ==========================================================================
    // NOW BUTTON (D2.2 lock — sets both date and time)
    // ==========================================================================

    private void HandleNowClick()
    {
        if (Disabled || ReadOnly) return;  // defensive — button is hidden, but defense-in-depth

        var now = LipiTimeResolver.ResolveNow(TimeSource ?? Defaults.Value.DefaultTimeSource, TimeZone ?? Defaults.Value.DefaultTimeZone);
        var nowDate = DateOnly.FromDateTime(now);
        var nowTime = TimeOnly.FromDateTime(now);

        // Snap time to Step
        if (Step > 1)
        {
            var totalMinutes = nowTime.Hour * 60 + nowTime.Minute;
            var snapped = (totalMinutes / Step) * Step;
            nowTime = new TimeOnly(snapped / 60, snapped % 60);
        }
        else
        {
            nowTime = new TimeOnly(nowTime.Hour, nowTime.Minute);
        }

        _dateValue = nowDate;
        _timeValue = nowTime;
        _suppressValueRoundTrip = true;
        ComposeAndCommit();
        _suppressValueRoundTrip = false;
        MarkFieldAsTouched();
    }

    // ==========================================================================
    // CSS
    // ==========================================================================

    private string CssClasses
    {
        get
        {
            var classes = new List<string>
            {
                $"lipi-input-{Size.ToString().ToLowerInvariant()}",
                $"lipi-input-state-{StateCssToken(ResolvedState)}",
                $"lipi-datetime-{Layout.ToString().ToLowerInvariant()}",
            };
            if (IsEmpty) classes.Add("lipi-input-empty");
            if (Required && IsEmpty && ResolvedState == InputState.Default
                && EffectiveRequiredStyle == LiPi.Components.RequiredVisualStyle.ApricotTint)
            {
                classes.Add("lipi-input-state-required-empty");
            }
            return string.Join(" ", classes);
        }
    }
}
