@* SPEC: docs/00-COMPONENTS/01.2-TextInputs.md (LipiTextBox component)            *@
@* PHASE: 2.2 (Batch 2 ship) + 2.2.5 (this Batch 8a — base class migration)      *@
@* AMEND: docs/CHANGE-LOG.md A16 (pending — Phase 2.2.5 wrap-up)                 *@
@*                                                                                *@
@* Phase 2.2.5 migration: derives from LipiInputBase<string?> instead of         *@
@* InputBase<string?>. The base now owns all common parameters (Name, Label,    *@
@* Helper, Error, Warning, Success, Required, Disabled, ReadOnly, Autocomplete, *@
@* Size, Icon, AriaDescribedBy, RequiredVisualStyle, LabelConfidence, Cols,     *@
@* Class), the EditContext subscription for validation auto-population, the    *@
@* anonymous-id fallback, the env-gated parameter validation, and the state    *@
@* cascade. LipiTextBox keeps only the single-line-text-specific bits: Type,   *@
@* IconRight, OnIconRightClick, IconRightAriaLabel, MaxLength, plus the markup *@
@* and event handlers.                                                          *@

@namespace LiPi.Components
@using LiPicons.Blazor
@inherits LipiInputBase<string?>

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

<div class="lipi-input-wrapper @CssClasses @_resolvedLabelPositionClass @(Class ?? string.Empty)" style="@InlineStyle">

    @* ===== LABEL ROW ===== *@
    <label class="lipi-input-label" for="@EffectiveId">
        <span class="lipi-input-label-text">@_resolvedLabel</span>
        @if (Required)
        {
            @* Locked Decision 6 (Approach D): asterisk + ARIA + tooltip ALWAYS render
               regardless of RequiredVisualStyle. Sighted users get apricot tint (when
               that style is active); screen-reader users get asterisk + aria-label. *@
            <span class="lipi-input-required-asterisk"
                  aria-label="required field"
                  title="Required">*</span>
        }
        @if (LabelConfidence.HasValue)
        {
            <span class="lipi-input-confidence-pill lipi-input-confidence-@ConfidenceCssClass"
                  aria-label="@ConfidenceAriaLabel">
                @ConfidenceLabelText
            </span>
        }
    </label>

    @* ===== INPUT BODY (field + helper grouped — required for Left/Right LabelPosition) ===== *@
    <div class="lipi-input-body">

    @* ===== INPUT ROW ===== *@
    <div class="lipi-input-field">

        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="lipi-input-icon-leading" aria-hidden="true">
                <LipiIcon Name="@Icon" Size="@IconPx" />
            </span>
        }

        <input id="@EffectiveId"
               name="@_resolvedName"
               type="@TypeAttr"
               class="lipi-input-control"
               value="@CurrentValueAsString"
               placeholder="@Placeholder"
               autocomplete="@AutocompleteAttr"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               maxlength="@MaxLengthAttr"
               aria-invalid="@AriaInvalidAttr"
               aria-describedby="@AriaDescribedByAttr"
               aria-label="@(string.IsNullOrEmpty(_resolvedLabel) ? AriaLabel : null)"
               @oninput="HandleInput"
               @onblur="HandleBlur" />

        @if (!string.IsNullOrEmpty(EffectiveTrailingIcon))
        {
            @if (IconRightClickable)
            {
                <button type="button"
                        class="lipi-input-icon-trailing lipi-input-icon-trailing-button"
                        aria-label="@IconRightAriaLabel"
                        disabled="@Disabled"
                        @onclick="HandleIconRightClick">
                    <LipiIcon Name="@EffectiveTrailingIcon" Size="@IconPx" />
                </button>
            }
            else
            {
                <span class="lipi-input-icon-trailing" aria-hidden="true">
                    <LipiIcon Name="@EffectiveTrailingIcon" Size="@IconPx" />
                </span>
            }
        }

    </div>

    @* ===== HELPER ROW (always reserved unless globally disabled) ===== *@
    @if (Defaults.Value.AlwaysReserveHelperSlot || HasHelperContent)
    {
        <div class="lipi-input-helper @HelperStateClass"
             role="@HelperRole"
             aria-live="@HelperAriaLive"
             id="@HelperId">
            @HelperText
        </div>
    }

    </div>@* end lipi-input-body *@

</div>

@code {
    // ==========================================================================
    // COMPONENT-SPECIFIC PARAMETERS
    // ──────────────────────────────────────────────────────────────────────────
    // The 18 common parameters live on LipiInputBase<string?> and are inherited
    // automatically. Only LipiTextBox-specific parameters are declared here.
    //
    // Inherited from InputBase<string?> — DO NOT redeclare:
    //   [Parameter] Value, ValueChanged, ValueExpression, DisplayName
    //   protected CurrentValue, CurrentValueAsString, EditContext, FieldIdentifier
    // ==========================================================================

    /// <summary>HTML input type. Default Text. Number is excluded — use LipiNumberInput
    /// instead for locale-aware numeric input. See <see cref="TextInputType"/> for the
    /// supported values (Text/Email/Tel/Password/Search/Url).</summary>
    [Parameter] public TextInputType Type { get; set; } = TextInputType.Text;

    /// <summary>Lucide icon name rendered to the RIGHT of input text. Replaced by validation
    /// overlay during Error/Warning/Success states. Becomes interactive when OnIconRightClick
    /// is wired (typical patterns: password toggle, clear button, copy-to-clipboard).</summary>
    [Parameter] public string? IconRight { get; set; }

    /// <summary>Click handler for the right-side icon. When set, the icon becomes a
    /// focusable button.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnIconRightClick { get; set; }

    /// <summary>Accessible label for the right-side icon button. Required when
    /// OnIconRightClick is set (WCAG 2.1 SC 4.1.2 — accessible name for interactive controls).</summary>
    [Parameter] public string? IconRightAriaLabel { get; set; }

    /// <summary>HTML maxlength attribute. Null = unlimited.</summary>
    [Parameter] public int? MaxLength { get; set; }

    // ── Phase 2.5.5 — LabelPosition cross-family retrofit ─────────────────────────────────

    /// <summary>Position of the label relative to the input field.
    /// Top (default) — label above. Left — saves vertical space. Right — label right. Bottom — caption.</summary>
    [Parameter] public InputLabelPosition LabelPosition { get; set; }
        = InputLabelPosition.Top;

    /// <summary>Accessible name when Label is empty (inline-left layout or icon-only context).
    /// Required when Label="" to satisfy WCAG 2.1 SC 4.1.2.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    private string _resolvedLabelPositionClass = string.Empty;

    // ==========================================================================
    // INPUTBASE OVERRIDE
    // ──────────────────────────────────────────────────────────────────────────
    // For string-typed inputs the parsing is identity — the raw string IS the value.
    // Always succeeds. NumberInput<TValue> has real parsing logic.
    // ==========================================================================

    protected override bool TryParseValueFromString(
        string? value,
        out string? result,
        out string validationErrorMessage)
    {
        result = value;
        validationErrorMessage = string.Empty;
        return true;
    }

    // ==========================================================================
    // BASE CLASS OVERRIDES
    // ==========================================================================

    /// <summary>Component id namespace — produces id="tb-{Name}" so legacy stylesheets
    /// targeting #tb-* selectors continue to match.</summary>
    protected override string ComponentIdPrefix => "tb";

    /// <summary>Type name for log messages — overrides the generic-mangled default.</summary>
    protected override string ComponentTypeName => "LipiTextBox";

    /// <summary>For string?, "empty" includes both null AND "". The base default
    /// (CurrentValue is null) would treat "" as non-empty, breaking the apricot-tint
    /// trigger when a user clears the input.</summary>
    protected override bool IsEmpty => string.IsNullOrEmpty(CurrentValueAsString);

    /// <summary>Append the LipiTextBox-specific component-validation check
    /// (IconRightAriaLabel required when OnIconRightClick is wired).</summary>
    protected override List<string> CollectParameterValidationErrors()
    {
        var errors = base.CollectParameterValidationErrors();

        // Phase 2.5.5 — suppress base's "Label parameter is required" when AriaLabel covers
        // the accessible-name requirement (inline-left layout pattern).
        if (!string.IsNullOrWhiteSpace(AriaLabel))
        {
            errors.RemoveAll(e => e.StartsWith("Label parameter is required"));
        }

        if (string.IsNullOrWhiteSpace(_resolvedLabel) && string.IsNullOrWhiteSpace(AriaLabel))
        {
            errors.Add("AriaLabel is required when Label is empty (accessible name for assistive tech).");
        }

        if (OnIconRightClick.HasDelegate && string.IsNullOrWhiteSpace(IconRightAriaLabel))
        {
            errors.Add("IconRightAriaLabel is required when OnIconRightClick is wired " +
                       "(WCAG 2.1 SC 4.1.2 — accessible name for interactive controls)");
        }

        return errors;
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        _resolvedLabelPositionClass = LabelPosition switch
        {
            InputLabelPosition.Left   => "lipi-input-label-left",
            InputLabelPosition.Right  => "lipi-input-label-right",
            InputLabelPosition.Bottom => "lipi-input-label-bottom",
            _                         => string.Empty
        };
    }

    // ==========================================================================
    // COMPONENT-SPECIFIC RESOLVED PROPERTIES
    // ==========================================================================

    private bool IconRightClickable => OnIconRightClick.HasDelegate;

    private string TypeAttr => Type switch
    {
        TextInputType.Email    => "email",
        TextInputType.Tel      => "tel",
        TextInputType.Password => "password",
        TextInputType.Search   => "search",
        TextInputType.Url      => "url",
        _                      => "text"
    };

    private string CssClasses
    {
        get
        {
            var classes = new List<string>
            {
                $"lipi-input-{Size.ToString().ToLowerInvariant()}",
                $"lipi-input-state-{StateCssToken(ResolvedState)}"
            };
            if (IsEmpty)            classes.Add("lipi-input-empty");
            if (IconRightClickable) classes.Add("lipi-input-icon-right-clickable");
            if (!string.IsNullOrEmpty(Icon))      classes.Add("lipi-input-has-leading-icon");
            if (EffectiveTrailingIcon != null)    classes.Add("lipi-input-has-trailing-icon");
            return string.Join(" ", classes);
        }
    }

    /// <summary>Validation-state icons override caller's IconRight when active.
    /// Lucide icons used: Error → circle-x, Warning → alert-triangle, Success → check.</summary>
    private string? EffectiveTrailingIcon => ResolvedState switch
    {
        InputState.Error   => "circle-x",
        InputState.Warning => "warning",
        InputState.Success => "check",
        _                  => IconRight
    };

    private string? MaxLengthAttr => MaxLength?.ToString();

    // ==========================================================================
    // EVENT HANDLERS
    // ==========================================================================

    private void HandleInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;

        // CurrentValueAsString setter (inherited from InputBase<string?>):
        //   1. Calls TryParseValueFromString → assigns CurrentValue
        //   2. Fires ValueChanged.InvokeAsync (fire-and-forget)
        //   3. Notifies EditContext.NotifyFieldChanged → triggers validation
        //   4. EditContext fires OnValidationStateChanged
        //   5. LipiInputBase's HandleValidationStateChanged updates _editContextError
        //   6. Re-render: EffectiveError surfaces validation message in helper slot
        // No await needed — the InputBase pipeline is internally fire-and-forget.
        CurrentValueAsString = e.Value?.ToString();
    }

    // HandleBlur is inherited from LipiInputBase<string?>. It marks _isTouched=true,
    // forces EditContext.NotifyFieldChanged so [Required] validates on tab-past, and
    // calls our virtual OnFieldBlurred hook (which we don't override — text inputs
    // have no component-specific blur logic).

    private async Task HandleIconRightClick(MouseEventArgs e)
    {
        if (!IconRightClickable || Disabled) return;
        await OnIconRightClick.InvokeAsync(e);
    }
}
