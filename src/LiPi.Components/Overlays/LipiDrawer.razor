@* SPEC:  docs/02-LipiDrawer-Spec.md
   PHASE: 2.6.2 — Overlay Surfaces
   AMEND: docs/CHANGE-LOG.md A32

   A32 completions (vs initial 2.6.2 build):
   1. SIX missing parameters added per spec §2:
        - SizePx           — px override of Size (sets width for R/L, height for T/B)
        - IsBusy           — aria-busy + disables close/pin buttons
        - Animate          — when false, applies lipi-drawer-no-animate class
        - AutoFocusSelector — accepted but no-op in v1.0 (needs JS helper, v1.1+)
        - RouteScopePrefix — required for PinScope.RouteScoped close behavior
        - DefaultPinned    — initial pin state when localStorage has no value
   2. Pin mode completion (spec §4.5):
        - localStorage read on first render → restores pin state across sessions
        - NavigationManager subscription closes drawer per PinScope
            * PageScoped:    closes on ANY navigation
            * RouteScoped:   closes when URL leaves RouteScopePrefix
            * Global:        never auto-closes
        - lipi-drawer-pinned class applied when pinned → triggers :has() CSS
          page-shift in lipi-overlays.css (Right/Left only; T/B unsupported
          per spec §4.5 "Pin mode availability")
        - Responsive disable (below 1024px) handled in CSS @media query
   3. Architecture: declarative path keeps own focus trap + scroll lock
      registrations (shared services are ref-counted, safe to layer).

   PATTERN: DrawerBody and DrawerFooter render their own HTML directly.
   LipiDrawer just renders @ChildContent — same pattern as LipiCard family.
*@

@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.JSInterop
@using LiPi.Components.Overlays

@inject IFocusTrapService  _focusTrap
@inject IScrollLockService _scrollLock
@inject ILipiModalService  _modal
@inject NavigationManager  _nav
@inject IJSRuntime         _js

@* ── Backdrop ── *@
@if (Backdrop != DrawerBackdrop.None && _isOpen)
{
    <div class="lipi-overlay-backdrop @BackdropCssClass"
         style="z-index: @(_resolvedZIndex - 1)"
         @onpointerdown:stopPropagation="true"
         @onclick="OnBackdropClickAsync"
         aria-hidden="true">
    </div>
}

@* ── Drawer panel ── *@
<div @ref="_drawerRef"
     class="lipi-drawer lipi-drawer-@PlacementClass @SizeClass @AnimateClass @OpenClass @PinnedClass"
     role="@AriaRole"
     aria-modal="@(Backdrop == DrawerBackdrop.Dimmed ? "true" : (string?)null)"
     aria-labelledby="drawer-title"
     aria-busy="@(IsBusy ? "true" : (string?)null)"
     style="@StyleAttr"
     tabindex="-1"
     @onkeydown="OnKeyDownAsync">

    @* Header *@
    <div class="lipi-drawer-header">

        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="lipi-drawer-icon lipi-drawer-icon-@IconCssClass" aria-hidden="true">
                <LipiIcon Name="@Icon" Size="16" />
            </span>
        }

        <div class="lipi-drawer-header-text">
            <span id="drawer-title" class="lipi-drawer-title">@Title</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="lipi-drawer-subtitle">@Subtitle</span>
            }
        </div>

        @* Pin button (Right + Left only — spec §4.5 "Pin mode availability") *@
        @if (Pinnable && (Placement == DrawerPlacement.Right || Placement == DrawerPlacement.Left))
        {
            <button type="button"
                    class="lipi-drawer-pin @(_isPinned ? "lipi-drawer-pin-active" : string.Empty)"
                    aria-label="@(_isPinned ? "Unpin drawer" : "Pin drawer")"
                    aria-pressed="@(_isPinned ? "true" : "false")"
                    disabled="@IsBusy"
                    @onclick="TogglePinAsync">📌</button>
        }

        @if (ShowCloseButton)
        {
            <button type="button"
                    class="lipi-drawer-close"
                    aria-label="Close panel"
                    disabled="@IsBusy"
                    @onclick="RequestCloseAsync">✕</button>
        }
    </div>

    @* Body — ChildContent renders DrawerBody/DrawerFooter sub-components directly *@
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        @* Structured action params shortcut (no sub-components) *@
        <div class="lipi-drawer-body">
            @if (!string.IsNullOrEmpty(PrimaryAction) || !string.IsNullOrEmpty(SecondaryAction))
            {
                <div style="font-size:13px;color:var(--color-text-secondary)">Use DrawerBody / DrawerFooter sub-components.</div>
            }
        </div>
        @if (!string.IsNullOrEmpty(PrimaryAction) || !string.IsNullOrEmpty(SecondaryAction))
        {
            <div class="lipi-drawer-footer">
                @if (!string.IsNullOrEmpty(SecondaryAction))
                {
                    <LipiButton Variant="@SecondaryVariant"
                                OnClick="OnSecondaryAction"
                                Disabled="@IsBusy">@SecondaryAction</LipiButton>
                }
                @if (!string.IsNullOrEmpty(PrimaryAction))
                {
                    <LipiButton Variant="@PrimaryVariant"
                                OnClick="OnPrimaryAction"
                                IsBusy="@IsBusy">@PrimaryAction</LipiButton>
                }
            </div>
        }
    }

</div>


@code {
    // ==========================================================================
    // PARAMETERS — Spec §2 (16 + 7 structured action params + ChildContent)
    // ==========================================================================

    [Parameter] public DrawerPlacement  Placement            { get; set; } = DrawerPlacement.Right;
    [Parameter] public DrawerSize       Size                 { get; set; } = DrawerSize.Standard;
    [Parameter] public int?             SizePx               { get; set; }              // A32: px override
    [Parameter] public string           Title                { get; set; } = string.Empty;
    [Parameter] public string?          Subtitle             { get; set; }
    [Parameter] public string?          Icon                 { get; set; }
    [Parameter] public DrawerIconColor  IconColor            { get; set; } = DrawerIconColor.None;
    [Parameter] public DrawerBackdrop   Backdrop             { get; set; } = DrawerBackdrop.Dimmed;
    [Parameter] public bool             ShowCloseButton      { get; set; } = true;
    [Parameter] public bool             CloseOnEscape        { get; set; } = true;
    [Parameter] public bool             CloseOnBackdropClick { get; set; } = true;
    [Parameter] public bool             IsDirty              { get; set; }
    [Parameter] public bool             IsBusy               { get; set; }              // A32
    [Parameter] public bool             Animate              { get; set; } = true;      // A32
    [Parameter] public string?          AutoFocusSelector    { get; set; }              // A32 — v1.0 no-op
    [Parameter] public EventCallback    OnClose              { get; set; }
    [Parameter] public RenderFragment?  ChildContent         { get; set; }

    // Pin mode
    [Parameter] public bool             Pinnable             { get; set; }
    [Parameter] public DrawerPinScope   PinScope             { get; set; } = DrawerPinScope.PageScoped;
    [Parameter] public string?          RouteScopePrefix     { get; set; }              // A32 — required when PinScope=RouteScoped
    [Parameter] public string?          PinPersistKey        { get; set; }
    [Parameter] public bool             DefaultPinned        { get; set; }              // A32

    // Structured action params (footer shortcut — ignored when ChildContent provided)
    [Parameter] public string?          PrimaryAction        { get; set; }
    [Parameter] public ButtonVariant    PrimaryVariant       { get; set; } = ButtonVariant.Primary;
    [Parameter] public EventCallback    OnPrimaryAction      { get; set; }
    [Parameter] public string?          SecondaryAction      { get; set; }
    [Parameter] public ButtonVariant    SecondaryVariant     { get; set; } = ButtonVariant.Secondary;
    [Parameter] public EventCallback    OnSecondaryAction    { get; set; }


    // ==========================================================================
    // INTERNAL STATE
    // ==========================================================================

    private ElementReference _drawerRef;
    private bool             _isOpen;
    private bool             _isPinned;
    private bool             _closedCleanly;
    private bool             _locationSubscribed;
    private int              _resolvedZIndex = 700;


    // ==========================================================================
    // LIFECYCLE
    // ==========================================================================

    protected override void OnInitialized()
    {
        // Optimistic initial pin state — JS will overwrite on first render if
        // localStorage has a stored value. This avoids a flash for the common
        // case where DefaultPinned matches the user's last choice.
        _isPinned = DefaultPinned;

        // Subscribe to navigation for scope-based auto-close (A32).
        // Global scope never auto-closes; PageScoped + RouteScoped do.
        if (PinScope is DrawerPinScope.PageScoped or DrawerPinScope.RouteScoped)
        {
            _nav.LocationChanged += OnLocationChanged;
            _locationSubscribed = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // A32: read localStorage to restore pin state from prior session.
        if (Pinnable && !string.IsNullOrEmpty(PinPersistKey))
        {
            try
            {
                var stored = await _js.InvokeAsync<string?>(
                    "localStorage.getItem",
                    $"lipi-drawer-pin:{PinPersistKey}");

                if (!string.IsNullOrEmpty(stored))
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(stored);
                    if (doc.RootElement.TryGetProperty("pinned", out var p) &&
                        (p.ValueKind == System.Text.Json.JsonValueKind.True ||
                         p.ValueKind == System.Text.Json.JsonValueKind.False))
                    {
                        var restored = p.GetBoolean();
                        if (restored != _isPinned)
                        {
                            _isPinned = restored;
                            StateHasChanged();
                        }
                    }
                }
                // else: keep DefaultPinned value set in OnInitialized.
            }
            catch { /* localStorage unavailable / parse error — keep default */ }
        }

        // Slide-in animation: flip _isOpen after first render so the CSS
        // transition (translate(0) via .open class) fires from the off-screen
        // starting transform.
        _isOpen = true;
        StateHasChanged();

        if (Backdrop != DrawerBackdrop.None)
        {
            await _focusTrap.ActivateAsync(_drawerRef);
            await _scrollLock.LockAsync();
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_locationSubscribed)
        {
            _nav.LocationChanged -= OnLocationChanged;
            _locationSubscribed = false;
        }

        if (_closedCleanly) return; // RequestCloseAsync already cleared everything

        // Component disposed without RequestCloseAsync (page navigated away etc.)
        if (Backdrop != DrawerBackdrop.None)
        {
            try { await _focusTrap.DeactivateAsync(); } catch { /* circuit closing */ }
            try { await _scrollLock.UnlockAsync(); }   catch { /* circuit closing */ }
        }
    }

    // ── A32: NavigationManager-driven auto-close per PinScope ────────────────

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_closedCleanly) return; // already closed
        if (PinScope == DrawerPinScope.Global) return; // never auto-close

        bool shouldClose = false;

        if (PinScope == DrawerPinScope.PageScoped)
        {
            // Closes on ANY navigation
            shouldClose = true;
        }
        else if (PinScope == DrawerPinScope.RouteScoped &&
                 !string.IsNullOrEmpty(RouteScopePrefix))
        {
            // Closes when new URL leaves the scope prefix
            var rel    = "/" + _nav.ToBaseRelativePath(e.Location).Split('?')[0]
                                  .TrimEnd('/').ToLowerInvariant();
            var prefix = RouteScopePrefix.TrimEnd('/').ToLowerInvariant();
            shouldClose = !(rel == prefix || rel.StartsWith(prefix + "/"));
        }

        if (shouldClose)
        {
            _ = InvokeAsync(RequestCloseAsync);
        }
    }


    // ==========================================================================
    // CLOSE FLOW
    // ==========================================================================

    private async Task RequestCloseAsync()
    {
        if (IsBusy) return; // A32: IsBusy disables all controls

        if (IsDirty)
        {
            var discard = await _modal.ConfirmAsync(
                title:        "Discard changes?",
                message:      "You have unsaved changes. Closing will lose them.",
                intent:       ConfirmIntent.Warning,
                primaryLabel: "Discard",
                cancelLabel:  "Keep open");
            if (!discard) return;
        }

        if (Backdrop != DrawerBackdrop.None)
        {
            await _focusTrap.DeactivateAsync();
            await _scrollLock.UnlockAsync();
        }

        _closedCleanly = true;
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClickAsync()
    {
        if (CloseOnBackdropClick) await RequestCloseAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && CloseOnEscape)
            await RequestCloseAsync();
    }


    // ==========================================================================
    // PIN MODE
    // ==========================================================================

    private async Task TogglePinAsync()
    {
        if (IsBusy) return;

        _isPinned = !_isPinned;

        if (!string.IsNullOrEmpty(PinPersistKey))
        {
            try
            {
                await _js.InvokeVoidAsync(
                    "localStorage.setItem",
                    $"lipi-drawer-pin:{PinPersistKey}",
                    System.Text.Json.JsonSerializer.Serialize(new { pinned = _isPinned }));
            }
            catch { /* localStorage unavailable — pin state is ephemeral this session */ }
        }
        StateHasChanged();
    }


    // ==========================================================================
    // CSS CLASS COMPOSITION
    // ==========================================================================

    private string PlacementClass => Placement.ToString().ToLowerInvariant();

    private string SizeClass => Size switch
    {
        DrawerSize.Compact  => "lipi-drawer-compact",
        DrawerSize.Wide     => "lipi-drawer-wide",
        DrawerSize.FullSide => "lipi-drawer-fullside",
        _                   => "lipi-drawer-standard"
    };

    private string BackdropCssClass => Backdrop switch
    {
        DrawerBackdrop.Light => "lipi-drawer-backdrop-light",
        _                    => "lipi-drawer-backdrop-dimmed"
    };

    private string AriaRole => Backdrop == DrawerBackdrop.Dimmed ? "dialog" : "complementary";

    private string IconCssClass => IconColor switch
    {
        DrawerIconColor.Info     => "info",
        DrawerIconColor.Success  => "success",
        DrawerIconColor.Warning  => "warning",
        DrawerIconColor.Danger   => "danger",
        DrawerIconColor.Critical => "critical",
        _                        => string.Empty
    };

    private string AnimateClass => Animate ? string.Empty : "lipi-drawer-no-animate";

    private string OpenClass => _isOpen ? "open" : string.Empty;

    private string PinnedClass => (_isPinned && (Placement == DrawerPlacement.Right || Placement == DrawerPlacement.Left))
        ? "lipi-drawer-pinned"
        : string.Empty;

    // A32: SizePx inline style override. For Right/Left drawers SizePx sets
    // width; for Top/Bottom it sets height. Wins over the Size enum class.
    private string StyleAttr
    {
        get
        {
            var parts = new List<string> { $"z-index: {_resolvedZIndex}" };
            if (SizePx.HasValue && SizePx.Value > 0)
            {
                var dim = (Placement == DrawerPlacement.Top || Placement == DrawerPlacement.Bottom)
                    ? "height"
                    : "width";
                parts.Add($"{dim}: {SizePx.Value}px");
            }
            return string.Join("; ", parts);
        }
    }
}
