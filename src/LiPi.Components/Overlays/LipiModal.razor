@* SPEC:  docs/01-LipiModal-Spec.md
   PHASE: 2.6.2 — Overlay Surfaces
   AMEND: docs/CHANGE-LOG.md A31 — declarative LipiModal component build.

   ARCHITECTURE
   ─────────────
   Self-rendering declarative modal. Renders its own backdrop + box. ModalBody
   and ModalFooter sub-components emit their own HTML directly. LipiModal just
   renders @ChildContent — same pattern as LipiCard/CardBody/CardFooter and
   LipiDrawer/DrawerBody/DrawerFooter.

   Service-driven modals (Modal.ShowAsync / ConfirmAsync / AlertAsync /
   PromptAsync) render via LipiOverlayHost.razor — that path is separate
   and uses its own stack management. This declarative path participates in
   shared focus trap + scroll lock infrastructure but NOT in the service stack
   cap.

   v1.0 SPEC DIVERGENCES (see CHANGE-LOG A31)
   ──────────────────────────────────────────
   1. Intent auto-defaults (spec §10) NOT cascaded for Size / FooterAlign etc.
      Reason: project rule rejects nullable enum params (LipiButton precedent).
      Without nullability we can't distinguish consumer-explicit from declared-
      default. Only "forced" Intent overrides apply:
        - Critical → Animation=None (§8, "regardless of param value")
        - Progress → ShowCloseButton=false, CloseOnEscape=false,
                     CloseOnBackdrop=false, Animate=false
      Wait — ModalIntent enum does NOT contain Critical. The §2 row notes
      "Auto-false for Critical/Progress" refer to ConfirmIntent.Critical /
      AlertIntent.Critical (dialog-level intents handled by LipiModalService
      already). For declarative LipiModal, only Progress force-overrides apply.

   2. ChildContent + structured action params (PrimaryAction/SecondaryAction):
      ChildContent wins. No dev warning (spec §2 says "warning logged" but
      detecting ModalFooter without CascadingValue plumbing is fragile;
      matches LipiDrawer's same divergence).

   3. Declarative LipiModal does NOT register with ILipiModalService stack.
      Stack-depth cap (max 3 per spec §6) applies only to service-driven
      modals. Two simultaneous declarative modals is consumer's responsibility.

   4. Z-index defaults to 800 (same as first service modal). Simultaneous
      declarative + service use overlaps backdrops visually (same color, no
      harm). Document as v1.0 limitation.

   USAGE
   ─────
   @if (_editOpen) {
       <LipiModal Title="Edit holiday"
                  Icon="calendar"
                  IconColor="ModalIconColor.Info"
                  IsDirty="@_hasChanges"
                  OnClose="@CloseEdit">
           <LipiModalBody>... form fields ...</LipiModalBody>
           <LipiModalFooter>
               <LipiButton Variant="ButtonVariant.Secondary" OnClick="@CloseEdit">Cancel</LipiButton>
               <LipiButton OnClick="@SaveAsync" IsLoading="@_saving">Save</LipiButton>
           </LipiModalFooter>
       </LipiModal>
   }
*@

@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using LiPi.Components.Overlays

@inject IFocusTrapService  _focusTrap
@inject IScrollLockService _scrollLock
@inject ILipiModalService  _modalSvc

@* ── Backdrop ── *@
<div class="lipi-overlay-backdrop"
     style="z-index: @(_resolvedZIndex - 1)"
     @onpointerdown:stopPropagation="true"
     @onclick="OnBackdropClickAsync"
     aria-hidden="true">
</div>

@* ── Modal box ── *@
<div @ref="_modalRef"
     class="lipi-modal @SizeClass @AnimClass"
     role="dialog"
     aria-modal="true"
     aria-labelledby="@_titleId"
     aria-busy="@(IsBusy ? "true" : (string?)null)"
     style="@StyleAttr"
     tabindex="-1"
     @onkeydown="OnKeyDownAsync">

    @* Header *@
    <div class="lipi-modal-header">

        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="lipi-modal-icon lipi-modal-icon-@IconCssClass" aria-hidden="true">
                <LipiIcon Name="@Icon" Size="16" />
            </span>
        }

        <div class="lipi-modal-header-text">
            <span id="@_titleId" class="lipi-modal-title">@Title</span>
            @if (!string.IsNullOrEmpty(Subtitle))
            {
                <span class="lipi-modal-subtitle">@Subtitle</span>
            }
        </div>

        @if (EffectiveShowCloseButton)
        {
            <button type="button"
                    class="lipi-modal-close"
                    aria-label="Close dialog"
                    disabled="@IsBusy"
                    @onclick="RequestCloseAsync">✕</button>
        }
    </div>

    @* Body — ChildContent renders ModalBody / ModalFooter sub-components directly *@
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else if (!string.IsNullOrEmpty(PrimaryAction) || !string.IsNullOrEmpty(SecondaryAction))
    {
        @* Structured action shortcut path — no ChildContent + actions provided *@
        <div class="lipi-modal-body">
            <div style="font-size:13px;color:var(--color-text-secondary)">
                Use ModalBody / ModalFooter sub-components for full control.
            </div>
        </div>
        <div class="lipi-modal-footer @FooterAlignClass">
            @if (!string.IsNullOrEmpty(SecondaryAction))
            {
                <LipiButton Variant="@SecondaryVariant"
                            OnClick="OnSecondaryAction"
                            Disabled="@IsBusy">@SecondaryAction</LipiButton>
            }
            @if (!string.IsNullOrEmpty(PrimaryAction))
            {
                <LipiButton Variant="@PrimaryVariant"
                            OnClick="OnPrimaryAction"
                            IsLoading="@IsBusy">@PrimaryAction</LipiButton>
            }
        </div>
    }
    else
    {
        @* No content at all — render empty body for spec layout integrity *@
        <div class="lipi-modal-body"></div>
    }

</div>


@code {
    // ==========================================================================
    // PARAMETERS — Spec §2
    // ==========================================================================

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string?           Subtitle           { get; set; }
    [Parameter] public string?           Icon               { get; set; }
    [Parameter] public ModalIconColor    IconColor          { get; set; } = ModalIconColor.None;
    [Parameter] public ModalSize         Size               { get; set; } = ModalSize.Standard;
    [Parameter] public int?              MaxWidth           { get; set; }
    [Parameter] public ModalIntent       Intent             { get; set; } = ModalIntent.Default;
    [Parameter] public bool              ShowCloseButton    { get; set; } = true;
    [Parameter] public bool              CloseOnEscape      { get; set; } = true;
    [Parameter] public bool              CloseOnBackdrop    { get; set; } = true;
    [Parameter] public bool              IsDirty            { get; set; }
    [Parameter] public bool              IsBusy             { get; set; }
    [Parameter] public bool              Animate            { get; set; } = true;
    [Parameter] public ModalAnimation    Animation          { get; set; } = ModalAnimation.FadeSlide;
    [Parameter] public EventCallback     OnClose            { get; set; }
    [Parameter] public string?           AutoFocusSelector  { get; set; }
    [Parameter] public RenderFragment?   ChildContent       { get; set; }

    // Structured action params (footer shortcut — ignored when ChildContent provided)
    [Parameter] public string?           PrimaryAction      { get; set; }
    [Parameter] public ButtonVariant     PrimaryVariant     { get; set; } = ButtonVariant.Primary;
    [Parameter] public EventCallback     OnPrimaryAction    { get; set; }
    [Parameter] public string?           SecondaryAction    { get; set; }
    [Parameter] public ButtonVariant     SecondaryVariant   { get; set; } = ButtonVariant.Secondary;
    [Parameter] public EventCallback     OnSecondaryAction  { get; set; }
    [Parameter] public ModalFooterAlign  FooterAlign        { get; set; } = ModalFooterAlign.End;


    // ==========================================================================
    // INTERNAL STATE
    // ==========================================================================

    private ElementReference _modalRef;
    private string           _titleId        = $"lipi-modal-title-{Guid.NewGuid():N}";
    private int              _resolvedZIndex = 800;
    private bool             _closedCleanly;


    // ==========================================================================
    // EFFECTIVE VALUES — Intent forced overrides (spec §8 + Progress rules)
    // Auto-defaults for Confirmation/Alert/Wizard/Preview NOT applied — see header.
    // ==========================================================================

    private bool EffectiveShowCloseButton =>
        Intent == ModalIntent.Progress ? false : ShowCloseButton;

    private bool EffectiveCloseOnEscape =>
        Intent == ModalIntent.Progress ? false : CloseOnEscape;

    private bool EffectiveCloseOnBackdrop =>
        Intent == ModalIntent.Progress ? false : CloseOnBackdrop;

    private bool EffectiveAnimate =>
        Intent == ModalIntent.Progress ? false : Animate;

    private ModalAnimation EffectiveAnimation =>
        !EffectiveAnimate
            ? ModalAnimation.None
            : Animation;


    // ==========================================================================
    // LIFECYCLE
    // ==========================================================================

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Focus trap + scroll lock — shared infrastructure, reference-counted.
        // If a service modal is already open, our calls layer cleanly on top.
        await _focusTrap.ActivateAsync(_modalRef);
        await _scrollLock.LockAsync();

        // AutoFocusSelector: defer to JS to query within the modal subtree.
        // (Not implemented in v1.0 — focus trap activates with first focusable
        // element. Future: add lipiOverlay.focusWithin(container, selector) JS
        // helper and call it here.)
    }

    public async ValueTask DisposeAsync()
    {
        if (_closedCleanly) return;
        // Component disposed without explicit close (parent unmounted / page
        // navigated away). Clean up shared infrastructure registrations.
        try { await _focusTrap.DeactivateAsync(); } catch { /* circuit closing */ }
        try { await _scrollLock.UnlockAsync(); }   catch { /* circuit closing */ }
    }


    // ==========================================================================
    // CLOSE FLOW
    // ==========================================================================

    private async Task RequestCloseAsync()
    {
        if (IsBusy) return; // Spec §2: IsBusy disables all controls

        if (IsDirty)
        {
            var discard = await _modalSvc.ConfirmAsync(
                title:        "Discard changes?",
                message:      "You have unsaved changes. Closing this will lose them.",
                intent:       ConfirmIntent.Warning,
                primaryLabel: "Discard",
                cancelLabel:  "Keep open");
            if (!discard) return;
        }

        await _focusTrap.DeactivateAsync();
        await _scrollLock.UnlockAsync();
        _closedCleanly = true;
        await OnClose.InvokeAsync();
    }

    private async Task OnBackdropClickAsync()
    {
        if (EffectiveCloseOnBackdrop) await RequestCloseAsync();
    }

    private async Task OnKeyDownAsync(KeyboardEventArgs e)
    {
        if (e.Key == "Escape" && EffectiveCloseOnEscape)
            await RequestCloseAsync();
    }


    // ==========================================================================
    // CSS CLASS COMPOSITION
    // ==========================================================================

    private string SizeClass => Size switch
    {
        ModalSize.Compact    => "lipi-modal-compact",
        ModalSize.Wide       => "lipi-modal-wide",
        ModalSize.Fullscreen => "lipi-modal-fullscreen",
        _                    => "lipi-modal-standard"
    };

    private string AnimClass => EffectiveAnimation switch
    {
        ModalAnimation.Fade      => "lipi-modal-anim-fade",
        ModalAnimation.FadeSlide => "lipi-modal-anim-fadeslide",
        ModalAnimation.FadeScale => "lipi-modal-anim-fadescale",
        _                        => string.Empty // None — no animation class
    };

    private string IconCssClass => IconColor switch
    {
        ModalIconColor.Info     => "info",
        ModalIconColor.Success  => "success",
        ModalIconColor.Warning  => "warning",
        ModalIconColor.Danger   => "danger",
        ModalIconColor.Critical => "critical",
        _                       => string.Empty
    };

    private string FooterAlignClass => FooterAlign switch
    {
        ModalFooterAlign.Start        => "lipi-modal-footer-start",
        ModalFooterAlign.SpaceBetween => "lipi-modal-footer-space-between",
        _                             => string.Empty // End is the default in lipi-overlays.css
    };

    private string StyleAttr
    {
        get
        {
            var parts = new List<string> { $"z-index: {_resolvedZIndex}" };
            if (MaxWidth.HasValue && MaxWidth.Value > 0)
                parts.Add($"width: {MaxWidth.Value}px; max-width: 96vw");
            return string.Join("; ", parts);
        }
    }
}
