@namespace LiPi.Web.Components.Theme
@implements IAsyncDisposable

@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims
@using LiPi.Web.Services

@inject IThemeContextService        ThemeSvc
@inject IJSRuntime                  JS
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<ThemeProvider>      Logger

<CascadingValue Value="@_currentTheme" Name="CurrentTheme" IsFixed="false">
    <CascadingValue Value="@this" Name="ThemeProvider" IsFixed="true">
        @ChildContent
    </CascadingValue>
</CascadingValue>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ThemeContext _currentTheme = ThemeContext.Default;
    private bool _jsReady  = false;
    private bool _disposed = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var mode  = await ThemeSvc.GetModeAsync();
            var brand = await ThemeSvc.GetBrandAsync();
            _currentTheme = new ThemeContext { Brand = brand, Mode = mode };
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex,
                "ThemeProvider.OnInitializedAsync: failed to resolve theme — using defaults");
            _currentTheme = ThemeContext.Default;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // theme-switcher.js (D6) already applied cookie value before first paint.
        // This call confirms/corrects with the DB-authoritative value.
        if (!firstRender || _disposed) return;

        _jsReady = true;
        await ApplyThemeToBodyAsync(_currentTheme.Brand, _currentTheme.Mode);
    }

    public async Task SwitchModeAsync(string newMode)
    {
        if (_disposed || string.IsNullOrWhiteSpace(newMode)) return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            await ThemeSvc.SetModeAsync(newMode, authState.User);
            _currentTheme = _currentTheme with { Mode = newMode };
            if (_jsReady) await ApplyThemeToBodyAsync(_currentTheme.Brand, _currentTheme.Mode);
            StateHasChanged();
        }
        catch (ArgumentException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "ThemeProvider.SwitchModeAsync: unexpected failure for mode='{Mode}'", newMode);
        }
    }

    public async Task SwitchBrandAsync(string newBrand)
    {
        if (_disposed || string.IsNullOrWhiteSpace(newBrand)) return;

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var actor     = authState.User;

            if (!ClaimsHelper.IsSiteAdmin(actor))
            {
                Logger.LogWarning(
                    "ThemeProvider.SwitchBrandAsync: denied for user '{User}' — SiteAdmin+ required",
                    ClaimsHelper.Username(actor));
                throw new UnauthorizedAccessException(
                    "Only SiteAdmin or higher can change brand themes.");
            }

            await ThemeSvc.SetBrandAsync(newBrand, actor);
            _currentTheme = _currentTheme with { Brand = newBrand };
            if (_jsReady) await ApplyThemeToBodyAsync(_currentTheme.Brand, _currentTheme.Mode);
            StateHasChanged();
        }
        catch (ArgumentException)        { throw; }
        catch (UnauthorizedAccessException) { throw; }
        catch (Exception ex)
        {
            Logger.LogError(ex,
                "ThemeProvider.SwitchBrandAsync: unexpected failure for brand='{Brand}'", newBrand);
        }
    }

    private async Task ApplyThemeToBodyAsync(string brand, string mode)
    {
        // Calls window.lipiTheme.apply(brand, mode) from theme-switcher.js (D6).
        // Blazor resolves "lipiTheme.apply" as window.lipiTheme.apply.
        // Targets document.documentElement — consistent with theme-switcher.js behavior.
        try
        {
            await JS.InvokeVoidAsync("lipiTheme.apply", brand, mode);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex,
                "ThemeProvider.ApplyThemeToBodyAsync: JS interop failed (brand={Brand}, mode={Mode})",
                brand, mode);
        }
        catch (TaskCanceledException) { /* circuit disconnected — next load re-applies from cookie */ }
    }

    public async ValueTask DisposeAsync()
    {
        if (_disposed) return;
        _disposed = true;
        await ValueTask.CompletedTask;
    }
}
