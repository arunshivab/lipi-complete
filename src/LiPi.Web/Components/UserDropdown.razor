@namespace LiPi.Web.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using System.Security.Claims

@rendermode InteractiveServer
@inject NavigationManager Nav
@implements IDisposable

<div class="udd-trigger @(open ? "udd-open" : "")" @onclick="Toggle">

    @* Backdrop — closes on outside click *@
    @if (open)
    {
        <div class="udd-backdrop" @onclick:stopPropagation @onclick="Close"></div>
    }

    @* Trigger: initials + name + role badge *@
    <div class="udd-av av-@AvatarCss">@Initials</div>
    <div class="udd-trigger-text">
        <span class="udd-trigger-name">@(string.IsNullOrEmpty(DisplayName) ? Username : DisplayName)</span>
        <span class="tn-role-badge tn-role-@RoleBadgeClass">@RoleDisplay</span>
    </div>
    <span class="udd-chevron">@(open ? "▴" : "▾")</span>

    @* Card — position fixed so it escapes all parent overflow *@
    @if (open)
    {
        <div class="udd-card" @onclick:stopPropagation>
            <div class="udd-head">
                <div class="udd-head-av av-@AvatarCss">@Initials</div>
                <div>
                    <div class="udd-head-name">@(string.IsNullOrEmpty(DisplayName) ? Username : DisplayName)</div>
                    @if (!string.IsNullOrEmpty(DisplayName) && DisplayName != Username)
                    { <div class="udd-head-user">@Username</div> }
                    <div class="udd-head-role">@RoleDisplay.ToUpperInvariant()</div>
                    <div class="udd-head-clinic">@ClinicName</div>
                </div>
            </div>

            <div class="udd-sep"></div>

            <button class="udd-item" @onclick="GoProfile">
                <span class="udd-ico" style="background:#DBEAFE">👤</span>
                <span>
                    <span class="udd-ilabel">Edit My Profile</span>
                    <span class="udd-ihint">@(IsAdmin ? "Full edit — all fields" : "Email + phone only")</span>
                </span>
            </button>
            <button class="udd-item" @onclick="GoPassword">
                <span class="udd-ico" style="background:#EDE7F6">🔑</span>
                <span>
                    <span class="udd-ilabel">Change Password</span>
                    <span class="udd-ihint">Current password required</span>
                </span>
            </button>
            <button class="udd-item" @onclick="GoPrefs">
                <span class="udd-ico" style="background:#DCFCE7">🎨</span>
                <span>
                    <span class="udd-ilabel">Preferences</span>
                    <span class="udd-ihint">Theme, language</span>
                </span>
            </button>

            <div class="udd-sep"></div>

            <form method="post" action="/logout" style="margin:0">
                <button type="submit" class="udd-item udd-signout">
                    <span class="udd-ico" style="background:#FEE2E2">↪</span>
                    <span class="udd-ilabel" style="color:#DC2626">Sign Out</span>
                </button>
            </form>
        </div>
    }
</div>

@code {
    [Parameter] public string  Username       { get; set; } = string.Empty;
    [Parameter] public string? DisplayName    { get; set; }
    [Parameter] public string  StaffType      { get; set; } = string.Empty;
    [Parameter] public string  ClinicName     { get; set; } = string.Empty;
    [Parameter] public string  RoleDisplay    { get; set; } = string.Empty;
    [Parameter] public string  RoleBadgeClass { get; set; } = "staff";
    [Parameter] public bool    IsAdmin        { get; set; }
    [Parameter] public string  OwnUserId      { get; set; } = string.Empty;

    private bool open;

    protected override void OnInitialized()
        => Nav.LocationChanged += OnNav;

    public void Dispose()
        => Nav.LocationChanged -= OnNav;

    private void OnNav(object? _, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs __)
    { open = false; InvokeAsync(StateHasChanged); }

    private void Toggle() => open = !open;
    private void Close()  => open = false;

    private void GoProfile()  => Go(IsAdmin && !string.IsNullOrEmpty(OwnUserId)
                                    ? $"/admin/users/{OwnUserId}/edit" : "/profile");
    private void GoPassword() => Go("/profile?tab=password");
    private void GoPrefs()    => Go("/profile?tab=prefs");
    private void Go(string url) { open = false; Nav.NavigateTo(url); }

    private string Initials
    {
        get {
            var name = string.IsNullOrEmpty(DisplayName) ? Username : DisplayName;
            var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
            return parts.Length >= 2
                ? $"{parts[0][0]}{parts[^1][0]}".ToUpperInvariant()
                : name.Length >= 1 ? name[..1].ToUpperInvariant() : "?";
        }
    }

    private string AvatarCss => RoleBadgeClass switch
    {
        "global-admin" or "sys-admin" or "site-admin" => "admin",
        _ => StaffType switch
        {
            "doctor" or "radiation_oncologist" or "medical_oncologist" or
            "radiologist" or "surgeon"                                => "doctor",
            "nurse"                                                   => "nurse",
            "medical_physicist" or "dosimetrist" or "nuclear_med"    => "physicist",
            "lab_tech" or "radiographer" or "radiation_therapist"    => "tech",
            "pharmacist" or "support"                                => "support",
            _                                                         => "other",
        }
    };
}
