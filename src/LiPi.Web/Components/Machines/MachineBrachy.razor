@namespace LiPi.Web.Components.Machines

<!-- Brachytherapy Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <rect width="800" height="500" fill="transparent"/>

    <!-- Brachytherapy Machine -->
    <g id="brachy-machine">
        <!-- Applicator Head -->
        <circle cx="400" cy="140" r="50" fill="rgba(255,255,255,0.1)" stroke="rgba(245,158,11,0.6)" stroke-width="4"/>
        <circle cx="400" cy="140" r="40" fill="rgba(245,158,11,0.15)" stroke="none"/>

        <!-- Radiation Source (animated pulse) -->
        <circle cx="400" cy="140" r="15" fill="rgba(245,158,11,0.4)" style="animation: pulse-glow 1.5s ease-in-out infinite;"/>
        <circle cx="400" cy="140" r="8" fill="rgba(245,158,11,0.9)"/>

        <!-- Catheter Visualization (animated) -->
        <g style="animation: drift-beam 3s ease-in-out infinite;">
            <path d="M 400 155 Q 410 200 415 280" fill="none" stroke="rgba(245,158,11,0.5)" stroke-width="3" stroke-linecap="round"/>
            <circle cx="415" cy="280" r="6" fill="rgba(245,158,11,0.7)"/>
        </g>

        <!-- Dwell Positions (animated) -->
        <g style="animation: pulse-glow 1s ease-in-out infinite 0.2s;">
            <circle cx="407" cy="190" r="4" fill="rgba(245,158,11,0.8)"/>
        </g>
        <g style="animation: pulse-glow 1s ease-in-out infinite 0.4s;">
            <circle cx="412" cy="230" r="4" fill="rgba(245,158,11,0.8)"/>
        </g>
        <g style="animation: pulse-glow 1s ease-in-out infinite 0.6s;">
            <circle cx="415" cy="270" r="4" fill="rgba(245,158,11,0.8)"/>
        </g>

        <!-- Source Travel Rail (rotating) -->
        <g style="animation: rotate-gantry 5s linear infinite; transform-origin: 400px 140px;">
            <line x1="400" y1="140" x2="550" y2="140" stroke="rgba(245,158,11,0.3)" stroke-width="2" stroke-dasharray="5,5"/>
            <circle cx="550" cy="140" r="8" fill="rgba(245,158,11,0.6)"/>
        </g>

        <!-- Treatment Planning Display -->
        <rect x="100" y="120" width="140" height="200" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- Dose Distribution Display -->
        <rect x="110" y="140" width="120" height="100" fill="rgba(245,158,11,0.12)" stroke="rgba(245,158,11,0.3)" stroke-width="1" rx="3"/>
        <circle cx="170" cy="190" r="30" fill="rgba(245,158,11,0.2)"/>
        <circle cx="170" cy="190" r="20" fill="rgba(245,158,11,0.3)"/>
        <circle cx="170" cy="190" r="10" fill="rgba(245,158,11,0.5)"/>

        <!-- Treatment Time Display -->
        <rect x="110" y="260" width="120" height="35" fill="rgba(245,158,11,0.1)" stroke="rgba(245,158,11,0.3)" stroke-width="1" rx="2"/>
        <text x="170" y="285" font-family="DM Mono" font-size="13" fill="rgba(245,158,11,0.8)" text-anchor="middle">420 sec</text>

        <!-- Control Console (Right Side) -->
        <rect x="560" y="120" width="130" height="200" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- Source Activity Display -->
        <rect x="575" y="145" width="100" height="40" fill="rgba(245,158,11,0.15)" stroke="rgba(245,158,11,0.4)" stroke-width="1" rx="2"/>
        <text x="625" y="167" font-family="DM Mono" font-size="11" fill="rgba(245,158,11,0.8)" text-anchor="middle">Ir-192 Source</text>
        <text x="625" y="182" font-family="DM Mono" font-size="10" fill="rgba(245,158,11,0.6)" text-anchor="middle">2.8 Bq</text>

        <!-- Fractionation Counter -->
        <rect x="575" y="200" width="100" height="30" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.1)" stroke-width="1" rx="2"/>
        <text x="625" y="222" font-family="DM Mono" font-size="12" fill="rgba(255,255,255,0.7)" text-anchor="middle">3/5 Sessions</text>

        <!-- Status Indicators -->
        <circle cx="595" cy="260" r="4" fill="rgba(16,185,129,0.9)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <circle cx="625" cy="260" r="4" fill="rgba(56,189,248,0.9)" style="animation: blink-led 1.1s ease-in-out infinite;"/>
        <circle cx="655" cy="260" r="4" fill="rgba(245,158,11,0.9)" style="animation: blink-led 0.9s ease-in-out infinite;"/>

        <!-- Info Text -->
        <text x="400" y="450" font-family="DM Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Internal Radiation Therapy</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
