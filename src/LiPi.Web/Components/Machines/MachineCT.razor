@namespace LiPi.Web.Components.Machines

<!-- CT Scanner Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <!-- Background -->
    <rect width="800" height="500" fill="transparent"/>

    <!-- CT Machine Illustration -->
    <g id="ct-machine">
        <!-- Base/Stand -->
        <rect x="250" y="350" width="300" height="80" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="2" rx="10"/>

        <!-- Main Gantry Ring -->
        <circle cx="400" cy="220" r="120" fill="none" stroke="rgba(74,155,212,0.6)" stroke-width="8"/>
        <circle cx="400" cy="220" r="115" fill="none" stroke="rgba(74,155,212,0.3)" stroke-width="1"/>

        <!-- Rotating Gantry Interior -->
        <g id="gantry-rotation" style="animation: rotate-gantry 4s linear infinite; transform-origin: 400px 220px;">
            <line x1="340" y1="220" x2="460" y2="220" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>
            <circle cx="400" cy="220" r="30" fill="rgba(74,155,212,0.4)" stroke="none"/>
            <circle cx="400" cy="220" r="25" fill="none" stroke="rgba(74,155,212,0.8)" stroke-width="1" style="animation: pulse-glow 2s ease-in-out infinite;"/>
        </g>

        <!-- Patient Table -->
        <rect x="320" y="200" width="160" height="40" fill="rgba(255,255,255,0.15)" stroke="rgba(255,255,255,0.3)" stroke-width="2" rx="4"
              style="animation: slide-table 3s ease-in-out infinite;"/>

        <!-- Control Panel -->
        <rect x="100" y="100" width="120" height="150" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- LED Indicators on Control Panel -->
        <circle cx="130" cy="130" r="4" fill="rgba(16,185,129,0.8)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <circle cx="160" cy="130" r="4" fill="rgba(239,68,68,0.8)" style="animation: blink-led 0.8s ease-in-out infinite;"/>
        <circle cx="130" cy="160" r="4" fill="rgba(245,158,11,0.8)" style="animation: blink-led 1.2s ease-in-out infinite;"/>
        <circle cx="160" cy="160" r="4" fill="rgba(56,189,248,0.8)" style="animation: blink-led 0.9s ease-in-out infinite;"/>

        <!-- Display Screen -->
        <rect x="110" y="200" width="100" height="40" fill="rgba(74,155,212,0.2)" stroke="rgba(74,155,212,0.6)" stroke-width="2" rx="3"/>
        <text x="160" y="227" font-family="DM Mono" font-size="14" fill="rgba(255,255,255,0.7)" text-anchor="middle">250 mA</text>

        <!-- Info Text -->
        <text x="400" y="450" font-family="DM Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Spiral CT Imaging</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
