@namespace LiPi.Web.Components.Machines

<!-- MRI Scanner Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <rect width="800" height="500" fill="transparent"/>

    <!-- MRI Machine -->
    <g id="mri-machine">
        <!-- Cylindrical Scanner Tube -->
        <ellipse cx="400" cy="180" rx="100" ry="80" fill="rgba(255,255,255,0.1)" stroke="rgba(74,155,212,0.6)" stroke-width="8"/>
        <rect x="300" y="240" width="200" height="100" fill="rgba(255,255,255,0.08)" stroke="rgba(74,155,212,0.4)" stroke-width="2" rx="8"/>

        <!-- Magnetic Field Ring (Animated) -->
        <circle cx="400" cy="180" r="110" fill="none" stroke="rgba(56,189,248,0.3)" stroke-width="2" style="animation: pulse-glow 3s ease-in-out infinite;"/>
        <circle cx="400" cy="180" r="125" fill="none" stroke="rgba(74,155,212,0.15)" stroke-width="1"/>

        <!-- Patient Sliding Table -->
        <rect x="320" y="190" width="160" height="35" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="2" rx="3"
              style="animation: slide-table 4s ease-in-out infinite;"/>

        <!-- Coil Array Visualization -->
        <g style="animation: drift-beam 3s ease-in-out infinite;">
            <line x1="280" y1="160" x2="520" y2="160" stroke="rgba(74,155,212,0.4)" stroke-width="2" opacity="0.6"/>
            <line x1="280" y1="200" x2="520" y2="200" stroke="rgba(74,155,212,0.4)" stroke-width="2" opacity="0.6"/>
        </g>

        <!-- Control Console -->
        <rect x="100" y="120" width="140" height="180" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- Status Lights -->
        <circle cx="130" cy="150" r="5" fill="rgba(16,185,129,0.9)" style="animation: pulse-glow 1.5s ease-in-out infinite;"/>
        <text x="170" y="155" font-family="LiPi Mono" font-size="11" fill="rgba(255,255,255,0.6)">1.5T Field</text>

        <circle cx="130" cy="190" r="5" fill="rgba(56,189,248,0.9)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <text x="170" y="195" font-family="LiPi Mono" font-size="11" fill="rgba(255,255,255,0.6)">Active Scan</text>

        <circle cx="130" cy="230" r="5" fill="rgba(245,158,11,0.9)" style="animation: blink-led 1.3s ease-in-out infinite;"/>
        <text x="170" y="235" font-family="LiPi Mono" font-size="11" fill="rgba(255,255,255,0.6)">RF Ready</text>

        <!-- Display -->
        <rect x="110" y="260" width="120" height="30" fill="rgba(74,155,212,0.15)" stroke="rgba(74,155,212,0.5)" stroke-width="1" rx="2"/>
        <text x="170" y="280" font-family="LiPi Mono" font-size="13" fill="rgba(74,155,212,0.9)" text-anchor="middle">◆ ◆ ◆</text>

        <!-- Info Text -->
        <text x="400" y="450" font-family="LiPi Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Magnetic Resonance Imaging</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
