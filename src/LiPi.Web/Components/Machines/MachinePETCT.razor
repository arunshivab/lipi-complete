@namespace LiPi.Web.Components.Machines

<!-- PET-CT Scanner Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <rect width="800" height="500" fill="transparent"/>

    <!-- PET-CT Machine -->
    <g id="petct-machine">
        <!-- Gantry Ring (PET Ring) -->
        <circle cx="400" cy="190" r="100" fill="none" stroke="rgba(56,189,248,0.5)" stroke-width="8"/>
        <circle cx="400" cy="190" r="95" fill="none" stroke="rgba(56,189,248,0.2)" stroke-width="1"/>

        <!-- CT Ring (Inner) -->
        <circle cx="400" cy="190" r="75" fill="none" stroke="rgba(74,155,212,0.4)" stroke-width="6"/>

        <!-- Detector Array Animation -->
        <g style="animation: rotate-gantry 5s linear infinite; transform-origin: 400px 190px;">
            <circle cx="475" cy="190" r="4" fill="rgba(56,189,248,0.8)"/>
            <circle cx="400" cy="265" r="4" fill="rgba(56,189,248,0.8)"/>
            <circle cx="325" cy="190" r="4" fill="rgba(56,189,248,0.8)"/>
            <circle cx="400" cy="115" r="4" fill="rgba(56,189,248,0.8)"/>
        </g>

        <!-- Patient Table -->
        <rect x="330" y="175" width="140" height="30" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="2" rx="3"
              style="animation: slide-table 3s ease-in-out infinite;"/>

        <!-- Radioactive Isotope Indicator -->
        <circle cx="400" cy="190" r="40" fill="rgba(56,189,248,0.1)" stroke="rgba(56,189,248,0.3)" stroke-width="1" style="animation: pulse-glow 2s ease-in-out infinite;"/>
        <polygon points="400,180 405,190 400,200 395,190" fill="rgba(56,189,248,0.6)"/>

        <!-- Control Console -->
        <rect x="80" y="120" width="140" height="200" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- Isotope Selection Panel -->
        <rect x="90" y="140" width="120" height="50" fill="rgba(56,189,248,0.12)" stroke="rgba(56,189,248,0.3)" stroke-width="1" rx="3"/>
        <text x="150" y="160" font-family="DM Mono" font-size="10" fill="rgba(255,255,255,0.5)" text-anchor="middle">F18 FDG</text>
        <text x="150" y="175" font-family="DM Mono" font-size="10" fill="rgba(255,255,255,0.5)" text-anchor="middle">240 MBq</text>

        <!-- Activity Meter -->
        <rect x="90" y="210" width="120" height="20" fill="rgba(255,255,255,0.06)" stroke="rgba(255,255,255,0.1)" stroke-width="1" rx="2"/>
        <rect x="92" y="212" width="116" height="16" fill="rgba(56,189,248,0.1)" stroke="none" rx="1"/>
        <rect x="92" y="212" width="70" height="16" fill="rgba(56,189,248,0.4)" stroke="none" rx="1" style="animation: pulse-glow 2.5s ease-in-out infinite;"/>

        <!-- Status Indicators -->
        <circle cx="110" cy="260" r="4" fill="rgba(16,185,129,0.9)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <circle cx="150" cy="260" r="4" fill="rgba(239,68,68,0.9)" style="animation: blink-led 0.8s ease-in-out infinite;"/>

        <!-- Info Text -->
        <text x="400" y="450" font-family="DM Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Nuclear Medicine Imaging</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
