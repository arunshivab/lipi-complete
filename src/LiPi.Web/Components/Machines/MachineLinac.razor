@namespace LiPi.Web.Components.Machines

<!-- Linear Accelerator (Linac) Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <rect width="800" height="500" fill="transparent"/>

    <!-- Linac Machine -->
    <g id="linac-machine">
        <!-- Gantry Arm -->
        <line x1="400" y1="150" x2="400" y2="280" stroke="rgba(255,255,255,0.2)" stroke-width="12" stroke-linecap="round"/>

        <!-- Rotating Gantry Head -->
        <circle cx="400" cy="150" r="60" fill="none" stroke="rgba(239,68,68,0.5)" stroke-width="6" style="animation: rotate-gantry 6s linear infinite;"/>
        <circle cx="400" cy="150" r="55" fill="rgba(239,68,68,0.1)" stroke="rgba(239,68,68,0.3)" stroke-width="2"/>

        <!-- X-ray Beam Emitter -->
        <circle cx="400" cy="150" r="35" fill="rgba(255,255,255,0.12)" stroke="rgba(239,68,68,0.6)" stroke-width="3"/>
        <circle cx="400" cy="150" r="25" fill="rgba(239,68,68,0.2)" stroke="none" style="animation: pulse-glow 2s ease-in-out infinite;"/>

        <!-- Beam Direction Indicator -->
        <g style="animation: drift-beam 3s ease-in-out infinite; transform-origin: 400px 150px;">
            <line x1="400" y1="185" x2="400" y2="340" stroke="rgba(239,68,68,0.5)" stroke-width="3" stroke-linecap="round"/>
            <polygon points="400,350 395,335 405,335" fill="rgba(239,68,68,0.6)"/>
        </g>

        <!-- Patient Positioning Couch -->
        <rect x="320" y="360" width="160" height="50" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.3)" stroke-width="2" rx="4"
              style="animation: slide-table 3.5s ease-in-out infinite;"/>

        <!-- Support Stand -->
        <rect x="380" y="300" width="40" height="60" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2"/>

        <!-- Control Panel (Left Side) -->
        <rect x="100" y="150" width="120" height="150" fill="rgba(255,255,255,0.08)" stroke="rgba(255,255,255,0.2)" stroke-width="2" rx="6"/>

        <!-- Dose Rate Display -->
        <rect x="110" y="165" width="100" height="35" fill="rgba(239,68,68,0.15)" stroke="rgba(239,68,68,0.4)" stroke-width="1" rx="2"/>
        <text x="160" y="190" font-family="DM Mono" font-size="14" fill="rgba(239,68,68,0.8)" text-anchor="middle">300 Gy/min</text>

        <!-- Status Indicators -->
        <circle cx="130" cy="230" r="4" fill="rgba(16,185,129,0.9)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <circle cx="160" cy="230" r="4" fill="rgba(239,68,68,0.9)" style="animation: pulse-glow 1.5s ease-in-out infinite;"/>

        <!-- Info Text -->
        <text x="400" y="450" font-family="DM Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Radiation Therapy</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
