@namespace LiPi.Web.Components.Machines

<!-- Operation Theatre Component -->
<svg viewBox="0 0 800 500" xmlns="http://www.w3.org/2000/svg" class="machine-svg">
    <rect width="800" height="500" fill="transparent"/>

    <!-- Surgical Theatre Setup -->
    <g id="operation-theatre">
        <!-- Operating Table -->
        <rect x="280" y="200" width="240" height="100" fill="rgba(255,255,255,0.12)" stroke="rgba(255,255,255,0.3)" stroke-width="3" rx="8"/>
        <ellipse cx="400" cy="250" rx="110" ry="45" fill="rgba(255,255,255,0.08)" stroke="none"/>

        <!-- Overhead Lights (animated) -->
        <g style="animation: pulse-glow 2s ease-in-out infinite;">
            <circle cx="300" cy="80" r="30" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
            <circle cx="300" cy="80" r="20" fill="rgba(255,255,255,0.3)"/>
        </g>

        <g style="animation: pulse-glow 2s ease-in-out infinite 0.5s;">
            <circle cx="400" cy="60" r="30" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
            <circle cx="400" cy="60" r="20" fill="rgba(255,255,255,0.3)"/>
        </g>

        <g style="animation: pulse-glow 2s ease-in-out infinite 1s;">
            <circle cx="500" cy="80" r="30" fill="rgba(255,255,255,0.2)" stroke="rgba(255,255,255,0.3)" stroke-width="2"/>
            <circle cx="500" cy="80" r="20" fill="rgba(255,255,255,0.3)"/>
        </g>

        <!-- Surgical Lights Beams -->
        <line x1="300" y1="110" x2="350" y2="200" stroke="rgba(255,255,255,0.15)" stroke-width="2" opacity="0.4"/>
        <line x1="400" y1="90" x2="400" y2="200" stroke="rgba(255,255,255,0.15)" stroke-width="2" opacity="0.4"/>
        <line x1="500" y1="110" x2="450" y2="200" stroke="rgba(255,255,255,0.15)" stroke-width="2" opacity="0.4"/>

        <!-- Surgical Equipment Boom (animated) -->
        <g style="animation: drift-beam 4s ease-in-out infinite; transform-origin: 650px 100px;">
            <line x1="650" y1="100" x2="580" y2="200" stroke="rgba(255,255,255,0.2)" stroke-width="4" stroke-linecap="round"/>
            <rect x="570" y="200" width="30" height="50" fill="rgba(255,255,255,0.1)" stroke="rgba(255,255,255,0.2)" stroke-width="1" rx="2"/>
        </g>

        <!-- Monitor Displays (Left & Right) -->
        <rect x="80" y="160" width="90" height="120" fill="rgba(56,189,248,0.12)" stroke="rgba(56,189,248,0.3)" stroke-width="2" rx="4"/>
        <rect x="85" y="180" width="80" height="60" fill="rgba(56,189,248,0.06)" stroke="none"/>
        <text x="125" y="215" font-family="DM Mono" font-size="9" fill="rgba(56,189,248,0.6)" text-anchor="middle">Vitals Monitor</text>

        <rect x="630" y="160" width="90" height="120" fill="rgba(56,189,248,0.12)" stroke="rgba(56,189,248,0.3)" stroke-width="2" rx="4"/>
        <rect x="635" y="180" width="80" height="60" fill="rgba(56,189,248,0.06)" stroke="none"/>
        <text x="675" y="215" font-family="DM Mono" font-size="9" fill="rgba(56,189,248,0.6)" text-anchor="middle">Surgical Video</text>

        <!-- Status Indicators (animated) -->
        <circle cx="110" cy="310" r="5" fill="rgba(16,185,129,0.9)" style="animation: blink-led 1s ease-in-out infinite;"/>
        <circle cx="150" cy="310" r="5" fill="rgba(56,189,248,0.9)" style="animation: blink-led 0.9s ease-in-out infinite;"/>
        <circle cx="190" cy="310" r="5" fill="rgba(245,158,11,0.9)" style="animation: blink-led 1.1s ease-in-out infinite;"/>

        <!-- Info Text -->
        <text x="400" y="450" font-family="DM Sans" font-size="16" fill="rgba(255,255,255,0.6)" text-anchor="middle">Surgical Suite</text>
    </g>
</svg>

<style>
    .machine-svg {
        width: 100%;
        height: 100%;
        object-fit: contain;
        filter: drop-shadow(0 20px 40px rgba(0,0,0,0.5));
    }
</style>
