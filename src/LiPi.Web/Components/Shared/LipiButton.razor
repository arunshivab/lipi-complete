@* SPEC: Phase 2.1 LipiButton design package *@
@* All variants × sizes × states per locked design package *@
@* Namespace: LiPi.Web.Components.Shared *@

@using Microsoft.JSInterop
@inject IJSRuntime JS

<button type="@Type"
        class="lipi-button @CssClasses @(Class ?? string.Empty)"
        disabled="@EffectiveDisabled"
        aria-busy="@AriaBusyValue"
        aria-label="@AriaLabel"
        @onclick="HandleClickAsync">
    @* Loading replaces LEFT icon only; text and right-icon remain visible to preserve width. *@
    @if (IsLoading)
    {
        <span class="lipi-button-icon-slot">
            <LipiButtonSpinner Size="@IconSize" />
        </span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <span class="lipi-button-icon-slot">
            <LucideIcon Name="@Icon" Size="@IconSize" />
        </span>
    }

    @if (ChildContent != null)
    {
        <span class="lipi-button-text">@ChildContent</span>
    }

    @if (!IsIconOnly && !string.IsNullOrEmpty(IconRight))
    {
        <span class="lipi-button-icon-slot">
            <LucideIcon Name="@IconRight" Size="@IconSize" />
        </span>
    }
</button>

@code {
    /// <summary>Button label content. Null = icon-only mode (requires Icon + AriaLabel).</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Small (28px), Medium (32px), Large (40px). Default Medium.</summary>
    [Parameter] public ButtonSize Size { get; set; } = ButtonSize.Medium;

    /// <summary>Visual variant. Default Primary. Use Ghost or Secondary explicitly for icon-only buttons.</summary>
    [Parameter] public ButtonVariant Variant { get; set; } = ButtonVariant.Primary;

    /// <summary>Lucide icon name (left of text, or alone if icon-only). v1.0: Lucide only.</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Lucide icon name rendered to right of text. Ignored when icon-only.</summary>
    [Parameter] public string? IconRight { get; set; }

    /// <summary>Click handler. Fires after optional confirm. No-op when Disabled or IsLoading.</summary>
    [Parameter] public EventCallback<MouseEventArgs> OnClick { get; set; }

    /// <summary>Disabled state: opacity 0.5, cursor not-allowed, no interaction.</summary>
    [Parameter] public bool Disabled { get; set; }

    /// <summary>
    /// Loading state: spinner replaces left icon, text and right-icon remain visible
    /// (width preserved, no layout shift), button disabled, aria-busy="true".
    /// Parent-controlled — caller sets to true in their OnClick handler before async work,
    /// false when done.
    /// </summary>
    [Parameter] public bool IsLoading { get; set; }

    /// <summary>
    /// If set, shows confirmation dialog before OnClick fires.
    /// v1.0 uses window.confirm() (native browser modal); v1.1+ may swap to LipiConfirmDialog
    /// component without changing this parameter's API.
    /// </summary>
    [Parameter] public string? ConfirmMessage { get; set; }

    /// <summary>Stretches button to full container width (for form layouts).</summary>
    [Parameter] public bool FullWidth { get; set; }

    /// <summary>HTML button type: "button" (default), "submit", or "reset".</summary>
    [Parameter] public string Type { get; set; } = "button";

    /// <summary>Screen reader label. REQUIRED for icon-only buttons (throws if missing).</summary>
    [Parameter] public string? AriaLabel { get; set; }

    /// <summary>
    /// Append-only CSS class. LAYOUT UTILITIES ONLY (margin, alignment).
    /// NEVER use for visual styling (colors, padding, borders) — use Size + Variant instead.
    /// </summary>
    [Parameter] public string? Class { get; set; }

    private bool IsIconOnly => ChildContent == null && !string.IsNullOrEmpty(Icon);

    private bool EffectiveDisabled => Disabled || IsLoading;

    private string? AriaBusyValue => IsLoading ? "true" : null;

    private int IconSize => Size switch
    {
        ButtonSize.Small => 14,
        ButtonSize.Large => 18,
        _ => 16
    };

    private string CssClasses
    {
        get
        {
            var classes = new List<string>
            {
                $"lipi-button-{Size.ToString().ToLowerInvariant()}",
                $"lipi-button-{Variant.ToString().ToLowerInvariant()}"
            };
            if (IsIconOnly)  classes.Add("lipi-button-icon-only");
            if (FullWidth)   classes.Add("lipi-button-full-width");
            if (IsLoading)   classes.Add("lipi-button-loading");
            return string.Join(" ", classes);
        }
    }

    protected override void OnParametersSet()
    {
        if (IsIconOnly && string.IsNullOrWhiteSpace(AriaLabel))
        {
            throw new ArgumentException(
                "LipiButton: AriaLabel is required when in icon-only mode " +
                "(ChildContent null + Icon set). WCAG 2.1.4.6 / SC 4.1.2 compliance.");
        }
    }

    private async Task HandleClickAsync(MouseEventArgs e)
    {
        if (EffectiveDisabled) return;

        if (!string.IsNullOrEmpty(ConfirmMessage))
        {
            var confirmed = await JS.InvokeAsync<bool>("confirm", ConfirmMessage);
            if (!confirmed) return;
        }

        if (OnClick.HasDelegate)
        {
            await OnClick.InvokeAsync(e);
        }
    }
}
