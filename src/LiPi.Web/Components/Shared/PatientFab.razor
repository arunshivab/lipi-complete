@namespace LiPi.Web.Components.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@rendermode InteractiveServer
@inject NavigationManager Nav

@if (_visible)
{
    @if (_open)
    {
        <div class="pfab-overlay" @onclick="Close"></div>
    }

    <div class="pfab-wrap @(_open ? "open" : "")" @onclick:stopPropagation="true">

        @if (_open)
        {
            <div class="pfab-actions">
                <div class="pfab-action-row" @onclick='() => Go("/patients/new")'>
                    <div class="pfab-chip">
                        Register patient
                        <div class="pfab-chip-sub">New UHID reserved immediately</div>
                    </div>
                    <div class="pfab-action-dot reg">&#9998;</div>
                </div>
                <div class="pfab-action-row" @onclick='() => Go("/patients/search")'>
                    <div class="pfab-chip">
                        Search patient
                        <div class="pfab-chip-sub">Name · MRN · Mobile · Aadhaar</div>
                    </div>
                    <div class="pfab-action-dot srch">&#9740;</div>
                </div>
                <div class="pfab-action-row" @onclick='() => Go("/patients/queue")'>
                    <div class="pfab-chip">
                        Add to queue
                        <div class="pfab-chip-sub">Pick doctor and slot</div>
                    </div>
                    <div class="pfab-action-dot que">&#9711;</div>
                </div>
            </div>
        }

        <button class="pfab-btn" type="button"
                title="Patient actions"
                @onclick="Toggle">
            <div class="pfab-pulse"></div>
            <div class="pfab-icon"></div>
        </button>

    </div>
}

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private bool     _visible     = false;
    private bool     _open        = false;
    private DateTime _lastToggle  = DateTime.MinValue;

    private static readonly string[] _patientRoles =
    [
        "global_admin","sys_admin","site_admin",
        "reception","data_entry",
        "nurse","charge_nurse",
        "physician","consultant","resident",
        "billing_staff","tpa_staff",
    ];

    protected override async Task OnInitializedAsync()
    {
        var user  = (await AuthState).User;
        var roles = user.Claims
                       .Where(c => c.Type == ClaimTypes.Role)
                       .Select(c => c.Value)
                       .ToHashSet();
        _visible = roles.Overlaps(_patientRoles);
    }

    private void Toggle()
    {
        _open       = !_open;
        _lastToggle = DateTime.UtcNow;
    }

    private void Close()
    {
        // Debounce: ignore Close fired within 300 ms of Toggle (ghost-click guard)
        if ((DateTime.UtcNow - _lastToggle).TotalMilliseconds < 300) return;
        _open = false;
        StateHasChanged();
    }

    private void Go(string path)
    {
        _open = false;
        StateHasChanged();
        Nav.NavigateTo(path);
    }
}
