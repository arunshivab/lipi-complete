@* SPEC:  docs/03-Phase-2.5-Selection-Components/02-LipiCheckboxGroup.md
           — 20 locked decisions
   PHASE: 2.5 Step 9 — second selection-family component
   AMEND: docs/CHANGE-LOG.md A15 (pending — Phase 2.5 close-out)
          Audit-item alignments shipped in this file:
            #2  helper slot single-bottom (no top split)
            #6  ValueSelector uniqueness check (env-gated)
            #7  tri-state Required caveat (documentation only)
            #8b over-max bound state (env-gated check + over-max CSS class)
            #12 cascade context = 2 fields (ReadOnly, OnChildInteracted)
            #15c InputLabelPosition enum is shared (no group LabelPosition v1.0)
            #19 lock 5 — error-state left-border in family CSS
            #19 lock 6 — Label/AriaLabel filter fix (mirrors LipiCheckbox)

   Component signature: LipiCheckboxGroup<TItem, TValue> : LipiInputBase<List<TValue>>
     - TItem  = type of items in the source list
     - TValue = type of the value stored in the bound List<TValue>
     - Often TItem == TValue for simple cases (List<string>, List<int>)

   Mutation pattern: REPLACEMENT, not in-place mutation. Every value change
   creates a new List<TValue> instance to avoid Blazor reactivity bugs. The
   bound list reference flips on every toggle.
*@

@typeparam TItem
@typeparam TValue
@inherits LipiInputBase<List<TValue>>

@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web

@*
   Wrapper is <fieldset> per Decision 2.6 — native HTML grouping element.
   Native disabled cascade via <fieldset disabled> — no C# wiring per child
   per Decision 2.9. Legend is <legend>; CSS resets remove default browser
   chrome (border, padding, margin) so the group renders flush.

   Family classes emitted:
     - .lipi-cbg-wrapper                 — component-specific
     - .lipi-input-{size}                — Phase 2.2 family (lipi-inputs.css)
     - .lipi-input-orient-{orientation}  — Phase 2.5 family
     - .lipi-input-cols-{N}              — Phase 2.5 family (Grid only)
     - .lipi-input-density-{density}     — Phase 2.5 family
     - .lipi-input-disabled              — Phase 2.5 family
     - .lipi-input-readonly              — Phase 2.5 family
     - .lipi-input-error                 — Phase 2.5 family
     - .lipi-input-required-tint         — Phase 2.5 family (apricot ambient cue)
*@
<fieldset class="@WrapperCssClasses"
          disabled="@Disabled"
          aria-describedby="@HelperId"
          aria-label="@(string.IsNullOrEmpty(_resolvedLabel) ? AriaLabel : null)"
          style="@InlineStyle">

    @* ===== LEGEND (top label only per Decision 2.7 — no LabelPosition v1.0) ===== *@
    @if (!string.IsNullOrEmpty(_resolvedLabel))
    {
        <legend class="lipi-cbg-label">
            <span class="lipi-cbg-label-text">@_resolvedLabel</span>
            @if (Required)
            {
                @* Asterisk + ARIA + tooltip ALWAYS render when Required regardless
                   of RequiredVisualStyle — matches Phase 2.2 Decision 6 (Approach D).
                   Sighted ApricotTint users get apricot ambient cue (T-G2) on the
                   options container; SR users get asterisk + aria-required on the
                   group level. *@
                <span class="lipi-input-required-asterisk"
                      aria-label="required field"
                      title="Required">*</span>
            }
            @if (ShowSelectionCount)
            {
                <span class="@CountCssClasses"
                      aria-live="polite"
                      aria-atomic="true">
                    @CountDisplayText
                </span>
            }
        </legend>
    }

    @* ===== OPTIONS CONTAINER + CASCADE ===== *@
    @* CascadingValue broadcasts the group context (ReadOnly + OnChildInteracted)
       to every descendant LipiCheckbox. IsFixed=false so child re-renders pick up
       changes when the group's ReadOnly or callback identity flips.
       Per audit item #12: 2-field record. Disabled cascade is handled by native
       <fieldset disabled> above; no C# wiring per child needed. *@
    <CascadingValue Value="@_groupContext"
                    Name="LipiCheckboxGroupContext"
                    IsFixed="false">
        <div class="lipi-cbg-options">
            @foreach (var item in Items)
            {
                var v = ResolvedValueSelector(item);
                var capturedV    = v;          // closure capture for lambda + ValueExpression
                var capturedItem = item;       // closure capture for ItemTemplate
                <LipiCheckbox TValue="bool"
                              Name="@($"{_resolvedName}-{capturedV}")"
                              Value="@IsItemSelected(capturedV)"
                              ValueChanged="@(EventCallback.Factory.Create<bool>(this, x => OnItemToggleAsync(capturedV, x)))"
                              ValueExpression="@(() => _childCheckboxBacking)"
                              Label="@(ItemTemplate is null ? ResolvedLabelSelector(capturedItem) : null)"
                              AriaLabel="@(ItemTemplate is null ? null : ResolvedLabelSelector(capturedItem))"
                              LabelTemplate="@(ItemTemplate is null ? null : (RenderFragment)(b => ItemTemplate(capturedItem)(b)))"
                              Helper="@(HelperSelector?.Invoke(capturedItem))"
                              Disabled="@IsItemDisabledForRender(capturedItem)"
                              Size="@Size"
                              @key="capturedV" />
            }
        </div>
    </CascadingValue>

    @* ===== HELPER SLOT (single bottom slot per audit item #2) ===== *@
    @* All states (error/warning/success/default) render in this single slot.
       No top slot — the spec's Decision 2.12 X-3-refined was reversed by
       audit item #2 in favor of cross-family always-below consistency
       with LipiTextBox/LipiSelect/LipiDate. Auto-scroll-to-first-error
       handles the long-group ergonomic concern. *@
    @if (HasHelperContent || Defaults.Value.AlwaysReserveHelperSlot)
    {
        <div id="@HelperId"
             class="@HelperCssClasses"
             role="@HelperRole"
             aria-live="@HelperAriaLive">
            @HelperText
        </div>
    }
</fieldset>


@code {
    // ==========================================================================
    // CASCADE STATE — group context (2-field per audit item #12)
    // ──────────────────────────────────────────────────────────────────────────
    // The group constructs the LipiCheckboxGroupContext once per render and emits
    // it via <CascadingValue>. Children receive ReadOnly + OnChildInteracted
    // callback. Disabled is NOT in the record — native <fieldset disabled>
    // cascades that to descendants automatically.
    // ==========================================================================

    private LipiCheckboxGroupContext _groupContext = default!;
    private EventCallback _onChildInteracted;

    // Dummy backing field used only to satisfy InputBase<bool>'s ValueExpression
    // requirement. FieldIdentifier.ParseAccessor requires a simple member accessor
    // (fields/properties of an object — no method calls). The group manages actual
    // selection state itself; this field is never read or written at runtime.
    // CS0649 suppressed intentionally — this field is a compile-time-only artifact.
#pragma warning disable CS0649
    private bool _childCheckboxBacking;
#pragma warning restore CS0649

    /// <summary>Resolved read-only state. Children's local ReadOnly OR's with this
    /// (group ReadOnly forces all children read-only; individual children can
    /// additionally be read-only when the group is not).</summary>
    private bool ResolvedReadOnly => ReadOnly;


    // ==========================================================================
    // COMPONENT-SPECIFIC PARAMETERS (Decision 2.19)
    // ==========================================================================

    /// <summary>Source list of items to render. Materialize upstream — every render
    /// enumerates Items.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; }
        = Array.Empty<TItem>();

    /// <summary>Maps an item to its bound value. Default: identity when TItem == TValue;
    /// throws otherwise (caller must provide). Validated at OnParametersSet.</summary>
    [Parameter] public Func<TItem, TValue>? ValueSelector { get; set; }

    /// <summary>Maps an item to its visible label text. Default: <c>item?.ToString() ?? ""</c>.</summary>
    [Parameter] public Func<TItem, string>? LabelSelector { get; set; }

    /// <summary>Per-item disabled flag — OR-merged with the group's Disabled and the
    /// MaxSelections-reached gating. Default: null (no items disabled by selector).</summary>
    [Parameter] public Func<TItem, bool>? DisabledSelector { get; set; }

    /// <summary>Per-item helper text rendered below each child checkbox label.
    /// Default: null (no per-item helper).</summary>
    [Parameter] public Func<TItem, string?>? HelperSelector { get; set; }

    /// <summary>Render fragment for rich item content (icon + label, custom layout).
    /// When non-null, drives each child LipiCheckbox via its LabelTemplate; the
    /// LabelSelector becomes a fallback for screen-reader text only. Default: null
    /// (use LabelSelector). Per Decision 2.3.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>Layout direction for options container.</summary>
    [Parameter] public CheckboxGroupOrientation Orientation { get; set; }
        = CheckboxGroupOrientation.Vertical;

    /// <summary>Grid column count when Orientation == Grid. Range 2-6.
    /// Validated env-gated at OnParametersSet.</summary>
    [Parameter] public int Columns { get; set; } = 2;

    /// <summary>Per-component density override. Null = inherit from
    /// <see cref="LipiInputDefaults.CheckboxGroupDensity"/>.</summary>
    [Parameter] public CheckboxGroupDensity? Density { get; set; }

    /// <summary>Accessible label for screen readers when <see cref="LipiInputBase{TValue}.Label"/>
    /// is intentionally empty (inline-left layout pattern). Either Label or AriaLabel
    /// must be non-empty per Decision 2.7.</summary>
    [Parameter] public string? AriaLabel { get; set; }

    // ── Phase 2.5.5 — LabelPosition (deferred from Phase 2.5 Decision 2.7) ──────────────

    /// <summary>Position of the group legend relative to the options container.
    /// Top (default) — legend above options. Left — legend left column. Right — legend right.
    /// Bottom — legend below options. When Left or Right, use AriaLabel or ensure Label has content.</summary>
    [Parameter] public InputLabelPosition LabelPosition { get; set; } = InputLabelPosition.Top;

    private string _resolvedLabelPositionClass = string.Empty;

    /// <summary>Minimum selections required (visual + count cue only — component does
    /// NOT enforce validation directly; pair with [MinLength] on the model).</summary>
    [Parameter] public int? MinSelections { get; set; }

    /// <summary>Maximum selections allowed. When <c>Value.Count == Max</c>, unselected
    /// items render disabled. Defensive guard in OnItemToggleAsync prevents
    /// programmatic over-selection.</summary>
    [Parameter] public int? MaxSelections { get; set; }

    /// <summary>Render live count display in legend ("3 / 5", "2"). State classes
    /// (.lipi-cbg-count-near-max / -at-max / -over-max) compose per heuristic.</summary>
    [Parameter] public bool ShowSelectionCount { get; set; }


    // ==========================================================================
    // RESOLVED SELECTORS (default-when-null pattern)
    // ──────────────────────────────────────────────────────────────────────────
    // Each ResolvedXSelector wraps the parameter with a default fallback. We do NOT
    // mutate the [Parameter] property directly (Blazor wipes it on re-render). The
    // resolved getter computes the default on every call, which is fine for these
    // simple cases.
    // ==========================================================================

    private TValue ResolvedValueSelector(TItem item)
    {
        if (ValueSelector is not null) return ValueSelector(item);

        // Identity fallback when TItem == TValue
        if (item is TValue tv) return tv;

        throw new InvalidOperationException(
            $"ValueSelector is required when TItem ({typeof(TItem).Name}) " +
            $"is not assignable to TValue ({typeof(TValue).Name}).");
    }

    private string ResolvedLabelSelector(TItem item)
        => LabelSelector?.Invoke(item) ?? item?.ToString() ?? string.Empty;

    private CheckboxGroupDensity ResolvedDensity
        => Density ?? Defaults.Value.CheckboxGroupDensity;


    // ==========================================================================
    // BASE CLASS OVERRIDES
    // ==========================================================================

    /// <summary>Component id namespace — produces id="cbg-{Name}".</summary>
    protected override string ComponentIdPrefix => "cbg";

    /// <summary>Type name for log messages.</summary>
    protected override string ComponentTypeName => "LipiCheckboxGroup";

    /// <summary>Empty when CurrentValue is null OR empty list. Drives apricot
    /// ambient cue (Required && IsEmpty) and Required validation messages.</summary>
    protected override bool IsEmpty
        => CurrentValue is null || CurrentValue.Count == 0;

    /// <summary>Vestigial — InputBase requires the override but the group never
    /// uses string round-trip. Returns CurrentValue unchanged (or empty list).</summary>
    protected override bool TryParseValueFromString(
        string? value,
        out List<TValue> result,
        out string validationErrorMessage)
    {
        result = CurrentValue ?? new List<TValue>();
        validationErrorMessage = string.Empty;
        return true;
    }

    /// <summary>Component-specific parameter validation.</summary>
    /// <remarks>
    /// Filter pattern (audit item #19 lock 6): suppress base class's "Label
    /// parameter is required" when AriaLabel is provided. Same pattern as
    /// LipiCheckbox — both components support the inline-left layout where the
    /// label sits visually elsewhere and AriaLabel covers the accessible-name
    /// requirement.
    /// </remarks>
    protected override List<string> CollectParameterValidationErrors()
    {
        var errors = base.CollectParameterValidationErrors();

        // Suppress base's "Label parameter is required" when AriaLabel covers the
        // accessible-name requirement.
        if (!string.IsNullOrWhiteSpace(AriaLabel))
        {
            errors.RemoveAll(e => e.StartsWith("Label parameter is required"));
        }

        // Either Label or AriaLabel must be non-empty (Decision 2.7).
        if (string.IsNullOrWhiteSpace(_resolvedLabel) && string.IsNullOrWhiteSpace(AriaLabel))
        {
            errors.Add("Either Label or AriaLabel is required (accessible name for assistive tech).");
        }

        // Columns range check (Decision 2.4 env-gated)
        if (Orientation == CheckboxGroupOrientation.Grid && (Columns < 2 || Columns > 6))
        {
            errors.Add($"Columns must be between 2 and 6 when Orientation=Grid. Got {Columns}.");
        }

        // MinSelections / MaxSelections sanity (Decision 2.11 env-gated)
        if (MinSelections.HasValue && MinSelections.Value < 0)
        {
            errors.Add($"MinSelections must be >= 0. Got {MinSelections.Value}.");
        }
        if (MaxSelections.HasValue && MaxSelections.Value < 1)
        {
            errors.Add($"MaxSelections must be >= 1. Got {MaxSelections.Value}.");
        }
        if (MinSelections.HasValue && MaxSelections.HasValue
            && MinSelections.Value > MaxSelections.Value)
        {
            errors.Add(
                $"MinSelections ({MinSelections.Value}) must be <= MaxSelections " +
                $"({MaxSelections.Value}).");
        }

        // ValueSelector uniqueness — when the parameter is non-null, every Items[i]
        // should map to a distinct TValue. Multi-null fails; single null OK.
        // Per audit item #6 — env-gated check.
        if (ValueSelector is not null && Items is not null)
        {
            var seen = new HashSet<TValue>();
            var nullCount = 0;
            foreach (var item in Items)
            {
                var v = ValueSelector(item);
                if (v is null)
                {
                    nullCount++;
                    if (nullCount > 1)
                    {
                        errors.Add(
                            "ValueSelector returned null for multiple items. " +
                            "At most one item may map to a null value (commonly used " +
                            "for 'no selection' sentinel).");
                        break;
                    }
                    continue;
                }
                if (!seen.Add(v))
                {
                    errors.Add(
                        $"ValueSelector returned duplicate value '{v}' for multiple " +
                        $"items. Bound List<TValue> requires distinct values.");
                    break;
                }
            }
        }

        // Bound count > MaxSelections — defensive check per audit item #8b.
        // Realistic data paths: database returns more rows than MaxSelections,
        // state restore, programmatic mutation. Component renders the over-max
        // visual class; this check ensures Dev sees the violation early.
        if (MaxSelections.HasValue
            && CurrentValue is not null
            && CurrentValue.Count > MaxSelections.Value)
        {
            errors.Add(
                $"Bound Value.Count ({CurrentValue.Count}) exceeds MaxSelections " +
                $"({MaxSelections.Value}). Component will render the over-max state. " +
                $"User can deselect items to recover; programmatic recovery depends " +
                $"on caller logic.");
        }

        return errors;
    }


    // ==========================================================================
    // LIFECYCLE — build group context after parameter validation
    // ──────────────────────────────────────────────────────────────────────────
    // EventCallback construction: bind once in OnInitialized so the callback
    // identity is stable. Without this, every render produces a new EventCallback
    // and CascadingValue treats it as changed → cascades to all children → all
    // children re-render. Stable callback = stable cascade.
    // ==========================================================================

    protected override void OnInitialized()
    {
        base.OnInitialized();
        _onChildInteracted = EventCallback.Factory.Create(this, OnChildInteractedHandler);
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        // Phase 2.5.5 — resolve label position CSS class.
        _resolvedLabelPositionClass = LabelPosition switch
        {
            InputLabelPosition.Left   => "lipi-input-label-left",
            InputLabelPosition.Right  => "lipi-input-label-right",
            InputLabelPosition.Bottom => "lipi-input-label-bottom",
            _                         => string.Empty
        };

        // Rebuild context on every parameter change. ResolvedReadOnly may have
        // flipped; CascadingValue compares by value-equality on records (record
        // value-based equality covers structural changes).
        _groupContext = new LipiCheckboxGroupContext(
            ResolvedReadOnly,
            _onChildInteracted);
    }


    // ==========================================================================
    // ITEM TOGGLE — REPLACEMENT MUTATION (not in-place)
    // ──────────────────────────────────────────────────────────────────────────
    // Per Decision 2.2: every value change creates a NEW List<TValue> instance.
    // Avoids Blazor reactivity bugs where in-place List.Add/Remove doesn't trigger
    // re-render because the reference hasn't changed.
    //
    // Defensive max-guard per Decision 2.11 — UI prevents over-selection clicks
    // via per-item disabled gating, but programmatic toggles bypass the UI. This
    // guard ensures the bound List never exceeds Max from ValueChanged emissions.
    // ==========================================================================

    private async Task OnItemToggleAsync(TValue value, bool checkedState)
    {
        if (Disabled || ResolvedReadOnly) return;

        var current = CurrentValue ?? new List<TValue>();

        // Defensive max-guard
        if (checkedState
            && MaxSelections.HasValue
            && current.Count >= MaxSelections.Value
            && !current.Contains(value))
        {
            return;  // bound List never exceeds Max from user toggles
        }

        var newList = new List<TValue>(current);

        if (checkedState && !newList.Contains(value))
        {
            newList.Add(value);
        }
        else if (!checkedState)
        {
            newList.Remove(value);
        }

        CurrentValue = newList;
        await ValueChanged.InvokeAsync(newList);
        EditContext?.NotifyFieldChanged(FieldIdentifier);
    }

    /// <summary>True when the bound list contains the given value.</summary>
    private bool IsItemSelected(TValue value)
        => CurrentValue?.Contains(value) ?? false;

    /// <summary>Effective per-item disabled state — OR-merged from
    /// DisabledSelector + MaxSelections-reached gating (Decision 2.11 B-1).</summary>
    private bool IsItemDisabledForRender(TItem item)
    {
        var perItemDisabled = DisabledSelector?.Invoke(item) ?? false;
        if (perItemDisabled) return true;

        if (MaxSelections.HasValue
            && CurrentValue is not null
            && CurrentValue.Count >= MaxSelections.Value)
        {
            var v = ResolvedValueSelector(item);
            var isCurrentlySelected = CurrentValue.Contains(v);
            if (!isCurrentlySelected) return true;
        }

        return false;
    }

    /// <summary>Cascade callback target — children invoke on @onchange.
    /// Delegates to MarkFieldAsTouched() which sets _isTouched, notifies
    /// EditContext, and calls StateHasChanged in one shot.
    /// Per audit item #12 + Decision 2.13: tab-through with no action does NOT
    /// trigger touched (children fire ONLY on @onchange, not focus or blur).</summary>
    private void OnChildInteractedHandler()
    {
        MarkFieldAsTouched();
    }


    // ==========================================================================
    // CSS CLASS COMPOSITION
    // ==========================================================================

    private string WrapperCssClasses
    {
        get
        {
            var classes = new List<string>(10) { "lipi-cbg-wrapper" };
            if (!string.IsNullOrEmpty(_resolvedLabelPositionClass))
                classes.Add(_resolvedLabelPositionClass);

            // Size
            classes.Add($"lipi-input-{Size.ToString().ToLowerInvariant()}");

            // Orientation
            classes.Add($"lipi-input-orient-{Orientation.ToString().ToLowerInvariant()}");

            // Grid columns (only when Grid orientation)
            if (Orientation == CheckboxGroupOrientation.Grid)
            {
                var cols = Columns < 2 ? 2 : (Columns > 6 ? 2 : Columns); // clamp in Prod
                classes.Add($"lipi-input-cols-{cols}");
            }

            // Density
            classes.Add($"lipi-input-density-{ResolvedDensity.ToString().ToLowerInvariant()}");

            // State modifiers
            if (Disabled)
                classes.Add("lipi-input-disabled");
            if (ResolvedReadOnly)
                classes.Add("lipi-input-readonly");
            if (HasErrorState)
                classes.Add("lipi-input-error");
            else if (ShouldShowRequiredAmbientCue)
                classes.Add("lipi-input-required-tint");

            // Caller-provided Class is append-only for layout utilities (Phase 2.2 convention)
            if (!string.IsNullOrWhiteSpace(Class))
                classes.Add(Class);

            return string.Join(" ", classes);
        }
    }

    /// <summary>Apricot ambient cue trigger per Decision 2.10 + audit item #2.
    /// Suppressed when error state takes precedence (state cascade).</summary>
    private bool ShouldShowRequiredAmbientCue
        => (Required || (MinSelections.HasValue && MinSelections.Value > 0))
           && IsEmpty
           && !HasErrorState
           && !Disabled
           && !ResolvedReadOnly
           && EffectiveRequiredStyle == LiPi.Web.Components.Shared.RequiredVisualStyle.ApricotTint;

    private bool HasErrorState => ResolvedState == InputState.Error;


    // ==========================================================================
    // SELECTION COUNT DISPLAY
    // ──────────────────────────────────────────────────────────────────────────
    // Four states per audit item #8b:
    //   Count > Max               → over-max (danger color)
    //   Count == Max              → at-max   (emphatic)
    //   Count == Max - 1          → near-max (warning hue)
    //   Count < Max - 1 OR no Max → default  (no modifier — tertiary color)
    // ==========================================================================

    private string CountCssClasses
    {
        get
        {
            var count = CurrentValue?.Count ?? 0;
            var classes = new List<string>(2) { "lipi-cbg-count" };

            if (MaxSelections.HasValue)
            {
                if (count > MaxSelections.Value)
                {
                    classes.Add("lipi-cbg-count-over-max");
                }
                else if (count == MaxSelections.Value)
                {
                    classes.Add("lipi-cbg-count-at-max");
                }
                else if (count == MaxSelections.Value - 1)
                {
                    classes.Add("lipi-cbg-count-near-max");
                }
            }

            return string.Join(" ", classes);
        }
    }

    private string CountDisplayText
    {
        get
        {
            var count = CurrentValue?.Count ?? 0;
            return MaxSelections.HasValue
                ? $"{count} / {MaxSelections.Value}"
                : count.ToString();
        }
    }


    // ==========================================================================
    // HELPER SLOT (single-bottom per audit item #2)
    // All helper composition (HelperText, HasHelperContent, HelperRole,
    // HelperAriaLive) uses inherited LipiInputBase members — no redeclaration.
    // ==========================================================================

    private string HelperCssClasses
    {
        get
        {
            var stateClass = ResolvedState switch
            {
                InputState.Error   => "lipi-input-helper-error",
                InputState.Warning => "lipi-input-helper-warning",
                InputState.Success => "lipi-input-helper-success",
                _                  => null
            };

            return stateClass is null
                ? "lipi-input-helper lipi-input-helper-bottom"
                : $"lipi-input-helper lipi-input-helper-bottom {stateClass}";
        }
    }
}
