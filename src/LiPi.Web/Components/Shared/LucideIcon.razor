@* SPEC: Phase 2.1 LipiButton design package §icons *@
@* AMEND: Phase 2.2 (May 4, 2026) — added eye, eye-off, circle-x, triangle-alert for TextInput family *@
@* AMEND: Phase 2.6.3 Stage 2B — added 10 icons: info-circle, circle-check (noun-first aliases),
          alert-octagon, shield-x (LipiAlert severities), phone, map-pin, layout-dashboard,
          pill, flask-conical, file-text (LipiTabs demos). *@
@* Lucide icons by name. v1.0 set: 43 icons (29 Phase 2.1 + 4 Phase 2.2 + 10 Phase 2.6.3). *@
@* Namespace: LiPi.Web.Components.Shared *@

@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (_iconContent != null)
{
    <svg xmlns="http://www.w3.org/2000/svg"
         width="@Size" height="@Size"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="@CssClass">
        @((MarkupString)_iconContent)
    </svg>
}
else
{
    @((MarkupString)$"<!-- LucideIcon: '{Name}' not found in dictionary -->")
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public string? CssClass { get; set; }

    private string? _iconContent;

    protected override void OnParametersSet()
    {
        _iconContent = Icons.TryGetValue(Name, out var content) ? content : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _iconContent == null)
        {
            try
            {
                await JS.InvokeVoidAsync("console.warn",
                    $"[LucideIcon] Unknown icon: '{Name}'. Add to LucideIcon.Icons dictionary.");
            }
            catch
            {
                // SSR / JS unavailable — HTML comment fallback is sufficient
            }
        }
    }

