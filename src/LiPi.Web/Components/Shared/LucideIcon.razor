@* SPEC: Phase 2.1 LipiButton design package §icons *@
@* Lucide icons by name. v1.0 starter set: 29 icons. *@
@* Namespace: LiPi.Web.Components.Shared *@

@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (_iconContent != null)
{
    <svg xmlns="http://www.w3.org/2000/svg"
         width="@Size" height="@Size"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         class="@CssClass">
        @((MarkupString)_iconContent)
    </svg>
}
else
{
    @((MarkupString)$"<!-- LucideIcon: '{Name}' not found in dictionary -->")
}

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public int Size { get; set; } = 16;
    [Parameter] public string? CssClass { get; set; }

    private string? _iconContent;

    protected override void OnParametersSet()
    {
        _iconContent = Icons.TryGetValue(Name, out var content) ? content : null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _iconContent == null)
        {
            try
            {
                await JS.InvokeVoidAsync("console.warn",
                    $"[LucideIcon] Unknown icon: '{Name}'. Add to LucideIcon.Icons dictionary.");
            }
            catch
            {
                // SSR / JS unavailable — HTML comment fallback is sufficient
            }
        }
    }

    private static readonly Dictionary<string, string> Icons = new()
    {
        // Universal (6)
        ["check"]    = """<polyline points="20 6 9 17 4 12"/>""",
        ["x"]        = """<line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>""",
