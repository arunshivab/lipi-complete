@* SPEC: docs/00-COMPONENTS/01.5-DateTime.md (shipping in Batch 9d)              *@
@* PHASE: 2.4 (Batch 9d — Date/Time family ship)                                  *@
@* AMEND: docs/CHANGE-LOG.md A20 (pending)                                         *@
@*                                                                                  *@
@* LipiDatePicker — single date picker bound to DateOnly?.                        *@
@*                                                                                  *@
@* InputMode=Field (default):                                                      *@
@*   Single text input. User types the date directly OR clicks calendar icon to  *@
@*   open popover. Format follows clinic preference (default DD/MM/YYYY).         *@
@*                                                                                  *@
@* InputMode=Segments:                                                             *@
@*   Three numeric segments (DD MM YYYY etc.) per clinic format. Smart auto-     *@
@*   advance — type 2 digits in DD → focus jumps to MM with cursor at position 0. *@
@*   Calendar icon also present for popover access.                                *@
@*                                                                                  *@
@* Calendar popover:                                                               *@
@*   Compact layout. Header: prev / [Month dropdown] / [Year dropdown] / next.   *@
@*   7-col grid, up to 6 rows. Today button only in footer. Click date = commit  *@
@*   + close popover. position:fixed via window.lipiDatePicker JS module.        *@
@*                                                                                  *@
@* Constraints:                                                                    *@
@*   - MinDate / MaxDate (clamps the year dropdown range and disables out-of-    *@
@*     range cells).                                                                *@
@*   - IsDateAllowed (Func) — custom predicate; returns false → cell disabled.   *@
@*   - IsDateDisabled (Func) + GetDisabledReason (Func) — blackout dates with     *@
@*     hover tooltip. If GetDisabledReason returns null/empty, fallback string    *@
@*     "Date unavailable" (Flag 6 A6 lock).                                        *@
@*                                                                                  *@
@* Keyboard (full WAI-ARIA pattern, Flag 6 B5 lock):                              *@
@*   Field/segments: Tab/Shift+Tab navigate. Type digits enter directly.          *@
@*   Calendar grid: Arrow ±1d, ±7d via Up/Down. PageUp/Down ±1 month. Shift+      *@
@*   PageUp/Down ±1 year. Home/End first/last day of week. Ctrl+Home/End          *@
@*   first/last day of month. Enter/Space = commit + close. Escape = close.       *@

@inherits LipiInputBase<DateOnly?>
@implements IDisposable

@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using LiPi.Web.Services
@inject IJSRuntime JS
@inject IDateFormatService DateFormat

<div class="lipi-input-wrapper lipi-datepicker @CssClasses @(Class ?? string.Empty)"
     style="@InlineStyle"
     @ref="_wrapperRef">

    @* ===== LABEL ROW ===== *@
    <label class="lipi-input-label" for="@EffectiveId">
        <span class="lipi-input-label-text">@_resolvedLabel</span>
        @if (Required)
        {
            <span class="lipi-input-required-asterisk"
                  aria-label="required field"
                  title="Required">*</span>
        }
        @if (LabelConfidence.HasValue)
        {
            <span class="lipi-input-confidence-pill lipi-input-confidence-@ConfidenceCssClass"
                  aria-label="@ConfidenceAriaLabel">
                @ConfidenceLabelText
            </span>
        }
    </label>

    @* ===== FIELD ROW ===== *@
    <div class="lipi-input-field lipi-datepicker-field" @ref="_anchorRef">

        @if (InputMode == DatePickerInputMode.Field)
        {
            @* Single text input — user types or clicks icon *@
            <input id="@EffectiveId"
                   name="@_resolvedName"
                   type="text"
                   class="lipi-input-control"
                   value="@_fieldText"
                   placeholder="@(Placeholder ?? _resolvedFormat)"
                   autocomplete="@AutocompleteAttr"
                   inputmode="numeric"
                   disabled="@Disabled"
                   readonly="@ReadOnly"
                   required="@Required"
                   aria-invalid="@AriaInvalidAttr"
                   aria-describedby="@AriaDescribedByAttr"
                   @oninput="HandleFieldInput"
                   @onblur="HandleFieldBlur"
                   @onkeydown="HandleFieldKeyDown" />
        }
        else
        {
            @* Segments mode — separate inputs for DD MM YYYY (or other order) *@
            <div class="lipi-datepicker-segments" id="@EffectiveId">
                @{
                    var segs = _segmentOrder;
                }
                @for (var i = 0; i < segs.Count; i++)
                {
                    var idx = i;  // capture for closure
                    var token = segs[idx];
                    var maxLen = TokenMaxLength(token);
                    var ph = TokenPlaceholder(token);
                    var width = TokenWidth(token);

                    <input @ref="@_segmentRefs[idx]"
                           type="text"
                           class="lipi-datepicker-segment"
                           data-segment-index="@idx"
                           data-segment-token="@token"
                           value="@_segmentValues[idx]"
                           placeholder="@ph"
                           maxlength="@maxLen"
                           inputmode="numeric"
                           autocomplete="off"
                           disabled="@Disabled"
                           readonly="@ReadOnly"
                           aria-label="@SegmentAriaLabel(token)"
                           style="@($"width: {width};")"
                           @oninput="@(e => HandleSegmentInput(e, idx))"
                           @onblur="HandleSegmentBlur"
                           @onkeydown="@(e => HandleSegmentKeyDown(e, idx))" />

                    @if (idx < segs.Count - 1)
                    {
                        <span class="lipi-datepicker-segment-separator" aria-hidden="true">@SegmentSeparator</span>
                    }
                }
            </div>
        }

        @* Clear button — only when value set, not when disabled/readonly *@
        @if (CurrentValue.HasValue && !Disabled && !ReadOnly)
        {
            <button type="button"
                    class="lipi-datepicker-clear"
                    aria-label="Clear date"
                    tabindex="-1"
                    @onclick="HandleClearClick">
                <LucideIcon Name="x" Size="14" />
            </button>
        }

        @* Calendar icon — opens popover *@
        <button type="button"
                class="lipi-datepicker-icon"
                aria-label="Open calendar"
                aria-expanded="@(_isPopoverOpen ? "true" : "false")"
                aria-haspopup="dialog"
                aria-controls="@PopoverId"
                disabled="@(Disabled || ReadOnly)"
                tabindex="@((Disabled || ReadOnly) ? -1 : 0)"
                @onclick="HandleIconClick">
            <LucideIcon Name="calendar" Size="16" />
        </button>
    </div>

    @* ===== POPOVER ===== *@
    @if (_isPopoverOpen)
    {
        <div class="lipi-datepicker-popover"
             id="@PopoverId"
             role="dialog"
             aria-label="Calendar date picker"
             aria-modal="false"
             tabindex="-1"
             @ref="_popoverRef"
             @onkeydown="HandlePopoverKeyDown">

            @* Header: prev / month-dropdown / year-dropdown / next *@
            <div class="lipi-datepicker-header">
                <button type="button"
                        class="lipi-datepicker-nav"
                        aria-label="Previous month"
                        @onclick="HandlePrevMonth">
                    <LucideIcon Name="chevron-left" Size="16" />
                </button>

                <select class="lipi-datepicker-month-dropdown"
                        aria-label="Month"
                        value="@_displayMonth.Month"
                        @onchange="HandleMonthChange">
                    @for (var m = 1; m <= 12; m++)
                    {
                        <option value="@m">@CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(m)</option>
                    }
                </select>

                <select class="lipi-datepicker-year-dropdown"
                        aria-label="Year"
                        value="@_displayMonth.Year"
                        @onchange="HandleYearChange">
                    @foreach (var y in _yearRange)
                    {
                        <option value="@y">@y</option>
                    }
                </select>

                <button type="button"
                        class="lipi-datepicker-nav"
                        aria-label="Next month"
                        @onclick="HandleNextMonth">
                    <LucideIcon Name="chevron-right" Size="16" />
                </button>
            </div>

            @* Day-of-week header *@
            <div class="lipi-datepicker-dow-row" role="presentation">
                @foreach (var dow in _dowOrder)
                {
                    <span class="lipi-datepicker-dow-cell">@DayShort(dow)</span>
                }
            </div>

            @* Day grid *@
            <div class="lipi-datepicker-grid"
                 role="grid"
                 aria-label="@($"{CultureInfo.InvariantCulture.DateTimeFormat.GetMonthName(_displayMonth.Month)} {_displayMonth.Year}")">
                @{
                    var firstOfMonth = new DateOnly(_displayMonth.Year, _displayMonth.Month, 1);
                    // Find the first cell in the grid: walk back to the previous occurrence
                    // of the clinic's week-start day-of-week.
                    var weekStart = DateFormat.GetClinicWeekStart();
                    var leadingDays = ((int)firstOfMonth.DayOfWeek - (int)weekStart + 7) % 7;
                    var gridStart = firstOfMonth.AddDays(-leadingDays);

                    for (var row = 0; row < 6; row++)
                    {
                        <div class="lipi-datepicker-row" role="row">
                            @for (var col = 0; col < 7; col++)
                            {
                                var cellDate = gridStart.AddDays(row * 7 + col);
                                var isOtherMonth = cellDate.Month != _displayMonth.Month;
                                var isToday      = cellDate == DateOnly.FromDateTime(DateTime.Today);
                                var isSelected   = CurrentValue.HasValue && cellDate == CurrentValue.Value;
                                var isDisabled   = IsCellDisabled(cellDate);
                                var disReason    = isDisabled ? GetCellDisabledReason(cellDate) : null;
                                var isHighlighted = _highlightedDate.HasValue && cellDate == _highlightedDate.Value;

                                <button type="button"
                                        class="@CellClass(isOtherMonth, isToday, isSelected, isDisabled, isHighlighted)"
                                        role="gridcell"
                                        aria-label="@cellDate.ToString("D", CultureInfo.InvariantCulture)"
                                        aria-selected="@(isSelected ? "true" : "false")"
                                        aria-disabled="@(isDisabled ? "true" : "false")"
                                        title="@(disReason)"
                                        tabindex="@(isHighlighted ? 0 : -1)"
                                        disabled="@isDisabled"
                                        @onclick="@(() => HandleCellClick(cellDate))">
                                    @cellDate.Day
                                </button>
                            }
                        </div>
                    }
                }
            </div>

            @* Footer: Today button only *@
            <div class="lipi-datepicker-footer">
                <button type="button"
                        class="lipi-datepicker-today"
                        @onclick="HandleTodayClick">
                    Today
                </button>
            </div>
        </div>
    }

    @* ===== HELPER ROW ===== *@
    @if (Defaults.Value.AlwaysReserveHelperSlot || HasHelperContent)
    {
        <div class="lipi-input-helper @HelperStateClass"
             role="@HelperRole"
             aria-live="@HelperAriaLive"
             id="@HelperId">
            @HelperText
        </div>
    }

</div>

@code {
    // ==========================================================================
    // COMPONENT-SPECIFIC PARAMETERS
    // ──────────────────────────────────────────────────────────────────────────
    // 18 common parameters (Name, Label, Helper, Error, Warning, Success,
    // Required, Disabled, ReadOnly, Autocomplete, Size, Icon, AriaDescribedBy,
    // RequiredVisualStyle, LabelConfidence, Cols, Class, plus inherited Value/
    // ValueChanged/ValueExpression) come from LipiInputBase<DateOnly?>.
    // ==========================================================================

    /// <summary>How the input renders. <see cref="DatePickerInputMode.Field"/> = single
    /// text input + calendar icon. <see cref="DatePickerInputMode.Segments"/> = 3 numeric
    /// segments + calendar icon. Default Field.</summary>
    [Parameter] public DatePickerInputMode InputMode { get; set; } = DatePickerInputMode.Field;

    /// <summary>Override the clinic's default date format. Pass null (default) to use
    /// <see cref="IDateFormatService.GetClinicDateFormat"/>. e.g., "DD/MM/YYYY", "MM/DD/YYYY",
    /// "YYYY-MM-DD". See spec doc 01.5 for the full token vocabulary.</summary>
    [Parameter] public string? Format { get; set; }

    /// <summary>Earliest selectable date (inclusive). Cells before this are disabled.
    /// Year dropdown range is clamped to MinDate.Year..MaxDate.Year if both set.</summary>
    [Parameter] public DateOnly? MinDate { get; set; }

    /// <summary>Latest selectable date (inclusive). Cells after this are disabled.</summary>
    [Parameter] public DateOnly? MaxDate { get; set; }

    /// <summary>Custom predicate: return false for dates that should NOT be selectable.
    /// Disabled cells render with strikethrough + grayed out. JUDGMENT: predicate is
    /// invoked once per visible cell (max 42 per render) — keep it cheap.</summary>
    [Parameter] public Func<DateOnly, bool>? IsDateAllowed { get; set; }

    /// <summary>Predicate: return true for dates that are blackout (e.g., holidays,
    /// outage windows). Renders cell with disabled styling + tooltip. Different from
    /// <see cref="IsDateAllowed"/> — IsDateAllowed=false implies "this date doesn't
    /// satisfy the constraint"; IsDateDisabled=true implies "this date is temporarily
    /// unavailable for an explainable reason".</summary>
    [Parameter] public Func<DateOnly, bool>? IsDateDisabled { get; set; }

    /// <summary>Companion to <see cref="IsDateDisabled"/>. Returns the human-readable
    /// reason shown on hover. If null/empty/whitespace, falls back to "Date unavailable"
    /// (Flag 6 A6 lock — never show empty tooltip on a disabled date).</summary>
    [Parameter] public Func<DateOnly, string?>? GetDisabledReason { get; set; }

    // ==========================================================================
    // INPUTBASE OVERRIDES
    // ==========================================================================

    protected override string ComponentIdPrefix => "dp";
    protected override string ComponentTypeName => "LipiDatePicker";
    protected override bool IsEmpty => !CurrentValue.HasValue;

    /// <summary>Parse user-typed input into DateOnly?. Used when CurrentValueAsString is set.
    /// Defers to <see cref="IDateFormatService.ParseDate"/> which handles the format library.
    /// Then validates against the same disable predicates as the calendar grid
    /// (MinDate / MaxDate / IsDateAllowed / IsDateDisabled) so typed input cannot
    /// bypass constraints that prevent cell clicks. The disable predicates are the
    /// SINGLE SOURCE OF TRUTH for "is this date acceptable" — invoked from typed
    /// commits, segment commits, calendar cell clicks, Today button, and any
    /// programmatic CurrentValue assignment that goes through this method.</summary>
    protected override bool TryParseValueFromString(
        string? value,
        out DateOnly? result,
        out string validationErrorMessage)
    {
        validationErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            result = null;
            return true;
        }

        var parsed = DateFormat.ParseDate(value, _resolvedFormat);
        if (!parsed.HasValue)
        {
            result = null;
            validationErrorMessage = $"The {DisplayName ?? FieldIdentifier.FieldName} field must be a valid date in format {_resolvedFormat}.";
            return false;
        }

        // Issue 1 fix: validate against the same predicates that govern cell-disable
        // in the popover. Without this, a user could type a date that the calendar
        // refuses to let them click — defeating the constraint.
        if (IsCellDisabled(parsed.Value))
        {
            result = null;
            // Use the same human-readable reason the calendar tooltip would show.
            // Falls back to "Date unavailable" via GetCellDisabledReason's own fallback.
            var reason = GetCellDisabledReason(parsed.Value) ?? "Date unavailable";
            validationErrorMessage = reason;
            return false;
        }

        result = parsed.Value;
        return true;
    }

    /// <summary>Format DateOnly? for display in the field.</summary>
    protected override string FormatValueAsString(DateOnly? value)
    {
        return value.HasValue
            ? DateFormat.FormatDate(value.Value, _resolvedFormat)
            : string.Empty;
    }

    // ==========================================================================
    // INTERNAL STATE
    // ==========================================================================

    private ElementReference _wrapperRef;
    private ElementReference _anchorRef;
    private ElementReference _popoverRef;
    private ElementReference[] _segmentRefs = Array.Empty<ElementReference>();
    private DotNetObjectReference<LipiDatePicker>? _dotNetRef;  // for OnOutsideClick JSInvokable

    private bool _isPopoverOpen;
    private DateOnly _displayMonth = DateOnly.FromDateTime(DateTime.Today);  // which month the calendar shows
    private DateOnly? _highlightedDate;  // for keyboard navigation
    private string _resolvedFormat = "DD/MM/YYYY";
    private List<string> _segmentOrder = new() { "DD", "MM", "YYYY" };
    private string[] _segmentValues = new[] { string.Empty, string.Empty, string.Empty };
    private DayOfWeek[] _dowOrder = new DayOfWeek[7];
    private List<int> _yearRange = new();
    private string _fieldText = string.Empty;
    private bool _suppressValueRoundTrip;  // prevent OnParametersSet from clobbering mid-typing

    // ==========================================================================
    // LIFECYCLE
    // ==========================================================================

    protected override void OnParametersSet()
    {
        base.OnParametersSet();

        _resolvedFormat = Format ?? DateFormat.GetClinicDateFormat();
        _segmentOrder = DateFormat.GetSegmentOrder(_resolvedFormat);

        // Resize segment refs array if order changed
        if (_segmentRefs.Length != _segmentOrder.Count)
        {
            _segmentRefs = new ElementReference[_segmentOrder.Count];
            _segmentValues = new string[_segmentOrder.Count];
        }

        // Build year range from MinDate/MaxDate or use a sensible default ±50 years from today
        var todayYear = DateTime.Today.Year;
        var minYear = MinDate?.Year ?? (todayYear - 50);
        var maxYear = MaxDate?.Year ?? (todayYear + 50);
        if (maxYear < minYear) maxYear = minYear;
        _yearRange = Enumerable.Range(minYear, maxYear - minYear + 1).ToList();

        // Compute DOW order based on clinic week start
        var weekStart = DateFormat.GetClinicWeekStart();
        for (var i = 0; i < 7; i++)
        {
            _dowOrder[i] = (DayOfWeek)(((int)weekStart + i) % 7);
        }

        // Sync field text and segment values from CurrentValue when not mid-edit
        if (!_suppressValueRoundTrip)
        {
            SyncDisplayFromValue();
        }
    }

    private void SyncDisplayFromValue()
    {
        if (CurrentValue.HasValue)
        {
            var v = CurrentValue.Value;
            _fieldText = DateFormat.FormatDate(v, _resolvedFormat);
            for (var i = 0; i < _segmentOrder.Count; i++)
            {
                _segmentValues[i] = SegmentValueFromDate(v, _segmentOrder[i]);
            }
        }
        else
        {
            _fieldText = string.Empty;
            for (var i = 0; i < _segmentValues.Length; i++) _segmentValues[i] = string.Empty;
        }
    }

    private static string SegmentValueFromDate(DateOnly d, string token) => token switch
    {
        "DD"   => d.Day.ToString("D2", CultureInfo.InvariantCulture),
        "MM"   => d.Month.ToString("D2", CultureInfo.InvariantCulture),
        "YY"   => (d.Year % 100).ToString("D2", CultureInfo.InvariantCulture),
        "YYYY" => d.Year.ToString("D4", CultureInfo.InvariantCulture),
        _      => string.Empty,
    };

    // ==========================================================================
    // FIELD-MODE EVENT HANDLERS (InputMode=Field)
    // ==========================================================================

    private void HandleFieldInput(ChangeEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        _fieldText = e.Value?.ToString() ?? string.Empty;
        _suppressValueRoundTrip = true;
        // Don't commit until blur — partial date strings are not yet valid
    }

    private void HandleFieldBlur()
    {
        if (Disabled || ReadOnly) { _suppressValueRoundTrip = false; return; }

        // Mark touched + commit the typed text. Both branches route through
        // CurrentValueAsString so InputBase clears any stale parse errors —
        // the empty-string branch handles the "user deleted everything" case.
        if (string.IsNullOrWhiteSpace(_fieldText))
        {
            CurrentValueAsString = string.Empty;
        }
        else
        {
            // CurrentValueAsString runs TryParseValueFromString → publishes via EditContext
            CurrentValueAsString = _fieldText;
            // After parse, re-format to canonical (e.g., "7/5/2026" → "07/05/2026")
            if (CurrentValue.HasValue)
            {
                _fieldText = DateFormat.FormatDate(CurrentValue.Value, _resolvedFormat);
            }
        }

        _suppressValueRoundTrip = false;
        MarkFieldAsTouched();  // base method — marks _isTouched, fires NotifyFieldChanged
    }

    private async Task HandleFieldKeyDown(KeyboardEventArgs e)
    {
        if (Disabled || ReadOnly) return;
        // Down arrow opens the popover from the field (WAI-ARIA combobox-like)
        if (e.Key == "ArrowDown" || e.Key == "Down")
        {
            await OpenPopoverAsync();
        }
    }

    // ==========================================================================
    // SEGMENTS-MODE EVENT HANDLERS (InputMode=Segments)
    // ==========================================================================

    private async Task HandleSegmentInput(ChangeEventArgs e, int idx)
    {
        if (Disabled || ReadOnly) return;
        var raw = e.Value?.ToString() ?? string.Empty;
        // Numeric-only filter
        var filtered = new string(raw.Where(char.IsDigit).ToArray());
        var maxLen = TokenMaxLength(_segmentOrder[idx]);
        if (filtered.Length > maxLen) filtered = filtered.Substring(0, maxLen);

        // Issue 2 fix — γ smart auto-advance (Flag 6 / F2 lock).
        // If a single-digit input cannot lead to any valid 2-digit completion,
        // pad with leading zero and advance focus immediately. The intent is
        // unambiguous: typing "5" in DD position can only mean day-05, not
        // day-50, so we don't make the user type the leading 0 explicitly.
        // Tokens that don't smart-advance (YY, YYYY) fall through to the
        // existing maxLen-only auto-advance.
        var token = _segmentOrder[idx];
        var smartAdvanced = false;
        if (filtered.Length == 1)
        {
            var d = filtered[0] - '0';
            var unambiguous = (token == "DD" && d >= 4)   // 40-99 invalid for day
                           || (token == "MM" && d >= 2);  // 20-99 invalid for month
            if (unambiguous)
            {
                filtered = "0" + filtered;
                smartAdvanced = true;
            }
        }

        _segmentValues[idx] = filtered;
        _suppressValueRoundTrip = true;

        // Auto-advance: at maxLen OR after smart-pad, focus next segment
        // (γ smart auto-advance lock — Flag 6 / F2 correction)
        var atMaxLen = filtered.Length == maxLen;
        if ((atMaxLen || smartAdvanced) && idx < _segmentOrder.Count - 1)
        {
            try
            {
                await JS.InvokeVoidAsync("lipiDatePicker.focusElement", _segmentRefs[idx + 1]);
            }
            catch (Exception) { /* circuit may be detached; ignore */ }
        }
    }

    private void HandleSegmentBlur()
    {
        if (Disabled || ReadOnly) { _suppressValueRoundTrip = false; return; }

        // Try to assemble a complete date from all 3 segments. If any segment empty
        // OR the assembled date is invalid, current value goes null (or stays the
        // last successfully parsed value — JUDGMENT: prefer null on incomplete input
        // so EditContext flags Required+null correctly).
        var assembled = TryAssembleFromSegments();
        if (assembled.HasValue)
        {
            // Issue 3 fix + Issue 1 alignment: route through CurrentValueAsString so
            // (a) any stale parsing errors are cleared, and (b) the disable predicates
            // in TryParseValueFromString validate the assembled value uniformly.
            var formatted = DateFormat.FormatDate(assembled.Value, _resolvedFormat);
            CurrentValueAsString = formatted;
        }
        else if (_segmentValues.All(string.IsNullOrEmpty))
        {
            CurrentValueAsString = string.Empty;
        }
        // If partial (some empty / parse failed), DO NOT clear CurrentValue — keep
        // the last good value to avoid surprising user with apparent data loss
        // mid-edit. JUDGMENT: matches convention from PatientNew DOB field.

        _suppressValueRoundTrip = false;
        MarkFieldAsTouched();
    }

    private DateOnly? TryAssembleFromSegments()
    {
        if (_segmentValues.Any(string.IsNullOrEmpty)) return null;

        int day = 0, month = 0, year = 0;
        for (var i = 0; i < _segmentOrder.Count; i++)
        {
            if (!int.TryParse(_segmentValues[i], NumberStyles.Integer, CultureInfo.InvariantCulture, out var v))
                return null;
            switch (_segmentOrder[i])
            {
                case "DD":   day = v; break;
                case "MM":   month = v; break;
                case "YY":
                    // 2-digit year: pivot at 50 (00-49 → 2000s, 50-99 → 1900s).
                    // JUDGMENT: Microsoft's TwoDigitYearMax default is 2029 which would
                    // pivot at 30. For DOB and clinical dates, a 50-pivot is more
                    // forgiving — a "DD/MM/YY = 01/01/45" reads as 2045 not 1945 in
                    // most clinical contexts. If ambiguity becomes a problem, expose
                    // a TwoDigitYearPivot parameter.
                    year = v < 50 ? 2000 + v : 1900 + v;
                    break;
                case "YYYY": year = v; break;
            }
        }

        if (year < 1 || month < 1 || month > 12 || day < 1 || day > 31) return null;

        try
        {
            return new DateOnly(year, month, day);
        }
        catch (ArgumentOutOfRangeException)
        {
            return null;  // e.g., February 30
        }
    }

    private async Task HandleSegmentKeyDown(KeyboardEventArgs e, int idx)
    {
        if (Disabled || ReadOnly) return;

        if (e.Key == "ArrowDown" || e.Key == "Down")
        {
            await OpenPopoverAsync();
        }
        // Backspace at empty segment → focus previous segment (JUDGMENT: not in
        // strict design spec but high-value UX consistency with native browser
        // date inputs)
        else if (e.Key == "Backspace" && string.IsNullOrEmpty(_segmentValues[idx]) && idx > 0)
        {
            try
            {
                await JS.InvokeVoidAsync("lipiDatePicker.focusElement", _segmentRefs[idx - 1]);
            }
            catch (Exception) { /* ignore */ }
        }
    }

    // ==========================================================================
    // POPOVER OPEN / CLOSE
    // ==========================================================================

    private string PopoverId => $"{EffectiveId}-popover";

    private async Task HandleIconClick()
    {
        if (Disabled || ReadOnly) return;
        if (_isPopoverOpen) await ClosePopoverAsync();
        else await OpenPopoverAsync();
    }

    private async Task OpenPopoverAsync()
    {
        if (_isPopoverOpen) return;

        // Position popover at the current value's month, or today's month if no value
        if (CurrentValue.HasValue)
        {
            _displayMonth = new DateOnly(CurrentValue.Value.Year, CurrentValue.Value.Month, 1);
            _highlightedDate = CurrentValue.Value;
        }
        else
        {
            var today = DateOnly.FromDateTime(DateTime.Today);
            _displayMonth = new DateOnly(today.Year, today.Month, 1);
            _highlightedDate = today;
        }

        _isPopoverOpen = true;
        StateHasChanged();

        // Defer JS positioning until after the popover is in DOM
        await Task.Yield();

        // Lazy-create the .NET object reference so JS can invoke OnOutsideClick.
        // Disposed in IDisposable.Dispose to prevent leaks if circuit closes
        // while popover is open.
        _dotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            await JS.InvokeVoidAsync("lipiDatePicker.positionPopover", _anchorRef, _popoverRef);
            await JS.InvokeVoidAsync("lipiDatePicker.attachReposition", _anchorRef, _popoverRef);
            // Issue 1 fix: outside-click dismisses popover (mousedown listener on document).
            await JS.InvokeVoidAsync("lipiDatePicker.attachOutsideClick", _wrapperRef, _dotNetRef);
            // Issue 2 fix: trap PageUp/PageDown/Home/End/Arrows on popover so they
            // don't scroll the page while user is keyboard-navigating the calendar.
            await JS.InvokeVoidAsync("lipiDatePicker.attachKeyboardTrap", _popoverRef);
            await JS.InvokeVoidAsync("lipiDatePicker.focusElement", _popoverRef);
        }
        catch (Exception) { /* circuit may be detached on rapid open/close; ignore */ }
    }

    private async Task ClosePopoverAsync()
    {
        if (!_isPopoverOpen) return;

        try
        {
            await JS.InvokeVoidAsync("lipiDatePicker.detachReposition", _popoverRef);
            await JS.InvokeVoidAsync("lipiDatePicker.detachOutsideClick", _wrapperRef);
            await JS.InvokeVoidAsync("lipiDatePicker.detachKeyboardTrap", _popoverRef);
        }
        catch (Exception) { /* ignore */ }

        _isPopoverOpen = false;
        StateHasChanged();
    }

    /// <summary>JS-invoked when user mousedowns outside the wrapper while the popover
    /// is open. Closes the popover. Issue 1 fix.</summary>
    [JSInvokable]
    public async Task OnOutsideClick()
    {
        if (!_isPopoverOpen) return;
        await ClosePopoverAsync();
        StateHasChanged();
    }

    public void Dispose()
    {
        // Disposes the DotNetObjectReference if it was created. Detaches any
        // still-attached JS listeners as a safety net (normally ClosePopoverAsync
        // detaches on close, but if disposal happens while popover is open
        // — e.g., parent component unmount mid-interaction — we want to clean up).
        if (_dotNetRef is not null)
        {
            try
            {
                // Best-effort detach — JS may already be unreachable.
                _ = JS.InvokeVoidAsync("lipiDatePicker.detachReposition", _popoverRef).AsTask();
                _ = JS.InvokeVoidAsync("lipiDatePicker.detachOutsideClick", _wrapperRef).AsTask();
                _ = JS.InvokeVoidAsync("lipiDatePicker.detachKeyboardTrap", _popoverRef).AsTask();
            }
            catch (Exception) { /* circuit detached; ignore */ }
            _dotNetRef.Dispose();
            _dotNetRef = null;
        }
    }

    // ==========================================================================
    // POPOVER NAVIGATION (month + year dropdowns, prev/next arrows)
    // ==========================================================================

    private void HandlePrevMonth()
    {
        var first = new DateTime(_displayMonth.Year, _displayMonth.Month, 1).AddMonths(-1);
        _displayMonth = new DateOnly(first.Year, first.Month, 1);
    }

    private void HandleNextMonth()
    {
        var first = new DateTime(_displayMonth.Year, _displayMonth.Month, 1).AddMonths(1);
        _displayMonth = new DateOnly(first.Year, first.Month, 1);
    }

    private void HandleMonthChange(ChangeEventArgs e)
    {
        if (e.Value is null) return;
        if (int.TryParse(e.Value.ToString(), out var m) && m >= 1 && m <= 12)
        {
            _displayMonth = new DateOnly(_displayMonth.Year, m, 1);
        }
    }

    private void HandleYearChange(ChangeEventArgs e)
    {
        if (e.Value is null) return;
        if (int.TryParse(e.Value.ToString(), out var y))
        {
            // Defensive: clamp month if new year + month combo doesn't have enough days
            // (e.g., Feb 29 → switching to non-leap year). Keep month, day clamped to
            // 1 since _displayMonth uses day=1.
            _displayMonth = new DateOnly(y, _displayMonth.Month, 1);
        }
    }

    // ==========================================================================
    // CELL CLICK + COMMIT
    // ==========================================================================

    private async Task HandleCellClick(DateOnly date)
    {
        if (IsCellDisabled(date)) return;

        // Issue 3 fix: route through CurrentValueAsString (not CurrentValue =) so
        // InputBase's internal _parsingValidationMessages — populated by any prior
        // failed type attempt — gets cleared. Setting CurrentValue directly bypasses
        // this clearing and leaves stale parse errors in the helper slot.
        // Round-tripping through TryParseValueFromString costs an extra parse but
        // ensures parse-error state and field-value state stay in sync.
        var formatted = DateFormat.FormatDate(date, _resolvedFormat);
        _suppressValueRoundTrip = true;
        CurrentValueAsString = formatted;
        _suppressValueRoundTrip = false;
        SyncDisplayFromValue();

        await ClosePopoverAsync();
        MarkFieldAsTouched();  // mark touched
    }

    private async Task HandleTodayClick()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        if (IsCellDisabled(today))
        {
            // JUDGMENT: if today is disabled (e.g., holiday blackout), Today button
            // is no-op rather than throwing or clearing. User sees no change; the
            // disabled cell shows the reason on hover.
            return;
        }
        await HandleCellClick(today);
    }

    private async Task HandleClearClick()
    {
        // Issue 3 fix: route clearing through CurrentValueAsString = "" instead of
        // CurrentValue = null. The empty-string path goes through TryParseValueFromString
        // (which returns true with result=null for whitespace), clearing any stale
        // _parsingValidationMessages from a prior failed type attempt.
        _suppressValueRoundTrip = true;
        CurrentValueAsString = string.Empty;
        _suppressValueRoundTrip = false;
        SyncDisplayFromValue();
        await Task.CompletedTask;
        MarkFieldAsTouched();
    }

    // ==========================================================================
    // POPOVER KEYBOARD (full WAI-ARIA pattern, B5 lock)
    // ==========================================================================

    private async Task HandlePopoverKeyDown(KeyboardEventArgs e)
    {
        if (!_highlightedDate.HasValue) return;
        var h = _highlightedDate.Value;
        DateOnly? newH = null;
        var handled = false;

        switch (e.Key)
        {
            case "ArrowLeft":
                newH = h.AddDays(-1); handled = true; break;
            case "ArrowRight":
                newH = h.AddDays(1); handled = true; break;
            case "ArrowUp":
                newH = h.AddDays(-7); handled = true; break;
            case "ArrowDown":
                newH = h.AddDays(7); handled = true; break;
            case "PageUp":
                newH = e.ShiftKey ? AddYears(h, -1) : AddMonths(h, -1);
                handled = true; break;
            case "PageDown":
                newH = e.ShiftKey ? AddYears(h, 1) : AddMonths(h, 1);
                handled = true; break;
            case "Home":
                if (e.CtrlKey) newH = new DateOnly(h.Year, h.Month, 1);
                else
                {
                    var weekStart = DateFormat.GetClinicWeekStart();
                    var diff = ((int)h.DayOfWeek - (int)weekStart + 7) % 7;
                    newH = h.AddDays(-diff);
                }
                handled = true; break;
            case "End":
                if (e.CtrlKey) newH = new DateOnly(h.Year, h.Month, DateTime.DaysInMonth(h.Year, h.Month));
                else
                {
                    var weekStart = DateFormat.GetClinicWeekStart();
                    var diff = ((int)h.DayOfWeek - (int)weekStart + 7) % 7;
                    newH = h.AddDays(6 - diff);
                }
                handled = true; break;
            case "Enter":
            case " ":
                if (!IsCellDisabled(h))
                {
                    await HandleCellClick(h);
                }
                handled = true; break;
            case "Escape":
                await ClosePopoverAsync();
                handled = true; break;
        }

        if (handled && newH.HasValue)
        {
            // Clamp to MinDate/MaxDate
            if (MinDate.HasValue && newH.Value < MinDate.Value) newH = MinDate.Value;
            if (MaxDate.HasValue && newH.Value > MaxDate.Value) newH = MaxDate.Value;
            _highlightedDate = newH;
            // If new highlight is outside current display month, advance display month
            if (newH.Value.Year != _displayMonth.Year || newH.Value.Month != _displayMonth.Month)
            {
                _displayMonth = new DateOnly(newH.Value.Year, newH.Value.Month, 1);
            }
        }
    }

    private static DateOnly AddMonths(DateOnly d, int months)
    {
        var dt = new DateTime(d.Year, d.Month, d.Day).AddMonths(months);
        return DateOnly.FromDateTime(dt);
    }

    private static DateOnly AddYears(DateOnly d, int years)
    {
        var dt = new DateTime(d.Year, d.Month, d.Day).AddYears(years);
        return DateOnly.FromDateTime(dt);
    }

    // ==========================================================================
    // CELL DISABLED LOGIC (combines all 3 disable-source predicates)
    // ==========================================================================

    private bool IsCellDisabled(DateOnly date)
    {
        if (MinDate.HasValue && date < MinDate.Value) return true;
        if (MaxDate.HasValue && date > MaxDate.Value) return true;
        if (IsDateAllowed is not null && !IsDateAllowed(date)) return true;
        if (IsDateDisabled is not null && IsDateDisabled(date)) return true;
        return false;
    }

    private string? GetCellDisabledReason(DateOnly date)
    {
        // IsDateDisabled takes precedence for tooltip — it's the predicate that
        // pairs with GetDisabledReason for human-readable explanations.
        // IsDateAllowed = false renders generic "Date unavailable".
        // MinDate/MaxDate violations render generic too.
        if (IsDateDisabled is not null && IsDateDisabled(date))
        {
            var reason = GetDisabledReason?.Invoke(date);
            if (!string.IsNullOrWhiteSpace(reason)) return reason;
            return "Date unavailable";  // Flag 6 A6 fallback lock
        }

        if (MinDate.HasValue && date < MinDate.Value)
            return $"Earliest allowed: {DateFormat.FormatDate(MinDate.Value, _resolvedFormat)}";
        if (MaxDate.HasValue && date > MaxDate.Value)
            return $"Latest allowed: {DateFormat.FormatDate(MaxDate.Value, _resolvedFormat)}";
        if (IsDateAllowed is not null && !IsDateAllowed(date))
            return "Date unavailable";

        return null;
    }

    // ==========================================================================
    // CSS HELPERS
    // ==========================================================================

    private string CssClasses
    {
        get
        {
            var classes = new List<string>
            {
                $"lipi-input-{Size.ToString().ToLowerInvariant()}",
                $"lipi-input-state-{StateCssToken(ResolvedState)}"
            };
            if (IsEmpty) classes.Add("lipi-input-empty");
            if (Required && IsEmpty && ResolvedState == InputState.Default
                && EffectiveRequiredStyle == LiPi.Web.Components.Shared.RequiredVisualStyle.ApricotTint)
            {
                classes.Add("lipi-input-state-required-empty");
            }
            classes.Add($"lipi-datepicker-mode-{InputMode.ToString().ToLowerInvariant()}");
            return string.Join(" ", classes);
        }
    }

    private string CellClass(bool isOtherMonth, bool isToday, bool isSelected, bool isDisabled, bool isHighlighted)
    {
        var classes = new List<string> { "lipi-datepicker-day-cell" };
        if (isOtherMonth)  classes.Add("lipi-datepicker-day-cell-other-month");
        if (isToday)       classes.Add("lipi-datepicker-day-cell-today");
        if (isSelected)    classes.Add("lipi-datepicker-day-cell-selected");
        if (isDisabled)    classes.Add("lipi-datepicker-day-cell-disabled");
        if (isHighlighted) classes.Add("lipi-datepicker-day-cell-highlighted");
        return string.Join(" ", classes);
    }

    // ==========================================================================
    // SEGMENT HELPERS
    // ==========================================================================

    private static int TokenMaxLength(string token) => token switch
    {
        "DD" => 2, "MM" => 2, "YY" => 2, "YYYY" => 4, _ => 2
    };

    private static string TokenPlaceholder(string token) => token switch
    {
        "DD" => "DD", "MM" => "MM", "YY" => "YY", "YYYY" => "YYYY", _ => string.Empty
    };

    private static string TokenWidth(string token) => token switch
    {
        "DD" => "32px", "MM" => "32px", "YY" => "32px", "YYYY" => "48px", _ => "32px"
    };

    private static string SegmentAriaLabel(string token) => token switch
    {
        "DD" => "Day", "MM" => "Month", "YY" => "Year (2-digit)", "YYYY" => "Year", _ => token
    };

    private string SegmentSeparator
    {
        get
        {
            // Pull the first non-token character from the format. JUDGMENT: simple
            // approach — formats use single-character separators, which is true for
            // all 12 supported format combinations.
            foreach (var ch in _resolvedFormat)
            {
                if (!char.IsLetter(ch)) return ch.ToString();
            }
            return "/";
        }
    }

    // ==========================================================================
    // DOW DISPLAY
    // ==========================================================================

    private static string DayShort(DayOfWeek dow) => dow switch
    {
        DayOfWeek.Sunday    => "Sun",
        DayOfWeek.Monday    => "Mon",
        DayOfWeek.Tuesday   => "Tue",
        DayOfWeek.Wednesday => "Wed",
        DayOfWeek.Thursday  => "Thu",
        DayOfWeek.Friday    => "Fri",
        DayOfWeek.Saturday  => "Sat",
        _                   => dow.ToString().Substring(0, 3),
    };
}
