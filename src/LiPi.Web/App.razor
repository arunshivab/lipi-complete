@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using LiPi.Web.Components.Theme

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LiPi - HIPAA Compliant Healthcare Information System</title>
    <base href="/" />
    <meta name="description" content="LiPi: Enterprise multi-tenant SaaS Hospital Information System (HIS) with HIPAA, DPDP, ABDM, and Six Sigma compliance.">
    <meta name="theme-color" content="#06b6d4">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect fill='%2306b6d4' width='180' height='180'/><text x='50%25' y='50%25' font-size='100' font-weight='bold' fill='white' text-anchor='middle' dominant-baseline='middle'>L</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    @*
        CSS CASCADE ORDER — Decision #12 §12.4 (SPEC: 00.2-THEMING-ARCHITECTURE.md)
        1. 00-baseline.css — structural tokens
        2. Existing layout/module CSS
        3. Theme: brand → mode-light → mode-dark
        4. admin.css (Phase 1-2 Modified Big Bang; removed Phase 3)
        5. lipi-inputs.css — Phase 2.2 Batch 3 shared input-family base styles
        6. Blazor CSS Isolation bundle (LiPi.Web.styles.css)

        Version bumped 20260509 → 20260510 for cache busting on Phase 2.2 Batch 5.4 deploy.
        Bug fix: LipiSelect size rules in lipi-inputs.css used descendant selectors
        ".lipi-input-medium .lipi-input-select .lipi-input-field" — but both classes are
        on the same wrapper element, so the rule never matched. Changed to compound-class
        ".lipi-input-medium.lipi-input-select .lipi-input-field" (no space between first
        two). Same fix applied to disabled/readonly cursor rules. Pre-fix LipiSelect field
        rendered at ~17.6px (natural content height); post-fix renders at 28/32/40px.
    *@

    <link rel="stylesheet" href="css/00-baseline.css?v=20260510" />
    <link rel="stylesheet" href="css/app.css?v=20260510" />
    <link rel="stylesheet" href="css/dashboard.css?v=20260510" />
    <link rel="stylesheet" href="themes/brand-lipi.css?v=20260510" />
    <link rel="stylesheet" href="themes/mode-light.css?v=20260510" />
    <link rel="stylesheet" href="themes/mode-dark.css?v=20260510" />
    <link rel="stylesheet" href="css/admin.css?v=20260510" />
    <link rel="stylesheet" href="css/lipi-inputs.css?v=20260510" />
    <link rel="stylesheet" href="LiPi.Web.styles.css" />

    <style>
        .loading-spinner {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
            height: 50px;
            border: 4px solid rgba(6, 182, 212, 0.2);
            border-top-color: #06b6d4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@keyframes spin {
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }
    </style>

    @*
        FOUC PREVENTION — MUST be blocking script (no async/defer), MUST be in <head>.
        Runs before browser paints content.
    *@
    <script src="js/theme-switcher.js?v=20260510"></script>

    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    <CascadingAuthenticationState>
        <ThemeProvider>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LiPi.Web.Components.MainLayout)">
                        <NotAuthorized>
                            <LiPi.Web.Components.RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Not Found</PageTitle>
                    <LayoutView Layout="@typeof(LiPi.Web.Components.MainLayout)">
                        <div class="container text-center mt-5">
                            <h1>Page Not Found</h1>
                            <p>The page you're looking for doesn't exist.</p>
                            <a href="/" class="btn btn-primary">Go Home</a>
                        </div>
                    </LayoutView>
                </NotFound>
            </Router>
        </ThemeProvider>
    </CascadingAuthenticationState>

    @* Body scripts — order preserved; theme-switcher.js is in <head>, not here.
       Cache version added to ALL JS scripts in this batch — previously only CSS was versioned. *@
    <script src="js/lipi-login.js?v=20260510"></script>
    <script src="js/lipi-topnav.js?v=20260510"></script>
    <script src="js/lipi-shortcuts.js?v=20260510"></script>

    @* Phase 2.2: input family helpers (autogrow Batch 3, selectAll Batch 4).
       Loaded BEFORE blazor.web.js so window.lipiInput is available when components first render. *@
    <script src="js/lipi-input.js?v=20260510"></script>

    <script src="_framework/blazor.web.js"></script>
</body>
</html>
