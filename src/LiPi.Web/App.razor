@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Web
@using LiPi.Web.Components.Theme

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LiPi - HIPAA Compliant Healthcare Information System</title>
    <base href="/" />
    <meta name="description" content="LiPi: Enterprise multi-tenant SaaS Hospital Information System (HIS) with HIPAA, DPDP, ABDM, and Six Sigma compliance.">
    <meta name="theme-color" content="#06b6d4">
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate">
    <link rel="apple-touch-icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 180 180'><rect fill='%2306b6d4' width='180' height='180'/><text x='50%25' y='50%25' font-size='100' font-weight='bold' fill='white' text-anchor='middle' dominant-baseline='middle'>L</text></svg>">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500;600;700&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">

    @*
        CSS CASCADE ORDER — Decision #12 §12.4 (SPEC: 00.2-THEMING-ARCHITECTURE.md)
        1. 00-baseline.css — structural tokens (radius, spacing, typography, layout) — Phase 2.0
        2. Existing layout/module CSS (unchanged during Phase 1-2 Modified Big Bang)
        3. Theme: brand → mode-light → mode-dark (both mode files loaded; data-mode attr activates one)
        4. admin.css stays during Phase 1-2; removed in Phase 3 after theme tokens verified
        5. Blazor CSS Isolation bundle (LiPi.Web.styles.css) — auto-generated from *.razor.css files,
           loaded LAST so isolation styles win specificity battles. Required for Phase 2.0+ component
           styles to apply (e.g., StyleGuide.razor.css for /admin/style-guide).

        Version bumped 20260502 → 20260503 for CSS cache busting (Phase 2.0 deploy).
    *@

    @* Phase 2.0: Structural foundation tokens — MUST load FIRST so other files can reference --r-sm, --sp-md, etc. *@
    <link rel="stylesheet" href="css/00-baseline.css?v=20260503" />

    <link rel="stylesheet" href="css/app.css?v=20260503" />
    <link rel="stylesheet" href="css/dashboard.css?v=20260503" />

    @* Theme CSS — Decision #12, populated in Phase 2.0 with full token values *@
    <link rel="stylesheet" href="themes/brand-lipi.css?v=20260503" />
    <link rel="stylesheet" href="themes/mode-light.css?v=20260503" />
    <link rel="stylesheet" href="themes/mode-dark.css?v=20260503" />

    @* admin.css: Modified Big Bang — stays loaded until Phase 3 *@
    <link rel="stylesheet" href="css/admin.css?v=20260503" />

    @*
        Phase 2.0 INFRASTRUCTURE FIX (2026-05-03):
        Blazor CSS Isolation bundle. Auto-generated from all *.razor.css files in the project
        (StyleGuide.razor.css, future LipiButton.razor.css, etc.). Served via static-file
        middleware from obj/Debug/net10.0/scopedcss/bundle/LiPi.Web.styles.css.

        Was missing from App.razor since project inception — never noticed because no page
        used CSS Isolation until StyleGuide.razor in Phase 2.0. Adding now unblocks the
        entire component library going forward.

        Loaded LAST in cascade — isolation rules use scope attributes ([b-abc123]) for natural
        specificity, but final-position guarantees they beat any unscoped admin.css rules.
    *@
    <link rel="stylesheet" href="LiPi.Web.styles.css" />

    <style>
        .loading-spinner {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
            height: 50px;
            border: 4px solid rgba(6, 182, 212, 0.2);
            border-top-color: #06b6d4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@keyframes spin {
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }
    </style>

    @*
        FOUC PREVENTION — MUST be blocking script (no async/defer), MUST be in <head>.
        Runs before browser paints content. Reads cookies, applies data-brand + data-mode
        to <html> immediately. See wwwroot/js/theme-switcher.js.
        Provides window.lipiTheme.apply(brand, mode) for ThemeProvider.razor interop.
    *@
    <script src="js/theme-switcher.js"></script>

    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    <CascadingAuthenticationState>
        @*
            ThemeProvider wraps Router — Decision #12 §12.4
            Cascades:
              CascadingValue<ThemeContext>  Name="CurrentTheme" (IsFixed=false) — data
              CascadingValue<ThemeProvider> Name="ThemeProvider" (IsFixed=true)  — actions
            Blazor Rule #6: CascadingAuthenticationState stays outermost. ThemeProvider inside.
            ThemeProvider has @rendermode InteractiveServer — all pages inherit this circuit.
        *@
        <ThemeProvider>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LiPi.Web.Components.MainLayout)">
                        <NotAuthorized>
                            <LiPi.Web.Components.RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Not Found</PageTitle>
                    <LayoutView Layout="@typeof(LiPi.Web.Components.MainLayout)">
                        <div class="container text-center mt-5">
                            <h1>Page Not Found</h1>
                            <p>The page you're looking for doesn't exist.</p>
                            <a href="/" class="btn btn-primary">Go Home</a>
                        </div>
                    </LayoutView>
                </NotFound>
            </Router>
        </ThemeProvider>
    </CascadingAuthenticationState>

    @* Body scripts — order preserved; theme-switcher.js is in <head>, not here *@
    <script src="js/lipi-login.js"></script>
    <script src="js/lipi-topnav.js"></script>
    <script src="js/lipi-shortcuts.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
