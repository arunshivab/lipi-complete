    <style>
        .loading-spinner {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 50px;
            height: 50px;
            border: 4px solid rgba(6, 182, 212, 0.2);
            border-top-color: #06b6d4;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }
        @@keyframes spin {
            to { transform: translate(-50%, -50%) rotate(360deg); }
        }
    </style>
    @*
        FOUC PREVENTION — MUST be blocking script (no async/defer), MUST be in <head>.
        Runs before browser paints content.
    *@
    <script src="js/theme-switcher.js?v=20260540"></script>
    <HeadOutlet @rendermode="@InteractiveServer" />
</head>
<body>
    @* CRITICAL: <CascadingAuthenticationState> wrapper required for SSR
       prerender + interactive circuit auth flow. Do not remove — removal
       breaks authentication on initial page load. See
       docs/00-PROJECT-BASELINE.md §Development & Debugging. *@
    <CascadingAuthenticationState>
        <ThemeProvider>
            <Router AppAssembly="@typeof(App).Assembly">
                <Found Context="routeData">
                    <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(LiPi.Web.Components.MainLayout)">
                        <NotAuthorized>
                            <LiPi.Web.Components.RedirectToLogin />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                    <FocusOnNavigate RouteData="@routeData" Selector="h1" />
                </Found>
                <NotFound>
                    <PageTitle>Not Found</PageTitle>
                    <LayoutView Layout="@typeof(LiPi.Web.Components.MainLayout)">
                        <div class="container text-center mt-5">
                            <h1>Page Not Found</h1>
                            <p>The page you're looking for doesn't exist.</p>
                            <a href="/" class="btn btn-primary">Go Home</a>
                        </div>
                    </LayoutView>
                </NotFound>
            </Router>
        </ThemeProvider>
    </CascadingAuthenticationState>
    @* Body scripts — order preserved; theme-switcher.js is in <head>, not here.
       Cache version added to ALL JS scripts in this batch — previously only CSS was versioned. *@
    <script src="js/lipi-login.js?v=20260540"></script>
    <script src="js/lipi-topnav.js?v=20260540"></script>
    <script src="js/lipi-shortcuts.js?v=20260540"></script>
    @* Phase 2.2: input family helpers (autogrow Batch 3, selectAll Batch 4).
       Loaded BEFORE blazor.web.js so window.lipiInput is available when components first render. *@
    <script src="js/lipi-input.js?v=20260540"></script>
    @* Phase 2.6.2: overlay surfaces JS interop (focus trap stack, ghost-click guard,
       body scroll lock with scrollbar compensation, page-inert helper, bfcache pageshow
       reload, document-level Escape listener registration).
       Loaded BEFORE blazor.web.js so window.lipiOverlay is available when overlay
       components (LipiOverlayHost, LipiDrawer) first render. Without this script,
       FocusTrapService / ScrollLockService / setPageInert calls throw JSException
       which is silently swallowed — overlays render but keyboard/scroll behaviors
       degrade silently. *@
    <script src="js/lipi-overlay-interop.js?v=20260540"></script>
    @* Phase 2.7 (A35): validation summary click-to-field interop. Exposes
       window.lipiValidation.scrollToField(fieldId) — used by LipiValidationSummary
       when the user clicks an error in the bulleted list. Loaded BEFORE blazor.web.js
       so window.lipiValidation is available when the summary first renders.
       Failure mode is silent: if the script doesn't load, the summary still shows
       errors, but clicking an item is a no-op. *@
    <script src="js/lipi-validation.js?v=20260540"></script>
    @* Phase 2.8 Stage 3 (A45): LipiTable copy-to-clipboard interop. Exposes
       window.lipiTable.copy(text) — used by LipiTable's hover-copy cell affordance.
       Component-local static web asset shipped inside LiPi.Components (served at
       _content/LiPi.Components/lipi-table.js), so the table is self-contained — no host
       JS dependency. Loaded BEFORE blazor.web.js so window.lipiTable is available when
       the table first renders. Failure mode is silent: if the script doesn't load, the
       copy button is a no-op (the inline "Copied!" flash simply won't fire). *@
    <script src="_content/LiPi.Components/lipi-table.js?v=20260540"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
