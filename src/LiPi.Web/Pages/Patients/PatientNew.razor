                        </div>
                    </div> }
                  @if (m.Payer == _pIns)
                  { <div class="pr-payer-sub"><div class="pr-payer-sub-title">Insurance / TPA</div>
                      <div class="reg-g2" style="margin-bottom:8px">
                        <div class="reg-fg"><label class="reg-lbl" for="pn-ins-co">Insurance Company <span class="reg-req">*</span></label>
                          <input id="pn-ins-co" name="insCompany" autocomplete="off" class="reg-inp" value="@m.InsCo" @oninput="e => m.InsCo=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-tpa">TPA Name</label>
                          <input id="pn-tpa" name="tpaName" autocomplete="off" class="reg-inp" value="@m.TpaName" @oninput="e => m.TpaName=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-pol-n">Policy Number <span class="reg-req">*</span></label>
                          <input id="pn-pol-n" name="policyNumber" autocomplete="off" class="reg-inp" value="@m.PolicyNo" @oninput="e => m.PolicyNo=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-pol-h">Policy Holder Name</label>
                          <input id="pn-pol-h" name="policyHolder" autocomplete="off" class="reg-inp" value="@m.PolHolder" @oninput="e => m.PolHolder=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-pol-r">Holder Relationship</label>
                          <input id="pn-pol-r" name="policyRelation" autocomplete="off" class="reg-inp" value="@m.PolRelation" placeholder="Self / Spouse / Parent" @oninput="e => m.PolRelation=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-cash">Cashless Limit (INR)</label>
                          <input id="pn-cash" name="cashlessLimit" autocomplete="off" class="reg-inp" inputmode="numeric" value="@m.CashlessLimit" @oninput="e => m.CashlessLimit=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-pol-f">Valid From</label>
                          <input id="pn-pol-f" name="policyFrom" type="date" autocomplete="off" class="reg-inp" value="@m.PolFrom" @onchange="e => m.PolFrom=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-pol-t">Valid To</label>
                          <input id="pn-pol-t" name="policyTo" type="date" autocomplete="off" class="reg-inp" value="@m.PolTo" @onchange="e => m.PolTo=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                      </div>
                      <div class="sc-tog-row" style="margin-top:4px">
                        <div><div class="sc-tog-lbl">Pre-authorisation required</div><div class="sc-tog-sub">Notify TPA desk before any procedure</div></div>
                        <div class="sc-toggle @(m.PreAuth?_togOn:_togOff)" @onclick="TgPreAuth"></div>
                      </div>
                    </div> }
                  @if (m.Payer == _pGovt)
                  { <div class="pr-payer-sub"><div class="pr-payer-sub-title">Government Scheme</div>
                      <div class="reg-g2" style="margin-bottom:8px">
                        <div class="reg-fg"><label class="reg-lbl" for="pn-scheme">Scheme <span class="reg-req">*</span></label>
                          <select id="pn-scheme" name="govtScheme" autocomplete="off" class="reg-sel" value="@m.GovtScheme" @onchange="e => m.GovtScheme=e.Value?.ToString()??string.Empty">
                            <option value="">Select…</option><option value="cghs">CGHS</option><option value="echs">ECHS</option>
                            <option value="esic">ESIC</option><option value="pmjay">Ayushman Bharat (PMJAY)</option>
                            <option value="state">State Scheme</option><option value="other">Other</option>
                          </select>                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-bene">Beneficiary / Card No. <span class="reg-req">*</span></label>
                          <input id="pn-bene" name="beneficiaryNo" autocomplete="off" class="reg-inp" value="@m.BeneNo" @oninput="e => m.BeneNo=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-bene-n">Card Holder Name</label>
                          <input id="pn-bene-n" name="beneficiaryName" autocomplete="off" class="reg-inp" value="@m.BeneHolder" @oninput="e => m.BeneHolder=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-bene-r">Holder Relationship</label>
                          <input id="pn-bene-r" name="beneficiaryRel" autocomplete="off" class="reg-inp" value="@m.BeneRelation" placeholder="Self / Dependent" @oninput="e => m.BeneRelation=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-sch-f">Valid From</label>
                          <input id="pn-sch-f" name="schemeFrom" type="date" autocomplete="off" class="reg-inp" value="@m.SchemeFrom" @onchange="e => m.SchemeFrom=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-income">Income Group</label>
                          <select id="pn-income" name="incomeGroup" autocomplete="off" class="reg-sel" value="@m.IncomeGroup" @onchange="e => m.IncomeGroup=e.Value?.ToString()??string.Empty">
                            <option value="">Select…</option><option value="bpl">BPL (Below Poverty Line)</option>
                            <option value="lower">Lower</option><option value="lower_middle">Lower Middle</option>
                            <option value="middle">Middle</option><option value="upper_middle">Upper Middle</option>
                            <option value="upper">Upper</option><option value="unknown">Prefer not to say</option>
                          </select>                            <span class="reg-err">&nbsp;</span>
                          </div>
                      </div>
                    </div> }
                  @if (m.Payer == _pOther)
                  { <div class="pr-payer-sub"><div class="pr-payer-sub-title">Other Payer</div>
                      <div class="reg-g2">
                        <div class="reg-fg"><label class="reg-lbl" for="pn-oth-n">Payer Name <span class="reg-req">*</span></label>
                          <input id="pn-oth-n" name="otherPayerName" autocomplete="off" class="reg-inp" value="@m.OtherPayerName" @oninput="e => m.OtherPayerName=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                        <div class="reg-fg"><label class="reg-lbl" for="pn-oth-r">Contact / Reference</label>
                          <input id="pn-oth-r" name="otherPayerRef" autocomplete="off" class="reg-inp" value="@m.OtherPayerRef" @oninput="e => m.OtherPayerRef=e.Value?.ToString()??string.Empty" />                            <span class="reg-err">&nbsp;</span>
                          </div>
                      </div>
                    </div> }
                </div>
              </div>
            }

            @* TAB 4: Review *@
            @if (_tab == 4)
            {
              <div class="reg-g2" style="gap:10px;margin-bottom:10px">
                <div class="af-card" style="border-left:3px solid #1565C0;margin-bottom:0">
                  <div class="af-card-header"><div class="af-card-num" style="background:#1565C0">1</div><span class="af-card-title">Personal Identity</span></div>
                  <div class="af-card-body" style="font-size:11px">
                    <div class="pr-review-row"><span class="pr-review-key">NAME</span><span class="pr-review-val">@m.DisplayName.ToUpperInvariant()</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">DOB / AGE</span><span class="pr-review-val">@(string.IsNullOrEmpty(m.DateOfBirth)?"":m.DateOfBirth)@(string.IsNullOrEmpty(_ageDisp)?"":" · "+_ageDisp+" YRS")</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">GENDER</span><span class="pr-review-val">@_gender.ToUpperInvariant()</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">BLOOD</span><span class="pr-review-val">@(string.IsNullOrEmpty(m.BloodGroup)?"UNKNOWN":m.BloodGroup.ToUpperInvariant())</span></div>
                  </div>
                </div>
                <div class="af-card" style="border-left:3px solid #00695C;margin-bottom:0">
                  <div class="af-card-header"><div class="af-card-num" style="background:#00695C">2</div><span class="af-card-title">Contact</span></div>
                  <div class="af-card-body" style="font-size:11px">
                    <div class="pr-review-row"><span class="pr-review-key">MOBILE</span><span class="pr-review-val">@(m.MobCC+" "+m.Mobile)</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">EMAIL</span><span class="pr-review-val">@(string.IsNullOrEmpty(m.Email)?"—":m.Email)</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">WHATSAPP</span><span class="pr-review-val">@(string.IsNullOrEmpty(m.WhatsApp)?"Same as mobile":m.WaCC+" "+m.WhatsApp)</span></div>
                  </div>
                </div>
                <div class="af-card" style="border-left:3px solid #6A1B9A;margin-bottom:0">
                  <div class="af-card-header"><div class="af-card-num" style="background:#6A1B9A">3</div><span class="af-card-title">Address</span></div>
                  <div class="af-card-body" style="font-size:11px">
                    <div class="pr-review-row"><span class="pr-review-key">LINE 1</span><span class="pr-review-val">@(string.IsNullOrEmpty(m.AddressLine)?"—":m.AddressLine.ToUpperInvariant())</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">CITY / STATE</span><span class="pr-review-val">@((m.City+", "+m.State).ToUpperInvariant())</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">PINCODE</span><span class="pr-review-val">@m.PinCode</span></div>
                  </div>
                </div>
                <div class="af-card" style="border-left:3px solid #C49A22;margin-bottom:0">
                  <div class="af-card-header"><div class="af-card-num" style="background:#C49A22">4</div><span class="af-card-title">Registration</span></div>
                  <div class="af-card-body" style="font-size:11px">
                    <div class="pr-review-row"><span class="pr-review-key">UHID</span><span class="pr-review-val" style="color:#C49A22">@_uhid</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">TYPE</span><span class="pr-review-val">@m.PatientType.Replace("_"," ").ToUpperInvariant()</span></div>
                    <div class="pr-review-row"><span class="pr-review-key">PAYER</span><span class="pr-review-val">@m.Payer.Replace("_"," ").ToUpperInvariant()</span></div>
                  </div>
                </div>
              </div>
              <div class="af-card" style="border-left:3px solid #10B981;margin-bottom:10px">
                <div class="af-card-header"><div class="af-card-num" style="background:#10B981">5</div><span class="af-card-title">Consent</span></div>
                <div class="af-card-body">
                  @if (_clinicIndia)
                  { <div style="background:#F0FDF4;border:.5px solid #6EE7B7;border-radius:6px;padding:8px 12px;font-size:12px;color:#065F46">
                      ✓ Walk-in registration — implied consent. Patient was informed that health data will be stored securely for their care.
                    </div> }
                  else
                  { <label style="display:flex;align-items:center;gap:8px;font-size:12px;cursor:pointer">
                      <input id="pn-c-hipaa" name="hipaaConsent" type="checkbox" checked="@m.HipaaConsent" @onchange="e => m.HipaaConsent=e.Value is true" />
                      HIPAA / Privacy consent (mandatory for non-India clinics)
                    </label>
                    @if (!m.HipaaConsent) { <div class="reg-err" style="margin-top:4px">HIPAA consent is required.</div> } }
                </div>
              </div>
              @if (_saved)
              { <div style="background:#ECFDF5;border:.5px solid #6EE7B7;border-radius:8px;padding:12px;text-align:center;font-size:13px;color:#065F46;font-weight:500">✓ @_successMsg</div> }
            }

          </fieldset>
        </div>

        @* RIGHT PANEL *@
        <div class="pn-right">
          <div class="pr-patient-card">
            <div class="pr-card-kicker">&#9711; live patient card</div>
            <div class="pr-card-top">
              <div>
                @if (_photoUrl is not null)
                { <div class="pr-card-photo" @onclick="TrigPhoto"><img src="@_photoUrl" alt="photo" /></div> }
                else
                { <div class="pr-card-photo" @onclick="TrigPhoto"><span style="font-size:20px;opacity:.3;color:#fff">&#9786;</span><span class="pr-card-photo-lbl">Photo</span></div> }
                <InputFile id="pn-photo" class="pr-photo-input" OnChange="OnPhoto" accept="image/*" />
              </div>
              <div style="min-width:0;flex:1">
                <div class="pr-card-name">@(string.IsNullOrWhiteSpace(m.DisplayName)?"New patient":m.DisplayName)</div>
                <div class="pr-card-uhid">@_uhid</div>
              </div>
            </div>
            <div class="pr-card-divider"></div>
            <div class="pr-card-row"><span class="pr-card-lbl">Mobile</span><span class="pr-card-val mono">@(string.IsNullOrEmpty(m.Mobile)?"—":m.MobCC+" "+m.Mobile)</span></div>
            <div class="pr-card-row"><span class="pr-card-lbl">Gender</span><span class="pr-card-val">@(string.IsNullOrEmpty(_gender)?"—":_gender)@(string.IsNullOrEmpty(_ageDisp)?"":" · "+_ageDisp+" yrs")</span></div>
            <div class="pr-card-row"><span class="pr-card-lbl">DOB</span><span class="pr-card-val mono">@(string.IsNullOrEmpty(m.DateOfBirth)?"—":m.DateOfBirth)</span></div>
            <div class="pr-card-row"><span class="pr-card-lbl">Address</span><span class="pr-card-val">@(string.IsNullOrEmpty(m.City)?"—":m.City+", "+m.State+" "+m.PinCode)</span></div>
            <div class="pr-card-row"><span class="pr-card-lbl">Payer</span><span class="pr-card-val">@m.Payer.Replace("_"," ")</span></div>
            <div class="pr-card-divider"></div>
            <div class="pr-card-consent">@if(_clinicIndia){<span class="pr-card-consent-ok">Implied consent ✓</span>}else{<span class="@(m.HipaaConsent?_consentOk:_e)">HIPAA @(m.HipaaConsent?"✓":"◌")</span>}</div>
          </div>

          <div class="pn-id-tiles" @onclick="OpenId">
            <div class="pn-id-tile abdm @(_abdmSet?"set-abdm":"")">
              <div class="pn-id-icon abdm"><svg viewBox="0 0 24 24"><path d="M12 2l2 7h7l-5.5 4 2 7L12 16l-5.5 4 2-7L3 9h7z"/></svg></div>
              <span class="pn-id-name">ABDM</span>
              @if (_abdmSet) { <span class="pn-id-disp">@_abdmDisp</span> }
              else { <span class="pn-id-empty">Not added</span> }
            </div>
            <div class="pn-id-tile aadh @(_aadSet?"set-aadh":"")">
              <div class="pn-id-icon aadh"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M7 8h10M7 12h6"/></svg></div>
              <span class="pn-id-name">Aadhaar</span>
              @if (_aadSet) { <span class="pn-id-disp">•••• @m.AadhaarLast4</span> }
              else { <span class="pn-id-empty">Not added</span> }
            </div>
            <div class="pn-id-tile oth @(_othSet?"set-oth":"")">
              <div class="pn-id-icon oth"><svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6"/></svg></div>
              <span class="pn-id-name">Other ID</span>
              @if (_othSet) { <span class="pn-id-disp">@_othDisp</span> }
              else { <span class="pn-id-empty">Not added</span> }
            </div>
          </div>

          <div class="pn-flags-panel">
            <div class="pn-flags-title">Alert Flags</div>
            <div class="pn-flags-wrap">
              <button type="button" class="pn-flag-pill @(m.VipFlag?"pn-flag-vip-on":"")" @onclick="TgVip">
                <div class="pn-flag-pill-dot" style="background:#F59E0B"></div>VIP</button>
              <button type="button" class="pn-flag-pill @(m.Allergy?"pn-flag-al-on":"")" @onclick="TgAl">
                <div class="pn-flag-pill-dot" style="background:#EF4444"></div>Allergies</button>
              <button type="button" class="pn-flag-pill @(m.OrganDonor?"pn-flag-or-on":"")" @onclick="TgOr">
                <div class="pn-flag-pill-dot" style="background:#EC4899"></div>Organ Donor</button>
              <button type="button" class="pn-flag-pill @(m.Research?"pn-flag-res-on":"")" @onclick="TgRes">
                <div class="pn-flag-pill-dot" style="background:#8B5CF6"></div>Research</button>
              <button type="button" class="pn-flag-pill @(m.Intl?"pn-flag-intl-on":"")" @onclick="TgIntl">
                <div class="pn-flag-pill-dot" style="background:#0EA5E9"></div>International</button>
            </div>
          </div>

          <div class="pn-hint">Step @(_tab+1) of 5 · @_hints[Math.Min(_tab,4)]</div>
          <div class="pn-min-note">⚡ Minimum: Name + DOB/Age + Gender + Mobile + PIN</div>
        </div>

      </div>
    </div>
  </div>

</div>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Parameter][SupplyParameterFromQuery(Name="m")] public string? ReturnModule { get; set; }

    private const string _e="", _e2="";
    private const string _consentOk="pr-card-consent-ok";
    private const string _pOn="pr-payer-cat pr-payer-cat-on";
    private const string _ptWalkIn="general";
    private bool _isWalkIn => m.PatientType == _ptWalkIn;
    private const string _pSelf="self", _pCorp="corporate", _pIns="insurance", _pGovt="govt", _pOther="other_payer";
    private const string _togOn="sc-toggle sc-toggle-on", _togOff="sc-toggle";
    private const string _never="not_disclosed";
    private const string _mtOn="pr-mtab pr-mtab-on";
    private const string _kFn="fn",_kLn="ln",_kDob="dob",_kGender="gender";
    private const string _kMob="mob",_kAlt="alt",_kWa="wa",_kEmail="email",_kEmail2="email2";
    private const string _kRefBy="refby";
    private static readonly string[] _tabLabels = { "Identity", "Address", "Socioeconomic", "Reg. Details", "Review" };

    private int    _tab=0;
    private bool   _saving=false, _saved=false;
    private string _successMsg=string.Empty, _errorMsg=string.Empty;
    private string _uhid=string.Empty, _gender=string.Empty;
    private string _ageDisp=string.Empty, _ageNote=string.Empty;
    private string _bmi=string.Empty;
    private bool   _clinicIndia=true;
    private string? _photoUrl;
    private IBrowserFile? _photoFile;
    private bool   _idOpen=false, _dupOpen=false;
    private int    _abdTab=0, _aadTab=0;
    private bool   _aadConsent=false, _aadParsing=false, _aadDone=false;
    private string _shareCode=string.Empty, _aadErr=string.Empty;
    private IBrowserFile? _aadFile;
    private bool   _pinErr=false, _cityErr=false, _stateErr=false, _addrErr=false;
    private string _pinErrMsg=string.Empty;
    // PIN lookup state — current address
    private bool   _pinLooking=false, _pinAutoFilled=false;
    private string _pinLookupErr=string.Empty;
    // PIN lookup state — permanent address
    private bool   _permPinLooking=false, _permPinAutoFilled=false;

    // Aspirational district check — loaded from master DB on init
    private HashSet<string> _aspDistricts = new(StringComparer.OrdinalIgnoreCase);
    private bool _isAspirational     => _aspDistricts.Contains((m.District     ?? "").Trim());
    private bool _permIsAspirational => _aspDistricts.Contains((m.PermDistrict ?? "").Trim());

    private static readonly string[] _indianStates =
    [
        "Andhra Pradesh","Arunachal Pradesh","Assam","Bihar","Chhattisgarh","Goa","Gujarat",
        "Haryana","Himachal Pradesh","Jharkhand","Karnataka","Kerala","Madhya Pradesh",
        "Maharashtra","Manipur","Meghalaya","Mizoram","Nagaland","Odisha","Punjab","Rajasthan",
        "Sikkim","Tamil Nadu","Telangana","Tripura","Uttar Pradesh","Uttarakhand","West Bengal",
        "Andaman & Nicobar Islands","Chandigarh","Dadra & Nagar Haveli and Daman & Diu",
        "Delhi","Jammu & Kashmir","Ladakh","Lakshadweep","Puducherry",
    ];
    private bool   _dupOverridden=false;
    private string _dupReason=string.Empty;
    private List<LiPi.Web.Services.DuplicateMatch> _dupMatches=new();

    private static readonly string[] _hints=[
        "Fill name, DOB/age, gender, contact details.",
        "Enter address and PIN code.",
        "Occupation, measurements and lifestyle (optional).",
        "Patient type, referral and payer details (optional).",
        "Review all details and confirm consent."
    ];

    private sealed class PM {
        public string Title=string.Empty,FirstName=string.Empty,MiddleName=string.Empty,LastName=string.Empty,DisplayName=string.Empty;
        public string DateOfBirth=string.Empty,Gender=string.Empty,BloodGroup=string.Empty,MaritalStatus=string.Empty;
        public string Nationality="IN",Language="hi";
        public string MobCC="+91",Mobile=string.Empty,AltMobCC="+91",AltMobile=string.Empty;
        public string WaCC="+91",WhatsApp=string.Empty;
        public string LandISD="+91",LandSTD=string.Empty,LandNum=string.Empty;
        public string Email=string.Empty,Email2=string.Empty;
        public string AddressLine=string.Empty,AddressLine2=string.Empty,District=string.Empty,City=string.Empty,State=string.Empty,PinCode=string.Empty;
        public bool   PermSameAsCurrent=true;
        public string PermAddressLine=string.Empty,PermAddressLine2=string.Empty,PermPinCode=string.Empty;
        public string PermDistrict=string.Empty,PermCity=string.Empty,PermState=string.Empty;
        public string AbhaNumber=string.Empty,AbhaAddress=string.Empty,AadhaarLast4=string.Empty;
        public string OtherIdType=string.Empty,OtherIdValue=string.Empty;
        public string Occupation=string.Empty,Education=string.Empty,HeightCm=string.Empty,WeightKg=string.Empty;
        public string TobaccoStatus="not_disclosed",TobaccoType=string.Empty,TobaccoDuration=string.Empty;
        public string AlcoholUse="not_disclosed",Activity="not_disclosed";
        public string PatientType="general",Priority="normal";
        public string RefSrc="self",RefBy=string.Empty;
        public string HowHeard=string.Empty,HowHeardDetail=string.Empty;
        public string Payer="self";
        public string CorpName=string.Empty,CorpEmpId=string.Empty,CorpHr=string.Empty,CorpHrPhone=string.Empty,CorpEmail=string.Empty;
        public string PolicyNumber=string.Empty,InsCo=string.Empty,TpaName=string.Empty;
        public string SchemeName=string.Empty,PolicyExpiry=string.Empty;
        public string HowDidHear=string.Empty;
        public string PolicyNo=string.Empty,PolHolder=string.Empty,PolRelation=string.Empty;
        public string PolFrom=string.Empty,PolTo=string.Empty,CashlessLimit=string.Empty;
        public bool   PreAuth=false;
        public string GovtScheme=string.Empty,BeneNo=string.Empty,BeneHolder=string.Empty,BeneRelation=string.Empty,SchemeFrom=string.Empty,IncomeGroup=string.Empty;
        public string OtherPayerName=string.Empty,OtherPayerRef=string.Empty;
        public bool VipFlag,Allergy,OrganDonor,Research,Intl,HipaaConsent=true;
    }
