    private async Task ParseAadhaar()
    { if(_aadFile==null||_shareCode.Length!=4)return;
      _aadParsing=true;_aadErr=string.Empty;StateHasChanged();
      try
      { await using var s=_aadFile.OpenReadStream(maxAllowedSize:5_242_880);
        var result=await AadhaarSvc.ParseAsync(s,_shareCode);
        if(result.Success)
        { // FullName from Aadhaar — populate if own name fields are still empty
          if(!string.IsNullOrEmpty(result.FullName)&&string.IsNullOrWhiteSpace(m.FirstName))
          { var parts=result.FullName.Trim().Split(' ',2,StringSplitOptions.RemoveEmptyEntries);
            m.FirstName=OnlyLet(parts[0]);
            if(parts.Length>1) m.LastName=OnlyLet(parts[1]); }
          if(!string.IsNullOrEmpty(result.DateOfBirth)){m.DateOfBirth=result.DateOfBirth;OnDob(new ChangeEventArgs{Value=result.DateOfBirth});}
          if(!string.IsNullOrEmpty(result.Gender)){_gender=result.Gender switch{"M"=>"male","F"=>"female","T"=>"other",_=>result.Gender};m.Gender=_gender;}
          m.AadhaarLast4=result.LastFourUid??string.Empty;
          if(!string.IsNullOrEmpty(result.AddressLine)) m.AddressLine=result.AddressLine;
          if(!string.IsNullOrEmpty(result.PinCode))     m.PinCode=result.PinCode;
          if(!string.IsNullOrEmpty(result.State))       m.State=result.State;
          if(!string.IsNullOrEmpty(result.PhotoBase64)) _photoUrl=$"data:image/jpeg;base64,{result.PhotoBase64}";
          Rebuild();_aadDone=true; }
        else _aadErr=result.Error??"Parse failed"; }
      catch(Exception ex){_aadErr=ex.Message;}
      finally{_aadParsing=false;} }

    private async Task RunDupCheck()
    { try
      { var user=(await AuthState).User;
        var cid=LiPi.Web.Services.ClaimsHelper.ClinicId(user);
        if(cid==null)return;
        var db=await ClinicDbFactory.CreateCoreForClinicAsync(cid.Value);
        if(db==null)return;
        await using(db)
        { var req=new LiPi.Web.Services.DuplicateCheckRequest{AadhaarLastFour=string.IsNullOrEmpty(m.AadhaarLast4)?null:m.AadhaarLast4,AbhaNumber=string.IsNullOrEmpty(m.AbhaNumber)?null:m.AbhaNumber,FirstName=m.FirstName,LastName=m.LastName,DateOfBirth=string.IsNullOrEmpty(m.DateOfBirth)?null:m.DateOfBirth,DobConfidence=string.IsNullOrEmpty(m.DateOfBirth)?"estimated":"self_reported",Mobile=m.Mobile};
          _dupMatches=await DupSvc.CheckAsync(cid.Value,req,db); } }
      catch{} }

    private void Touch(string f){_tch[f]=true;Validate(f);StateHasChanged();}
    private void Validate(string f)
    { _errs[f]=f switch{
        var k when k==_kFn     =>string.IsNullOrWhiteSpace(m.FirstName)?"First name is required":string.Empty,
        var k when k==_kLn     =>string.IsNullOrWhiteSpace(m.LastName)?"Last name is required":string.Empty,
        var k when k==_kGender =>string.IsNullOrEmpty(_gender)?"Gender is required":string.Empty,
        var k when k==_kDob    =>(string.IsNullOrEmpty(m.DateOfBirth)&&string.IsNullOrEmpty(_ageDisp))?"Date of birth or age is required":(!string.IsNullOrEmpty(m.DateOfBirth)&&(!DateTime.TryParse(m.DateOfBirth,out var dv)||dv>DateTime.Today))?"Date of birth cannot be in the future":string.Empty,
        var k when k==_kMob    =>string.IsNullOrEmpty(m.Mobile)?"Mobile is required":m.MobCC=="+91"&&!Regex.IsMatch(m.Mobile,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kAlt    =>string.IsNullOrEmpty(m.AltMobile)?string.Empty:m.MobCC=="+91"&&!Regex.IsMatch(m.AltMobile,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kWa     =>string.IsNullOrEmpty(m.WhatsApp)?string.Empty:m.WaCC=="+91"&&!Regex.IsMatch(m.WhatsApp,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kEmail  =>string.IsNullOrEmpty(m.Email)?string.Empty:Regex.IsMatch(m.Email,"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")?string.Empty:"Invalid email address",
        var k when k==_kEmail2 =>string.IsNullOrEmpty(m.Email2)?string.Empty:Regex.IsMatch(m.Email2,"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")?string.Empty:"Invalid email address",
        var k when k==_kRefBy  =>m.RefSrc=="doctor"&&string.IsNullOrWhiteSpace(m.RefBy)?"Referred by is required when Doctor Referral is selected":string.Empty,
        _=>string.Empty }; }

    private string ErrCss(string f)=>_tch.GetValueOrDefault(f)&&!string.IsNullOrEmpty(_errs.GetValueOrDefault(f,string.Empty))?"err":string.Empty;
    private RenderFragment ErrFrag(string f)=>b=>{if(_tch.GetValueOrDefault(f)&&!string.IsNullOrEmpty(_errs.GetValueOrDefault(f,string.Empty))){b.OpenElement(0,"span");b.AddAttribute(1,"class","af-ferr");b.AddContent(2,_errs[f]);b.CloseElement();}};
    private static string DupCss(string s)=>s switch{"high"=>"dup-high","probable"=>"dup-probable",_=>"dup-possible"};
    private void Rebuild(){m.DisplayName=string.Join(" ",new[]{m.Title,m.FirstName,m.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)));}

    // ── Identifier tile computed properties (Rule 11: no @{} inside @if) ──
    private bool _abdmSet => !string.IsNullOrEmpty(m.AbhaNumber) || !string.IsNullOrEmpty(m.AbhaAddress);
    private string _abdmDisp { get { var n=(m.AbhaNumber??"").Replace("-",""); return n.Length>=4?"•• "+n[^4..]:"ABHA"; } }
    private bool _aadSet  => !string.IsNullOrEmpty(m.AadhaarLast4);
    private bool _othSet  => !string.IsNullOrEmpty(m.OtherIdValue);
    private string _othPfx => (m.OtherIdType??"") switch { "passport"=>"PASS","pan"=>"PAN","voter_id"=>"VOT","driving_licence"=>"DL",_=>"ID" };
    private string _othDisp { get { if(!_othSet)return ""; var v=m.OtherIdValue??""; return v.Length>=4?_othPfx+" •• "+v[^4..]:_othPfx+" "+v; } }

    private void CalcBmi(){_bmi=string.Empty;if(float.TryParse(m.HeightCm,out var h)&&float.TryParse(m.WeightKg,out var w)&&h>0)_bmi=(w/(h/100f*(h/100f))).ToString("F1");}
    private static string BmiCat(string s)=>float.TryParse(s,out var v)?v switch{<18.5f=>"· Underweight",<25f=>"· Normal",<30f=>"· Overweight",_=>"· Obese"}:string.Empty;
    private string MobHint()=>m.MobCC switch{"+91"=>"10 digits 6-9","+1"=>"10 digits",_=>"Digits only"};
    private static string StripDig(string?s,int max=20)=>string.IsNullOrEmpty(s)?string.Empty:new string(s.Where(char.IsDigit).Take(max).ToArray());
    private static string OnlyLet(string?s)=>string.IsNullOrEmpty(s)?string.Empty:Regex.Replace(s,"[^a-zA-Z\\-\\.]",string.Empty);

    // ── Tab status — drives icon colour ────────────────────────────────────
    private string TabStatus(int tab)
    { if(!_visited.Contains(tab)&&_tab!=tab) return "neutral";
      return tab switch
      { 0=>Tab1Status(), 1=>Tab2Status(),
        2=>(!string.IsNullOrEmpty(m.Occupation)||!string.IsNullOrEmpty(m.HeightCm)||m.TobaccoStatus!=_never||m.AlcoholUse!="none")?"opt-filled":"neutral",
        3=>(!string.IsNullOrEmpty(m.RefSrc)||(!string.IsNullOrEmpty(m.HowHeard)&&m.HowHeard!="referral")||m.Payer!=_pSelf)?"opt-filled":"neutral",
        _=>"neutral" }; }
    private string Tab1Status()
    { var f=new[]{!string.IsNullOrWhiteSpace(m.FirstName),!string.IsNullOrWhiteSpace(m.LastName),!string.IsNullOrEmpty(_gender),!string.IsNullOrEmpty(m.Mobile),!string.IsNullOrEmpty(m.DateOfBirth)||!string.IsNullOrEmpty(_ageDisp)};
      var n=f.Count(x=>x); return n==5?"complete":n==0?"empty":"partial"; }
    private string Tab2Status()
    { var f=new[]{!string.IsNullOrWhiteSpace(m.PinCode),!string.IsNullOrWhiteSpace(m.City),!string.IsNullOrWhiteSpace(m.State)};
      var n=f.Count(x=>x); return n==3?"complete":n==0?"empty":"partial"; }

    private string TabCss(int tab)
    { if(_tab==tab) return "active";
      return TabStatus(tab) switch
      { "complete"   => "done",
        "opt-filled" => "done",
        "partial"    => "partial",
        _            => "" }; }
}
