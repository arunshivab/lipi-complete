                      <input id="pn-refby" name="referredBy" autocomplete="off" class="reg-inp @ErrCss(_kRefBy)"
                             value="@m.RefBy" placeholder="Dr. Name or hospital"
                             @oninput="e => { m.RefBy=e.Value?.ToString()??string.Empty; if(_tch.GetValueOrDefault(_kRefBy))Validate(_kRefBy); }"
