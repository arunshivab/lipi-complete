                      <span class="reg-err">@((_tch.GetValueOrDefault(_kEmail2)&&!string.IsNullOrEmpty(_errs.GetValueOrDefault(_kEmail2,string.Empty)))?_errs[_kEmail2]:"\u00A0")</span>
                    </div>
                  </div>
                </div>
              </div>
            }

            @* TAB 1: Address *@
            @if (_tab == 1)
            {
              @* Current Address *@
              <div class="af-card" style="border-left:3px solid #1565C0">
                <div class="af-card-header"><div class="af-card-num" style="background:#1565C0">1</div><span class="af-card-title">Current Address</span></div>
                <div class="af-card-body">
                  <div class="reg-g4">
                    @* Address lines — full width *@
                    <div class="reg-fg" style="grid-column:1/-1">
                      <label class="reg-lbl" for="pn-addr1">Address Line 1 <span class="reg-req">*</span></label>
                      <input id="pn-addr1" name="addressLine" autocomplete="address-line1" class="reg-inp @(_addrErr?"err":"")"
                             value="@m.AddressLine" placeholder="House / Flat no. · Building · Floor"
                             @oninput="OnAddrInput" @onblur="OnAddrBlurred" />
                      @if (_addrErr) { <span class="reg-err">Address is required</span> }
                    </div>
                    <div class="reg-fg" style="grid-column:1/-1">
                      <label class="reg-lbl" for="pn-addr2">Address Line 2</label>
                      <input id="pn-addr2" name="addressLine2" autocomplete="address-line2" class="reg-inp"
                             value="@m.AddressLine2" placeholder="Street · Colony · Area · Locality"
                             @oninput="e => m.AddressLine2=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    @* Row 3: Pincode | City | District | State *@
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-pin">Pincode <span class="reg-req">*</span>@if(_pinLooking){<span class="reg-lhint"> · looking up…</span>}else if(_pinAutoFilled){<span class="reg-lhint" style="color:#059669"> · ✓ auto-filled</span>}</label>
                      <input id="pn-pin" name="pinCode" autocomplete="postal-code" class="reg-inp @(_pinErr?"err":"")"
                             value="@m.PinCode" inputmode="numeric" maxlength="6" placeholder="6 digits"
                             @oninput="OnPinInput" @onblur="OnPinBlurred" />
                      <span class="reg-err">@(!string.IsNullOrEmpty(_pinLookupErr)?_pinLookupErr:_pinErr?_pinErrMsg:" ")</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-city">City / Town <span class="reg-req">*</span></label>
                      <input id="pn-city" name="city" autocomplete="address-level2" class="reg-inp @(_cityErr?"err":"")"
                             value="@m.City" placeholder="@(_pinAutoFilled?"auto-filled":"enter city")"
                             @oninput="OnCityInput" @onblur="OnCityBlurred" />
                      <span class="reg-err">@(_cityErr?"City is required":" ")</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-dist">District @if (_isAspirational) {<span class="pn-asp-badge">★ Aspirational</span>}</label>
                      <input id="pn-dist" name="district" autocomplete="off" class="reg-inp"
                             value="@m.District" placeholder="@(_pinAutoFilled?"auto-filled":"enter district")"
                             @oninput="e => m.District=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-state">State <span class="reg-req">*</span></label>
                      <select id="pn-state" name="state" autocomplete="address-level1" class="reg-sel @(_stateErr?"err":"")"
                              value="@m.State" @onchange="OnStateInput" @onblur="OnStateBlurred">
                        <option value="">Select…</option>
                        @foreach (var s in _indianStates) { <option value="@s">@s</option> }
                      </select>
                      <span class="reg-err">@(_stateErr?"State is required":" ")</span>
                    </div>
                  </div>
                </div>
              </div>

              @* Permanent Address *@
              <div class="af-card" style="border-left:3px solid #00695C">
                <div class="af-card-header"><div class="af-card-num" style="background:#00695C">2</div><span class="af-card-title">Permanent Address</span></div>
                <div class="af-card-body">
                  <div class="pn-perm-toggle">
                    <button type="button" class="pn-perm-btn @(m.PermSameAsCurrent?"on":"")" @onclick="() => m.PermSameAsCurrent=true">
                      ✓ Same as current address
                    </button>
                    <button type="button" class="pn-perm-btn @(!m.PermSameAsCurrent?"on":"")" @onclick="() => m.PermSameAsCurrent=false">
                      Enter separately
                    </button>
                  </div>
                  @if (m.PermSameAsCurrent)
                  { <div style="font-size:11px;color:#059669">✓ Using current address — no separate entry needed.</div> }
                  else
                  {
                    <div class="reg-g4">
                      <div class="reg-fg" style="grid-column:1/-1">
                        <label class="reg-lbl" for="pn-paddr1">Address Line 1</label>
                        <input id="pn-paddr1" name="permAddressLine" autocomplete="off" class="reg-inp"
                               value="@m.PermAddressLine" placeholder="House / Flat no. · Building"
                               @oninput="e => m.PermAddressLine=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                      </div>
                      <div class="reg-fg" style="grid-column:1/-1">
                        <label class="reg-lbl" for="pn-paddr2">Address Line 2</label>
                        <input id="pn-paddr2" name="permAddressLine2" autocomplete="off" class="reg-inp"
                               value="@m.PermAddressLine2" placeholder="Street · Colony · Locality"
                               @oninput="e => m.PermAddressLine2=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                      </div>
                      <div class="reg-fg">
                        <label class="reg-lbl" for="pn-ppin">Pincode @if(_permPinLooking){<span class="reg-lhint"> · looking up…</span>}else if(_permPinAutoFilled){<span class="reg-lhint" style="color:#059669"> · ✓ auto-filled</span>}</label>
                        <input id="pn-ppin" name="permPinCode" autocomplete="off" class="reg-inp"
                               value="@m.PermPinCode" inputmode="numeric" maxlength="6" placeholder="6 digits"
                               @oninput="OnPermPinInput" />
                      <span class="reg-err">&nbsp;</span>
                      </div>
                      <div class="reg-fg">
                        <label class="reg-lbl" for="pn-pdist">
                          District
                          @if (_permIsAspirational) { <span class="pn-asp-badge">★ Aspirational</span> }
                        </label>
                        <input id="pn-pdist" name="permDistrict" autocomplete="off" class="reg-inp"
                               value="@m.PermDistrict" placeholder="@(_permPinAutoFilled?"auto-filled":"enter district")"
                               @oninput="e => m.PermDistrict=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                      </div>
                      <div class="reg-fg">
                        <label class="reg-lbl" for="pn-pcity">City / Town</label>
                        <input id="pn-pcity" name="permCity" autocomplete="off" class="reg-inp"
                               value="@m.PermCity" placeholder="@(_permPinAutoFilled?"auto-filled":"enter city")"
                               @oninput="e => m.PermCity=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                      </div>
                      <div class="reg-fg">
                        <label class="reg-lbl" for="pn-pstate">State</label>
                        <select id="pn-pstate" name="permState" autocomplete="off" class="reg-sel"
                                value="@m.PermState" @onchange="e => m.PermState=e.Value?.ToString()??string.Empty">
                          <option value="">Select…</option>
                          @foreach (var s in _indianStates) { <option value="@s">@s</option> }
                        </select>
                      <span class="reg-err">&nbsp;</span>
                      </div>
                    </div>
                  }
                </div>
              </div>
            }

            @* TAB 2: Socioeconomic *@
            @if (_tab == 2)
            {
              <div class="af-card" style="border-left:3px solid #1565C0">
                <div class="af-card-header"><div class="af-card-num" style="background:#1565C0">1</div><span class="af-card-title">Socioeconomic Profile</span></div>
                <div class="af-card-body">
                  <div class="reg-g4">
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-occ">Occupation</label>
                      <input id="pn-occ" name="occupation" autocomplete="off" class="reg-inp" value="@m.Occupation" placeholder="e.g. Teacher" @oninput="e => m.Occupation=e.Value?.ToString()??string.Empty" />
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-edu">Education Level</label>
                      <select id="pn-edu" name="educationLevel" autocomplete="off" class="reg-sel" value="@m.Education" @onchange="e => m.Education=e.Value?.ToString()??string.Empty">
