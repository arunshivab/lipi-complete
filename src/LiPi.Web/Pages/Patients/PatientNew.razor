    private async Task OnPinInput(ChangeEventArgs e)
    { var raw=new string((e.Value?.ToString()??string.Empty).Where(char.IsDigit).Take(6).ToArray());
      m.PinCode=raw; _pinLookupErr=string.Empty;
      if(raw.Length<6){_pinAutoFilled=false;m.District=m.City=m.State=string.Empty;}
      if(raw.Length==6) await LookupPin(raw, current:true); }

    private async Task LookupPin(string pin, bool current)
    { if(current){_pinLooking=true;}else{_permPinLooking=true;} StateHasChanged();
      try
      { using var http=HttpFactory.CreateClient("IndiaPinApi");
        var resp=await http.GetStringAsync($"pincode/{pin}");
        var docs=System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement[]>(resp);
        if(docs is {Length:>0})
        { var doc=docs[0];
          if(doc.GetProperty("Status").GetString()=="Success")
          { var po=doc.GetProperty("PostOffice")[0];
            var dist =po.GetProperty("District").GetString()??string.Empty;
            var state=po.GetProperty("State").GetString()??string.Empty;
            var div  =po.GetProperty("Division").GetString()??string.Empty;
            // City = Division (more specific than district) if available, else district
            var city = !string.IsNullOrEmpty(div)&&div!=dist ? div : dist;
            if(current){m.District=dist;m.City=city;m.State=state;_pinAutoFilled=true;_pinLookupErr=string.Empty;}
            else{m.PermDistrict=dist;m.PermCity=city;m.PermState=state;_permPinAutoFilled=true;}
          } else {
            if(current){_pinAutoFilled=false;_pinLookupErr="PIN not found — enter manually";}
            else _permPinAutoFilled=false;
          }
        }
      }
      catch{if(current){_pinAutoFilled=false;_pinLookupErr="Lookup failed — enter manually";}else _permPinAutoFilled=false;}
      finally{if(current)_pinLooking=false;else _permPinLooking=false;} }

