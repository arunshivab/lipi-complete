@namespace LiPi.Web.Pages.PatientPages
@page "/patients/new"
@page "/patients/register"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Security.Claims
@using System.Text.RegularExpressions
@rendermode InteractiveServer
@layout LiPi.Web.Components.Layouts.TopNavLayout
@attribute [Authorize]
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LiPi.Web.Services.IAadhaarXmlService AadhaarSvc
@inject LiPi.Web.Services.ClinicDbFactory ClinicDbFactory
@inject LiPi.Web.Services.IDuplicateDetectionService DupSvc

<PageTitle>Register Patient – LiPi</PageTitle>
<SectionContent SectionName="page-title">
    <div class="tn-pt-title">Register Patient</div>
    <div class="tn-pt-sub">OPD · New patient registration</div>
</SectionContent>

<div class="pr-body">

  <div class="pr-kpi-strip">
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#0B2545"></div><div class="pr-kpi-lbl">Today's Reg</div><div class="pr-kpi-val">38</div><div class="pr-kpi-sub">↑ 6 vs yesterday</div></div>
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#D97706"></div><div class="pr-kpi-lbl">OPD Queue</div><div class="pr-kpi-val">12</div><div class="pr-kpi-sub">avg wait 18 min</div></div>
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#1B4DA0"></div><div class="pr-kpi-lbl">Appts Today</div><div class="pr-kpi-val">47</div><div class="pr-kpi-sub">3 unconfirmed</div></div>
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#4A9BD4"></div><div class="pr-kpi-lbl">Active Patients</div><div class="pr-kpi-val">1,284</div><div class="pr-kpi-sub">↑ 5.1% MoM</div></div>
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#EF4444"></div><div class="pr-kpi-lbl">Pending</div><div class="pr-kpi-val">3</div><div class="pr-kpi-sub">action required</div></div>
    <div class="pr-kpi-tile"><div class="pr-kpi-accent" style="background:#10B981"></div><div class="pr-kpi-lbl">Empty Slots</div><div class="pr-kpi-val">9</div><div class="pr-kpi-sub">all doctors</div></div>
  </div>


  @if (_dupOpen && _dupMatches.Count > 0)
  {
    <div class="dup-backdrop" @onclick="CloseDup">
      <div class="dup-box" @onclick:stopPropagation="true">
        <div class="dup-head"><div class="dup-head-icon">⚠️</div>
          <span class="dup-head-title">Possible duplicate patient</span>
          <button type="button" class="pr-modal-close" @onclick="CloseDup">✕ Close</button></div>
        <div class="dup-body">
          @foreach (var dm in _dupMatches)
          { var dmid = dm.PatientId;
            <div class="dup-match-card">
              <div class="dup-match-head"><span class="dup-strength @DupCss(dm.MatchStrength)">@dm.MatchStrength.ToUpperInvariant()</span>
                <span style="font-size:12px;font-weight:500;color:#0B2545;flex:1;margin-left:8px">@dm.DisplayName</span>
                <span style="font-family:'DM Mono',monospace;font-size:11px;color:#E8B84B">@dm.Mrn</span></div>
              <div class="dup-cols">
                <div><div class="dup-col-head"><div class="dup-col-badge" style="background:#E3F2FD;color:#1B4DA0">NEW</div>This form</div>
                  <div class="dup-field"><span class="dup-field-lbl">Name</span><span class="dup-field-val">@m.DisplayName</span></div>
                  <div class="dup-field"><span class="dup-field-lbl">DOB</span><span class="dup-field-val">@(string.IsNullOrEmpty(m.DateOfBirth)?_ageDisp+" yrs est.":m.DateOfBirth)</span></div>
                  <div class="dup-field"><span class="dup-field-lbl">Mobile</span><span class="dup-field-val">@(string.IsNullOrEmpty(m.Mobile)?"—":m.MobCC+" "+m.Mobile)</span></div></div>
                <div><div class="dup-col-head"><div class="dup-col-badge" style="background:#ECFDF5;color:#065F46">DB</div>Existing record</div>
                  <div class="dup-field"><span class="dup-field-lbl">Name</span><span class="dup-field-val">@dm.DisplayName</span></div>
                  <div class="dup-field"><span class="dup-field-lbl">DOB</span><span class="dup-field-val">@(dm.DateOfBirth??"—")</span></div>
                  <div class="dup-field"><span class="dup-field-lbl">Mobile</span><span class="dup-field-val">@(dm.Mobile??"—")</span></div></div>
              </div>
              <div class="dup-actions">
                <button type="button" class="dup-open-btn" @onclick="() => OpenExisting(dmid)">Open existing record</button>
                <div style="flex:1"></div>
                <label class="pr-float" style="max-width:230px"><div class="pr-flabel">Override reason (required)</div>
                  <input class="pr-inp" value="@_dupReason" @oninput="OnDupReason" placeholder="e.g. Verified in person" /></label>
                <button type="button" class="dup-override-btn" disabled="@(string.IsNullOrWhiteSpace(_dupReason))" @onclick="OverrideDup">Override &amp; Continue</button>
              </div>
            </div>
          }
        </div>
      </div>
    </div>
  }

  @if (_idOpen)
  {
    <div class="pr-modal-backdrop" @onclick="CloseId">
      <div class="pr-modal-box" @onclick:stopPropagation="true">
        <div class="pr-modal-head"><div class="pr-modal-icon" style="background:#E3F2FD;color:#1B4DA0">ID</div>
          <span class="pr-modal-title">Patient Identifiers</span>
          <button type="button" class="pr-modal-close" @onclick="CloseId">✕ Close</button></div>
        <div class="pr-modal-body">
          <div class="pr-modal-section">
            <div class="pr-modal-section-title"><div class="pr-modal-badge" style="background:#E3F2FD;color:#1B4DA0">AB</div>ABDM / ABHA</div>
            <div class="pr-mtabs">
              <button type="button" class="pr-mtab @(_abdTab==0?_mtOn:_e)" @onclick="SetAbdTab0">ABHA Number</button>
              <button type="button" class="pr-mtab @(_abdTab==1?_mtOn:_e)" @onclick="SetAbdTab1">ABHA Address</button>
            </div>
            @if (_abdTab == 0)
            { <label class="pr-float" style="display:block;margin-bottom:8px"><div class="pr-flabel">14-digit ABHA Number</div>
                <input id="pn-abha" name="abhaNumber" autocomplete="off" class="pr-minp" value="@m.AbhaNumber" inputmode="numeric" maxlength="17" @oninput="OnAbha" /></label>
              <button type="button" class="pr-fetch-btn pr-fetch-abdm" disabled="@true">Fetch from ABDM →</button>
              <div style="font-size:9px;color:#F59E0B;margin-top:4px">ABDM API — coming soon</div> }
            @if (_abdTab == 1)
            { <label class="pr-float" style="display:block;margin-bottom:8px"><div class="pr-flabel">ABHA Address</div>
                <input id="pn-abha-a" name="abhaAddress" autocomplete="off" class="pr-minp" value="@m.AbhaAddress" placeholder="name@abdm" @oninput="OnAbhaAddr" /></label>
              <button type="button" class="pr-fetch-btn pr-fetch-abdm" disabled="@true">Fetch from ABDM →</button> }
          </div>
          <div class="pr-modal-divider"></div>
          <div class="pr-modal-section">
            <div class="pr-modal-section-title"><div class="pr-modal-badge" style="background:#FFF3E0;color:#E65100">AA</div>Aadhaar — UIDAI</div>
            <div class="pr-mtabs">
              <button type="button" class="pr-mtab @(_aadTab==0?_mtOn:_e)" @onclick="SetAadTab0">XML Upload</button>
              <button type="button" class="pr-mtab @(_aadTab==1?_mtOn:_e)" @onclick="SetAadTab1">Last 4 digits</button>
            </div>
            @if (_aadTab == 0 && !_aadDone)
            { @if (!_clinicIndia)
              { <label class="pr-consent-row" style="display:flex;margin-bottom:8px">
                  <input type="checkbox" @onchange="OnAadConsent" />
                  <span>Patient has provided consent to share identity document data</span>
                </label> }
              @if (_clinicIndia || _aadConsent)
              { <div class="pr-aadh-upload"><div><div class="pr-upload-lbl">Offline XML from uidai.gov.in</div>
                  <InputFile id="pn-aadh-zip" OnChange="OnAadhaarFile" accept=".zip" style="font-size:10px;width:100%" /></div>
                  <label class="pr-float"><div class="pr-flabel">Share Code</div>
                    <input id="pn-share" name="shareCode" autocomplete="off" class="pr-minp" value="@_shareCode" placeholder="4 digits" maxlength="4" inputmode="numeric" @oninput="OnShareCode" /></label>
                </div>
                <span class="pr-aa-note">Full Aadhaar never stored · UIDAI regulations</span>
                @if (!string.IsNullOrEmpty(_aadErr)){<div class="pr-err-msg">⚠ @_aadErr</div>}
                <button type="button" class="pr-fetch-btn pr-fetch-aadh"
                        disabled="@(_aadFile==null||_shareCode.Length!=4||_aadParsing)" @onclick="ParseAadhaar">
                  @(_aadParsing?"Reading…":"Auto-fill from XML →")</button> }
              else { <span class="pr-aa-note">Tick consent above to upload</span> } }
            @if (_aadTab == 0 && _aadDone)
            { <div style="background:#ECFDF5;border:.5px solid #6EE7B7;border-radius:8px;padding:8px 12px;display:flex;align-items:center;gap:8px;font-size:12px;color:#065F46">
                ✅ Auto-filled — UID ending ···@m.AadhaarLast4
                <button type="button" style="margin-left:auto;font-size:10px;color:#94A3B8;background:none;border:none;cursor:pointer" @onclick="ClearAadhaar">Clear</button></div> }
            @if (_aadTab == 1)
            { <label class="pr-float" style="display:block"><div class="pr-flabel">Last 4 digits only</div>
                <input id="pn-aad4" name="aadhaarLast4" autocomplete="off" class="pr-minp" value="@m.AadhaarLast4" placeholder="1234" maxlength="4" inputmode="numeric" @oninput="OnAad4" /></label>
              <span class="pr-aa-note">For record linking only</span> }
          </div>
          <div class="pr-modal-divider"></div>
          <div class="pr-modal-section" style="margin-bottom:0">
            <div class="pr-modal-section-title"><div class="pr-modal-badge" style="background:#F3E8FF;color:#7C3AED">OT</div>Other Government ID</div>
            <div class="pr-g2" style="margin-bottom:0">
              <label class="pr-float"><div class="pr-flabel">ID Type</div>
                <select id="pn-oid-t" name="otherIdType" autocomplete="off" class="pr-msel" value="@m.OtherIdType" @onchange="OnOtherType">
                  <option value="">—</option>
                  <option value="passport">Passport</option>
                  <option value="pan">PAN Card</option>
                  <option value="voter_id">Voter ID</option>
                  <option value="driving_licence">Driving Licence</option>
                </select></label>
              <label class="pr-float"><div class="pr-flabel">ID Number</div>
                <input id="pn-oid-v" name="otherIdValue" autocomplete="off" class="pr-minp" value="@m.OtherIdValue" @oninput="OnOtherVal" /></label>
            </div>
          </div>
        </div>
      </div>
    </div>
  }

  <div class="pr-panel">

    <div class="pr-tabs">
      <div class="@TabCss(0)" @onclick="() => GoTab(0)">
        <div class="pr-tab-num">@TabNum(0)</div>
        <div><div class="pr-tab-step">STEP 01</div><div class="pr-tab-lbl">Identity</div></div>
      </div>
      <div class="@TabCss(1)" @onclick="() => GoTab(1)">
        <div class="pr-tab-num">@TabNum(1)</div>
        <div><div class="pr-tab-step">STEP 02</div><div class="pr-tab-lbl">Address</div></div>
      </div>
      <div class="@TabCss(2)" @onclick="() => GoTab(2)">
        <div class="pr-tab-num">@TabNum(2)</div>
        <div><div class="pr-tab-step">STEP 03 · optional</div><div class="pr-tab-lbl">Socioeconomic</div></div>
      </div>
      <div class="@TabCss(3)" @onclick="() => GoTab(3)">
        <div class="pr-tab-num">@TabNum(3)</div>
        <div><div class="pr-tab-step">STEP 04 · optional</div><div class="pr-tab-lbl">Reg. Details</div></div>
      </div>
      <div class="@TabCss(4)" @onclick="() => GoTab(4)">
        <div class="pr-tab-num">@TabNum(4)</div>
        <div><div class="pr-tab-step">STEP 05</div><div class="pr-tab-lbl">Review</div></div>
      </div>
      <div style="margin-left:auto;display:flex;gap:6px;flex-shrink:0">
        @if (!string.IsNullOrEmpty(_successMsg))
        { <span class="pr-inline-success">✓ @_successMsg</span> }
        @if (!string.IsNullOrEmpty(_errorMsg) && _tab == 4)
        { <span class="pr-inline-error">⚠ @_errorMsg</span> }
        <button type="button" class="pr-btn-ghost" @onclick="HandleCancel">@(_saved ? "Close" : "Cancel")</button>
        <button type="button" class="pr-btn-ghost" disabled="@(_tab == 0 || _saved)" @onclick="HandleBack">← Back</button>
        <button type="button" class="pr-btn-primary" disabled="@(_tab == 4 || _saved)" @onclick="HandleNext">Next →</button>
      </div>
    </div>

    <fieldset disabled="@_saved" style="border:none;padding:0;margin:0">
    <div class="pr-main">
      <div>

        @if (_tab == 0) {
          <div class="pr-form">
            <div class="pr-sh"><span class="pr-sh-num">01</span><span class="pr-sh-title">Personal Identity</span><div class="pr-sh-line"></div></div>
            <div class="pr-g4n">
              <label class="pr-float"><div class="pr-flabel">Title</div>
                <select id="pn-title" name="title" autocomplete="honorific-prefix" class="pr-sel" value="@m.Title" @onchange="OnTitle">
                  <option value=""></option>
                  <option value="Mr">Mr</option>
                  <option value="Mrs">Mrs</option>
                  <option value="Miss">Miss</option>
                  <option value="Ms">Ms</option>
                  <option value="Dr">Dr</option>
                  <option value="Prof">Prof</option>
                  <option value="Baby">Baby</option>
                  <option value="Master">Master</option>
                  <option value="Rev">Rev</option>
                </select></label>
              <label class="pr-float"><div class="pr-flabel">First Name <span style="color:#EF4444">*</span></div>
                <input id="pn-fn" name="firstName" autocomplete="given-name" class="pr-inp @ErrCss(_kFn)"
                       @bind:get="m.FirstName" @bind:set="OnFn" @bind:event="oninput" @onblur="OnFnBlur" />
                @ErrFrag(_kFn)</label>
              <label class="pr-float"><div class="pr-flabel">Middle Name</div>
                <input id="pn-mn" name="middleName" autocomplete="additional-name" class="pr-inp"
                       @bind:get="m.MiddleName" @bind:set="OnMn" @bind:event="oninput" /></label>
              <label class="pr-float"><div class="pr-flabel">Last Name <span style="color:#EF4444">*</span></div>
                <input id="pn-ln" name="lastName" autocomplete="family-name" class="pr-inp @ErrCss(_kLn)"
                       @bind:get="m.LastName" @bind:set="OnLn" @bind:event="oninput" @onblur="OnLnBlur" />
                @ErrFrag(_kLn)</label>
            </div>
            <div class="pr-dob-row">
              <label class="pr-float"><div class="pr-flabel">Date of Birth <span style="font-size:8px;color:#7B8EA5;font-weight:400">⇄ auto-fills age</span></div>
                <input id="pn-dob" name="dob" type="date" autocomplete="bday" class="pr-inp @ErrCss(_kDob)"
                       value="@m.DateOfBirth" max="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @onchange="OnDob" @onblur="OnDobBlur" />
                @ErrFrag(_kDob)</label>
              <label class="pr-float"><div class="pr-flabel">Age (yrs)</div>
                <input id="pn-age" name="approximateAge" autocomplete="off" class="pr-inp"
                       @bind:get="_ageDisp" @bind:set="OnAgeSet" @bind:event="oninput"
                       inputmode="numeric" maxlength="3" />
                <span class="pr-note @_ageNoteCss">@_ageNote</span></label>
              <label class="pr-float"><div class="pr-flabel">Gender <span style="color:#EF4444">*</span></div>
                <select id="pn-gender" name="gender" autocomplete="sex" class="pr-sel @ErrCss(_kGender)" value="@_gender" @onchange="OnGender">
                  <option value="">Select…</option>
                  <option value="male">Male</option>
                  <option value="female">Female</option>
                  <option value="other">Other / Non-binary</option>
                  <option value="prefer_not_to_say">Prefer not to say</option>
                </select>
                @ErrFrag(_kGender)</label>
              <label class="pr-float"><div class="pr-flabel">Blood Group</div>
                <select id="pn-blood" name="bloodGroup" autocomplete="off" class="pr-sel" value="@m.BloodGroup" @onchange="OnBlood">
                  <option value="">Unknown</option>
                  <option value="A+">A+</option>
                  <option value="A-">A-</option>
                  <option value="B+">B+</option>
                  <option value="B-">B-</option>
                  <option value="AB+">AB+</option>
                  <option value="AB-">AB-</option>
                  <option value="O+">O+</option>
                  <option value="O-">O-</option>
                </select></label>
            </div>
            <div class="pr-dob-row">
              <label class="pr-float" style="grid-column:1/3"><div class="pr-flabel">Marital Status</div>
                <select id="pn-marital" name="maritalStatus" autocomplete="off" class="pr-sel" value="@m.MaritalStatus" @onchange="e => m.MaritalStatus=e.Value?.ToString()??string.Empty">
                  <option value="">Select…</option>
                  <option value="single">Single</option>
                  <option value="married">Married</option>
                  <option value="divorced">Divorced</option>
                  <option value="widowed">Widowed</option>
                </select></label>
              <label class="pr-float"><div class="pr-flabel">Nationality</div>
                <select id="pn-nat" name="nationality" autocomplete="country" class="pr-sel" value="@m.Nationality" @onchange="e => m.Nationality=e.Value?.ToString()??string.Empty">
                  <option value="IN">Indian</option><option value="XX">Other</option>
                </select></label>
              <label class="pr-float"><div class="pr-flabel">Preferred Language</div>
                <select id="pn-lang" name="preferredLanguage" autocomplete="language" class="pr-sel" value="@m.Language" @onchange="e => m.Language=e.Value?.ToString()??string.Empty">
                  <option value="hi">Hindi</option>
                  <option value="en">English</option>
                  <option value="ta">Tamil</option>
                  <option value="te">Telugu</option>
                  <option value="mr">Marathi</option>
                  <option value="bn">Bengali</option>
                  <option value="gu">Gujarati</option>
                  <option value="kn">Kannada</option>
                </select></label>
            </div>
            <div class="pr-sh" style="margin-top:4px"><span class="pr-sh-num">02</span><span class="pr-sh-title">Contact</span><div class="pr-sh-line"></div></div>
            <div class="pr-g3">
              <label class="pr-float"><div class="pr-flabel">Mobile <span style="color:#EF4444">*</span></div>
                <div class="pr-cc-wrap">
                  <select id="pn-mob-cc" name="mobileCC" autocomplete="tel-country-code" class="pr-cc-sel" value="@m.MobCC" @onchange="OnMobCC">
                    <option value="+91">+91 India</option>
                    <option value="+1">+1 USA/CA</option>
                    <option value="+44">+44 UK</option>
                    <option value="+971">+971 UAE</option>
                    <option value="+966">+966 KSA</option>
                    <option value="+65">+65 SG</option>
                    <option value="+61">+61 AU</option>
                    <option value="+880">+880 BD</option>
                    <option value="+94">+94 LK</option>
                  </select>
                  <input id="pn-mob" name="mobile" autocomplete="tel-national" class="pr-cc-inp @ErrCss(_kMob)"
                         @bind:get="m.Mobile" @bind:set="OnMobSet" @bind:event="oninput"
                         inputmode="numeric" placeholder="@MobHint()"
                         @onblur="OnMobBlur" /></div>
                @ErrFrag(_kMob)</label>
              <label class="pr-float"><div class="pr-flabel">Alternate</div>
                <div class="pr-cc-wrap">
                  <select id="pn-amob-cc" name="altMobCC" autocomplete="off" class="pr-cc-sel" value="@m.AltMobCC" @onchange="e => m.AltMobCC=e.Value?.ToString()??string.Empty">
                    <option value="+91">+91</option>
                    <option value="+1">+1</option>
                    <option value="+44">+44</option>
                    <option value="+971">+971</option>
                    <option value="+966">+966</option>
                    <option value="+65">+65</option>
                    <option value="+61">+61</option>
                  </select>
                  <input id="pn-amob" name="altMobile" autocomplete="off" class="pr-cc-inp @ErrCss(_kAlt)"
                         @bind:get="m.AltMobile" @bind:set="OnAltMobSet" @bind:event="oninput"
                         inputmode="numeric" placeholder="@MobHint()"
                         @onblur="OnAltBlur" /></div>
                @ErrFrag(_kAlt)</label>
              <label class="pr-float"><div class="pr-flabel">Email <span style="font-size:8px;color:#7B8EA5">(optional)</span></div>
                <input id="pn-email" name="email" type="email" autocomplete="email" class="pr-inp @ErrCss(_kEmail)"
                       value="@m.Email" @oninput="OnEmail" @onblur="OnEmailBlur" />
                @ErrFrag(_kEmail)</label>
            </div>
            <div class="pr-g3">
              <label class="pr-float"><div class="pr-flabel">WhatsApp</div>
                <div class="pr-cc-wrap">
                  <select id="pn-wa-cc" name="whatsappCC" autocomplete="off" class="pr-cc-sel" value="@m.WaCC" @onchange="e => m.WaCC=e.Value?.ToString()??string.Empty">
                    <option value="+91">+91</option>
                    <option value="+1">+1</option>
                    <option value="+44">+44</option>
                    <option value="+971">+971</option>
                    <option value="+966">+966</option>
                    <option value="+65">+65</option>
                    <option value="+61">+61</option>
                  </select>
                  <input id="pn-wa" name="whatsapp" autocomplete="off" class="pr-cc-inp @ErrCss(_kWa)"
                         @bind:get="m.WhatsApp" @bind:set="OnWaSet" @bind:event="oninput"
                         inputmode="numeric" placeholder="if different"
                         @onblur="OnWaBlur" /></div>
                @ErrFrag(_kWa)</label>
              <label class="pr-float"><div class="pr-flabel">Landline</div>
                <div class="pr-cc-wrap">
                  <select id="pn-land-isd" name="landlineISD" autocomplete="off" class="pr-cc-sel" style="width:68px" value="@m.LandISD" @onchange="e => m.LandISD=e.Value?.ToString()??string.Empty">
                    <option value="+91">+91</option>
                    <option value="+1">+1</option>
                    <option value="+44">+44</option>
                    <option value="+971">+971</option>
                    <option value="+65">+65</option>
                  </select>
                  <input id="pn-land-std" name="landlineSTD" autocomplete="off" inputmode="numeric" maxlength="5" placeholder="STD"
                         style="width:56px;flex:none;border-left:none;border-right:none;border-radius:0;padding:16px 6px 5px;font-family:'DM Mono',monospace;font-size:12px;background:#fff;border-top:1px solid #B6C4D4;border-bottom:1px solid #B6C4D4;color:#0B2545;outline:none"
                         value="@m.LandSTD" @oninput="e => m.LandSTD=StripDig(e.Value?.ToString(),5)" />
                  <input id="pn-land-num" name="landlineNum" autocomplete="tel" class="pr-cc-inp"
                         value="@m.LandNum" inputmode="numeric" placeholder="Number" @oninput="e => m.LandNum=StripDig(e.Value?.ToString(),10)" /></div></label>
              <label class="pr-float"><div class="pr-flabel">Secondary Email <span style="font-size:8px;color:#7B8EA5">(optional)</span></div>
