                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-lang">Preferred Language</label>
                      <select id="pn-lang" name="preferredLanguage" autocomplete="language" class="reg-sel" value="@m.Language" @onchange="e => m.Language=e.Value?.ToString()??string.Empty">
                        <option value="hi">Hindi</option><option value="en">English</option><option value="ta">Tamil</option>
                        <option value="te">Telugu</option><option value="mr">Marathi</option><option value="bn">Bengali</option>
                        <option value="gu">Gujarati</option><option value="kn">Kannada</option>
                      </select>
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-ht">Height (cm)</label>
                      <input id="pn-ht" name="heightCm" autocomplete="off" class="reg-inp" value="@m.HeightCm" inputmode="numeric" @oninput="OnHt" />
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-wt">Weight (kg)@if(!string.IsNullOrEmpty(_bmi)){<span class="reg-lhint"> · BMI @_bmi @BmiCat(_bmi)</span>}</label>
                      <input id="pn-wt" name="weightKg" autocomplete="off" class="reg-inp" value="@m.WeightKg" inputmode="numeric" @oninput="OnWt" />
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-alc">Alcohol Use</label>
                      <select id="pn-alc" name="alcoholUse" autocomplete="off" class="reg-sel" value="@m.AlcoholUse" @onchange="e => m.AlcoholUse=e.Value?.ToString()??string.Empty">
                        <option value="not_disclosed">Not disclosed</option><option value="none">None</option>
                        <option value="occasional">Occasional</option><option value="moderate">Moderate</option>
                        <option value="heavy">Heavy / Dependent</option>
                      </select>
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-act">Physical Activity</label>
                      <select id="pn-act" name="physicalActivity" autocomplete="off" class="reg-sel" value="@m.Activity" @onchange="e => m.Activity=e.Value?.ToString()??string.Empty">
                        <option value="not_disclosed">Not disclosed</option><option value="sedentary">Sedentary</option>
                        <option value="moderate">Moderate</option><option value="active">Active</option>
                      </select>
                      <span class="reg-err">&nbsp;</span>
                    </div>
                  </div>
                </div>
              </div>
              <div class="af-card" style="border-left:3px solid #00695C">
                <div class="af-card-header"><div class="af-card-num" style="background:#00695C">2</div><span class="af-card-title">Lifestyle &amp; Risk Factors</span></div>
                <div class="af-card-body">
                  <div class="reg-g3">
                    <div class="reg-fg">
                      <label class="reg-lbl" for="pn-tob">Tobacco / Smoking</label>
                      <select id="pn-tob" name="tobaccoStatus" autocomplete="off" class="reg-sel" value="@m.TobaccoStatus" @onchange="e => m.TobaccoStatus=e.Value?.ToString()??_never">
                        <option value="not_disclosed">Not disclosed</option><option value="never">Never</option>
                        <option value="current">Current</option><option value="former">Former / Quit</option>
                      </select>
                      <span class="reg-err">&nbsp;</span>
                    </div>
                    @if (m.TobaccoStatus == "current" || m.TobaccoStatus == "former")
                    {
                      <div class="reg-fg">
                        <label class="reg-lbl" for="pn-ttype">Type</label>
                        <select id="pn-ttype" name="tobaccoType" autocomplete="off" class="reg-sel" value="@m.TobaccoType" @onchange="e => m.TobaccoType=e.Value?.ToString()??string.Empty">
                          <option value="cigarette">Cigarette</option><option value="beedi">Beedi</option>
                          <option value="gutkha">Gutkha</option><option value="hookah">Hookah</option><option value="mixed">Mixed</option>
