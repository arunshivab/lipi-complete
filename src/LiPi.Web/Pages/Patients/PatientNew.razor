                @if (!string.IsNullOrEmpty(_errorMsg))
                { <div class="pr-inline-error" style="text-align:center">⚠ @_errorMsg</div> }
                <button type="button" class="pr-btn-save" style="width:100%;padding:11px;font-size:13px"
                        disabled="@_saving" @onclick="HandleSubmit">
                  @(_saving ? "Registering…" : "✓ Register Patient")
                </button>
              </div>
            }
            @if (_saved)
            { <div class="pr-inline-success" style="margin-top:16px;text-align:center;padding:10px">✓ @_successMsg</div> }
          </div>
        }

      </div>

      <div>
        <div class="pr-patient-card">
          <div class="pr-card-kicker">&#9711; live patient card</div>
          <div class="pr-card-top">
            <div>
              @if (_photoUrl is not null)
              { <div class="pr-card-photo" @onclick="TrigPhoto"><img src="@_photoUrl" alt="photo" /></div> }
              else
              { <div class="pr-card-photo" @onclick="TrigPhoto"><span style="font-size:20px;opacity:.3;color:#fff">&#9786;</span><span class="pr-card-photo-lbl">Photo</span></div> }
              <InputFile id="pn-photo" class="pr-photo-input" OnChange="OnPhoto" accept="image/*" />
            </div>
            <div style="min-width:0;flex:1">
              <div class="pr-card-name">@(string.IsNullOrWhiteSpace(m.DisplayName)?"New patient":m.DisplayName)</div>
              <div class="pr-card-uhid">@_uhid</div>
            </div>
          </div>
          <div class="pr-card-divider"></div>
          <div class="pr-card-row"><span class="pr-card-lbl">Mobile</span><span class="pr-card-val mono">@(string.IsNullOrEmpty(m.Mobile)?"—":m.MobCC+" "+m.Mobile)</span></div>
          <div class="pr-card-row"><span class="pr-card-lbl">Gender</span><span class="pr-card-val">@(string.IsNullOrEmpty(_gender)?"—":_gender)@(string.IsNullOrEmpty(_ageDisp)?"":" · "+_ageDisp+" yrs")</span></div>
          <div class="pr-card-row"><span class="pr-card-lbl">DOB</span><span class="pr-card-val mono">@(string.IsNullOrEmpty(m.DateOfBirth)?"—":m.DateOfBirth)</span></div>
          <div class="pr-card-row"><span class="pr-card-lbl">Address</span><span class="pr-card-val">@(string.IsNullOrEmpty(m.City)?"—":m.City+", "+m.State+" "+m.PinCode)</span></div>
          <div class="pr-card-row"><span class="pr-card-lbl">Payer</span><span class="pr-card-val">@m.Payer.Replace("_"," ")</span></div>
          @if (m.VipFlag || m.Allergy || m.OrganDonor)
          { <div class="pr-card-divider"></div>
            <div style="display:flex;gap:4px;flex-wrap:wrap">
              @if (m.VipFlag)    { <span class="pr-flag-chip pr-flag-vip">★ VIP</span> }
              @if (m.Allergy)   { <span class="pr-flag-chip pr-flag-allergy">⚠ Allergies</span> }
              @if (m.OrganDonor){ <span class="pr-flag-chip pr-flag-organ">♥ Organ Donor</span> }
            </div> }
          <div class="pr-card-divider"></div>
          <div class="pr-card-consent">@if(_clinicIndia){<span class="pr-card-consent-ok">Implied consent ✓</span>}else{<span class="@(m.HipaaConsent?_consentOk:_e)">HIPAA @(m.HipaaConsent?"✓":"◌")</span>}</div>
        </div>
        @if (_tab == 0)
        {
        <div class="pr-id-card" @onclick="OpenId">
          <div class="pr-id-strip">
            <span class="pr-id-strip-lbl">ID</span>
            <span class="pr-id-entry @(string.IsNullOrEmpty(m.AbhaNumber)?"pr-id-unset":"pr-id-set")">
              <span class="pr-id-dot"></span><span class="pr-id-code" style="background:#E3F2FD;color:#1B4DA0">AB</span>
            </span>
            <span class="pr-id-entry @(string.IsNullOrEmpty(m.AadhaarLast4)?"pr-id-unset":"pr-id-set")">
              <span class="pr-id-dot"></span><span class="pr-id-code" style="background:#FFF3E0;color:#E65100">AA</span>
            </span>
            <span class="pr-id-entry @(string.IsNullOrEmpty(m.OtherIdValue)?"pr-id-unset":"pr-id-set")">
              <span class="pr-id-dot"></span><span class="pr-id-code" style="background:#F3E8FF;color:#7C3AED">OT</span>
            </span>
            <span style="margin-left:auto;font-size:11px;color:#94A3B8">↗</span>
          </div>
        </div>
        }
        <div class="pr-card-hint">Step @(_tab+1) of 5 · @_hints[Math.Min(_tab,4)]</div>
        <div class="pr-emerg-note">&#9889; Minimum: Name + DOB/Age + Gender + Mobile + PIN</div>
      </div>
    </div>
    </fieldset>
  </div>
</div>

@code {
    [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;
    [Parameter][SupplyParameterFromQuery(Name="m")] public string? ReturnModule { get; set; }

    // Constants — no string literals in Razor attributes
    private const string _e="", _e2="";
    private const string _tabActive="pr-tab pr-tab-active", _tabDone="pr-tab pr-tab-done";
    private const string _cVip="pr-flag-chip pr-flag-vip", _cAl="pr-flag-chip pr-flag-allergy";
    private const string _cOr="pr-flag-chip pr-flag-organ", _cAct="pr-flag-chip pr-flag-active";
    private const string _consentOk="pr-card-consent-ok";
    private const string _pOn="pr-payer-cat pr-payer-cat-on";
    private const string _ptWalkIn="walk_in";
    private bool _isWalkIn => m.PatientType == _ptWalkIn;
    private const string _pSelf="self", _pCorp="corporate", _pIns="insurance", _pGovt="govt", _pOther="other_payer";
    private const string _togOn="sc-toggle sc-toggle-on", _togOff="sc-toggle";
    private const string _never="not_disclosed"; // hide sub-fields when not disclosed or never
    private const string _mtOn="pr-mtab pr-mtab-on";
    private const string _kFn="fn",_kLn="ln",_kDob="dob",_kGender="gender";
    private const string _kMob="mob",_kAlt="alt",_kWa="wa",_kEmail="email",_kEmail2="email2";

    private int    _tab=0;
    private bool   _saving=false, _saved=false;
    private string _successMsg=string.Empty, _errorMsg=string.Empty;
    private string _uhid=string.Empty, _gender=string.Empty;
    private string _ageDisp=string.Empty, _ageNote=string.Empty, _ageNoteCss="pr-note";
    private string _bmi=string.Empty;
    private bool   _clinicIndia=true;
    private string? _photoUrl;
    private IBrowserFile? _photoFile;
    private bool   _idOpen=false, _dupOpen=false;
    private int    _abdTab=0, _aadTab=0;
    private bool   _aadConsent=false, _aadParsing=false, _aadDone=false;
    private string _shareCode=string.Empty, _aadErr=string.Empty;
    private IBrowserFile? _aadFile;
    private bool   _pinErr=false, _cityErr=false, _stateErr=false;
    private string _pinErrMsg=string.Empty;
    private bool   _dupOverridden=false;
    private string _dupReason=string.Empty;
    private List<LiPi.Web.Services.DuplicateMatch> _dupMatches=new();

    private static readonly string[] _hints=[
        "Fill name, DOB/age, gender, contact details and flags.",
        "Enter address and PIN code.",
        "Occupation, measurements and lifestyle (optional).",
        "Patient type, doctor, referral and payer details (optional).",
        "Review all details and confirm consent."
    ];

    private sealed class PM {
        public string Title=string.Empty,FirstName=string.Empty,MiddleName=string.Empty,LastName=string.Empty,DisplayName=string.Empty;
        public string DateOfBirth=string.Empty,Gender=string.Empty,BloodGroup=string.Empty,MaritalStatus=string.Empty;
        public string Nationality="IN",Language="hi";
        public string MobCC="+91",Mobile=string.Empty,AltMobCC="+91",AltMobile=string.Empty;
        public string WaCC="+91",WhatsApp=string.Empty;
        public string LandISD="+91",LandSTD=string.Empty,LandNum=string.Empty;
        public string Email=string.Empty,Email2=string.Empty;
        public string AddressLine=string.Empty,City=string.Empty,State=string.Empty,PinCode=string.Empty;
        public string AbhaNumber=string.Empty,AbhaAddress=string.Empty,AadhaarLast4=string.Empty;
        public string OtherIdType=string.Empty,OtherIdValue=string.Empty;
        public string Occupation=string.Empty,Education=string.Empty,HeightCm=string.Empty,WeightKg=string.Empty;
        public string TobaccoStatus="not_disclosed",TobaccoType=string.Empty,TobaccoDuration=string.Empty;
        public string AlcoholUse="not_disclosed",Activity="not_disclosed";
        public string PatientType="walk_in",Priority="normal";
        public string RefSrc=string.Empty,RefBy=string.Empty;
        public string HowHeard=string.Empty,HowHeardDetail=string.Empty;
        public string Payer="self";
        public string CorpName=string.Empty,CorpEmpId=string.Empty,CorpHr=string.Empty,CorpHrPhone=string.Empty,CorpEmail=string.Empty;
        public string InsCo=string.Empty,TpaName=string.Empty,PolicyNo=string.Empty,PolHolder=string.Empty,PolRelation=string.Empty;
        public string PolFrom=string.Empty,PolTo=string.Empty,CashlessLimit=string.Empty;
        public bool   PreAuth=false;
        public string GovtScheme=string.Empty,BeneNo=string.Empty,BeneHolder=string.Empty,BeneRelation=string.Empty,SchemeFrom=string.Empty,IncomeGroup=string.Empty;
        public string OtherPayerName=string.Empty,OtherPayerRef=string.Empty;
        public bool VipFlag,Allergy,OrganDonor,Research,Intl,HipaaConsent=true,PhotoConsent;
    }
    private PM m=new();
    private readonly Dictionary<string,string> _errs=new();
    private readonly Dictionary<string,bool>   _tch=new();

    protected override async Task OnInitializedAsync()
    { _uhid=$"PT-{DateTime.Today.Year}-{Random.Shared.Next(100000,999999)}";
      await Task.CompletedTask; }

    private readonly HashSet<int> _visited = new();
    private void GoTab(int t) { _visited.Add(_tab); _tab=Math.Clamp(t,0,4); }
    private void HandleBack()  => GoTab(_tab-1);
    private void HandleCancel()=> Nav.NavigateTo(string.IsNullOrEmpty(ReturnModule)?"/patients":$"/module/{ReturnModule}");

    private async Task HandleNext()
    { _visited.Add(_tab); if (!ValidTab(_tab))
      { await JS.InvokeVoidAsync("eval","setTimeout(()=>{var el=document.querySelector('.pr-inp.err,.pr-sel.err,.pr-cc-inp.err');if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.focus();}},50)");
        return; }
      if (_tab==0 && !_dupOverridden)
      { await RunDupCheck(); if (_dupMatches.Count>0){_dupOpen=true;return;} }
      GoTab(_tab+1); }

    private bool ValidTab(int t)
    { _errorMsg=string.Empty;
      if (t==0)
      { foreach(var f in new[]{_kFn,_kLn,_kGender,_kMob}) Touch(f);
        if (string.IsNullOrEmpty(m.DateOfBirth)&&string.IsNullOrEmpty(_ageDisp)) _errs[_kDob]="Date of birth or age is required";
        return _errs.All(kv=>string.IsNullOrEmpty(kv.Value)); }
      if (t==1)
      { _pinErr=string.IsNullOrEmpty(m.PinCode); _pinErrMsg=_pinErr?"PIN code required":string.Empty;
        _cityErr=string.IsNullOrEmpty(m.City); _stateErr=string.IsNullOrEmpty(m.State);
        return !_pinErr&&!_cityErr&&!_stateErr; }
      return true; }

    private async Task HandleSubmit()
    { if (!_clinicIndia&&!m.HipaaConsent){_errorMsg="HIPAA consent is required.";return;}
      m.FirstName=OnlyLet(m.FirstName); m.MiddleName=OnlyLet(m.MiddleName); m.LastName=OnlyLet(m.LastName);
      Rebuild();
      _saving=true;_errorMsg=string.Empty;StateHasChanged();
      try
      { var user=(await AuthState).User;
        var cid=LiPi.Web.Services.ClaimsHelper.ClinicId(user)??throw new InvalidOperationException("No clinic in session.");
        var db=await ClinicDbFactory.CreateCoreForClinicAsync(cid)??throw new InvalidOperationException("Cannot connect to clinic database.");
        await using(db)
        { await using var tx=await db.Database.BeginTransactionAsync();
          var pe=new LiPi.Clinic.Core.Entities.Person{Id=Guid.NewGuid(),ClinicId=cid,Title=string.IsNullOrEmpty(m.Title)?null:m.Title,GivenName=m.FirstName,MiddleName=string.IsNullOrEmpty(m.MiddleName)?null:m.MiddleName,FamilyName=m.LastName,DisplayName=m.DisplayName,Gender=m.Gender,DateOfBirth=DateOnly.TryParse(m.DateOfBirth,out var dob)?dob:null,BloodGroup=string.IsNullOrEmpty(m.BloodGroup)?null:m.BloodGroup,MaritalStatus=string.IsNullOrEmpty(m.MaritalStatus)?null:m.MaritalStatus,NationalityCode=m.Nationality,PreferredLanguage=m.Language,CreatedAt=DateTimeOffset.UtcNow,UpdatedAt=DateTimeOffset.UtcNow};
          db.Persons.Add(pe);
          var pt=new LiPi.Clinic.Core.Entities.Patient{Id=Guid.NewGuid(),ClinicId=cid,PersonId=pe.Id,Mrn=_uhid,RegistrationDate=DateTimeOffset.UtcNow,VipFlag=m.VipFlag,OrganDonor=m.OrganDonor,PatientType=m.PatientType,ReferralSource=string.IsNullOrEmpty(m.RefSrc)?null:m.RefSrc,Occupation=string.IsNullOrEmpty(m.Occupation)?null:m.Occupation,CreatedAt=DateTimeOffset.UtcNow,UpdatedAt=DateTimeOffset.UtcNow};
          db.Patients.Add(pt);
          if(!string.IsNullOrEmpty(m.Mobile)) db.ContactPoints.Add(new LiPi.Clinic.Core.Entities.ContactPoint{Id=Guid.NewGuid(),ClinicId=cid,PersonId=pe.Id,System="phone",Value=m.MobCC+m.Mobile,UseType="mobile",IsPrimary=true,CreatedAt=DateTimeOffset.UtcNow,UpdatedAt=DateTimeOffset.UtcNow});
          if(!string.IsNullOrEmpty(m.Email)) db.ContactPoints.Add(new LiPi.Clinic.Core.Entities.ContactPoint{Id=Guid.NewGuid(),ClinicId=cid,PersonId=pe.Id,System="email",Value=m.Email,UseType="work",IsPrimary=false,CreatedAt=DateTimeOffset.UtcNow,UpdatedAt=DateTimeOffset.UtcNow});
          if(!string.IsNullOrEmpty(m.AadhaarLast4)) db.PatientIdentifiers.Add(new LiPi.Clinic.Core.Entities.PatientIdentifier{Id=Guid.NewGuid(),ClinicId=cid,PatientId=pt.Id,IdentifierType="aadhaar",IdentifierValue=m.AadhaarLast4,IssuingAuthority="UIDAI",IsVerified=_aadDone,CreatedAt=DateTimeOffset.UtcNow,UpdatedAt=DateTimeOffset.UtcNow});
          db.Consents.Add(new LiPi.Clinic.Core.Entities.Consent{Id=Guid.NewGuid(),ClinicId=cid,PatientId=pt.Id,ConsentType=_clinicIndia?"implied_walk_in":"hipaa_privacy",Granted=true,GrantedAt=DateTimeOffset.UtcNow,ValidFrom=DateTimeOffset.UtcNow,Scope="{}"});
          await db.SaveChangesAsync(); await tx.CommitAsync(); } }
      catch(Exception ex){_errorMsg=ex.Message;}
      finally{_saving=false;}
      if(string.IsNullOrEmpty(_errorMsg))
      { _saved=true; _successMsg=$"Patient '{m.DisplayName}' registered · MRN: {_uhid}";
        await Task.Delay(1500);
        Nav.NavigateTo(string.IsNullOrEmpty(ReturnModule)?"/patients":$"/module/{ReturnModule}"); } }

    private void SetPS() => m.Payer=_pSelf;
    private void SetPC() => m.Payer=_pCorp;
    private void SetPI() => m.Payer=_pIns;
    private void SetPG() => m.Payer=_pGovt;
    private void SetPO() => m.Payer=_pOther;

    private void TgVip()  => m.VipFlag    =!m.VipFlag;
    private void TgAl()   => m.Allergy    =!m.Allergy;
    private void TgOr()   => m.OrganDonor =!m.OrganDonor;
    private void TgRes()  => m.Research   =!m.Research;
    private void TgIntl() => m.Intl       =!m.Intl;
    private void TgPreAuth()=>m.PreAuth   =!m.PreAuth;

    private void OpenId()  => _idOpen=true;
    private void CloseId() => _idOpen=false;
    private void CloseDup()=> _dupOpen=false;
    private void OverrideDup(){_dupOverridden=true;_dupOpen=false;GoTab(1);}
    private void OpenExisting(Guid id){_dupOpen=false;Nav.NavigateTo($"/patients/{id}/edit");}
    private void SetAbdTab0()=>_abdTab=0; private void SetAbdTab1()=>_abdTab=1;
    private void SetAadTab0()=>_aadTab=0; private void SetAadTab1()=>_aadTab=1;

    private async Task TrigPhoto() => await JS.InvokeVoidAsync("eval","document.getElementById('pn-photo')?.click()");
    private async Task OnPhoto(InputFileChangeEventArgs e)
    { _photoFile=e.File;
      try{var buf=new byte[Math.Min(_photoFile.Size,2097152)];
          await using var s=_photoFile.OpenReadStream(maxAllowedSize:2097152);
          var rd=await s.ReadAsync(buf);
          _photoUrl=$"data:{_photoFile.ContentType};base64,{Convert.ToBase64String(buf,0,rd)}";}
      catch{_photoUrl=null;} }

    private void OnTitle(ChangeEventArgs e) {m.Title=e.Value?.ToString()??string.Empty;Rebuild();}
    private void OnFn(string? v)  {m.FirstName=OnlyLet(v);Rebuild();if(_tch.GetValueOrDefault(_kFn))Validate(_kFn);}
    private void OnFnBlur()       =>Touch(_kFn);
    private void OnMn(string? v)  =>m.MiddleName=OnlyLet(v);
    private void OnLn(string? v)  {m.LastName=OnlyLet(v);Rebuild();if(_tch.GetValueOrDefault(_kLn))Validate(_kLn);}
    private void OnLnBlur()       =>Touch(_kLn);
    private void OnGender(ChangeEventArgs e){_gender=e.Value?.ToString()??string.Empty;m.Gender=_gender;Touch(_kGender);}
    private void OnDob(ChangeEventArgs e)
    { m.DateOfBirth=e.Value?.ToString()??string.Empty;_tch[_kDob]=true;Validate(_kDob);
      if(!string.IsNullOrEmpty(m.DateOfBirth)&&DateTime.TryParse(m.DateOfBirth,out var d)&&d<=DateTime.Today)
      { var now=DateTime.Today;var age=now.Year-d.Year-(now<d.AddYears(now.Year-d.Year)?1:0);
        _ageDisp=age.ToString();_ageNote="exact age";_ageNoteCss="pr-note pr-note-ok";}
      else if(!string.IsNullOrEmpty(m.DateOfBirth)){_ageDisp=string.Empty;_ageNote=string.Empty;_ageNoteCss="pr-note";}
      StateHasChanged();}
    private void OnDobBlur()   =>Touch(_kDob);
    private void OnAgeSet(string? v)
    { _ageDisp=StripDig(v,3);
      if(int.TryParse(_ageDisp,out var age)&&age>0)
      { m.DateOfBirth=$"{DateTime.Today.Year-age}-01-01";_ageNote=$"est. Jan 1 {DateTime.Today.Year-age}";_ageNoteCss="pr-note pr-note-warn"; } }

    private void OnAge(ChangeEventArgs e)
    { _ageDisp=StripDig(e.Value?.ToString(),3);
      if(int.TryParse(_ageDisp,out var age)&&age>0)
      { m.DateOfBirth=$"{DateTime.Today.Year-age}-01-01";_ageNote=$"est. Jan 1 {DateTime.Today.Year-age}";_ageNoteCss="pr-note pr-note-warn"; } }
    private void OnBlood(ChangeEventArgs e) =>m.BloodGroup=e.Value?.ToString()??string.Empty;

    private void OnMobCC(ChangeEventArgs e){m.MobCC=e.Value?.ToString()??string.Empty;if(_tch.GetValueOrDefault(_kMob))Validate(_kMob);}
    private void OnMobSet(string? v)       {m.Mobile=StripDig(v,m.MobCC=="+91"?10:15);if(_tch.GetValueOrDefault(_kMob))Validate(_kMob);}
    private void OnMob(ChangeEventArgs e)  {m.Mobile=StripDig(e.Value?.ToString(),m.MobCC=="+91"?10:15);if(_tch.GetValueOrDefault(_kMob))Validate(_kMob);}
    private void OnMobBlur()               =>Touch(_kMob);
    private void OnAltMobSet(string? v)    {m.AltMobile=StripDig(v,15);if(_tch.GetValueOrDefault(_kAlt))Validate(_kAlt);}
    private void OnAltMob(ChangeEventArgs e){m.AltMobile=StripDig(e.Value?.ToString(),15);if(_tch.GetValueOrDefault(_kAlt))Validate(_kAlt);}
    private void OnAltBlur()               =>Touch(_kAlt);
    private void OnWaSet(string? v)        {m.WhatsApp=StripDig(v,15);if(_tch.GetValueOrDefault(_kWa))Validate(_kWa);}
    private void OnWaBlur()                =>Touch(_kWa);
    private void OnEmail(ChangeEventArgs e) {m.Email=e.Value?.ToString()??string.Empty;if(_tch.GetValueOrDefault(_kEmail))Validate(_kEmail);}
    private void OnEmailBlur()             =>Touch(_kEmail);
    private void OnEmail2(ChangeEventArgs e){m.Email2=e.Value?.ToString()??string.Empty;if(_tch.GetValueOrDefault(_kEmail2))Validate(_kEmail2);}
    private void OnEmail2Blur()            =>Touch(_kEmail2);

    private void OnHt(ChangeEventArgs e){m.HeightCm=e.Value?.ToString()??string.Empty;CalcBmi();}
    private void OnWt(ChangeEventArgs e){m.WeightKg=e.Value?.ToString()??string.Empty;CalcBmi();}

    private void OnPinChanged(string v)  { m.PinCode=v; if (_pinErr && !string.IsNullOrEmpty(v)) { _pinErr=false; _pinErrMsg=string.Empty; } }
    private void OnPinBlurred()          { _pinErr=string.IsNullOrEmpty(m.PinCode); _pinErrMsg=_pinErr?"PIN code is required":string.Empty; StateHasChanged(); }
    private void OnAddrBlurred()         { }  // address line not mandatory — no error needed
    private void OnCityBlurred()         { _cityErr=string.IsNullOrEmpty(m.City); StateHasChanged(); }
    private void OnStateBlurred()        { _stateErr=string.IsNullOrEmpty(m.State); StateHasChanged(); }
    private void OnCityChanged(string v) { m.City=v;   _cityErr=string.IsNullOrEmpty(v); StateHasChanged(); }
    private void OnStateChanged(string v){ m.State=v;  _stateErr=string.IsNullOrEmpty(v); StateHasChanged(); }

    private void OnPatTypeChange(ChangeEventArgs e)
    { m.PatientType=e.Value?.ToString()??string.Empty;
      if(m.PatientType!=_ptWalkIn){m.HowHeard="referral";m.HowHeardDetail=string.Empty;}
      else m.HowHeard=string.Empty; }
    private void OnHowHeardChange(ChangeEventArgs e)
    { m.HowHeard=e.Value?.ToString()??string.Empty;
      if(m.HowHeard!="doctor_referral")m.HowHeardDetail=string.Empty; }


    private void OnAadConsent(ChangeEventArgs e)=>_aadConsent=e.Value is true;
    private void OnAadhaarFile(InputFileChangeEventArgs e)=>_aadFile=e.File;
    private void OnShareCode(ChangeEventArgs e)=>_shareCode=StripDig(e.Value?.ToString(),4);
    private void OnAbha(ChangeEventArgs e)    =>m.AbhaNumber=e.Value?.ToString()??string.Empty;
    private void OnAbhaAddr(ChangeEventArgs e) =>m.AbhaAddress=e.Value?.ToString()??string.Empty;
    private void OnAad4(ChangeEventArgs e)     =>m.AadhaarLast4=StripDig(e.Value?.ToString(),4);
    private void OnOtherType(ChangeEventArgs e)=>m.OtherIdType=e.Value?.ToString()??string.Empty;
    private void OnOtherVal(ChangeEventArgs e) =>m.OtherIdValue=e.Value?.ToString()??string.Empty;
    private void OnDupReason(ChangeEventArgs e)=>_dupReason=e.Value?.ToString()??string.Empty;
    private void ClearAadhaar(){_aadDone=false;_aadFile=null;_shareCode=string.Empty;_aadErr=string.Empty;m.AadhaarLast4=string.Empty;_aadConsent=false;}

    private async Task ParseAadhaar()
    { if(_aadFile==null||_shareCode.Length!=4)return;
      _aadParsing=true;_aadErr=string.Empty;StateHasChanged();
      try
      { await using var s=_aadFile.OpenReadStream(maxAllowedSize:5242880);
        var r=await AadhaarSvc.ParseAsync(s,_shareCode);
        if(!r.Success){_aadErr=r.Error??"Unknown error";return;}
        if(!string.IsNullOrEmpty(r.FullName)){var p=r.FullName.Trim().Split(' ',2);m.FirstName=p[0];m.LastName=p.Length>1?p[^1]:string.Empty;Rebuild();}
        if(!string.IsNullOrEmpty(r.DateOfBirth)){m.DateOfBirth=r.DateOfBirth.Length==10?r.DateOfBirth:$"{r.DateOfBirth}-01-01";OnDob(new ChangeEventArgs{Value=m.DateOfBirth});}
        if(!string.IsNullOrEmpty(r.Gender)){m.Gender=r.Gender.ToUpperInvariant() switch{"M"=>"male","F"=>"female",_=>"other"};_gender=m.Gender;}
        if(!string.IsNullOrEmpty(r.AddressLine))m.AddressLine=r.AddressLine;
        if(!string.IsNullOrEmpty(r.District))m.City=r.District;
        if(!string.IsNullOrEmpty(r.State))m.State=r.State;
        if(!string.IsNullOrEmpty(r.PinCode))m.PinCode=r.PinCode;
        m.AadhaarLast4=r.LastFourUid??string.Empty;
        _aadDone=true;_idOpen=false; }
      catch(Exception ex){_aadErr=$"Error: {ex.Message}";}
      finally{_aadParsing=false;} }

    private async Task RunDupCheck()
    { _dupMatches=new();
      try
      { var user=(await AuthState).User;var cid=LiPi.Web.Services.ClaimsHelper.ClinicId(user);
        if(cid==null)return;
        var db=await ClinicDbFactory.CreateCoreForClinicAsync(cid.Value);
        if(db==null)return;
        await using(db)
        { var req=new LiPi.Web.Services.DuplicateCheckRequest{AadhaarLastFour=string.IsNullOrEmpty(m.AadhaarLast4)?null:m.AadhaarLast4,AbhaNumber=string.IsNullOrEmpty(m.AbhaNumber)?null:m.AbhaNumber,GivenName=m.FirstName,FamilyName=m.LastName,DateOfBirth=string.IsNullOrEmpty(m.DateOfBirth)?null:m.DateOfBirth,AgeDisplay=_ageDisp,DobConfidence=string.IsNullOrEmpty(m.DateOfBirth)?"estimated":"self_reported",Mobile=m.Mobile};
          _dupMatches=await DupSvc.CheckAsync(cid.Value,req,db); } }
      catch{} }

    private void Touch(string f){_tch[f]=true;Validate(f);StateHasChanged();}
    private void Validate(string f)
    { _errs[f]=f switch{
        var k when k==_kFn     =>string.IsNullOrWhiteSpace(m.FirstName)?"First name is required":string.Empty,
        var k when k==_kLn     =>string.IsNullOrWhiteSpace(m.LastName)?"Last name is required":string.Empty,
        var k when k==_kGender =>string.IsNullOrEmpty(_gender)?"Gender is required":string.Empty,
        var k when k==_kDob    =>(string.IsNullOrEmpty(m.DateOfBirth)&&string.IsNullOrEmpty(_ageDisp))?"Date of birth or age is required":(!string.IsNullOrEmpty(m.DateOfBirth)&&(!DateTime.TryParse(m.DateOfBirth,out var dv)||dv>DateTime.Today))?"Date of birth cannot be in the future":string.Empty,
        var k when k==_kMob    =>string.IsNullOrEmpty(m.Mobile)?"Mobile is required":m.MobCC=="+91"&&!Regex.IsMatch(m.Mobile,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kAlt    =>string.IsNullOrEmpty(m.AltMobile)?string.Empty:m.MobCC=="+91"&&!Regex.IsMatch(m.AltMobile,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kWa     =>string.IsNullOrEmpty(m.WhatsApp)?string.Empty:m.WaCC=="+91"&&!Regex.IsMatch(m.WhatsApp,"^[6-9]\\d{9}$")?"India: 10 digits starting 6-9":string.Empty,
        var k when k==_kEmail  =>string.IsNullOrEmpty(m.Email)?string.Empty:Regex.IsMatch(m.Email,"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")?string.Empty:"Invalid email address",
        var k when k==_kEmail2 =>string.IsNullOrEmpty(m.Email2)?string.Empty:Regex.IsMatch(m.Email2,"^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$")?string.Empty:"Invalid email address",
        _=>string.Empty }; }

    private string ErrCss(string f)=>_tch.GetValueOrDefault(f)&&!string.IsNullOrEmpty(_errs.GetValueOrDefault(f,string.Empty))?"err":string.Empty;
    private RenderFragment ErrFrag(string f)=>b=>{if(_tch.GetValueOrDefault(f)&&!string.IsNullOrEmpty(_errs.GetValueOrDefault(f,string.Empty))){b.OpenElement(0,"span");b.AddAttribute(1,"class","pr-err-msg");b.AddContent(2,_errs[f]);b.CloseElement();}};
    private static string DupCss(string s)=>s switch{"high"=>"dup-high","probable"=>"dup-probable",_=>"dup-possible"};
    private void Rebuild(){m.DisplayName=string.Join(" ",new[]{m.Title,m.FirstName,m.LastName}.Where(x=>!string.IsNullOrWhiteSpace(x)));}
    private void CalcBmi(){_bmi=string.Empty;if(float.TryParse(m.HeightCm,out var h)&&float.TryParse(m.WeightKg,out var w)&&h>0)_bmi=(w/(h/100f*(h/100f))).ToString("F1");}
    private static string BmiCat(string s)=>float.TryParse(s,out var v)?v switch{<18.5f=>"· Underweight",<25f=>"· Normal",<30f=>"· Overweight",_=>"· Obese"}:string.Empty;
    private string MobHint()=>m.MobCC switch{"+91"=>"10 digits 6-9","+1"=>"10 digits",_=>"Digits only"};
    private static string StripDig(string?s,int max=20)=>string.IsNullOrEmpty(s)?string.Empty:new string(s.Where(char.IsDigit).Take(max).ToArray());
    private static string OnlyLet(string?s)=>string.IsNullOrEmpty(s)?string.Empty:Regex.Replace(s,"[^a-zA-Z\\-\\.]",string.Empty);

    // ── Tab status indicators ────────────────────────────────────────────────
    private string TabStatus(int tab)
    {
        if (!_visited.Contains(tab) && _tab != tab) return "neutral";
        return tab switch
        {
            0 => Tab1Status(),
            1 => Tab2Status(),
            2 => Tab2OptStatus(),   // socioeconomic — optional
            3 => Tab3OptStatus(),   // reg details — optional
            _ => "neutral"
        };
    }

    private string Tab1Status()
    {
        // Mandatory: FirstName, LastName, Gender, Mobile, (DOB or Age)
        var fields = new[]
        {
            !string.IsNullOrWhiteSpace(m.FirstName),
            !string.IsNullOrWhiteSpace(m.LastName),
            !string.IsNullOrEmpty(_gender),
            !string.IsNullOrEmpty(m.Mobile),
            !string.IsNullOrEmpty(m.DateOfBirth) || !string.IsNullOrEmpty(_ageDisp),
        };
        var n = fields.Count(f => f);
        return n == 5 ? "complete" : n == 0 ? "empty" : "partial";
    }

    private string Tab2Status()
    {
        // Mandatory: PIN, City, State
        var fields = new[]
        {
            !string.IsNullOrWhiteSpace(m.PinCode),
            !string.IsNullOrWhiteSpace(m.City),
            !string.IsNullOrWhiteSpace(m.State),
        };
        var n = fields.Count(f => f);
        return n == 3 ? "complete" : n == 0 ? "empty" : "partial";
    }

    private string Tab2OptStatus() =>   // socioeconomic — optional
        (!string.IsNullOrEmpty(m.Occupation) || !string.IsNullOrEmpty(m.HeightCm) ||
         m.TobaccoStatus != _never || m.AlcoholUse != "none") ? "opt-filled" : "neutral";

    private string Tab3OptStatus() =>   // reg details — optional
        (!string.IsNullOrEmpty(m.RefSrc) || (!string.IsNullOrEmpty(m.HowHeard) && m.HowHeard != "referral") ||
         m.Payer != _pSelf) ? "opt-filled" : "neutral";

    private string TabCss(int tab)
    {
        if (_tab == tab) return _tabActive;
        return TabStatus(tab) switch
        {
            "complete"   => "pr-tab pr-tab-complete",
            "partial"    => "pr-tab pr-tab-partial",
            "empty"      => "pr-tab pr-tab-empty",
            "opt-filled" => "pr-tab pr-tab-complete pr-tab-optional",
            _            => "pr-tab pr-tab-optional",
        };
    }

    private string TabNum(int tab)
    {
        var nums = new[] { "01", "02", "03", "04", "05" };
        return TabStatus(tab) switch
        {
            "complete"   => "✓",
            "opt-filled" => "✓",
            "partial"    => nums[tab],
            "empty"      => nums[tab],
            _            => nums[tab],
        };
    }

}