    protected override async Task OnInitializedAsync()
    { _uhid=$"PT-{DateTime.Today.Year}-{Random.Shared.Next(100000,999999)}";
      // Load active aspirational districts from master DB
      try
      { await using var db = await MasterDbFactory.CreateDbContextAsync();
        var names = await db.AspirationalDistricts
            .Where(d => d.IsActive)
            .Select(d => d.DistrictName)
            .ToListAsync();
        _aspDistricts = new HashSet<string>(names, StringComparer.OrdinalIgnoreCase); }
      catch { /* non-fatal — aspirational badge simply won't show */ } }

    private readonly HashSet<int> _visited = new();
    private void GoTab(int t) { _visited.Add(_tab); _tab=Math.Clamp(t,0,4); }
    private void HandleBack()  => GoTab(_tab-1);
    private void HandleCancel()=> Nav.NavigateTo(string.IsNullOrEmpty(ReturnModule)?"/patients":$"/module/{ReturnModule}");

    private async Task HandleNext()
    { _visited.Add(_tab); if (!ValidTab(_tab))
      { await JS.InvokeVoidAsync("eval","setTimeout(()=>{var el=document.querySelector('.reg-inp.err,.reg-sel.err,.reg-split-r.err');if(el){el.scrollIntoView({behavior:'smooth',block:'center'});el.focus();}},50)");
        return; }
      if (_tab==0 && !_dupOverridden)
      { await RunDupCheck(); if (_dupMatches.Count>0){_dupOpen=true;return;} }
      GoTab(_tab+1); }

    private bool ValidTab(int t)
    { _errorMsg=string.Empty;
      if (t==0)
      { foreach(var f in new[]{_kFn,_kLn,_kGender,_kMob}) Touch(f);
        if (string.IsNullOrEmpty(m.DateOfBirth)&&string.IsNullOrEmpty(_ageDisp)) _errs[_kDob]="Date of birth or age is required";
        return _errs.All(kv=>string.IsNullOrEmpty(kv.Value)); }
      if (t==1)
      { _addrErr=string.IsNullOrWhiteSpace(m.AddressLine); _pinErr=string.IsNullOrEmpty(m.PinCode); _pinErrMsg=_pinErr?"PIN code required":string.Empty;
        _cityErr=string.IsNullOrEmpty(m.City); _stateErr=string.IsNullOrEmpty(m.State);
        return !_addrErr&&!_pinErr&&!_cityErr&&!_stateErr; }
      if (t==3)
      { Touch(_kRefBy);
        return _errs.GetValueOrDefault(_kRefBy,string.Empty)==string.Empty; }
      return true; }

    private async Task HandleSubmit()
    { if (!_clinicIndia&&!m.HipaaConsent){_errorMsg="HIPAA consent is required.";return;}
      m.FirstName=OnlyLet(m.FirstName); m.MiddleName=OnlyLet(m.MiddleName); m.LastName=OnlyLet(m.LastName);
      Rebuild();
      _saving=true;_errorMsg=string.Empty;StateHasChanged();
      try
      { var user=(await AuthState).User;
        var cid=LiPi.Web.Services.ClaimsHelper.ClinicId(user)??throw new InvalidOperationException("No clinic in session.");
        var userId=Guid.TryParse(user.Claims.FirstOrDefault(c=>c.Type=="sub")?.Value,out var uid)?uid:(Guid?)null;
        var db=await ClinicDbFactory.CreateCoreForClinicAsync(cid)??throw new InvalidOperationException("Clinic core database is not configured.");
        await using(db)
        { await using var tx=await db.Database.BeginTransactionAsync();

          // ── 1. Patient (collapsed — identity + clinical + JSONB) ────────
          var entityId = Guid.NewGuid();
          var socioExt=System.Text.Json.JsonSerializer.Serialize(new {
            education   = m.Education,
            height_cm   = m.HeightCm,
            weight_kg   = m.WeightKg,
            alcohol_use = m.AlcoholUse,
            activity    = m.Activity,
            tobacco     = m.TobaccoStatus,
            payer=new {
              category=m.Payer, corp_name=m.CorpName, policy_number=m.PolicyNumber,
              insurance_co=m.InsCo, tpa_name=m.TpaName,
              scheme_name=m.SchemeName, expiry=m.PolicyExpiry },
            referral_by=m.RefBy, how_did_hear=m.HowDidHear });
          var pt=new LiPi.Clinic.Core.Entities.Patient
          { Id=Guid.NewGuid(), EntityId=entityId,
            ClinicId=cid,
            Title=string.IsNullOrEmpty(m.Title)?null:m.Title,
            FirstName=m.FirstName, MiddleName=string.IsNullOrEmpty(m.MiddleName)?null:m.MiddleName,
            LastName=m.LastName,
            Gender=m.Gender,
            DateOfBirth=DateOnly.TryParse(m.DateOfBirth,out var dob)?dob:DateOnly.FromDateTime(DateTime.Today.AddYears(-(int.TryParse(_ageDisp,out var a)?a:0))),
            DobConfidence=string.IsNullOrEmpty(m.DateOfBirth)?"estimated":"self_reported",
            BloodGroup=string.IsNullOrEmpty(m.BloodGroup)?null:m.BloodGroup,
            MaritalStatus=string.IsNullOrEmpty(m.MaritalStatus)?null:m.MaritalStatus,
            NationalityCode=m.Nationality,
            PreferredLanguage=m.Language,
            Uhid=_uhid, Mrn=null,
            RegistrationDate=DateTimeOffset.UtcNow,
            PatientType=m.PatientType,
            Occupation=string.IsNullOrEmpty(m.Occupation)?null:m.Occupation,
            ReferralSource=string.IsNullOrEmpty(m.RefSrc)?null:m.RefSrc,
            ReferredBy=string.IsNullOrEmpty(m.RefBy)?null:m.RefBy,
            RegisteredBy=userId,
            ExtensionData=socioExt,
            ValidFrom=DateTimeOffset.UtcNow,
            CreatedAt=DateTimeOffset.UtcNow };
          db.Patients.Add(pt);

          // ── 3. Contact points (all phones + emails) ──────────────────
          void AddPhone(string cc,string num,string use,bool primary)
          { if(string.IsNullOrWhiteSpace(num))return;
            db.ContactPoints.Add(new LiPi.Clinic.Core.Entities.ContactPoint
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              System="phone",Value=(cc+num).Trim(),UseType=use,
              IsPrimary=primary,CreatedAt=DateTimeOffset.UtcNow }); }
          void AddEmail(string val,bool primary)
          { if(string.IsNullOrWhiteSpace(val))return;
            db.ContactPoints.Add(new LiPi.Clinic.Core.Entities.ContactPoint
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              System="email",Value=val.Trim(),UseType="work",
              IsPrimary=primary,CreatedAt=DateTimeOffset.UtcNow }); }
          AddPhone(m.MobCC,m.Mobile,"mobile",true);
          AddPhone(m.AltMobCC,m.AltMobile,"mobile",false);
          if(!string.IsNullOrWhiteSpace(m.WhatsApp)&&m.WhatsApp!=m.Mobile)
            AddPhone(m.WaCC,m.WhatsApp,"mobile",false);
          if(!string.IsNullOrWhiteSpace(m.LandNum))
            db.ContactPoints.Add(new LiPi.Clinic.Core.Entities.ContactPoint
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              System="phone",Value=(m.LandISD+m.LandSTD+m.LandNum).Trim(),
              UseType="home",IsPrimary=false,
              CreatedAt=DateTimeOffset.UtcNow });
          AddEmail(m.Email,true);
          AddEmail(m.Email2,false);

          // ── 4. Addresses ─────────────────────────────────────────────
          if (!string.IsNullOrWhiteSpace(m.AddressLine) && !string.IsNullOrWhiteSpace(m.City))
            db.Addresses.Add(new LiPi.Clinic.Core.Entities.Address
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,
              ClinicId=cid,AddressType="current",
              Line1=m.AddressLine,
              Line2=string.IsNullOrEmpty(m.AddressLine2)?null:m.AddressLine2,
              District=string.IsNullOrEmpty(m.District)?null:m.District,
              City=m.City,State=m.State,
              Pincode=string.IsNullOrEmpty(m.PinCode)?null:m.PinCode,
              CountryCode="IN",IsAspirational=_isAspirational,
              ValidFrom=DateTimeOffset.UtcNow,CreatedAt=DateTimeOffset.UtcNow });
          if (!m.PermSameAsCurrent &&
              !string.IsNullOrWhiteSpace(m.PermAddressLine) &&
              !string.IsNullOrWhiteSpace(m.PermCity))
            db.Addresses.Add(new LiPi.Clinic.Core.Entities.Address
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,
              ClinicId=cid,AddressType="permanent",
              Line1=m.PermAddressLine,
              Line2=string.IsNullOrEmpty(m.PermAddressLine2)?null:m.PermAddressLine2,
              District=string.IsNullOrEmpty(m.PermDistrict)?null:m.PermDistrict,
              City=m.PermCity,State=m.PermState,
              Pincode=string.IsNullOrEmpty(m.PermPinCode)?null:m.PermPinCode,
              CountryCode="IN",IsAspirational=_permIsAspirational,
              ValidFrom=DateTimeOffset.UtcNow,CreatedAt=DateTimeOffset.UtcNow });

          // ── 5. Identifiers (Aadhaar last 4, ABHA) ───────────────────
          if(!string.IsNullOrEmpty(m.AadhaarLast4))
            db.PatientIdentifiers.Add(new LiPi.Clinic.Core.Entities.PatientIdentifier
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              IdentifierType="aadhaar",IdentifierValue=m.AadhaarLast4,
              IssuingAuthority="UIDAI",IsVerified=_aadDone,
              CreatedAt=DateTimeOffset.UtcNow });
          if(!string.IsNullOrEmpty(m.AbhaNumber))
            db.PatientIdentifiers.Add(new LiPi.Clinic.Core.Entities.PatientIdentifier
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              IdentifierType="abha_number",IdentifierValue=m.AbhaNumber,
              IssuingAuthority="ABDM",IsVerified=false,
              CreatedAt=DateTimeOffset.UtcNow });
          if(!string.IsNullOrEmpty(m.AbhaAddress))
            db.PatientIdentifiers.Add(new LiPi.Clinic.Core.Entities.PatientIdentifier
            { Id=Guid.NewGuid(),EntityId=Guid.NewGuid(),PatientEntityId=entityId,ClinicId=cid,
              IdentifierType="abha_address",IdentifierValue=m.AbhaAddress,
              IssuingAuthority="ABDM",IsVerified=false,
              CreatedAt=DateTimeOffset.UtcNow });

          // ── 6. Implied treatment consent ─────────────────────────────
          db.Consents.Add(new LiPi.Clinic.Core.Entities.Consent
          { Id=Guid.NewGuid(),ClinicId=cid,PatientEntityId=entityId,
            ConsentType="treatment",Granted=true,
            GrantedAt=DateTimeOffset.UtcNow,ValidFrom=DateTimeOffset.UtcNow,
            Scope="{}",LanguageUsed=m.Language,
            CreatedAt=DateTimeOffset.UtcNow });

          await db.SaveChangesAsync(); await tx.CommitAsync(); } }
      catch(Exception ex)
      { var root=ex; while(root.InnerException!=null)root=root.InnerException;
        _errorMsg=$"{root.GetType().Name}: {root.Message}"; }
      finally{_saving=false;}
      if(string.IsNullOrEmpty(_errorMsg))
      { _saved=true; _successMsg=$"Patient '{m.DisplayName}' registered · UHID: {_uhid}";
        await Task.Delay(1500);
        Nav.NavigateTo(string.IsNullOrEmpty(ReturnModule)?"/patients/search":$"/module/{ReturnModule}"); } }

