                        <option value="secondary">Secondary</option><option value="higher_sec">Higher Secondary</option>
                        <option value="diploma">Diploma / ITI</option><option value="graduate">Graduate</option>
                        <option value="post_graduate">Post-Graduate</option><option value="professional">Professional</option>
