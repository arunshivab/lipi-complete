@page "/verify-otp/{UserId:guid}"
@using LiPi.Web.Services
@layout LiPi.Web.Components.EmptyLayout
@rendermode InteractiveServer
@inject OtpService OtpSvc
@inject NavigationManager Nav

<PageTitle>Verify OTP – LiPi HIS</PageTitle>

<div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#F0F4F8">
  <div style="background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(11,37,69,.12);padding:32px;width:380px;max-width:95vw">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <div style="width:40px;height:40px;background:#0B2545;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex-shrink:0">L</div>
      <div>
        <div style="font-size:15px;font-weight:700;color:#0B2545">Enter OTP</div>
        <div style="font-size:11px;color:#94A3B8">6-digit code from your email</div>
      </div>
    </div>
    <div style="height:1px;background:#E2E8F0;margin-bottom:20px"></div>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div style="color:#991B1B;font-size:12px;background:#FEF2F2;border:1px solid #FCA5A5;padding:10px 12px;border-radius:8px;margin-bottom:14px">⚠ @_error</div>
    }

    <div style="margin-bottom:20px">
      <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:8px" for="vo-otp">One-Time Password</label>
      <input id="vo-otp" name="otp" type="text" inputmode="numeric" autocomplete="one-time-code"
             maxlength="6"
             style="width:100%;height:52px;border:2px solid #E2E8F0;border-radius:10px;padding:0 16px;font-size:28px;font-weight:700;letter-spacing:10px;text-align:center;font-family:monospace;box-sizing:border-box"
             value="@_otp" @oninput="OnOtpInput" placeholder="------" />
      <div style="font-size:11px;color:#94A3B8;text-align:center;margin-top:6px">Expires in 10 minutes</div>
    </div>

    <button type="button" disabled="@(_busy || _otp.Length < 6)"
            style="width:100%;height:40px;background:#0B2545;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer;opacity:@(_otp.Length<6?"0.5":"1")"
            @onclick="HandleVerify">
      @(_busy ? "Verifying…" : "Verify OTP →")
    </button>

    <div style="text-align:center;margin-top:16px;display:flex;justify-content:space-between">
      <a href="/forgot-password" style="font-size:12px;color:#64748B;text-decoration:none">← Resend OTP</a>
      <a href="/" style="font-size:12px;color:#64748B;text-decoration:none">Back to Login</a>
    </div>
  </div>
</div>

@code {
  [Parameter] public Guid UserId { get; set; }

  private string _otp = "", _error = "";
  private bool   _busy;

  private void OnOtpInput(ChangeEventArgs e)
  {
    var val = System.Text.RegularExpressions.Regex.Replace(
        e.Value?.ToString() ?? "", @"\D", "");
    _otp = val.Length > 6 ? val[..6] : val;
  }

  private async Task HandleVerify()
  {
    _error = ""; _busy = true; StateHasChanged();
    try
    {
      await Task.Delay(300); // prevent timing attacks
      if (!OtpSvc.Verify(UserId, "forgot_password", _otp))
      {
        _error = "Incorrect or expired OTP. Please try again.";
        _otp   = "";
        return;
      }
      var token = OtpSvc.GenerateResetToken(UserId);
      Nav.NavigateTo($"/reset-password/{token}");
    }
    finally { _busy = false; }
  }
}
