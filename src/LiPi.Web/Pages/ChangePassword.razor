@page "/change-password"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using System.Text.RegularExpressions
@using Isopoh.Cryptography.Argon2
@using LiPi.Master
@using LiPi.Master.Entities
@using LiPi.Web.Services
@using Microsoft.EntityFrameworkCore
@layout LiPi.Web.Components.EmptyLayout
@attribute [Authorize]
@rendermode InteractiveServer
@inject IDbContextFactory<MasterDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Change Password – LiPi HIS</PageTitle>

<div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#F0F4F8">
  <div style="background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(11,37,69,.12);padding:32px;width:380px;max-width:95vw">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <div style="width:40px;height:40px;background:#0B2545;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex-shrink:0">L</div>
      <div>
        <div style="font-size:15px;font-weight:700;color:#0B2545">Set new password</div>
        <div style="font-size:11px;color:#94A3B8">Required before continuing</div>
      </div>
    </div>

    <div style="height:1px;background:#E2E8F0;margin-bottom:20px"></div>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div style="color:#991B1B;font-size:12px;background:#FEF2F2;border:1px solid #FCA5A5;padding:10px 12px;border-radius:8px;margin-bottom:14px">⚠ @_error</div>
    }
    @if (!string.IsNullOrEmpty(_success))
    {
      <div style="color:#065F46;font-size:12px;background:#ECFDF5;border:1px solid #6EE7B7;padding:10px 12px;border-radius:8px;margin-bottom:14px">✓ @_success</div>
    }

    <div style="margin-bottom:14px">
      <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px" for="cp-pwd">New Password</label>
      <input id="cp-pwd" name="newPassword" type="password" autocomplete="new-password"
             style="width:100%;height:36px;border:1px solid @(!string.IsNullOrEmpty(_pwdErr)?"#FCA5A5":"#E2E8F0");border-radius:8px;padding:0 12px;font-size:13px;outline:none;box-sizing:border-box"
             value="@_pwd" @oninput="OnPwd" placeholder="Min 8 chars, upper+digit+symbol" />
      @if (!string.IsNullOrEmpty(_pwdErr))
      { <span style="font-size:11px;color:#EF4444">@_pwdErr</span> }
    </div>

    <div style="margin-bottom:20px">
      <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px" for="cp-cpwd">Confirm Password</label>
      <input id="cp-cpwd" name="confirmPassword" type="password" autocomplete="new-password"
             style="width:100%;height:36px;border:1px solid @(!string.IsNullOrEmpty(_confirmErr)?"#FCA5A5":"#E2E8F0");border-radius:8px;padding:0 12px;font-size:13px;outline:none;box-sizing:border-box"
             value="@_confirm" @oninput="OnConfirm" placeholder="Repeat password" />
      @if (!string.IsNullOrEmpty(_confirmErr))
      { <span style="font-size:11px;color:#EF4444">@_confirmErr</span> }
    </div>

    <button type="button" disabled="@_saving"
            style="width:100%;height:40px;background:#0B2545;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:@(_saving?"wait":"pointer");opacity:@(_saving?"0.7":"1")"
            @onclick="HandleSubmit">
      @(_saving ? "Saving…" : "Set Password & Continue →")
    </button>

  </div>
</div>

@code {
  [CascadingParameter] Task<AuthenticationState> AuthState { get; set; } = default!;

  private string _pwd = "", _confirm = "";
  private string _error = "", _pwdErr = "", _confirmErr = "", _success = "";
  private bool _saving;

  private void OnPwd(ChangeEventArgs e)
  {
    _pwd = e.Value?.ToString() ?? "";
    _pwdErr = "";
    // Live confirm match check
    if (!string.IsNullOrEmpty(_confirm) && _confirm != _pwd)
      _confirmErr = "Passwords do not match";
    else if (!string.IsNullOrEmpty(_confirm))
      _confirmErr = "";
  }

  private void OnConfirm(ChangeEventArgs e)
  {
    _confirm = e.Value?.ToString() ?? "";
    _confirmErr = _confirm != _pwd ? "Passwords do not match" : "";
  }

  private async Task HandleSubmit()
  {
    _pwdErr = _confirmErr = _error = "";

    if (string.IsNullOrWhiteSpace(_pwd))        { _pwdErr = "Password required"; return; }
    if (_pwd.Length < 8)                         { _pwdErr = "Min 8 characters"; return; }
    if (!Regex.IsMatch(_pwd, @"[A-Z]"))          { _pwdErr = "Need one uppercase letter"; return; }
    if (!Regex.IsMatch(_pwd, @"[0-9]"))          { _pwdErr = "Need one digit"; return; }
    if (!Regex.IsMatch(_pwd, @"[^A-Za-z0-9]"))  { _pwdErr = "Need one symbol (!@#$...)"; return; }
    if (string.IsNullOrWhiteSpace(_confirm))     { _confirmErr = "Please confirm your password"; return; }
    if (_confirm != _pwd)                        { _confirmErr = "Passwords do not match"; return; }

    _saving = true; StateHasChanged();
    try
    {
      var user   = (await AuthState).User;
      var userId = Guid.Parse(user.FindFirstValue(ClaimTypes.NameIdentifier) ?? Guid.Empty.ToString());

      await using var db = await DbFactory.CreateDbContextAsync();
      var pu = await db.PlatformUsers.FindAsync(userId);
      if (pu == null) { _error = "User not found. Please log in again."; return; }

      pu.PasswordHash       = Argon2.Hash(_pwd);
      pu.MustChangePassword = false;
      pu.UpdatedAt          = DateTime.UtcNow;
      await db.SaveChangesAsync();

      _success = "Password set! Redirecting…";
      StateHasChanged();
      await Task.Delay(1200);
      Nav.NavigateTo("/dashboard", forceLoad: true);
    }
    catch (Exception ex) { _error = $"Error: {ex.Message}"; }
    finally { _saving = false; StateHasChanged(); }
  }
}
