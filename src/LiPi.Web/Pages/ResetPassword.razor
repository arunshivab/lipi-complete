@page "/reset-password/{Token}"
@using System.Text.RegularExpressions
@using Isopoh.Cryptography.Argon2
@using LiPi.Master
@using LiPi.Web.Services
@using Microsoft.EntityFrameworkCore
@layout LiPi.Web.Components.EmptyLayout
@rendermode InteractiveServer
@inject IDbContextFactory<MasterDbContext> DbFactory
@inject OtpService OtpSvc
@inject IEmailService EmailSvc
@inject NavigationManager Nav

<PageTitle>Reset Password – LiPi HIS</PageTitle>

<div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#F0F4F8">
  <div style="background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(11,37,69,.12);padding:32px;width:380px;max-width:95vw">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <div style="width:40px;height:40px;background:#0B2545;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex-shrink:0">L</div>
      <div>
        <div style="font-size:15px;font-weight:700;color:#0B2545">Set New Password</div>
        <div style="font-size:11px;color:#94A3B8">Choose a strong password</div>
      </div>
    </div>
    <div style="height:1px;background:#E2E8F0;margin-bottom:20px"></div>

    @if (_tokenInvalid)
    {
      <div style="text-align:center;padding:10px 0">
        <div style="font-size:32px;margin-bottom:12px">⏱</div>
        <div style="font-size:14px;color:#991B1B;margin-bottom:16px">Link expired or already used.</div>
        <a href="/forgot-password" class="btn-primary">Try Again</a>
      </div>
    }
    else if (_done)
    {
      <div style="text-align:center;padding:10px 0">
        <div style="font-size:32px;margin-bottom:12px">✅</div>
        <div style="font-size:14px;font-weight:600;color:#065F46;margin-bottom:6px">Password reset!</div>
        <div style="font-size:12px;color:#64748B;margin-bottom:20px">You can now log in with your new password.</div>
        <a href="/" class="btn-primary">Go to Login</a>
      </div>
    }
    else
    {
      @if (!string.IsNullOrEmpty(_error))
      {
        <div style="color:#991B1B;font-size:12px;background:#FEF2F2;border:1px solid #FCA5A5;padding:10px 12px;border-radius:8px;margin-bottom:14px">⚠ @_error</div>
      }

      <div style="margin-bottom:14px">
        <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px" for="rp-pwd">New Password</label>
        <input id="rp-pwd" name="newPassword" type="password" autocomplete="new-password"
               style="width:100%;height:36px;border:1px solid @(!string.IsNullOrEmpty(_pwdErr)?"#FCA5A5":"#E2E8F0");border-radius:8px;padding:0 12px;font-size:13px;box-sizing:border-box"
               value="@_pwd" @oninput="OnPwd" placeholder="Min 8 chars, upper+digit+symbol" />
        @if (!string.IsNullOrEmpty(_pwdErr))
        { <span style="font-size:11px;color:#EF4444">@_pwdErr</span> }
      </div>

      <div style="margin-bottom:20px">
        <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px" for="rp-cpwd">Confirm Password</label>
        <input id="rp-cpwd" name="confirmPassword" type="password" autocomplete="new-password"
               style="width:100%;height:36px;border:1px solid @(!string.IsNullOrEmpty(_confirmErr)?"#FCA5A5":"#E2E8F0");border-radius:8px;padding:0 12px;font-size:13px;box-sizing:border-box"
               value="@_confirm" @oninput="OnConfirm" placeholder="Repeat password" />
        @if (!string.IsNullOrEmpty(_confirmErr))
        { <span style="font-size:11px;color:#EF4444">@_confirmErr</span> }
      </div>

      <button type="button" disabled="@_saving"
              style="width:100%;height:40px;background:#0B2545;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"
              @onclick="HandleReset">
        @(_saving ? "Saving…" : "Reset Password")
      </button>
    }
  </div>
</div>

@code {
  [Parameter] public string Token { get; set; } = string.Empty;

  private string _pwd = "", _confirm = "";
  private string _error = "", _pwdErr = "", _confirmErr = "";
  private bool   _saving, _done, _tokenInvalid;

  protected override void OnInitialized()
  {
    // Validate token exists (don't consume it yet)
    if (string.IsNullOrWhiteSpace(Token)) _tokenInvalid = true;
  }

  private void OnPwd(ChangeEventArgs e)
  {
    _pwd = e.Value?.ToString() ?? ""; _pwdErr = "";
    if (!string.IsNullOrEmpty(_confirm))
      _confirmErr = _confirm != _pwd ? "Passwords do not match" : "";
  }
  private void OnConfirm(ChangeEventArgs e)
  {
    _confirm = e.Value?.ToString() ?? "";
    _confirmErr = _confirm != _pwd ? "Passwords do not match" : "";
  }

  private async Task HandleReset()
  {
    _pwdErr = _confirmErr = _error = "";
    if (string.IsNullOrWhiteSpace(_pwd))        { _pwdErr = "Password required"; return; }
    if (_pwd.Length < 8)                         { _pwdErr = "Min 8 characters"; return; }
    if (!Regex.IsMatch(_pwd, @"[A-Z]"))          { _pwdErr = "Need one uppercase letter"; return; }
    if (!Regex.IsMatch(_pwd, @"[0-9]"))          { _pwdErr = "Need one digit"; return; }
    if (!Regex.IsMatch(_pwd, @"[^A-Za-z0-9]"))  { _pwdErr = "Need one symbol"; return; }
    if (_confirm != _pwd)                        { _confirmErr = "Passwords do not match"; return; }

    _saving = true; StateHasChanged();
    try
    {
      var userId = OtpSvc.ConsumeResetToken(Token);
      if (userId == null) { _tokenInvalid = true; return; }

      await using var db = await DbFactory.CreateDbContextAsync();
      var user = await db.PlatformUsers.FindAsync(userId.Value);
      if (user == null) { _error = "User not found."; return; }

      user.PasswordHash       = Argon2.Hash(_pwd);
      user.MustChangePassword = false;
      user.UpdatedAt          = DateTime.UtcNow;
      await db.SaveChangesAsync();

      // Send confirmation email (best-effort)
      try { await EmailSvc.SendPasswordChangedAsync(user.Email, user.DisplayName); } catch { }

      _done = true;
    }
    catch (Exception ex) { _error = $"Error: {ex.Message}"; }
    finally { _saving = false; }
  }
}
