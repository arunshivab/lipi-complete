@*
    SPEC:     docs/00-COMPONENTS/00.2-THEMING-ARCHITECTURE.md (Foundation tokens)
    SPEC:     docs/00-COMPONENTS/01.1-Buttons.md (LipiButton)
    SPEC:     docs/00-COMPONENTS/01.2-TextInputs.md (LipiTextBox, LipiTextArea,
              LipiNumberInput, LipiSelect, LipiCombobox — Phase 2.2 Batch 6 NEW)
    DECISION: docs/00-PROJECT-BASELINE.md §12.5 (Style Guide Page)
    PHASE:    Phase 2 Sub-step 2.0 — Foundation showcase (DEPLOYED)
              Phase 2 Sub-step 2.1 — Buttons component showcase (DEPLOYED)
              Phase 2 Sub-step 2.2 — Text Inputs component showcase (NEW Batch 6)
    AUTH:     SiteAdmin / SysAdmin / GlobalAdmin only
    LOCATION: src/LiPi.Web/Pages/StyleGuide.razor
              (placed directly in Pages/ — Pages/Admin.razor already
               exists, so a Pages/Admin/ subfolder would collide.)

    AUTH PATTERN (FIX 2026-05-03 v2):
              Matches the production-proven pattern used by Settings.razor,
              Users.razor, etc. Roles in ClaimTypes.Role with snake_case values:
              "global_admin", "sys_admin", "site_admin", "staff".

    JS INTEROP (FIX 2026-05-03 v3):
              theme-switcher.js exposes window.lipiTheme with:
                - apply(brand, mode)        ← sets attributes + writes cookies
                - getCurrentTheme()         ← returns { brand, mode } object
                - init()                    ← cookie-driven re-init
              Earlier draft incorrectly called lipiTheme.set/.get which don't exist.

    PHASE 2.2 ADDITIONS (Batch 6, 2026-05-05):
              New sections under Components → Text Inputs covering all 5 input
              components with full state matrix, sizes, locale demos for
              LipiNumberInput, search/pinned/AllowFreeText for LipiSelect/Combobox,
              and a §7 alignment-comparison row that wraps LipiButton in
              .lipi-input-wrapper structure for label/helper typography parity
              (showcase-only — production forms don't wrap buttons this way).
*@

@page "/admin/style-guide"
@layout LiPi.Web.Components.Layouts.TopNavLayout
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop
@using System.Security.Claims
@using LiPi.Web.Components.Shared
@inject IJSRuntime JS
@inject NavigationManager Nav

<SectionContent SectionName="page-title">LiPi Component Library</SectionContent>

<div class="sg-page">

    <!-- ===== Top bar: title + mode toggle ===== -->
    <header class="sg-topbar">
        <div class="sg-titleblock">
            <h1 class="sg-h1">LiPi Component Library</h1>
            <p class="sg-subtitle">Living style guide for the LiPi HIS design system</p>
            <div class="sg-status">
                Current theme: <code class="sg-code">@_brand · @_mode</code>
            </div>
        </div>
        <div class="sg-modeswitcher" role="group" aria-label="Theme mode">
            <button type="button"
                    class="sg-mode-btn @(_mode == "light" ? "active" : string.Empty)"
                    @onclick="SetLight"
                    aria-pressed="@(_mode == "light")">
                <span class="sg-mode-icon" aria-hidden="true">☀</span> Light
            </button>
            <button type="button"
                    class="sg-mode-btn @(_mode == "dark" ? "active" : string.Empty)"
                    @onclick="SetDark"
                    aria-pressed="@(_mode == "dark")">
                <span class="sg-mode-icon" aria-hidden="true">🌙</span> Dark
            </button>
        </div>
    </header>

    <!-- ===== Layout: sidebar + content ===== -->
    <div class="sg-layout">

        <!-- Sidebar -->
        <aside class="sg-sidebar" aria-label="Style guide sections">
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">Foundation</h3>
                <a class="sg-nav-link" href="#colors">Colors</a>
                <a class="sg-nav-link" href="#typography">Typography</a>
                <a class="sg-nav-link" href="#spacing">Spacing</a>
                <a class="sg-nav-link" href="#radius">Radius</a>
                <a class="sg-nav-link" href="#shadows">Shadows</a>
            </div>
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">Components</h3>
                <a class="sg-nav-link" href="#buttons">Buttons</a>
                <a class="sg-nav-link" href="#text-inputs">Text Inputs</a>
                <a class="sg-nav-link" href="#alignment">Alignment</a>
                <a class="sg-nav-link" href="#compound-multi">Compound &amp; Multi-Select</a>
                <a class="sg-nav-link" href="#date-time">Date &amp; Time</a>
                <a class="sg-nav-link" href="#label-positions">Label Positions</a>
            </div>
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">Patterns</h3>
                <span class="sg-nav-link sg-nav-disabled">(Coming later)</span>
            </div>
        </aside>

        <!-- Content -->
        <main class="sg-content">

            <!-- ====== COLORS ====== -->
            <section id="colors" class="sg-section">
                <h2 class="sg-h2">Colors</h2>
                <p class="sg-p">
                    All color tokens resolve based on <code class="sg-code">data-mode</code> on
                    <code class="sg-code">&lt;html&gt;</code>. Switch the mode toggle above to see
                    live values change. Hover any swatch to see the resolved CSS value.
                </p>

                @foreach (var group in _colorGroups)
                {
                    <h3 class="sg-h3">@group.Title</h3>
                    <div class="sg-swatch-row">
                        @foreach (var token in group.Tokens)
                        {
                            <div class="sg-swatch">
                                <div class="sg-swatch-box" style="background: var(@token);"
                                     title="@token"></div>
                                <div class="sg-swatch-label">@token</div>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- ====== TYPOGRAPHY ====== -->
            <section id="typography" class="sg-section">
                <h2 class="sg-h2">Typography</h2>
                <p class="sg-p">
                    Two-font system: <strong>LiPi Sans</strong> for all UI,
                    <strong>LiPi Mono</strong> for IDs / dates / clinical data.
                </p>
                <div class="sg-typo-list">
                    @foreach (var t in _typoSamples)
                    {
                        <div class="sg-typo-row">
                            <div class="sg-typo-meta">
                                <code class="sg-code">@t.Token</code>
                                <span class="sg-typo-spec">@t.SizePx · @t.Weight</span>
                            </div>
                            <div class="sg-typo-sample"
                                 style="font-size: var(@t.Token); font-weight: @t.Weight; @(t.Mono ? "font-family: var(--font-mono);" : string.Empty)">
                                @t.Sample
                            </div>
                        </div>
                    }
                </div>
            </section>

            <!-- ====== SPACING ====== -->
            <section id="spacing" class="sg-section">
                <h2 class="sg-h2">Spacing</h2>
                <p class="sg-p">Used for padding, margins, gaps. All multiples of 4px.</p>
                <div class="sg-spacing-list">
                    @foreach (var s in _spacingTokens)
                    {
                        <div class="sg-spacing-row">
                            <code class="sg-code sg-spacing-token">@s.Token</code>
                            <div class="sg-spacing-bar" style="width: var(@s.Token);"></div>
                            <span class="sg-spacing-px">@s.Px</span>
                        </div>
                    }
                </div>
            </section>

            <!-- ====== RADIUS ====== -->
            <section id="radius" class="sg-section">
                <h2 class="sg-h2">Border Radius</h2>
                <p class="sg-p">
                    Updated 2026-05-03 (was 4/7/10/16). Buttons + inputs share
                    <code class="sg-code">--r-sm</code> (6px).
                </p>
                <div class="sg-radius-row">
                    @foreach (var r in _radiusTokens)
                    {
                        <div class="sg-radius-item">
                            <div class="sg-radius-box" style="border-radius: var(@r.Token);"></div>
                            <code class="sg-code">@r.Token</code>
                            <span class="sg-radius-px">@r.Px</span>
                        </div>
                    }
                </div>
            </section>

            <!-- ====== SHADOWS ====== -->
            <section id="shadows" class="sg-section">
                <h2 class="sg-h2">Shadows</h2>
                <p class="sg-p">
                    Two-layer navy-tinted on light (admin.css formula), single-layer black on dark.
                </p>
                <div class="sg-shadow-row">
                    @foreach (var s in _shadowTokens)
                    {
                        <div class="sg-shadow-item">
                            <div class="sg-shadow-box" style="box-shadow: var(@s.Token);">
                                <code class="sg-code">@s.Token</code>
                            </div>
                            <span class="sg-shadow-label">@s.Label</span>
                        </div>
                    }
                </div>
            </section>

            <!-- ====== BUTTONS (Phase 2.1) ====== -->
            <section id="buttons" class="sg-section">
                <h2 class="sg-h2">Buttons</h2>
                <p class="sg-p">
                    5 variants × 3 sizes. Icon-only mode inferred from absent <code class="sg-code">ChildContent</code>
                    (requires <code class="sg-code">AriaLabel</code>). Loading state is parent-controlled.
                    <code class="sg-code">ConfirmMessage</code> uses <code class="sg-code">window.confirm()</code> in v1.0.
                </p>

                @* Variants × Sizes Grid *@
                <h3 class="sg-h3">Variants × Sizes (15 buttons)</h3>
                <div class="sg-button-grid">
                    @foreach (var variant in _variants)
                    {
                        <div class="sg-button-row">
                            <span class="sg-button-label">@variant</span>
                            <LipiButton Size="ButtonSize.Small"  Variant="@variant">Small</LipiButton>
                            <LipiButton Size="ButtonSize.Medium" Variant="@variant">Medium</LipiButton>
                            <LipiButton Size="ButtonSize.Large"  Variant="@variant">Large</LipiButton>
                        </div>
                    }
                </div>

                @* States Demo *@
                <h3 class="sg-h3">States — Primary Medium</h3>
                <div class="sg-button-row">
                    <LipiButton Variant="ButtonVariant.Primary" Icon="save">Default</LipiButton>
                    <LipiButton Variant="ButtonVariant.Primary" Icon="save" Disabled="true">Disabled</LipiButton>
                    <LipiButton Variant="ButtonVariant.Primary" Icon="save" IsLoading="true">Loading</LipiButton>
                    <span class="sg-state-hint">Hover, focus, and active states visible on interaction. Loading swaps icon for spinner; text stays.</span>
                </div>

                @* Icon Patterns *@
                <h3 class="sg-h3">Icon Patterns</h3>
                <div class="sg-button-row">
                    <LipiButton Icon="check">Icon Left</LipiButton>
                    <LipiButton IconRight="arrow-right">Icon Right</LipiButton>
                    <LipiButton Icon="save" IconRight="chevron-down">Both</LipiButton>
                    <LipiButton Variant="ButtonVariant.Ghost" Icon="x" AriaLabel="Close" />
                    <LipiButton Variant="ButtonVariant.Secondary" Icon="settings" AriaLabel="Settings" />
                    <LipiButton Variant="ButtonVariant.Danger" Icon="trash" AriaLabel="Delete" />
                </div>

                @* Real-World Use Cases *@
                <h3 class="sg-h3">Real-World Use Cases</h3>

                <div class="sg-use-case">
                    <span class="sg-use-case-label">Form actions (Save + Cancel pair):</span>
                    <LipiButton Variant="ButtonVariant.Primary" Icon="save" OnClick="DemoSave">Save Patient</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" OnClick="DemoCancel">Cancel</LipiButton>
                    @if (!string.IsNullOrEmpty(_lastAction))
                    {
                        <span class="sg-use-case-feedback">@_lastAction</span>
                    }
                </div>

                <div class="sg-use-case">
                    <span class="sg-use-case-label">Destructive with confirmation:</span>
                    <LipiButton Variant="ButtonVariant.Danger"
                                Icon="trash"
                                ConfirmMessage="Delete this record? This cannot be undone."
                                OnClick="DemoDelete">
                        Delete Record
                    </LipiButton>
                </div>

                <div class="sg-use-case">
                    <span class="sg-use-case-label">Async save (parent toggles IsLoading):</span>
                    <LipiButton Variant="ButtonVariant.Primary"
                                Icon="save"
                                IsLoading="@_isSaving"
                                OnClick="DemoAsyncSave">
                        Save Changes
                    </LipiButton>
                </div>

                <div class="sg-use-case">
                    <span class="sg-use-case-label">Full-width form submit:</span>
                    <div class="sg-form-width">
                        <LipiButton Variant="ButtonVariant.Primary"
                                    FullWidth="true"
                                    Type="submit">
                            Sign In
                        </LipiButton>
                    </div>
                </div>
            </section>

            <!-- ====== TEXT INPUTS (Phase 2.2 Batch 6) ====== -->
            <section id="text-inputs" class="sg-section">
                <h2 class="sg-h2">Text Inputs</h2>
                <p class="sg-p">
                    Five components share <code class="sg-code">InputBase&lt;TValue&gt;</code> derivation
                    so all participate in <code class="sg-code">EditForm</code> validation,
                    <code class="sg-code">DataAnnotationsValidator</code>, and the
                    <code class="sg-code">ValidationMessage&lt;For&gt;</code> pipeline. State precedence:
                    <strong>Disabled &gt; ReadOnly &gt; Error &gt; Success &gt; Warning &gt; RequiredEmpty &gt; Default</strong>.
                    See <code class="sg-code">docs/00-COMPONENTS/01.2-TextInputs.md</code> for the full spec.
                </p>

                @* ====== LipiTextBox ====== *@
                <h3 class="sg-h3">LipiTextBox — single-line text</h3>
                <div class="sg-input-grid">
                    <LipiTextBox Name="sg-tb-default" Label="Default"
                                 Placeholder="Type something"
                                 @bind-Value="_sg.TbDefault" />
                    <LipiTextBox Name="sg-tb-required" Label="Required"
                                 Required="true"
                                 Placeholder="Required field"
                                 @bind-Value="_sg.TbRequired" />
                    <LipiTextBox Name="sg-tb-error" Label="Error"
                                 Error="Must be at least 3 characters"
                                 @bind-Value="_sg.TbError" />
                    <LipiTextBox Name="sg-tb-warning" Label="Warning"
                                 Warning="Verify with patient"
                                 @bind-Value="_sg.TbWarning" />
                    <LipiTextBox Name="sg-tb-success" Label="Success"
                                 Success="Confirmed"
                                 @bind-Value="_sg.TbSuccess" />
                    <LipiTextBox Name="sg-tb-readonly" Label="Read-only"
                                 ReadOnly="true"
                                 @bind-Value="_sg.TbReadonly" />
                    <LipiTextBox Name="sg-tb-disabled" Label="Disabled"
                                 Disabled="true"
                                 @bind-Value="_sg.TbDisabled" />
                    <LipiTextBox Name="sg-tb-icon" Label="With leading icon"
                                 Icon="user"
                                 Placeholder="Search staff"
                                 @bind-Value="_sg.TbIcon" />
                    <LipiTextBox Name="sg-tb-confidence" Label="With confidence pill"
                                 LabelConfidence="ConfidenceLevel.Verified"
                                 @bind-Value="_sg.TbConfidence" />
                </div>

                <h3 class="sg-h3">LipiTextBox — sizes (28 / 32 / 40)</h3>
                <div class="sg-input-grid sg-input-grid-3">
                    <LipiTextBox Name="sg-tb-small" Label="Small (28px)"
                                 Size="InputSize.Small"
                                 @bind-Value="_sg.TbSmall" />
                    <LipiTextBox Name="sg-tb-medium" Label="Medium (32px)"
                                 @bind-Value="_sg.TbMedium" />
                    <LipiTextBox Name="sg-tb-large" Label="Large (40px)"
                                 Size="InputSize.Large"
                                 @bind-Value="_sg.TbLarge" />
                </div>

                @* ====== LipiTextArea ====== *@
                <h3 class="sg-h3">LipiTextArea — multi-line with autogrow</h3>
                <p class="sg-p">
                    <code class="sg-code">MinRows</code> sets initial visible height;
                    <code class="sg-code">MaxRows</code> caps growth (then scrolls). Autogrow
                    measured via <code class="sg-code">scrollHeight</code> in
                    <code class="sg-code">lipi-input.js</code>.
                </p>
                <div class="sg-input-grid sg-input-grid-2">
                    <LipiTextArea Name="sg-ta-default" Label="Default (3 rows min)"
                                  Placeholder="Type a multi-line note. The textarea grows as you type, up to 8 rows, then scrolls."
                                  @bind-Value="_sg.TaDefault" />
                    <LipiTextArea Name="sg-ta-clamped" Label="Clamped (max 4 rows)"
                                  MaxRows="4"
                                  Placeholder="This area stops growing at 4 rows and starts scrolling."
                                  @bind-Value="_sg.TaClamped" />
                </div>

                @* ====== LipiNumberInput ====== *@
                <h3 class="sg-h3">LipiNumberInput&lt;TValue&gt; — locale-aware numeric</h3>
                <p class="sg-p">
                    Generic over numeric <code class="sg-code">TValue</code> (int/decimal/double, signed/unsigned, nullable).
                    Default locale is <strong>en-IN</strong> (1,23,456 grouping). Locale parameter overrides per-instance.
                    Steppers + Min/Max bounds + arrow-key support.
                </p>

                <h3 class="sg-h3" style="font-size: 13px; color: var(--color-text-secondary);">Type variants</h3>
                <div class="sg-input-grid sg-input-grid-3">
                    <LipiNumberInput TValue="int?" Name="sg-ni-int"
                                     Label="int? (whole numbers)"
                                     Helper="Minus allowed (signed)"
                                     @bind-Value="_sg.NiInt" />
                    <LipiNumberInput TValue="decimal?" Name="sg-ni-dec"
                                     Label="decimal? (clinical)"
                                     DecimalPlaces="2"
                                     @bind-Value="_sg.NiDec" />
                    <LipiNumberInput TValue="double?" Name="sg-ni-dbl"
                                     Label="double? (lab values)"
                                     @bind-Value="_sg.NiDbl" />
                </div>

                <h3 class="sg-h3" style="font-size: 13px; color: var(--color-text-secondary);">Locale comparison (same value, different formatting on blur)</h3>
                <div class="sg-input-grid sg-input-grid-3">
                    <LipiNumberInput TValue="decimal?" Name="sg-ni-loc-in"
                                     Label="en-IN (default)"
                                     Helper="1,23,456.78"
                                     @bind-Value="_sg.NiLocIn" />
                    <LipiNumberInput TValue="decimal?" Name="sg-ni-loc-us"
                                     Label="en-US"
                                     Locale="en-US"
                                     Helper="123,456.78"
                                     @bind-Value="_sg.NiLocUs" />
                    <LipiNumberInput TValue="decimal?" Name="sg-ni-loc-de"
                                     Label="de-DE"
                                     Locale="de-DE"
                                     Helper="123.456,78"
                                     @bind-Value="_sg.NiLocDe" />
                </div>

                <h3 class="sg-h3" style="font-size: 13px; color: var(--color-text-secondary);">Steppers + bounds + filter modes</h3>
                <div class="sg-input-grid sg-input-grid-3">
                    <LipiNumberInput TValue="int?" Name="sg-ni-stepper"
                                     Label="With steppers (Min=0, Max=100)"
                                     ShowSteppers="true"
                                     Min="0" Max="100"
                                     Step="5"
                                     Helper="At-bound buttons disable"
                                     @bind-Value="_sg.NiStepper" />
                    <LipiNumberInput TValue="int?" Name="sg-ni-noarrow"
                                     Label="DisableArrowKeys=true"
                                     DisableArrowKeys="true"
                                     Helper="Arrow keys ignored"
                                     @bind-Value="_sg.NiNoArrow" />
                    <LipiNumberInput TValue="int?" Name="sg-ni-letterok"
                                     Label="BlockNonNumericInput=false"
                                     BlockNonNumericInput="false"
                                     Helper="Letters allowed (parse fails on submit)"
                                     @bind-Value="_sg.NiLetterOk" />
                </div>

                @* ====== LipiSelect ====== *@
                <h3 class="sg-h3">LipiSelect&lt;TValue&gt; — simple identity selector</h3>
                <p class="sg-p">
                    Use when item label = value (enums, primitive lists).
                    <code class="sg-code">Searchable</code> defaults to true; opt out for short fixed lists.
                </p>
                <div class="sg-input-grid sg-input-grid-3">
                    <LipiSelect TValue="string" Name="sg-sel-gender"
                                Label="Gender (no search)"
                                Items="@_sg.Genders"
                                Searchable="false"
                                Placeholder="Select"
                                @bind-Value="_sg.SelGender" />
                    <LipiSelect TValue="string" Name="sg-sel-blood"
                                Label="Blood group (search)"
                                Items="@_sg.BloodGroups"
                                Required="true"
                                Placeholder="Select"
                                @bind-Value="_sg.SelBlood" />
                    <LipiSelect TValue="string" Name="sg-sel-pinned"
                                Label="Pinned + headings"
                                Items="@_sg.SourceList"
                                PinnedValues="@(new[] { "Self", "GP referral" })"
                                PinnedHeading="Most common"
                                UnpinnedHeading="Other"
                                Placeholder="Select"
                                @bind-Value="_sg.SelPinned" />
                </div>

                @* ====== LipiCombobox ====== *@
                <h3 class="sg-h3">LipiCombobox&lt;TValue, TItem&gt; — rich templated items</h3>
                <p class="sg-p">
                    Caller provides <code class="sg-code">ValueSelector</code> +
                    <code class="sg-code">LabelSelector</code> +
                    <code class="sg-code">ItemTemplate</code> for icon / meta rendering.
                    <code class="sg-code">SelectedAnchorTemplate</code> renders the chosen
                    item richly in the closed-state anchor (e.g., flag + name).
                </p>
                <div class="sg-input-grid sg-input-grid-2">

                    <LipiCombobox TValue="string"
                                  TItem="StyleGuide.CountryDemo"
                                  Name="sg-cb-country"
                                  Label="Country (flag + name + ISD)"
                                  Items="@_sg.Countries"
                                  ValueSelector="@(c => c.Iso)"
                                  LabelSelector="@(c => c.Name)"
                                  PinnedValues="@(new[] { "IN", "US", "GB" })"
                                  PinnedHeading="Common"
                                  UnpinnedHeading="All countries"
                                  Placeholder="Select country"
                                  @bind-Value="_sg.CbCountry">
                        <ItemTemplate Context="country">
                            <span style="font-size: 16px; margin-right: 8px;">@country.Flag</span>
                            <span class="lipi-select-option-label">@country.Name</span>
                            <span style="color: var(--color-text-tertiary); font-size: 12px; margin-left: auto;">+@country.Isd</span>
                        </ItemTemplate>
                        <SelectedAnchorTemplate Context="country">
                            <span style="font-size: 16px; margin-right: 8px;">@country.Flag</span>
                            <span>@country.Name</span>
                        </SelectedAnchorTemplate>
                    </LipiCombobox>

                    <LipiCombobox TValue="string"
                                  TItem="StyleGuide.ReferralDemo"
                                  Name="sg-cb-referral"
                                  Label="Referral source (AllowFreeText)"
                                  Items="@_sg.Referrals"
                                  ValueSelector="@(r => r.Code)"
                                  LabelSelector="@(r => r.Label)"
                                  AllowFreeText="true"
                                  Placeholder="Select or add new"
                                  Helper="Type a new value to see Add as new"
                                  @bind-Value="_sg.CbReferral">
                        <ItemTemplate Context="r">
                            <span class="lipi-select-option-label">@r.Label</span>
                            <span style="color: var(--color-text-tertiary); font-size: 12px; margin-left: auto;">@r.Category</span>
                        </ItemTemplate>
                    </LipiCombobox>

                </div>

                @* ====== Compound forms preview ====== *@
                <h3 class="sg-h3">Compound forms (preview of real-form composition)</h3>
                <p class="sg-p">
                    Components composed in form-realistic combinations.
                    Title + First Name on one row, DOB + Age computed on another.
                    These use individual <code class="sg-code">LipiSelect</code> +
                    <code class="sg-code">LipiTextBox</code> instances side-by-side.
                    For unified single-control compounds (Mobile = ISD + number,
                    Aadhaar = 4-4-4 groups), see the
                    <a href="#compound-multi"><code class="sg-code">LipiCompoundField</code></a>
                    section below — shipped in Phase 2.3 Batch 9a.
                </p>

                <h3 class="sg-h3" style="font-size: 13px; color: var(--color-text-secondary);">Title + First Name</h3>
                <div class="sg-compound-row">
                    <LipiSelect TValue="string" Name="sg-cmp-title"
                                Label="Title"
                                Items="@_sg.Titles"
                                Searchable="false"
                                Placeholder="Sel"
                                @bind-Value="_sg.CmpTitle"
                                Cols="1" />
                    <LipiTextBox Name="sg-cmp-fn"
                                 Label="First Name"
                                 Required="true"
                                 Placeholder="Given name"
                                 @bind-Value="_sg.CmpFirstName"
                                 Cols="2" />
                </div>

                <h3 class="sg-h3" style="font-size: 13px; color: var(--color-text-secondary);">DOB + Age</h3>
                <div class="sg-compound-row">
                    <LipiTextBox Name="sg-cmp-dob"
                                 Label="Date of birth"
                                 Required="true"
                                 Autocomplete="bday"
                                 Placeholder="DD/MM/YYYY"
                                 @bind-Value="_sg.CmpDob" />
                    <LipiNumberInput TValue="int?" Name="sg-cmp-age"
                                     Label="Age (computed, read-only)"
                                     ReadOnly="true"
                                     Helper="Auto-calculated from DOB"
                                     @bind-Value="_sg.CmpAge" />
                </div>

            </section>

            <!-- ====== ALIGNMENT (showcase-only structure for visual parity) ====== -->
            <section id="alignment" class="sg-section">
                <h2 class="sg-h2">Alignment Comparison</h2>
                <p class="sg-p">
                    LipiTextBox, LipiSelect, and LipiButton at <code class="sg-code">Size=Medium</code> (32px) —
                    text baselines aligned, fields share <code class="sg-code">.lipi-input-field</code>
                    height across the family. The button is wrapped in
                    <code class="sg-code">.lipi-input-wrapper</code> structure for label/helper typography
                    parity with the other two — <strong>showcase-only structure</strong>; production forms
                    don't wrap buttons this way (use <code class="sg-code">LipiButton</code> directly with
                    its own label-less sizing).
                </p>

                <div class="sg-input-grid sg-input-grid-3 sg-align-row">

                    <LipiTextBox Name="sg-align-tb"
                                 Label="LipiTextBox"
                                 Placeholder="Sample text"
                                 @bind-Value="_sg.AlignText"
                                 Helper="32px field height" />

                    <LipiSelect TValue="string" Name="sg-align-sel"
                                Label="LipiSelect"
                                Items="@_sg.Genders"
                                Placeholder="Select"
                                @bind-Value="_sg.AlignSelect"
                                Helper="32px field height" />

                    @* Showcase-only: LipiButton wrapped in input-wrapper structure for label/helper parity *@
                    <div class="lipi-input-wrapper sg-button-wrapper">
                        <label class="lipi-input-label">
                            <span class="lipi-input-label-text">LipiButton (wrapped for parity)</span>
                        </label>
                        <div class="sg-button-shell">
                            <LipiButton Variant="ButtonVariant.Primary"
                                        Size="ButtonSize.Medium"
                                        FullWidth="true">
                                Primary action
                            </LipiButton>
                        </div>
                        <div class="lipi-input-helper lipi-input-helper-default">
                            32px button height
                        </div>
                    </div>

                </div>
            </section>

            <!-- ====== COMPOUND & MULTI-SELECT (Phase 2.3) ====== -->
            <section id="compound-multi" class="sg-section">
                <h2 class="sg-h2">Compound &amp; Multi-Select Components</h2>
                <p class="sg-p">
                    Phase 2.3 family — multi-segment input scenarios and chip-based multi-value
                    selection. <code class="sg-code">LipiCompoundField</code> hosts segments
                    (<code class="sg-code">SelectSegment</code>, <code class="sg-code">TextSegment</code>)
                    for unified controls like Mobile and Aadhaar.
                    <code class="sg-code">LipiMultiSelect</code> and
                    <code class="sg-code">LipiMultiCombobox</code> handle multi-value selection with
                    chips, search, free-text entry, and configurable visibility caps.
                </p>

                @* ====== LipiCompoundField ====== *@
                <h3 class="sg-h3">LipiCompoundField — multi-segment input</h3>
                <p class="sg-p">
                    Composes child segments under a single label and helper. Segments share
                    field-level state aggregation (any segment in error → field shows error).
                    Auto-advance: typing fills MaxLength → focus jumps to next segment with
                    cursor at position 0. Touched-state (Q2 = Z) surfaces validation only when
                    focus leaves the entire compound, not when moving between segments.
                </p>

                <div class="sg-input-grid sg-input-grid-2">

                    <LipiCompoundField Name="sg-cmp-mobile"
                                       Label="Mobile"
                                       Required="true"
                                       Helper="ISD + 10-digit number">
                        <SelectSegment TValue="string"
                                       Name="sg-cmp-mobile-isd"
                                       Label="ISD code"
                                       Items="@_sg.IsdCodes"
                                       @bind-Value="_sg.MobileIsd"
                                       Width="80px"
                                       SegmentAriaLabel="ISD code"
                                       Placeholder="ISD"
                                       Required="true" />
                        <TextSegment Name="sg-cmp-mobile-num"
                                     Label="Mobile number"
                                     @bind-Value="_sg.MobileNum"
                                     MaxLength="10"
                                     Type="tel"
                                     InputMode="numeric"
                                     Placeholder="9876543210"
                                     SegmentAriaLabel="Number"
                                     Required="true" />
                    </LipiCompoundField>

                    <LipiCompoundField Name="sg-cmp-aadhaar"
                                       Label="Aadhaar Number"
                                       Helper="12 digits, grouped 4-4-4">
                        <TextSegment Name="sg-cmp-aadhaar-1"
                                     Label="Aadhaar group 1"
                                     @bind-Value="_sg.Aadhaar1"
                                     MaxLength="4"
                                     Type="tel"
                                     InputMode="numeric"
                                     Placeholder="XXXX"
                                     SegmentAriaLabel="Aadhaar group 1" />
                        <TextSegment Name="sg-cmp-aadhaar-2"
                                     Label="Aadhaar group 2"
                                     @bind-Value="_sg.Aadhaar2"
                                     MaxLength="4"
                                     Type="tel"
                                     InputMode="numeric"
                                     Placeholder="XXXX"
                                     SegmentAriaLabel="Aadhaar group 2" />
                        <TextSegment Name="sg-cmp-aadhaar-3"
                                     Label="Aadhaar group 3"
                                     @bind-Value="_sg.Aadhaar3"
                                     MaxLength="4"
                                     Type="tel"
                                     InputMode="numeric"
                                     Placeholder="XXXX"
                                     SegmentAriaLabel="Aadhaar group 3" />
                    </LipiCompoundField>

                </div>

                @* ====== LipiMultiSelect ====== *@
                <h3 class="sg-h3">LipiMultiSelect&lt;TValue&gt; — chip-style multi-selection</h3>
                <p class="sg-p">
                    Identity-typed multi-select. Caller binds to
                    <code class="sg-code">List&lt;TValue&gt;</code>; component manages selection,
                    search, and chip rendering. <code class="sg-code">AllowFreeText</code> requires
                    <code class="sg-code">TValue=string</code>.
                    <code class="sg-code">MaxSelections</code> caps total picks;
                    <code class="sg-code">MaxVisibleChips</code> caps visible chips with a
                    <code class="sg-code">+M more</code> summary chip that reveals the rest in
                    the dropdown sorted selected-first.
                </p>

                <div class="sg-input-grid sg-input-grid-2">

                    <LipiMultiSelect TValue="string"
                                     Name="sg-ms-allergies"
                                     Label="Allergies (free-text allowed)"
                                     Items="@_sg.AllergyOptions"
                                     @bind-Value="_sg.MsAllergies"
                                     Searchable="true"
                                     AllowFreeText="true"
                                     Required="true"
                                     Placeholder="Type to search or add new" />

                    <LipiMultiSelect TValue="string"
                                     Name="sg-ms-tags"
                                     Label="Project tags (max-visible 4)"
                                     Items="@_sg.TagOptions"
                                     @bind-Value="_sg.MsTags"
                                     Searchable="true"
                                     MaxVisibleChips="4"
                                     Placeholder="Add tags…"
                                     Helper="Add 5+ to see +M more summary" />

                </div>

                @* ====== LipiMultiCombobox ====== *@
                <h3 class="sg-h3">LipiMultiCombobox&lt;TValue, TItem&gt; — templated multi-select</h3>
                <p class="sg-p">
                    Caller provides <code class="sg-code">ValueSelector</code>,
                    <code class="sg-code">LabelSelector</code>, optional
                    <code class="sg-code">ItemTemplate</code> (rich dropdown rendering), and
                    optional <code class="sg-code">SelectedChipTemplate</code> (rich chip rendering).
                    The × button is auto-appended to every chip — do not include one in your
                    SelectedChipTemplate.
                </p>

                <div class="sg-input-grid sg-input-grid-1">

                    <LipiMultiCombobox TValue="string"
                                       TItem="StyleGuide.DiagnosisDemo"
                                       Name="sg-mcb-dx"
                                       Label="Active diagnoses (ICD code + severity)"
                                       Items="@_sg.DiagnosisOptions"
                                       ValueSelector="@(d => d.Code)"
                                       LabelSelector="@(d => d.Name)"
                                       @bind-Value="_sg.McbDiagnoses"
                                       Searchable="true"
                                       Placeholder="Search diagnoses…"
                                       Helper="Try searching by ICD code or name">
                        <ItemTemplate Context="dx">
                            <div style="display: flex; align-items: center; gap: 10px; flex: 1 1 auto; min-width: 0;">
                                <span style="font-family: ui-monospace, monospace; font-size: 11px; color: var(--color-text-tertiary); white-space: nowrap; min-width: 60px;">@dx.Code</span>
                                <span style="flex: 1 1 auto; overflow: hidden; text-overflow: ellipsis;">@dx.Name</span>
                                <span style="display: inline-flex; padding: 1px 6px; font-size: 10px; font-weight: 500; border-radius: var(--r-sm); text-transform: uppercase; letter-spacing: 0.04em; flex-shrink: 0; background: @(dx.Severity == "Severe" ? "var(--color-danger-pale)" : dx.Severity == "Moderate" ? "var(--color-warning-pale)" : "var(--color-success-pale)"); color: @(dx.Severity == "Severe" ? "var(--color-danger)" : dx.Severity == "Moderate" ? "var(--color-warning)" : "var(--color-success)");">@dx.Severity</span>
                            </div>
                        </ItemTemplate>
                        <SelectedChipTemplate Context="dx">
                            <span style="font-family: ui-monospace, monospace; font-size: 11px; color: var(--color-text-tertiary); white-space: nowrap;">@dx.Code</span>
                            <span class="lipi-multi-chip-label">@dx.Name</span>
                        </SelectedChipTemplate>
                    </LipiMultiCombobox>

                </div>

            </section>

            <!-- ====== DATE & TIME (Phase 2.4) ====== -->
            <section id="date-time" class="sg-section">
                <h2 class="sg-h2">Date &amp; Time Components</h2>
                <p class="sg-p">
                    Phase 2.4 family — date, time, datetime, and date-range pickers.
                    All components respect clinic configuration via
                    <code class="sg-code">IDateFormatService</code> (date/time format)
                    and <code class="sg-code">IClinicTimezoneService</code> (timezone).
                    Default for India: <code class="sg-code">DD/MM/YYYY</code>, 24-hour time,
                    Sunday-first week, Asia/Kolkata timezone.
                </p>

                @* ====== LipiDatePicker ====== *@
                <h3 class="sg-h3">LipiDatePicker — single date</h3>
                <p class="sg-p">
                    Bound to <code class="sg-code">DateOnly?</code>. InputMode controls whether
                    rendering uses a single text field or compound segments. Calendar popover
                    with month + year dropdowns and full WAI-ARIA keyboard navigation.
                </p>

                <div class="sg-input-grid sg-input-grid-2">
                    <LipiDatePicker Name="sg-dp-field"
                                    Label="Field mode (default)"
                                    @bind-Value="_sg.DpField"
                                    Helper="Type DD/MM/YYYY or click icon" />

                    <LipiDatePicker Name="sg-dp-segments"
                                    Label="Segments mode"
                                    InputMode="DatePickerInputMode.Segments"
                                    @bind-Value="_sg.DpSegments"
                                    Helper="Auto-advance between segments" />
                </div>

                @* ====== LipiTimePicker ====== *@
                <h3 class="sg-h3">LipiTimePicker — time of day</h3>
                <p class="sg-p">
                    Bound to <code class="sg-code">TimeOnly?</code>. 24h or 12h format. Step
                    parameter validates user input strictly; Now button snaps to nearest past
                    Step boundary (asymmetry is deliberate per locked Q4 / C2 decision).
                </p>

                <div class="sg-input-grid sg-input-grid-2">
                    <LipiTimePicker Name="sg-tp-24h"
                                    Label="24-hour"
                                    @bind-Value="_sg.Tp24"
                                    Helper="Default 24h format" />

                    <LipiTimePicker Name="sg-tp-12h"
                                    Label="12-hour with AM/PM"
                                    TimeFormat="12h"
                                    Step="15"
                                    @bind-Value="_sg.Tp12"
                                    Helper="15-min steps" />
                </div>

                @* ====== LipiDateTimePicker ====== *@
                <h3 class="sg-h3">LipiDateTimePicker — date + time composed</h3>
                <p class="sg-p">
                    Bound to <code class="sg-code">DateTimeOffset?</code>. Composes
                    <code class="sg-code">LipiDatePicker</code> +
                    <code class="sg-code">LipiTimePicker</code>. Stacked or Inline layout
                    (Inline collapses to Stacked at &lt;640px viewport).
                </p>

                <div class="sg-input-grid sg-input-grid-1">
                    <LipiDateTimePicker Name="sg-dtp-stacked"
                                        Label="Visit timestamp (Stacked)"
                                        @bind-Value="_sg.DtpStacked"
                                        Helper="Default stacked layout" />
                </div>

                @* ====== LipiDateRangePicker ====== *@
                <h3 class="sg-h3">LipiDateRangePicker — date range</h3>
                <p class="sg-p">
                    Dual-bound — <code class="sg-code">@@bind-StartValue</code> +
                    <code class="sg-code">@@bind-EndValue</code> (separate
                    <code class="sg-code">DateOnly?</code> properties). Two-calendar popover.
                    Optional preset panel via <code class="sg-code">Presets</code> parameter.
                </p>

                <div class="sg-input-grid sg-input-grid-1">
                    <LipiDateRangePicker Name="sg-drp"
                                         Label="Reporting period (with preset bundle)"
                                         @bind-StartValue="_sg.DrpStart"
                                         @bind-EndValue="_sg.DrpEnd"
                                         Presets="LipiDateRangePresets.CommonReports"
                                         HelperText="Try the preset panel on left of calendars" />
                </div>

            </section>

            <!-- ====== LABEL POSITIONS (Phase 2.5.5) ====== -->
            <section id="label-positions" class="sg-section">
                <h2 class="sg-h2">Label Positions — Phase 2.5.5</h2>
                <p class="sg-p">
                    All input components now support <code class="sg-code">LabelPosition</code>
                    (<code class="sg-code">InputLabelPosition.Top</code> default,
                    <code class="sg-code">Left</code>, <code class="sg-code">Right</code>,
                    <code class="sg-code">Bottom</code>). The label column width defaults to
                    <strong>130px</strong> and is overridable per-field or per-section via
                    <code class="sg-code">style="--lipi-label-w: 190px"</code>.
                    Two-font system: <strong>LiPi Sans</strong> for all UI,
                    <strong>LiPi Mono</strong> for IDs / dates / clinical data.
                </p>

                @* ====== Error state in Left position ====== *@
                <h3 class="sg-h3">Error state — Left position</h3>
                <p class="sg-p">
                    The red border and helper text both stay in the input column.
                    The label turns red to match.
                </p>
                <div style="max-width: 520px;">
                    <LipiTextBox Name="sg-lp-error"
                                 Label="Patient name"
                                 LabelPosition="InputLabelPosition.Left"
                                 Error="Name is required for registration"
                                 @bind-Value="_sg.LpError" />
                </div>

                @* ====== Apricot required tint in Left position ====== *@
                <h3 class="sg-h3">Apricot required tint — Left position</h3>
                <p class="sg-p">
                    The apricot tint covers the input column only — not the label column.
                    Leave the field empty to see the tint; fill it to watch it retract.
                </p>
                <div style="max-width: 520px;">
                    <LipiTextBox Name="sg-lp-apricot"
                                 Label="Mobile number"
                                 LabelPosition="InputLabelPosition.Left"
                                 Required="true"
                                 Helper="10 digits, no spaces"
                                 @bind-Value="_sg.LpApricot" />
                </div>

                @* ====== All four positions ====== *@
                <h3 class="sg-h3">All four positions — LipiTextBox</h3>
                <div class="sg-input-grid sg-input-grid-2">
                    <LipiTextBox Name="sg-lp-top"
                                 Label="Top (default)"
                                 Helper="Label above the input — default for all components"
                                 @bind-Value="_sg.LpTop" />
                    <LipiTextBox Name="sg-lp-left"
                                 Label="Patient name"
                                 LabelPosition="InputLabelPosition.Left"
                                 Helper="Legal name as on government ID"
                                 @bind-Value="_sg.LpLeft" />
                    <LipiTextBox Name="sg-lp-right"
                                 Label="Patient name"
                                 LabelPosition="InputLabelPosition.Right"
                                 Helper="Label to the right of the field"
                                 @bind-Value="_sg.LpRight" />
                    <LipiTextBox Name="sg-lp-bottom"
                                 Label="Patient name"
                                 LabelPosition="InputLabelPosition.Bottom"
                                 Helper="Label below — caption style"
                                 @bind-Value="_sg.LpBottom" />
                </div>

                @* ====== Dense left-label clinical form ====== *@
                <h3 class="sg-h3">Dense left-label form — clinical context</h3>
                <p class="sg-p">
                    Left position saves vertical space on data-entry forms. The
                    <code class="sg-code">--lipi-label-w</code> custom property is inherited,
                    so setting it once on a wrapper div aligns all labels in that block.
                </p>
                <div style="max-width: 520px; --lipi-label-w: 140px;">
                    <LipiTextBox Name="sg-lp-dense-name"
                                 Label="Patient name"
                                 LabelPosition="InputLabelPosition.Left"
                                 Helper="Legal name as on Aadhaar"
                                 @bind-Value="_sg.LpDenseName" />
                    <div style="margin-top: 12px;">
                        <LipiDatePicker Name="sg-lp-dense-dob"
                                        Label="Date of birth"
                                        LabelPosition="InputLabelPosition.Left"
                                        @bind-Value="_sg.LpDenseDob" />
                    </div>
                    <div style="margin-top: 12px;">
                        <LipiNumberInput TValue="int?"
                                         Name="sg-lp-dense-age"
                                         Label="Age (years)"
                                         LabelPosition="InputLabelPosition.Left"
                                         Helper="Calculated from DOB or enter manually"
                                         @bind-Value="_sg.LpDenseAge" />
                    </div>
                    <div style="margin-top: 12px;">
                        <LipiTextBox Name="sg-lp-dense-uhid"
                                     Label="UHID"
                                     LabelPosition="InputLabelPosition.Left"
                                     ReadOnly="true"
                                     Helper="Assigned at registration"
                                     @bind-Value="_sg.LpDenseUhid" />
                    </div>
                </div>

                @* ====== TextArea — top-aligned label in Left position ====== *@
                <h3 class="sg-h3">TextArea — Left position (label top-aligned)</h3>
                <p class="sg-p">
                    Multi-line components (<code class="sg-code">LipiTextArea</code>,
                    <code class="sg-code">LipiMultiSelect</code>) use
                    <code class="sg-code">lipi-input-multiline</code> to top-align the label
                    at the first row of content rather than center it.
                </p>
                <div style="max-width: 520px;">
                    <LipiTextArea Name="sg-lp-notes"
                                  Label="Clinical notes"
                                  LabelPosition="InputLabelPosition.Left"
                                  Helper="Allergies, special instructions, etc."
                                  @bind-Value="_sg.LpNotes" />
                </div>

                @* ====== Empty Label + AriaLabel accessibility pattern ====== *@
                <h3 class="sg-h3">Label="" + AriaLabel — accessible empty-label pattern</h3>
                <p class="sg-p">
                    When the visible label is omitted (e.g., a search field inside a labelled
                    container), set <code class="sg-code">Label=""</code> and provide
                    <code class="sg-code">AriaLabel</code> for screen readers. No Dev error
                    fires; inspect the element to confirm <code class="sg-code">aria-label</code>
                    is present on the native input.
                </p>
                <div style="max-width: 320px;">
                    <LipiTextBox Name="sg-lp-arialabel"
                                 Label=""
                                 AriaLabel="Search patients by name or UHID"
                                 Placeholder="Search patients…"
                                 @bind-Value="_sg.LpAriaLabel" />
                </div>

                @* ====== Custom --lipi-label-w override ====== *@
                <h3 class="sg-h3">Custom label width — <code class="sg-code">--lipi-label-w</code></h3>
                <p class="sg-p">
                    Set on a single field inline (190px), or on a wrapper div for an entire
                    form section. Default is 130px.
                </p>
                <div style="max-width: 560px;">
                    <LipiTextBox Name="sg-lp-wide-label"
                                 Label="Referring physician"
                                 LabelPosition="InputLabelPosition.Left"
                                 Helper="190px label column — wider for long labels"
                                 style="--lipi-label-w: 190px"
                                 @bind-Value="_sg.LpWideLabel" />
                </div>

                @* ====== CheckboxGroup Left position ====== *@
                <h3 class="sg-h3">CheckboxGroup — Left position</h3>
                <p class="sg-p">
                    Group components use grid layout — legend left, options container right,
                    helper text scoped to the options column.
                </p>
                <div style="max-width: 520px;">
                    <LipiCheckboxGroup TItem="string" TValue="string"
                                       Name="sg-lp-cbg"
                                       Label="Comorbidities"
                                       LabelPosition="InputLabelPosition.Left"
                                       Items="_sg.LpComorbidities"
                                       @bind-Value="_sg.LpComorbiditiesSelected"
                                       Helper="Select all that apply" />
                </div>

            </section>

        </main>
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState> AuthState { get; set; } = default!;

    private string _mode  = "light";
    private string _brand = "lipi-default";

    // ---------- Authorization ----------
    // Pattern matches Settings.razor / Users.razor / Clinics.razor — the production-proven
    // approach for this project. Roles are in ClaimTypes.Role with snake_case values.
    // forceLoad: true ensures the redirect survives SSR pre-render.
    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        var role = auth.User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value;

        if (role is not ("global_admin" or "sys_admin" or "site_admin"))
        {
            Nav.NavigateTo("/dashboard", forceLoad: true);
            return;
        }
    }

    // ---------- Theme mode wiring ----------
    // theme-switcher.js exposes:
    //   lipiTheme.apply(brand, mode)  — sets data-* attrs on <html> + writes cookies
    //   lipiTheme.getCurrentTheme()   — returns { brand, mode } object (NOT a string)
    //   lipiTheme.init()              — re-reads cookies and applies
    //
    // We deserialize getCurrentTheme into the ThemeState record below.
    private record ThemeState(string Brand, string Mode);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var current = await JS.InvokeAsync<ThemeState>("lipiTheme.getCurrentTheme");
                if (current is not null)
                {
                    _mode  = string.IsNullOrEmpty(current.Mode)  ? "light"        : current.Mode;
                    _brand = string.IsNullOrEmpty(current.Brand) ? "lipi-default" : current.Brand;
                }
            }
            catch
            {
                // JS interop may not be ready in pre-render; fall through to defaults.
                _mode  = "light";
                _brand = "lipi-default";
            }
            StateHasChanged();
        }
    }

    private async Task SetLight() => await SetMode("light");
    private async Task SetDark()  => await SetMode("dark");

    private async Task SetMode(string mode)
    {
        _mode = mode;
        try
        {
            // lipiTheme.apply takes TWO args (brand, mode) and writes both cookies.
            // We pass current _brand to keep the brand stable while only mode changes.
            await JS.InvokeVoidAsync("lipiTheme.apply", _brand, mode);
        }
        catch
        {
            // If JS interop fails, internal state still updates. UI re-renders below.
        }
        StateHasChanged();
    }

    // ---------- Phase 2.1: Buttons demo state ----------
    private readonly ButtonVariant[] _variants =
    {
        ButtonVariant.Primary,
        ButtonVariant.Secondary,
        ButtonVariant.Danger,
        ButtonVariant.Ghost,
        ButtonVariant.Link
    };

    private bool _isSaving;
    private string _lastAction = string.Empty;

    private void DemoSave()    => _lastAction = "✓ Save clicked";
    private void DemoCancel()  => _lastAction = "Cancel clicked";
    private void DemoDelete()  => _lastAction = "✓ Delete confirmed";

    private async Task DemoAsyncSave()
    {
        _isSaving = true;
        StateHasChanged();   // Force immediate render so spinner appears before await
        await Task.Delay(1500);
        _isSaving = false;
    }

    // ---------- Phase 2.2: Text-input demo state ----------
    // All state lives in a single TextInputDemo instance so the @code block stays compact
    // and the markup binds cleanly via _sg.FieldName. Each property is a free-form input
    // value with no validation — this is a showcase, not a form.

    private TextInputDemo _sg = new();

    private sealed class TextInputDemo
    {
        // LipiTextBox states + sizes
        public string? TbDefault    { get; set; }
        public string? TbRequired   { get; set; }
        public string? TbError      { get; set; } = "ab";   // <3 chars to show error
        public string? TbWarning    { get; set; } = "verify";
        public string? TbSuccess    { get; set; } = "Confirmed value";
        public string? TbReadonly   { get; set; } = "Read-only sample";
        public string? TbDisabled   { get; set; }
        public string? TbIcon       { get; set; }
        public string? TbConfidence { get; set; } = "Verified entry";
        public string? TbSmall      { get; set; }
        public string? TbMedium     { get; set; } = "Medium sample";
        public string? TbLarge      { get; set; }

        // LipiTextArea
        public string? TaDefault    { get; set; }
        public string? TaClamped    { get; set; }

        // LipiNumberInput type variants + locales + filter modes
        public int?     NiInt       { get; set; } = 42;
        public decimal? NiDec       { get; set; } = 99.95m;
        public double?  NiDbl       { get; set; } = 7.123;
        public decimal? NiLocIn     { get; set; } = 123456.78m;
        public decimal? NiLocUs     { get; set; } = 123456.78m;
