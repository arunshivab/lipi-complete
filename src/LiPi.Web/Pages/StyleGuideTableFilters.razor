                <LipiSlicerOption TItem="DemoStaff" TValue="string" Field="@(s => s.Status)"
                                  Type="ColumnType.Status" DefaultVisible="true" />
                <LipiSlicerOption TItem="DemoStaff" TValue="bool" Field="@(s => s.IsActive)"
                                  Type="ColumnType.Boolean" Header="Active" DefaultVisible="false" />
                <LipiSlicerOption TItem="DemoStaff" TValue="decimal" Field="@(s => s.MonthlyCtc)"
                                  Type="ColumnType.Currency" Header="Monthly CTC" DefaultVisible="false" />
                <LipiSlicerOption TItem="DemoStaff" TValue="DateOnly" Field="@(s => s.JoinedOn)"
                                  Type="ColumnType.Date" Header="Joined" DefaultVisible="false" />
            </LipiSlicerPanel>
            }

            <div style="flex:1;min-width:0;">
                <LipiTable TItem="DemoStaff" Items="@_staff" KeySelector="@(s => s.Id)" TableId="sg-filters-panel"
                           FilterState="_panelState" FilterMode="FilterMode.None"
                           ShowQuickSearch="true" HighlightMatches="true">
                    <ToolbarStart>
                        <button type="button" @onclick="ToggleFilters"
                                style="display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border:1px solid var(--color-border-strong,#94a3b8);border-radius:6px;background:var(--color-bg-base,#fff);color:var(--color-text-secondary,#475569);font:inherit;font-size:.8125rem;cursor:pointer;">
                            @(_filtersOpen ? "Hide filters" : "Show filters")
                        </button>
                    </ToolbarStart>
                    <ChildContent>
                    <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Name)" Header="Name" />
                    <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.EmployeeCode)"
                                Header="Code" Type="ColumnType.Mono" />
                    <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Department)"
                                Header="Department" Type="ColumnType.Status" />
                    <LipiColumn TItem="DemoStaff" TValue="DateOnly" Field="@(s => s.JoinedOn)"
                                Header="Joined" Type="ColumnType.Date" />
                    <LipiColumn TItem="DemoStaff" TValue="decimal" Field="@(s => s.MonthlyCtc)"
                                Header="Monthly CTC" Type="ColumnType.Currency" />
                    <LipiColumn TItem="DemoStaff" TValue="bool" Field="@(s => s.IsActive)"
                                Header="Active" Type="ColumnType.Boolean" />
                    <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Status)"
                                Header="Status" Type="ColumnType.Status" />
                    </ChildContent>
                </LipiTable>
            </div>
        </div>
    </div>

    <div class="sg-section">
        <h2>Notes</h2>
        <ul class="sg-notes">
            <li><code>OperatorsFor(ColumnType)</code> drives which operators each header offers — numeric,
                date (+relative), boolean, and In/Status sets.</li>
            <li>Date relative operators (This month, Last quarter, Last N days) resolve against the table's
                <code>FilterTimeZone</code> (defaults to server-local "today"); week operators use
                <code>FilterWeekStart</code>.</li>
            <li>The <code>In</code> editor lists the column's distinct values as checkboxes — the partial
                answer to multi-value OR (e.g. Department in Radiation Oncology + Medical Physics).</li>
            <li>Between uses both <code>Value</code> and <code>ValueEnd</code> on the descriptor.</li>
        </ul>
    </div>
    <div class="sg-section">
        <h2>LipiFilterBar — standalone, editable filter toolbar (PR6b)</h2>
        <p class="sg-note-p">
            A standalone bar bound to a shared <code>LipiFilterState</code> — not a table FilterMode.
            Curated <code>&lt;LipiFilterBarItem&gt;</code> children define the candidates; "Add filter"
            adds one, clicking a pill edits it (the same shared <code>&lt;LipiFilterEditor&gt;</code>
            the table surfaces use), and the &times; removes it. The bar and the table below share one
            state, so the bar drives the table. Live apply — edits commit as you type (debounced).
        </p>

        <LipiFilterBar TItem="DemoStaff" FilterState="_barState" Items="@_staff">
            <LipiFilterBarItem TItem="DemoStaff" TValue="string"   Field="@(s => s.Name)"       Header="Name"        Type="ColumnType.Text" />
            <LipiFilterBarItem TItem="DemoStaff" TValue="string"   Field="@(s => s.Department)" Header="Department"  Type="ColumnType.Status" />
            <LipiFilterBarItem TItem="DemoStaff" TValue="DateOnly" Field="@(s => s.JoinedOn)"   Header="Joined"      Type="ColumnType.Date" />
            <LipiFilterBarItem TItem="DemoStaff" TValue="decimal"  Field="@(s => s.MonthlyCtc)" Header="Monthly CTC" Type="ColumnType.Currency" />
            <LipiFilterBarItem TItem="DemoStaff" TValue="bool"     Field="@(s => s.IsActive)"   Header="Active"      Type="ColumnType.Boolean" />
            <LipiFilterBarItem TItem="DemoStaff" TValue="string"   Field="@(s => s.Status)"     Header="Status"      Type="ColumnType.Status" />
        </LipiFilterBar>

        <LipiTable TItem="DemoStaff" Items="@_staff" KeySelector="@(s => s.Id)" TableId="sg-filterbar-shared"
                   FilterState="_barState" FilterMode="FilterMode.None">
            <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Name)" Header="Name" />
            <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.EmployeeCode)" Header="Code" Type="ColumnType.Mono" />
            <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Department)" Header="Department" Type="ColumnType.Status" />
            <LipiColumn TItem="DemoStaff" TValue="DateOnly" Field="@(s => s.JoinedOn)" Header="Joined" Type="ColumnType.Date" />
            <LipiColumn TItem="DemoStaff" TValue="decimal" Field="@(s => s.MonthlyCtc)" Header="Monthly CTC" Type="ColumnType.Currency" />
            <LipiColumn TItem="DemoStaff" TValue="bool" Field="@(s => s.IsActive)" Header="Active" Type="ColumnType.Boolean" />
            <LipiColumn TItem="DemoStaff" TValue="string" Field="@(s => s.Status)" Header="Status" Type="ColumnType.Status" />
        </LipiTable>
    </div>

</div>

