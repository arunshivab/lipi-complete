    private async Task RunConfirm(ConfirmIntent intent)
    {
        var (title, message) = intent switch
        {
            ConfirmIntent.Danger   => ("Delete record?",   "This permanently deletes the record. This action cannot be undone."),
            ConfirmIntent.Warning  => ("Overwrite file?",  "A file with this name already exists. Overwrite it?"),
            ConfirmIntent.Critical => ("Patient safety: high-risk action", "You are about to administer a Level-3 contraindicated drug. This action will be logged and require co-signature."),
            _                      => ("Continue?",        "Are you sure you want to proceed?")
        };

        var result = await _modal.ConfirmAsync(title, message, intent);
        _confirmResult = result ? "Confirmed" : "Cancelled";
        StateHasChanged();
    }

    private async Task RunAlert(AlertIntent intent)
    {
        var (title, message) = intent switch
        {
            AlertIntent.Success  => ("Saved",         "Changes saved successfully."),
            AlertIntent.Warning  => ("Heads up",      "Your session expires in 5 minutes."),
            AlertIntent.Danger   => ("Error",         "Failed to save changes. Please retry."),
            AlertIntent.Critical => ("Critical lab",  "K+ 6.8 mEq/L — physician review required immediately."),
            _                    => ("Info",          "Demo information dialog.")
        };

        await _modal.AlertAsync(title, message, intent);
    }

    private async Task RunPrompt()
    {
        _promptResult    = null;
        _promptCancelled = false;

        var result = await _modal.PromptAsync(
            title:        "Override allergy warning",
            label:        "Reason (required for HIPAA audit)",
            placeholder:  "e.g. patient confirmed prior tolerance",
            required:     true);

        if (result is null) _promptCancelled = true;
        else                _promptResult    = result;
        StateHasChanged();
    }

    private async Task RunCustomShow()
    {
        var parameters = new Dictionary<string, object?>
        {
            ["InitialValue"] = "Hello from demo 7"
        };

        var result = await _modal.ShowAsync<SampleCustomModal, string?>(
            parameters: parameters,
            size:       ModalSize.Standard,
            title:      "Custom modal — ShowAsync");

        _showResult = result;
        StateHasChanged();
    }

    private async Task RunStackConfirm()
    {
        var ok = await _modal.ConfirmAsync(
            title:        "Inner confirmation",
            message:      "This ConfirmAsync sits on top of the outer declarative modal. " +
                          "Notice the outer modal is dimmed and inert behind.",
            intent:       ConfirmIntent.Default);

        _m10InnerResult = ok ? "OK" : "Cancelled";
        StateHasChanged();
    }


