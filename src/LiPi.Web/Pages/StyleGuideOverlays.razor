    private async Task OpenDemoTab(string tabId, string title, string icon)
    {
        await _tabSvc.OpenAsync(
            url:        $"/admin/style-guide-overlays/tab/{tabId}",
            tabKey:     $"demo-tab-{tabId}",
            title:      title,
            icon:       icon,
            closeRoute: "/admin/style-guide-overlays");
    }

    private async Task CloseAllDemoTabs()
    {
        // Snapshot tab keys to avoid mutation during iteration
        var keys = _tabSvc.OpenTabs.Select(t => t.TabKey).ToList();
        foreach (var key in keys)
        {
            await _tabSvc.CloseAsync(key);
        }
        StateHasChanged();
    }

    private async Task RunCapDemo()
    {
        _tabSvc.SetMaxTabs(3);
        await OpenDemoTab("cap-1", "Cap-test 1", "user");
        await OpenDemoTab("cap-2", "Cap-test 2", "user");
        await OpenDemoTab("cap-3", "Cap-test 3", "user");
        // 4th open should pop AlertAsync (cap reached)
        await OpenDemoTab("cap-4", "Cap-test 4 (blocked)", "user");
        // Restore default cap for the global strip
        _tabSvc.SetMaxTabs(20);
    }

    private async Task OpenManyTabs()
    {
        for (var i = 1; i <= 12; i++)
        {
            await _tabSvc.OpenAsync(
                url:        $"/admin/style-guide-overlays/tab/many-{i}",
                tabKey:     $"demo-tab-many-{i}",
                title:      $"Tab {i:00}",
                icon:       "file",
                closeRoute: "/admin/style-guide-overlays");
        }
    }

    private async Task HandleAddClick()
    {
        _addClickCount++;
        await _modal.AlertAsync(
            title:   "Add-button clicked",
            message: $"Click count: {_addClickCount}. In production this would " +
                     $"open a picker (search, recent, new patient, etc.).");
    }
