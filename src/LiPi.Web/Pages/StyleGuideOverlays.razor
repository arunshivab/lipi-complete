@code {
    // ═══════════════════════════════════════════════════════════════════
    // MODAL DEMO STATE
    // ═══════════════════════════════════════════════════════════════════

    private ModalSize?      _m1Open;
    private ModalIconColor? _m2Open;
    private bool            _m3Open;
    private string          _m3Anim = "FadeSlide";
