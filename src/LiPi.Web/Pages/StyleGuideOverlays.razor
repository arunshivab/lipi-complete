            </p>
        </ModalBody>
        <ModalFooter>
            <LipiButton Variant="ButtonVariant.Secondary"
                        OnClick="@(() => { _m8Open = false; _m8Text = string.Empty; })">Cancel</LipiButton>
            <LipiButton OnClick="@(() => { _m8Open = false; _m8Text = string.Empty; })">Save</LipiButton>
        </ModalFooter>
    </LipiModal>
}

@* Demo 9 — IsBusy *@
@if (_m9Open)
{
    <LipiModal Title="Saving…"
               Subtitle="IsBusy demo"
               Icon="loader"
               IconColor="ModalIconColor.Info"
               Size="ModalSize.Compact"
               IsBusy="@_m9Busy"
               OnClose="@(() => _m9Open = false)">
        <ModalBody>
            <p style="font-size:13px;margin:0 0 12px 0">
                When IsBusy is on: ✕, Escape, backdrop click all suppressed.
                Primary action shows busy spinner.
            </p>
            <LipiButton Size="ButtonSize.Small"
                        Variant="ButtonVariant.Secondary"
                        OnClick="@(() => _m9Busy = !_m9Busy)">
                Toggle IsBusy (currently @(_m9Busy ? "ON" : "OFF"))
            </LipiButton>
        </ModalBody>
        <ModalFooter>
            <LipiButton Variant="ButtonVariant.Secondary"
                        OnClick="@(() => _m9Open = false)">Cancel</LipiButton>
            <LipiButton OnClick="@(() => _m9Open = false)" IsLoading="@_m9Busy">Submit</LipiButton>
        </ModalFooter>
    </LipiModal>
}

@* Demo 10 — Stack *@
@if (_m10Open)
{
    <LipiModal Title="Outer modal"
               Subtitle="Click below to open ConfirmAsync on top"
               Icon="layers"
               IconColor="ModalIconColor.Info"
               Size="ModalSize.Standard"
               OnClose="@(() => _m10Open = false)">
        <ModalBody>
            <p style="font-size:13px;margin:0 0 12px 0;line-height:1.6">
                The button below opens <code style="font-family:var(--font-mono);font-size:12px">
                Modal.ConfirmAsync</code> — that's a service-driven modal stacked
                on top of this declarative one.
            </p>
            <p style="font-size:12px;color:var(--color-text-secondary);margin:0 0 12px 0">
                Stack depth on confirm: 1 declarative + 1 service. Within spec §6 cap of 3.
            </p>
            <LipiButton Size="ButtonSize.Small" OnClick="RunStackConfirm">
                Open ConfirmAsync on top
            </LipiButton>
            @if (_m10InnerResult is not null)
            {
                <div class="sg-result" style="margin-top:12px">
                    Inner result: <strong>@_m10InnerResult</strong>
                </div>
            }
        </ModalBody>
        <ModalFooter>
            <LipiButton OnClick="@(() => _m10Open = false)">Close outer</LipiButton>
        </ModalFooter>
    </LipiModal>
}

@* Demo 11 — Intents *@
@if (_m11Open is not null)
{
    <LipiModal Title="@($"Intent: {_m11Open}")"
               Subtitle="Spec §10 — auto-defaults table"
               Icon="layout"
               IconColor="ModalIconColor.Info"
               Size="ModalSize.Standard"
               Intent="_m11Open.Value"
               OnClose="@(() => _m11Open = null)">
        <ModalBody>
            @switch (_m11Open)
            {
                case ModalIntent.Progress:
                    <p style="font-size:13px;margin:0 0 8px 0">
                        Progress intent forces: <code style="font-family:var(--font-mono);font-size:12px">ShowCloseButton=false</code>,
                        <code style="font-family:var(--font-mono);font-size:12px">CloseOnEscape=false</code>,
                        <code style="font-family:var(--font-mono);font-size:12px">CloseOnBackdrop=false</code>,
                        <code style="font-family:var(--font-mono);font-size:12px">Animate=false</code>.
                    </p>
                    <p style="font-size:12px;color:var(--color-text-secondary);margin:0">
                        Use the footer button to close (✕ and Esc don't work).
                    </p>
                    break;
                default:
                    <p style="font-size:13px;margin:0 0 8px 0">
                        v1.0 (A31 divergence): non-Progress intents don't cascade
                        Size/FooterAlign auto-defaults. This modal stays at
                        <code style="font-family:var(--font-mono);font-size:12px">Size.Standard</code> /
                        <code style="font-family:var(--font-mono);font-size:12px">FooterAlign.End</code>
                        as declared.
                    </p>
                    <p style="font-size:12px;color:var(--color-text-secondary);margin:0">
                        Tracked for v1.1.
                    </p>
                    break;
            }
        </ModalBody>
        <ModalFooter>
            <LipiButton OnClick="@(() => _m11Open = null)">Close</LipiButton>
        </ModalFooter>
    </LipiModal>
}


