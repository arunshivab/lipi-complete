                <code style="font-family:var(--font-mono);font-size:12px">.lipi-modal-icon-@(_m2Open.ToString()?.ToLowerInvariant())</code>.
            </p>
        </ModalBody>
        <ModalFooter>
            <LipiButton OnClick="@(() => _m2Open = null)">Close</LipiButton>
        </ModalFooter>
    </LipiModal>
}

@* Demo 3 — Animation *@
@if (_m3Open)
{
    <LipiModal Title="@($"Animation: {_m3Anim}")"
               Icon="film"
