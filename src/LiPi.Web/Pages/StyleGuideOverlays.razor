               IconColor="ModalIconColor.Info"
               Size="_m1Open.Value"
               OnClose="@(() => _m1Open = null)">
        <ModalBody>
            <p style="font-size:13px;color:var(--color-text-primary);line-height:1.6;margin:0">
                This is a <strong>@(_m1Open)</strong> modal. Width as defined in
                <code style="font-family:var(--font-mono);font-size:12px">lipi-overlays.css</code>:
                @(_m1Open == ModalSize.Compact    ? "400px" :
                  _m1Open == ModalSize.Standard   ? "520px" :
                  _m1Open == ModalSize.Wide       ? "680px" :
                                                    "95vw × 95vh").
            </p>
        </ModalBody>
        <ModalFooter>
            <LipiButton OnClick="@(() => _m1Open = null)">Close</LipiButton>
        </ModalFooter>
    </LipiModal>
}

@* Demo 2 — IconColor *@
