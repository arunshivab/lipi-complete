@page "/admin/style-guide-overlays"
@layout LiPi.Web.Components.Layouts.TopNavLayout
@attribute [Authorize]
@rendermode InteractiveServer

@* SPEC:  docs/01-LipiModal-Spec.md §12 (Modal demos 1–11)
          docs/02-LipiDrawer-Spec.md §11 (Drawer demos 1–8)
          docs/03-LipiDynamicTabs-Spec.md §14 (DynamicTabs demos 1–11)
   PHASE: 2.6.2 — Overlay Surfaces showcase
   AMEND: docs/CHANGE-LOG.md A33

   Full 30-demo showcase for the Phase 2.6.2 overlay component family.
   Modal demos use both the declarative <LipiModal> path (built A31) and
   the service path. Drawer demos likewise use both paths. DynamicTabs
   demos navigate to StyleGuideOverlayTabDemo.razor stub pages with
   different TabId prefixes that drive save-handler registration.

   v1.0 limitations surfaced in-page:
     - Modal §10 Intent auto-defaults: only Critical/Progress forced overrides
       apply (A31 divergence). Confirmation/Alert/Wizard/Preview stay at
       declared defaults — consumer must set Size etc. explicitly.
     - Drawer demo 5 (service path) doesn't carry Icon/IconColor/IsDirty/
       Pinnable — needs DrawerRequest extension (v1.1+, tracked in A32).
     - DynamicTabs demo 10 (Dropdown overflow): logs warning + falls back
       to Scroll mode (v1.0 limitation, A32). Demo shows the static
       expected behavior + code block.
*@

@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.AspNetCore.Authorization
@using LiPi.Web.Services
@using LiPi.Web.Components.Shared

@inject ILipiModalService        _modal
@inject ILipiDrawerService       _drawer
@inject ILipiDynamicTabsService  _tabSvc
@inject NavigationManager        _nav

<PageTitle>Style Guide — Overlays – LiPi</PageTitle>
<SectionContent SectionName="page-title">
    <div class="tn-pt-title">Style Guide</div>
    <div class="tn-pt-sub">Overlays — Modal · Drawer · DynamicTabs</div>
</SectionContent>

<div class="sg-page">

    @* ════════ TOP BAR ════════ *@
    <header class="sg-topbar">
        <div class="sg-titleblock">
            <h1 class="sg-h1">Overlay Surfaces</h1>
            <p class="sg-subtitle">
                Phase 2.6.2 — 30 demos covering LipiModal (11), LipiDrawer (8),
                LipiDynamicTabs (11). Both declarative and service-driven paths shown
                where the spec covers both.
            </p>
        </div>
        <a class="sg-back-link" href="/admin/style-guide">← Foundation style guide</a>
    </header>

    @* ════════ LAYOUT ════════ *@
    <div class="sg-layout">

        @* ─── Sidebar nav ─── *@
        <aside class="sg-sidebar" aria-label="Demo sections">
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">LipiModal §12</h3>
                <a class="sg-nav-link" href="#modal-sizes">1. Sizes</a>
                <a class="sg-nav-link" href="#modal-iconcolors">2. IconColor</a>
                <a class="sg-nav-link" href="#modal-animations">3. Animations</a>
                <a class="sg-nav-link" href="#modal-confirm">4. ConfirmAsync</a>
                <a class="sg-nav-link" href="#modal-alert">5. AlertAsync</a>
                <a class="sg-nav-link" href="#modal-prompt">6. PromptAsync</a>
                <a class="sg-nav-link" href="#modal-show">7. ShowAsync&lt;T&gt;</a>
                <a class="sg-nav-link" href="#modal-isdirty">8. IsDirty</a>
                <a class="sg-nav-link" href="#modal-isbusy">9. IsBusy</a>
                <a class="sg-nav-link" href="#modal-stack">10. Stack</a>
                <a class="sg-nav-link" href="#modal-intents">11. Intent presets</a>
            </div>
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">LipiDrawer §11</h3>
                <a class="sg-nav-link" href="#drawer-placements">1. 4 placements</a>
                <a class="sg-nav-link" href="#drawer-sizes">2. 4 sizes per placement</a>
                <a class="sg-nav-link" href="#drawer-backdrops">3. 3 backdrops</a>
                <a class="sg-nav-link" href="#drawer-dirty">4. Form + dirty state</a>
                <a class="sg-nav-link" href="#drawer-show">5. ShowAsync programmatic</a>
                <a class="sg-nav-link" href="#drawer-multi">6. R + B simultaneous</a>
                <a class="sg-nav-link" href="#drawer-modal-on">7. Modal on drawer</a>
                <a class="sg-nav-link" href="#drawer-busy">8. IsBusy</a>
            </div>
            <div class="sg-nav-group">
                <h3 class="sg-nav-header">LipiDynamicTabs §14</h3>
                <a class="sg-nav-link" href="#dtabs-empty">1. Empty state</a>
                <a class="sg-nav-link" href="#dtabs-open3">2. Open 3 tabs</a>
                <a class="sg-nav-link" href="#dtabs-dirty">3. Dirty marker</a>
                <a class="sg-nav-link" href="#dtabs-close-clean">4. Clean close</a>
                <a class="sg-nav-link" href="#dtabs-close-dirty">5. Dirty close</a>
                <a class="sg-nav-link" href="#dtabs-save-ok">6. Save &amp; close OK</a>
                <a class="sg-nav-link" href="#dtabs-save-fail">7. Save &amp; close fail</a>
                <a class="sg-nav-link" href="#dtabs-cap">8. Soft cap</a>
                <a class="sg-nav-link" href="#dtabs-scroll">9. Scroll overflow</a>
                <a class="sg-nav-link" href="#dtabs-dropdown">10. Dropdown overflow</a>
                <a class="sg-nav-link" href="#dtabs-addbtn">11. Add button</a>
            </div>
        </aside>

        @* ─── Main content ─── *@
        <main class="sg-content">

            @* ╔══════════════════════════════════════════════════════════════╗
               ║  MODAL SECTION — 11 demos                                   ║
               ╚══════════════════════════════════════════════════════════════╝ *@

            @* ── Demo 1 — Sizes ── *@
            <section id="modal-sizes" class="sg-section">
                <h2 class="sg-h2">LipiModal — Demos</h2>
                <h3 class="sg-h3"><span class="sg-demo-num">1</span>All four sizes</h3>
                <p class="sg-p">
                    Spec §4 sizes: <code class="sg-code">Compact</code> 400px ·
                    <code class="sg-code">Standard</code> 520px ·
                    <code class="sg-code">Wide</code> 680px ·
                    <code class="sg-code">Fullscreen</code> 95vw. Each opens a
                    declarative <code class="sg-code">&lt;LipiModal&gt;</code>.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m1Open = ModalSize.Compact)">Compact</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m1Open = ModalSize.Standard)">Standard</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m1Open = ModalSize.Wide)">Wide</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m1Open = ModalSize.Fullscreen)">Fullscreen</LipiButton>
                </div>
            </section>

            @* ── Demo 2 — IconColor ── *@
            <section id="modal-iconcolors" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">2</span>All six IconColor values</h3>
                <p class="sg-p">
                    Spec §4 IconColors: None · Info · Success · Warning · Danger · Critical.
                    Backgrounds defined in <code class="sg-code">lipi-overlays.css</code>.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.None)">None</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.Info)">Info</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.Success)">Success</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.Warning)">Warning</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.Danger)">Danger</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m2Open = ModalIconColor.Critical)">Critical</LipiButton>
                </div>
            </section>

            @* ── Demo 3 — Animations ── *@
            <section id="modal-animations" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">3</span>Animations + toggle</h3>
                <p class="sg-p">
                    Spec §8 animations: <code class="sg-code">None</code> ·
                    <code class="sg-code">Fade</code> ·
                    <code class="sg-code">FadeSlide</code> (default) ·
                    <code class="sg-code">FadeScale</code>. Pick one, then click Open.
                </p>
                <div class="sg-btn-row">
                    <label class="sg-form-label" for="m3-anim">Animation:</label>
                    <select id="m3-anim" class="sg-anim-select" @bind="_m3Anim">
                        <option value="None">None</option>
                        <option value="Fade">Fade</option>
                        <option value="FadeSlide">FadeSlide</option>
                        <option value="FadeScale">FadeScale</option>
                    </select>
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _m3Open = true)">Open</LipiButton>
                </div>
            </section>

            @* ── Demo 4 — ConfirmAsync ── *@
            <section id="modal-confirm" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">4</span>ConfirmAsync — service path</h3>
                <p class="sg-p">
                    Spec §5 <code class="sg-code">Modal.ConfirmAsync(...)</code> with all four intents.
                    Critical hides Cancel and disables Esc / backdrop click.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => RunConfirm(ConfirmIntent.Default))">Default</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => RunConfirm(ConfirmIntent.Warning))">Warning</LipiButton>
                    <LipiButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small"
                                OnClick="@(() => RunConfirm(ConfirmIntent.Danger))">Danger</LipiButton>
                    <LipiButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small"
                                OnClick="@(() => RunConfirm(ConfirmIntent.Critical))">Critical</LipiButton>
                </div>
                @if (_confirmResult is not null)
                {
                    <div class="sg-result">Last result: <strong>@_confirmResult</strong></div>
                }
            </section>

            @* ── Demo 5 — AlertAsync ── *@
            <section id="modal-alert" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">5</span>AlertAsync — service path</h3>
                <p class="sg-p">
                    Spec §5 <code class="sg-code">Modal.AlertAsync(...)</code> with all five intents.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => RunAlert(AlertIntent.Info))">Info</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => RunAlert(AlertIntent.Success))">Success</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => RunAlert(AlertIntent.Warning))">Warning</LipiButton>
                    <LipiButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small"
                                OnClick="@(() => RunAlert(AlertIntent.Danger))">Danger</LipiButton>
                    <LipiButton Variant="ButtonVariant.Danger" Size="ButtonSize.Small"
                                OnClick="@(() => RunAlert(AlertIntent.Critical))">Critical</LipiButton>
                </div>
            </section>

            @* ── Demo 6 — PromptAsync ── *@
            <section id="modal-prompt" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">6</span>PromptAsync — service path</h3>
                <p class="sg-p">
                    Spec §5 <code class="sg-code">Modal.PromptAsync(...)</code> for single-input
                    capture. Returns the typed string, or <code class="sg-code">null</code> on cancel.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="RunPrompt">Open prompt</LipiButton>
                </div>
                @if (_promptResult is not null)
                {
                    <div class="sg-result">You entered: <strong>"@_promptResult"</strong></div>
                }
                else if (_promptCancelled)
                {
                    <div class="sg-result sg-result-muted">Cancelled (null returned).</div>
                }
            </section>

            @* ── Demo 7 — ShowAsync ── *@
            <section id="modal-show" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">7</span>ShowAsync — custom component</h3>
                <p class="sg-p">
                    Spec §5 <code class="sg-code">Modal.ShowAsync&lt;TComponent, TResult&gt;()</code> opens any
                    component as a modal. Body is supplied by
                    <code class="sg-code">SampleCustomModal.razor</code>.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="RunCustomShow">Open custom modal</LipiButton>
                </div>
                @if (_showResult is not null)
                {
                    <div class="sg-result">Result: <strong>"@_showResult"</strong></div>
                }
            </section>

            @* ── Demo 8 — IsDirty ── *@
            <section id="modal-isdirty" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">8</span>IsDirty — discard confirmation</h3>
                <p class="sg-p">
                    Spec §2 <code class="sg-code">IsDirty</code> triggers a Warning ConfirmAsync
                    when the user attempts to close. Try ✕ / Escape / backdrop click.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _m8Open = true)">Open dirty modal</LipiButton>
                </div>
            </section>

            @* ── Demo 9 — IsBusy ── *@
            <section id="modal-isbusy" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">9</span>IsBusy — controls disabled</h3>
                <p class="sg-p">
                    Spec §2 <code class="sg-code">IsBusy</code> disables ✕, Esc, backdrop click,
                    and primary action shows busy state. Toggle inside the modal.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _m9Open = true)">Open busy demo</LipiButton>
                </div>
            </section>

            @* ── Demo 10 — Stack ── *@
            <section id="modal-stack" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">10</span>Stack — modal opens another modal</h3>
                <p class="sg-p">
                    Spec §6 stack rules: max 3 modals deep, z-index increments by 10 per level,
                    only topmost is interactive (others <code class="sg-code">inert</code>).
                    Below opens a declarative modal that itself triggers a service ConfirmAsync.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _m10Open = true)">Open stack demo</LipiButton>
                </div>
            </section>

            @* ── Demo 11 — Intents ── *@
            <section id="modal-intents" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">11</span>All six Intent presets</h3>
                <p class="sg-p">
                    Spec §10 Intent auto-defaults table: Default · Confirmation · Alert ·
                    Wizard · Preview · Progress.
                </p>
                <div class="sg-note">
                    <strong>v1.0 divergence (A31):</strong> Only <code class="sg-code">Progress</code> intent
                    cascades forced overrides (ShowCloseButton/CloseOnEscape/CloseOnBackdrop/Animate
                    all forced to false). Confirmation, Alert, Wizard, Preview do NOT auto-default
                    Size or FooterAlign in v1.0 — the project rejects nullable enum params
                    (LipiButton precedent). Consumer must set these explicitly. Tracked for v1.1.
                </div>
                <div class="sg-btn-row" style="margin-top:12px">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Default)">Default</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Confirmation)">Confirmation</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Alert)">Alert</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Wizard)">Wizard</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Preview)">Preview</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _m11Open = ModalIntent.Progress)">Progress</LipiButton>
                </div>
            </section>


            @* ╔══════════════════════════════════════════════════════════════╗
               ║  DRAWER SECTION — 8 demos                                   ║
               ╚══════════════════════════════════════════════════════════════╝ *@

            @* ── Demo 1 — Placements ── *@
            <section id="drawer-placements" class="sg-section">
                <h2 class="sg-h2">LipiDrawer — Demos</h2>
                <h3 class="sg-h3"><span class="sg-demo-num">1</span>All four placements</h3>
                <p class="sg-p">
                    Spec §4 placements: Right (default) · Left · Top · Bottom.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d1Open = DrawerPlacement.Right)">Right</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d1Open = DrawerPlacement.Left)">Left</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d1Open = DrawerPlacement.Top)">Top</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d1Open = DrawerPlacement.Bottom)">Bottom</LipiButton>
                </div>
            </section>

            @* ── Demo 2 — Sizes ── *@
            <section id="drawer-sizes" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">2</span>Sizes per placement</h3>
                <p class="sg-p">
                    Spec §4 sizes. Right/Left: 320 / 400 / 560 / 95vw.
                    Top/Bottom: 240 / 400 / 480 / 95vh.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => OpenSizedDrawer(DrawerSize.Compact))">Compact</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => OpenSizedDrawer(DrawerSize.Standard))">Standard</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => OpenSizedDrawer(DrawerSize.Wide))">Wide</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => OpenSizedDrawer(DrawerSize.FullSide))">FullSide</LipiButton>
                </div>
            </section>

            @* ── Demo 3 — Backdrops ── *@
            <section id="drawer-backdrops" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">3</span>Three backdrop modes</h3>
                <p class="sg-p">
                    Spec §4 backdrops: <code class="sg-code">Dimmed</code> (default, modal-like) ·
                    <code class="sg-code">Light</code> (faint overlay) ·
                    <code class="sg-code">None</code> (page stays fully interactive).
                </p>
                <div class="sg-btn-row">
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d3Open = DrawerBackdrop.Dimmed)">Dimmed</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d3Open = DrawerBackdrop.Light)">Light</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="@(() => _d3Open = DrawerBackdrop.None)">None</LipiButton>
                </div>
            </section>

            @* ── Demo 4 — Dirty form ── *@
            <section id="drawer-dirty" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">4</span>Form with dirty state</h3>
                <p class="sg-p">
                    Spec §2 <code class="sg-code">IsDirty</code> triggers Warning ConfirmAsync on close
                    (✕ / Esc / backdrop). Type into the field to dirty it.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _d4Open = true)">Open dirty drawer</LipiButton>
                </div>
            </section>

            @* ── Demo 5 — Programmatic ── *@
            <section id="drawer-show" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">5</span>Programmatic via ShowAsync</h3>
                <p class="sg-p">
                    Spec §5 <code class="sg-code">Drawer.ShowAsync&lt;TComponent, TResult&gt;()</code>.
                    Body supplied by <code class="sg-code">SampleDrawerPanel.razor</code>.
                </p>
                <div class="sg-note">
                    <strong>v1.0 limitation (A32):</strong> service-driven drawers don't yet carry
                    <code class="sg-code">Icon</code>, <code class="sg-code">IconColor</code>,
                    <code class="sg-code">IsDirty</code>, or <code class="sg-code">Pinnable</code>.
                    Use the declarative <code class="sg-code">&lt;LipiDrawer&gt;</code> for those features
                    until <code class="sg-code">DrawerRequest</code> is extended in v1.1.
                </div>
                <div class="sg-btn-row" style="margin-top:12px">
                    <LipiButton Size="ButtonSize.Small" OnClick="RunDrawerShow">Open via ShowAsync</LipiButton>
                </div>
                @if (_drawerShowResult is not null)
                {
                    <div class="sg-result">Result: <strong>@(_drawerShowResult.Value ? "Confirmed" : "Rejected")</strong></div>
                }
            </section>

            @* ── Demo 6 — Multi-side ── *@
            <section id="drawer-multi" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">6</span>Right + Bottom simultaneous</h3>
                <p class="sg-p">
                    Spec §6 stack rules: different sides can coexist. Right + Bottom is the
                    most common combo (filters + action sheet).
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => { _d6Right = true; _d6Bottom = true; })">
                        Open both
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 7 — Modal on drawer ── *@
            <section id="drawer-modal-on" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">7</span>Modal opens on top of drawer</h3>
                <p class="sg-p">
                    Spec §6: Modal on drawer is valid. Drawer stays visible but inert (no focus).
                    Modal traps focus. Closing modal returns focus to drawer.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _d7Open = true)">Open drawer (then modal inside)</LipiButton>
                </div>
            </section>

            @* ── Demo 8 — Busy ── *@
            <section id="drawer-busy" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">8</span>IsBusy state</h3>
                <p class="sg-p">
                    Spec §2 <code class="sg-code">IsBusy</code> disables controls.
                    Toggle inside the drawer.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="@(() => _d8Open = true)">Open busy drawer</LipiButton>
                </div>
            </section>


            @* ╔══════════════════════════════════════════════════════════════╗
               ║  DYNAMIC TABS SECTION — 11 demos                            ║
               ╚══════════════════════════════════════════════════════════════╝ *@

            <section id="dtabs-empty" class="sg-section">
                <h2 class="sg-h2">LipiDynamicTabs — Demos</h2>

                <p class="sg-p">
                    A single live tab strip lives at the top of every demo tab page
                    (<code class="sg-code">/admin/style-guide-overlays/tab/{TabId}</code>) and
                    reflects all open demo tabs. Use the buttons below to drive its state.
                </p>

                <h3 class="sg-h3"><span class="sg-demo-num">1</span>Empty state</h3>
                <p class="sg-p">
                    Spec §3 <code class="sg-code">EmptyStateMessage</code>: shown when no tabs are open.
                    Close all tabs to see it (or open this page in a fresh tab).
                </p>
                @if (_tabSvc.OpenTabs.Count == 0)
                {
                    <div class="sg-result sg-result-muted">No demo tabs currently open.</div>
                }
                else
                {
                    <div class="sg-result">@_tabSvc.OpenTabs.Count tab(s) currently open.
                        <LipiButton Size="ButtonSize.Small" Variant="ButtonVariant.Secondary"
                                    OnClick="CloseAllDemoTabs">Close all to see empty state</LipiButton>
                    </div>
                }
            </section>

            @* ── Demo 2 — Open 3 ── *@
            <section id="dtabs-open3" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">2</span>3 tabs open, one active</h3>
                <p class="sg-p">
                    Opens patient A, B, C tabs. Last one navigated to is active. Click any tab
                    in the strip (on the destination page) to switch.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("clean-A", "Patient A", "user"))">
                        Open Patient A
                    </LipiButton>
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("clean-B", "Patient B", "user"))">
                        Open Patient B
                    </LipiButton>
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("clean-C", "Patient C", "user"))">
                        Open Patient C
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 3 — Dirty marker ── *@
            <section id="dtabs-dirty" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">3</span>Tab with dirty marker (*)</h3>
                <p class="sg-p">
                    Spec §8 <code class="sg-code">.lipi-dtab-dirty::after</code> shows
                    <code class="sg-code">*</code> in warning color. Open the tab then mark dirty
                    from inside the stub page.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("dirty-demo", "Dirty demo", "file-edit"))">
                        Open dirty-demo tab
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 4 — Clean close ── *@
            <section id="dtabs-close-clean" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">4</span>Closing a clean tab — instant</h3>
                <p class="sg-p">
                    Spec §7 step 3: clean tab closes immediately. Open a tab, then click its ✕
                    in the strip (visible on the destination stub page) — no dialog.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("clean-close", "Clean close test", "x"))">
                        Open then close it
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 5 — Dirty close ── *@
            <section id="dtabs-close-dirty" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">5</span>Closing a dirty tab — 3-option dialog</h3>
                <p class="sg-p">
                    Spec §7 step 4 → <code class="sg-code">DirtyTabConfirmDialog</code>: Cancel · Discard ·
                    Save &amp; close. Without a save handler, only Cancel and Discard appear.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("dirty-no-save", "Dirty (no save handler)", "alert-triangle"))">
                        Open (no save handler)
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 6 — Save & close success ── *@
            <section id="dtabs-save-ok" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">6</span>Save &amp; close — success path</h3>
                <p class="sg-p">
                    TabId prefix <code class="sg-code">save-ok-*</code> registers a passing save
                    handler. Mark dirty, click ✕, choose "Save &amp; close" → handler succeeds, tab closes.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("save-ok-1", "Save &amp; close (OK)", "save"))">
                        Open save-ok-1
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 7 — Save & close failure ── *@
            <section id="dtabs-save-fail" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">7</span>Save &amp; close — failure path</h3>
                <p class="sg-p">
                    TabId prefix <code class="sg-code">save-fail-*</code> registers a save handler
                    that throws. Mark dirty, click ✕, choose "Save &amp; close" → handler throws,
                    tab stays open (spec §7 step 4 sub-bullet).
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small"
                                OnClick="@(() => OpenDemoTab("save-fail-1", "Save &amp; close (fails)", "save"))">
                        Open save-fail-1
                    </LipiButton>
                </div>
            </section>

            @* ── Demo 8 — Soft cap ── *@
            <section id="dtabs-cap" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">8</span>Soft cap warning</h3>
                <p class="sg-p">
                    Spec §7 step 4 + A32: when <code class="sg-code">MaxTabs</code> is reached,
                    further <code class="sg-code">OpenAsync</code> calls pop an
                    <code class="sg-code">AlertAsync</code> warning instead of opening the tab.
                    The button below temporarily sets a 3-tab cap then tries to open 4.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="RunCapDemo">Set cap=3, open 4 tabs</LipiButton>
                </div>
            </section>

            @* ── Demo 9 — Scroll overflow ── *@
            <section id="dtabs-scroll" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">9</span>Scroll overflow (default)</h3>
                <p class="sg-p">
                    Spec §3 <code class="sg-code">OverflowMode.Scroll</code>: horizontal scrollbar
                    appears when tabs exceed strip width. Opens 12 demo tabs to trigger overflow.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="OpenManyTabs">Open 12 tabs</LipiButton>
                    <LipiButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small"
                                OnClick="CloseAllDemoTabs">Close all</LipiButton>
                </div>
            </section>

            @* ── Demo 10 — Dropdown overflow ── *@
            <section id="dtabs-dropdown" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">10</span>Dropdown overflow</h3>
                <p class="sg-p">
                    Spec §3 <code class="sg-code">OverflowMode.Dropdown</code>: visible tabs + "⋯ N more"
                    menu.
                </p>
                <div class="sg-note">
                    <strong>v1.0 limitation (A32):</strong> selecting <code class="sg-code">Dropdown</code>
                    logs a warning and falls back to <code class="sg-code">Scroll</code> mode.
                    Dropdown needs strip-width measurement which is queued for v1.1+.
                </div>
                <div class="sg-code-block">&lt;LipiDynamicTabs MaxTabs="20" OverflowMode="TabOverflowMode.Dropdown" /&gt;
// v1.0: logs warning, behaves as Scroll mode</div>
            </section>

            @* ── Demo 11 — Add button ── *@
            <section id="dtabs-addbtn" class="sg-section">
                <h3 class="sg-h3"><span class="sg-demo-num">11</span>Add button + custom OnAddClick</h3>
                <p class="sg-p">
                    Spec §3 <code class="sg-code">ShowAddButton</code> + <code class="sg-code">OnAddClick</code>.
                    The strip on the demo tab page has <code class="sg-code">ShowAddButton="false"</code>
                    so use the button below to simulate the add action.
                </p>
                <div class="sg-btn-row">
                    <LipiButton Size="ButtonSize.Small" OnClick="HandleAddClick">+ Add new tab</LipiButton>
                </div>
                <div class="sg-result sg-result-muted">
                    Last add click count: <strong>@_addClickCount</strong>
                </div>
            </section>

        </main>
    </div>

</div>


@* ════════════════════════════════════════════════════════════════════
