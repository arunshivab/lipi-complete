@* Demo 8 — IsDirty *@
@if (_m8Open)
{
    <LipiModal Title="Edit something"
               Subtitle="Dirty state demo"
               Icon="file-edit"
               IconColor="ModalIconColor.Warning"
               Size="ModalSize.Standard"
               IsDirty="@(!string.IsNullOrEmpty(_m8Text))"
               OnClose="@(() => { _m8Open = false; _m8Text = string.Empty; })">
        <ModalBody>
            <div class="sg-form-row">
                <label class="sg-form-label" for="m8-input">
