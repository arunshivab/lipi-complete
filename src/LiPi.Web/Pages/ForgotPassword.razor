@page "/forgot-password"
@using LiPi.Master
@using LiPi.Master.Entities
@using LiPi.Web.Services
@using Microsoft.EntityFrameworkCore
@layout LiPi.Web.Components.EmptyLayout
@rendermode InteractiveServer
@inject IDbContextFactory<MasterDbContext> DbFactory
@inject OtpService OtpSvc
@inject IEmailService EmailSvc
@inject NavigationManager Nav

<PageTitle>Forgot Password – LiPi HIS</PageTitle>

<div style="min-height:100dvh;display:flex;align-items:center;justify-content:center;background:#F0F4F8">
  <div style="background:#fff;border-radius:16px;box-shadow:0 8px 40px rgba(11,37,69,.12);padding:32px;width:380px;max-width:95vw">

    <div style="display:flex;align-items:center;gap:12px;margin-bottom:20px">
      <div style="width:40px;height:40px;background:#0B2545;color:#fff;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:20px;font-weight:800;flex-shrink:0">L</div>
      <div>
        <div style="font-size:15px;font-weight:700;color:#0B2545">Forgot Password</div>
        <div style="font-size:11px;color:#94A3B8">We'll send an OTP to your registered email</div>
      </div>
    </div>
    <div style="height:1px;background:#E2E8F0;margin-bottom:20px"></div>

    @if (!string.IsNullOrEmpty(_error))
    {
      <div style="color:#991B1B;font-size:12px;background:#FEF2F2;border:1px solid #FCA5A5;padding:10px 12px;border-radius:8px;margin-bottom:14px">⚠ @_error</div>
    }

    @if (!_sent)
    {
      <div style="margin-bottom:16px">
        <label style="display:block;font-size:11px;font-weight:600;color:#64748B;text-transform:uppercase;letter-spacing:.4px;margin-bottom:5px" for="fp-user">Username or Email</label>
        <input id="fp-user" name="usernameOrEmail" type="text" autocomplete="username"
               style="width:100%;height:36px;border:1px solid #E2E8F0;border-radius:8px;padding:0 12px;font-size:13px;box-sizing:border-box"
               value="@_input" @oninput="e => _input = e.Value?.ToString() ?? string.Empty"
               placeholder="Enter username or email" />
      </div>
      <button type="button" disabled="@_busy"
              style="width:100%;height:40px;background:#0B2545;color:#fff;border:none;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer"
              @onclick="SendOtp">
        @(_busy ? "Sending…" : "Send OTP →")
      </button>
    }
    else
    {
      <div style="text-align:center;padding:10px 0">
        <div style="font-size:32px;margin-bottom:12px">📧</div>
        <div style="font-size:14px;font-weight:600;color:#0B2545;margin-bottom:6px">OTP Sent!</div>
        <div style="font-size:12px;color:#64748B;margin-bottom:20px">
          A 6-digit code was sent to <strong>@_maskedEmail</strong>.<br/>Valid for 10 minutes.
        </div>
        <button class="btn-primary" type="button"
                @onclick='() => Nav.NavigateTo($"/verify-otp/{_userId}")'>
          Enter OTP →
        </button>
      </div>
    }

    <div style="text-align:center;margin-top:16px">
      <a href="/" style="font-size:12px;color:#64748B;text-decoration:none">← Back to Login</a>
    </div>
  </div>
</div>

@code {
  private string _input = "", _maskedEmail = "", _error = "";
  private Guid   _userId;
  private bool   _busy, _sent;

  private async Task SendOtp()
  {
    _error = ""; _busy = true; StateHasChanged();
    try
    {
      await using var db = await DbFactory.CreateDbContextAsync();
      PlatformUser? user;

      if (_input.Contains('@'))
        user = await db.PlatformUsers.FirstOrDefaultAsync(u => u.Email == _input && u.DeletedAt == null);
      else
        user = await db.PlatformUsers.FirstOrDefaultAsync(u => u.Username == _input && u.DeletedAt == null);

      // Always show success even if user not found (security — don't reveal if user exists)
      if (user != null && !string.IsNullOrEmpty(user.Email))
      {
        var otp = OtpSvc.Generate(user.Id, "forgot_password");
        await EmailSvc.SendOtpAsync(user.Email, user.DisplayName, otp, "forgot_password");
        _userId = user.Id;
        // Mask email: ab***@gmail.com
        var parts = user.Email.Split('@');
        _maskedEmail = parts[0][..Math.Min(2, parts[0].Length)] + "***@" + parts[1];
      }
      else
      {
        // Fake success to prevent user enumeration
        _maskedEmail = "your registered email";
        _userId = Guid.NewGuid(); // fake ID — OTP won't verify
      }
      _sent = true;
    }
    catch (Exception ex) { _error = $"Error sending OTP: {ex.Message}"; }
    finally { _busy = false; }
  }
}
