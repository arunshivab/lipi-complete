@page "/test/timepicker"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using LiPi.Web.Components.Shared

<PageTitle>LipiTimePicker Test (Phase 2.4 Batch 9d)</PageTitle>

<style>
    .test-page         { max-width: 720px; margin: 24px auto; padding: 0 16px; }
    .test-section      { margin-bottom: 40px; }
    .test-section h3   { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
    .test-section p    { color: var(--color-text-tertiary); font-size: 13px; margin-bottom: 16px; }
    .live-state        { margin-top: 12px; font-size: 12px; color: var(--color-text-tertiary); font-family: monospace; }
</style>

<div class="test-page">
    <h1 style="font-size: 24px; margin-bottom: 8px;">LipiTimePicker Test</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 32px;">
        Phase 2.4 Batch 9d — verification of segmented time picker bound to TimeOnly?.
        Tests 12h/24h modes, Step validation, Now button (clinic-local + snap).
    </p>

    <EditForm Model="_model" OnValidSubmit="OnValidSubmit">
        <DataAnnotationsValidator />

        <div class="test-section">
            <h3>1. Default (24h, Step=1, ShowNow=true)</h3>
            <p>HH:MM segments. Now sets clinic-local time.</p>
            <LipiTimePicker Name="default"
                            Label="Default time picker"
                            @bind-Value="_model.Default"
                            Helper="24-hour format, any minute" />
            <div class="live-state">Live: @(_model.Default?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>2. 12h mode</h3>
            <p>HH:MM AM/PM. Pressing Up/Down on the AM/PM dropdown toggles.</p>
            <LipiTimePicker Name="twelve"
                            Label="Appointment slot"
                            TimeFormat="12h"
                            @bind-Value="_model.Twelve"
                            Helper="12-hour format with AM/PM" />
            <div class="live-state">Live: @(_model.Twelve?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>3. Step=15 — 15-minute increments</h3>
            <p>Now snaps to nearest past 15. Typing 09:23 → submit shows error.</p>
            <LipiTimePicker Name="step15"
                            Label="15-minute slot"
                            Step="15"
                            @bind-Value="_model.Step15"
                            Required="true"
                            Helper="Must be 00, 15, 30, or 45" />
            <div class="live-state">Live: @(_model.Step15?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>4. Step=30, 12h mode</h3>
            <LipiTimePicker Name="step30"
                            Label="30-minute slot (12h)"
                            Step="30"
                            TimeFormat="12h"
                            @bind-Value="_model.Step30"
                            Helper="Must be on the hour or half-hour" />
            <div class="live-state">Live: @(_model.Step30?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>5. ShowNow=false</h3>
            <LipiTimePicker Name="nonow"
                            Label="No Now button"
                            ShowNow="false"
                            @bind-Value="_model.NoNow" />
            <div class="live-state">Live: @(_model.NoNow?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>6. Read-only</h3>
            <LipiTimePicker Name="readonly"
                            Label="Read-only"
                            @bind-Value="_model.StateReadOnly"
                            ReadOnly="true"
                            Helper="Shows value but cannot be edited" />
        </div>

        <div class="test-section">
            <h3>7. Disabled</h3>
            <LipiTimePicker Name="disabled"
                            Label="Locked"
                            @bind-Value="_model.StateDisabled"
                            Disabled="true" />
        </div>

        <div style="margin-top: 32px;">
            <LipiButton Type="submit" Variant="ButtonVariant.Primary" AriaLabel="Submit">Submit</LipiButton>
        </div>
    </EditForm>

    <div style="margin-top: 32px; padding: 12px; background: var(--color-bg-subtle); border-radius: var(--r-sm); font-size: 12px; color: var(--color-text-secondary);">
        <strong>What to verify (Phase 2.4 Batch 9d):</strong>
        <br /> • <strong>Auto-advance:</strong> Type "09" in HH → focus jumps to MM.
        <br /> • <strong>Arrow keys:</strong> Up/Down on hour wraps; Up/Down on minute increments by Step.
        <br /> • <strong>Now button:</strong> Reads clinic-local time (Asia/Kolkata default), snaps to Step.
        <br /> • <strong>Step asymmetry (Flag 6 C2 lock):</strong> Now SNAPS silently; user-typing rejects with error message.
        <br /> • <strong>12h mode:</strong> AM/PM dropdown shows. Up/Down toggles. Hour 1-12, not 0-23.
        <br /> • <strong>Clear button (×):</strong> Appears when value set.
    </div>
</div>

@code {
    private TestModel _model = new();

    private void OnValidSubmit() { /* no-op */ }

    public class TestModel
    {
        public TimeOnly? Default { get; set; }
        public TimeOnly? Twelve { get; set; }
        [Required(ErrorMessage = "Slot time required.")]
        public TimeOnly? Step15 { get; set; }
        public TimeOnly? Step30 { get; set; }
        public TimeOnly? NoNow { get; set; }
        public TimeOnly? StateReadOnly { get; set; } = new TimeOnly(14, 30);
        public TimeOnly? StateDisabled { get; set; } = new TimeOnly(9, 30);
    }
}
