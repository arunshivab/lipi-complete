@page "/test/datepicker"
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using LiPi.Web.Components.Shared

<PageTitle>LipiDatePicker Test (Phase 2.4 Batch 9d)</PageTitle>

<style>
    .test-page         { max-width: 720px; margin: 24px auto; padding: 0 16px; }
    .test-section      { margin-bottom: 40px; }
    .test-section h3   { font-size: 16px; font-weight: 600; margin-bottom: 4px; }
    .test-section p    { color: var(--color-text-tertiary); font-size: 13px; margin-bottom: 16px; }
    .test-status       { margin-top: 16px; padding: 8px 12px; border-radius: var(--r-sm); font-size: 13px; font-weight: 500; }
    .test-status-valid { background-color: var(--color-success-pale); color: var(--color-success-text-strong); }
    .test-status-invalid { background-color: var(--color-danger-pale); color: var(--color-danger); }
    .live-state        { margin-top: 12px; font-size: 12px; color: var(--color-text-tertiary); font-family: monospace; }
</style>

<div class="test-page">
    <h1 style="font-size: 24px; margin-bottom: 8px;">LipiDatePicker Test</h1>
    <p style="color: var(--color-text-secondary); margin-bottom: 32px;">
        Phase 2.4 Batch 9d — verification of single-date picker bound to DateOnly?.
        Tests Field/Segments modes, calendar popover, constraints, full WAI-ARIA keyboard.
    </p>

    <EditForm Model="_model" OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
        <DataAnnotationsValidator />

        <div class="test-section">
            <h3>1. InputMode=Field (default) — DOB</h3>
            <p>Type DD/MM/YYYY OR click calendar icon. Required.</p>
            <LipiDatePicker Name="dob"
                            Label="Date of Birth"
                            @bind-Value="_model.Dob"
                            Required="true"
                            MaxDate="@DateOnly.FromDateTime(DateTime.Today)"
                            Helper="Cannot be in the future" />
            <div class="live-state">Live: @(_model.Dob?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>2. InputMode=Segments — Appointment date</h3>
            <p>Three numeric segments. Auto-advance on 2 digits in DD/MM. Tab between them.</p>
            <LipiDatePicker Name="appt"
                            Label="Appointment date"
                            InputMode="DatePickerInputMode.Segments"
                            @bind-Value="_model.Appointment"
                            MinDate="@DateOnly.FromDateTime(DateTime.Today)"
                            MaxDate="@DateOnly.FromDateTime(DateTime.Today.AddMonths(3))"
                            Helper="Today through 3 months ahead" />
            <div class="live-state">Live: @(_model.Appointment?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>3. IsDateAllowed — Weekdays only</h3>
            <p>Weekends are not selectable (cells render disabled with strikethrough).</p>
            <LipiDatePicker Name="weekday"
                            Label="Pick a weekday"
                            @bind-Value="_model.WeekdayOnly"
                            IsDateAllowed="@(d => d.DayOfWeek != DayOfWeek.Saturday && d.DayOfWeek != DayOfWeek.Sunday)" />
            <div class="live-state">Live: @(_model.WeekdayOnly?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>4. IsDateDisabled with reason — Holidays</h3>
            <p>Specific dates are blackout. Hover disabled cells to see the reason.</p>
            <LipiDatePicker Name="holiday"
                            Label="Schedule a meeting"
                            @bind-Value="_model.HolidayCheck"
                            IsDateDisabled="@IsHoliday"
                            GetDisabledReason="@GetHolidayReason"
                            Helper="Avoid public holidays" />
            <div class="live-state">Live: @(_model.HolidayCheck?.ToString() ?? "null")</div>
        </div>

        <div class="test-section">
            <h3>5. Read-only state</h3>
            <LipiDatePicker Name="readonly"
                            Label="Read-only date"
                            @bind-Value="_model.StateReadOnly"
                            ReadOnly="true"
                            Helper="Shows value but cannot be edited" />
        </div>

        <div class="test-section">
            <h3>6. Disabled state</h3>
            <LipiDatePicker Name="disabled"
                            Label="Locked date"
                            @bind-Value="_model.StateDisabled"
                            Disabled="true"
                            Helper="Cannot be edited" />
        </div>

        <div style="display: flex; gap: 12px; align-items: center; margin-top: 32px;">
            <LipiButton Type="submit"
                        Variant="ButtonVariant.Primary"
                        AriaLabel="Submit form">
                Submit
            </LipiButton>

            @if (_submitted)
            {
                <span class="test-status @(_isValid ? "test-status-valid" : "test-status-invalid")">
                    @(_isValid ? "✓ Valid submission" : "✗ Invalid — DOB required")
                </span>
            }
        </div>
    </EditForm>

    <div style="margin-top: 32px; padding: 12px; background: var(--color-bg-subtle); border-radius: var(--r-sm); font-size: 12px; color: var(--color-text-secondary);">
        <strong>What to verify (Phase 2.4 Batch 9d):</strong>
        <br /> • <strong>Field mode (1):</strong> Type "07/05/2026", tab out — value commits. Click calendar icon — popover opens.
        <br /> • <strong>Segments mode (2):</strong> Type "0" "7" in DD → focus jumps to MM. Type "0" "5" → focus jumps to YYYY. Type "2026" → completes.
        <br /> • <strong>Calendar popover:</strong> Click cell = commits + closes. Today button = sets today + closes.
        <br /> • <strong>Keyboard (B5 lock):</strong> Open popover, focus calendar. Arrow keys ±1d / ±7d. PageUp/Down ±1 month. Shift+PageUp/Down ±1 year. Home/End first/last day of week. Ctrl+Home/End first/last day of month. Enter/Space commits. Escape closes.
        <br /> • <strong>Min/Max (2):</strong> Cells before today and after 3 months ahead are disabled with strikethrough.
        <br /> • <strong>IsDateAllowed (3):</strong> Saturday/Sunday cells render disabled.
        <br /> • <strong>IsDateDisabled (4):</strong> Hover a holiday cell — tooltip shows reason. If reason returns null, fallback "Date unavailable" appears.
        <br /> • <strong>Clear button:</strong> When value set, × appears. Click clears.
        <br /> • <strong>Required validation:</strong> Submit without DOB → error.
    </div>
</div>

@code {
    private TestModel _model = new();
    private bool _submitted;
    private bool _isValid;

    // Some sample holidays
    private static readonly Dictionary<DateOnly, string> Holidays = new()
    {
        [new DateOnly(2026, 1, 26)]  = "Republic Day",
        [new DateOnly(2026, 8, 15)]  = "Independence Day",
        [new DateOnly(2026, 10, 2)]  = "Gandhi Jayanti",
        [new DateOnly(2026, 12, 25)] = "Christmas Day",
        // One holiday with no reason text — to verify "Date unavailable" fallback
        [new DateOnly(2026, 5, 14)]  = string.Empty,
    };

    private bool IsHoliday(DateOnly d) => Holidays.ContainsKey(d);

    private string? GetHolidayReason(DateOnly d) =>
        Holidays.TryGetValue(d, out var reason) && !string.IsNullOrEmpty(reason)
            ? reason
            : null;  // null triggers fallback "Date unavailable"

    private void OnValidSubmit() { _submitted = true; _isValid = true; }
    private void OnInvalidSubmit() { _submitted = true; _isValid = false; }

    public class TestModel
    {
        [Required(ErrorMessage = "DOB is required.")]
        public DateOnly? Dob { get; set; }
        public DateOnly? Appointment { get; set; }
        public DateOnly? WeekdayOnly { get; set; }
        public DateOnly? HolidayCheck { get; set; }
        public DateOnly? StateReadOnly { get; set; } = DateOnly.FromDateTime(DateTime.Today);
        public DateOnly? StateDisabled { get; set; } = DateOnly.FromDateTime(DateTime.Today);
    }
}
